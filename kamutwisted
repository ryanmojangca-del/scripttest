--============================================================
-- TRUE TWISTED
-- Garou "twisted": land the 4th M1, then front dash into the opponent.
-- Lee twisted (ported from the AHK macro): flick right 50 deg, 30 ms later dash,
-- 110 ms after that flick left 70 deg (net 20 deg left). Flicks are instant snaps.
-- Two ways to start it, same idea as the dash in the main menu:
--   Touch mode ON  = manual: press the key / tap the button and it fires right away.
--   Touch mode OFF = auto: it fires by itself after your 4th M1 (Auto delay, adjustable).
-- Auto mode watches for the animation of your 4th M1 (FOURTH_M1_ANIM below).
-- Shift lock should be ON.
-- Tune the numbers in the window. Nothing here uses virtual keys or mouse.
--============================================================
local Settings = {
    Version = 5,
    Enabled = true,
    Key = Enum.KeyCode.V,
    Direction = "Right", -- side of the first flick (the second flick goes the other way)
    Angle = 70,          -- first flick, degrees
    BackAngle = 95,      -- second flick back, degrees
    DashAt = 0,          -- dash fires this long after the first flick (0 = same moment)
    BackAt = 0.14,       -- second flick, seconds after the press (30 + 80 q-hold + 30)
    EndWait = 0.03,      -- cooldown before it can run again (AHK last Sleep 30)
    TouchMode = true,    -- true = manual (key / tap button), false = auto after the 4th M1
    AutoDelay = 0.15,    -- auto mode: seconds between the 4th M1 starting and the twist
    BackTap = false,     -- optional: walk backwards for a moment first
    BackTapTime = 0.05,
    RotateChar = true,   -- turn the character with the camera (works without shift lock)
    CooldownGuard = false, -- true = client-side 5s dash lock (the server enforces the real one)
}
--// values survive closing and reopening the window
local saved = _G.KAMUI_TrueTwistedSettings
if type(saved) == "table" and saved.Version == Settings.Version then
    for k, v in pairs(saved) do
        if Settings[k] ~= nil then
            Settings[k] = v
        end
    end
end
_G.KAMUI_TrueTwistedSettings = Settings

--// animation id of the 4th M1: auto mode fires when this animation starts
local FOURTH_M1_ANIM = "13294471966"

local DASH_PAYLOAD = { Dash = Enum.KeyCode.W, Key = Enum.KeyCode.Q, Goal = "KeyPress" }
local FLICK_BIND = "KAMUI_TwistedFlick"
local BACKTAP_BIND = "KAMUI_TwistedBackTap"
local dashBusy = false
local running = false

local function isAlive()
    local character = localPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    return humanoid ~= nil
        and humanoid.Health > 0
        and character:FindFirstChild("HumanoidRootPart") ~= nil
end

local function getCommunicate()
    local character = localPlayer.Character
    return character and character:FindFirstChild("Communicate")
end

local function easeInOut(x)
    return x * x * (3 - 2 * x)
end

--// one instant flick, like a single big mouse_event: camera and character turn together by
--// `angle` radians (positive = left). Applied once, right after Roblox's own camera script.
local snapId = 0
local function snapTurn(angle)
    if angle == 0 or not workspace.CurrentCamera then
        return
    end
    snapId = snapId + 1
    local name = FLICK_BIND .. snapId
    RunService:BindToRenderStep(name, Enum.RenderPriority.Camera.Value + 1, function()
        RunService:UnbindFromRenderStep(name)
        local cam = workspace.CurrentCamera
        if cam then
            local focus = cam.Focus.Position
            cam.CFrame = CFrame.new(focus) * CFrame.Angles(0, angle, 0) * CFrame.new(-focus) * cam.CFrame
        end
        if Settings.RotateChar then
            local ch = localPlayer.Character
            local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
            if hrp then
                local p = hrp.Position
                hrp.CFrame = CFrame.new(p) * CFrame.Angles(0, angle, 0) * (CFrame.new(-p) * hrp.CFrame)
            end
        end
    end)
end

--// "light S tap": walk backwards (relative to the camera) for a moment, no virtual keys
local function backTap(duration)
    local character = localPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if not humanoid or duration <= 0 then
        return
    end
    local untilT = os.clock() + duration
    pcall(function()
        RunService:UnbindFromRenderStep(BACKTAP_BIND)
    end)
    RunService:BindToRenderStep(BACKTAP_BIND, Enum.RenderPriority.Camera.Value + 2, function()
        if os.clock() >= untilT or humanoid.Health <= 0 then
            RunService:UnbindFromRenderStep(BACKTAP_BIND)
            return
        end
        humanoid:Move(Vector3.new(0, 0, 1), true)
    end)
end

local function executeTrueTwisted()
    if not Settings.Enabled or running or not isAlive() then
        return
    end
    running = true
    local ok, err = pcall(function()
        local t0 = os.clock()
        local function waitUntil(t)
            local w = t - (os.clock() - t0)
            if w > 0 then
                task.wait(w)
            end
        end
        local sign = (Settings.Direction == "Left") and 1 or -1
        --// 1) FLICK OUT
        snapTurn(sign * math.rad(Settings.Angle))
        if Settings.BackTap then
            backTap(Settings.BackTapTime)
        end
        --// 2) DASH
        waitUntil(Settings.DashAt)
        if isAlive() then
            local remote = getCommunicate()
            if remote then
                if not (Settings.CooldownGuard and dashBusy) then
                    remote:FireServer(DASH_PAYLOAD)
                    if Settings.CooldownGuard and not workspace:GetAttribute("NoDashCooldown") then
                        dashBusy = true
                        task.delay(5, function()
                            dashBusy = false
                        end)
                    end
                end
            else
                warn("[KAMUI Twisted] no Communicate remote on your character")
            end
        end
        --// 3) FLICK BACK (the other way, bigger)
        waitUntil(Settings.BackAt)
        snapTurn(-sign * math.rad(Settings.BackAngle))
        waitUntil(Settings.BackAt + Settings.EndWait)
    end)
    running = false
    if not ok then
        warn("[KAMUI Twisted] error:", err)
    end
end

