-- MOBILE MODE (Others -> True twisted -> Mobile -> Open)
-- One touch button that fires on touch-down, plus a small card with
-- Move / x chips and a switch that shows or hides the settings window.
--============================================================
if _G.KAMUI_TwistedMobile then
    main.Visible = false
    local editing = false
    local strokes = {}

    local function movable(handle, target, onPress)
        local dragging, dragStart, startPos, dragInput = false, nil, nil, nil
        handle.InputBegan:Connect(function(input)
            if not isPress(input) then
                return
            end
            if editing then
                dragging = true
                dragStart = input.Position
                startPos = target.Position
                input.Changed:Connect(function()
                    if input.UserInputState == Enum.UserInputState.End then
                        dragging = false
                    end
                end)
            elseif onPress then
                onPress()
            end
        end)
        handle.InputChanged:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseMovement
                or input.UserInputType == Enum.UserInputType.Touch then
                dragInput = input
            end
        end)
        conns[#conns + 1] = UserInputService.InputChanged:Connect(function(input)
            if dragging and input == dragInput then
                local d = input.Position - dragStart
                target.Position = UDim2.new(
                    startPos.X.Scale, startPos.X.Offset + d.X,
                    startPos.Y.Scale, startPos.Y.Offset + d.Y
                )
            end
        end)
    end

    local twistBtn = mk("TextButton", {
        Name = "TwistTouch",
        Size = UDim2.fromOffset(60, 60),
        Position = UDim2.new(0, 14, 0.28, 0),
        BackgroundColor3 = PAL.Panel,
        BackgroundTransparency = 0.05,
        BorderSizePixel = 0,
        AutoButtonColor = false,
        Text = "",
        ZIndex = 10,
    }, gui)
    applyCorner(twistBtn, 12)
    local twistStroke = addStroke(twistBtn, PAL.Line, 1, 0)
    strokes[#strokes + 1] = twistStroke
    mk("TextLabel", {
        Name = "Icon",
        Size = UDim2.new(1, 0, 0, 22),
        Position = UDim2.fromOffset(0, 7),
        BackgroundTransparency = 1,
        Text = "TW",
        Font = Enum.Font.GothamBold,
        TextSize = 14,
        TextColor3 = PAL.Bright,
        ZIndex = 11,
    }, twistBtn)
    mk("TextLabel", {
        Name = "Label",
        Size = UDim2.new(1, 0, 0, 16),
        Position = UDim2.fromOffset(0, 31),
        BackgroundTransparency = 1,
        Text = "Twisted",
        Font = Enum.Font.GothamMedium,
        TextSize = 12,
        TextColor3 = PAL.Text,
        ZIndex = 11,
    }, twistBtn)
    local accent = mk("Frame", {
        Name = "Accent",
        Size = UDim2.fromOffset(14, 3),
        Position = UDim2.new(0.5, -7, 1, -11),
        BackgroundColor3 = PAL.Red,
        BorderSizePixel = 0,
        ZIndex = 11,
    }, twistBtn)
    applyCorner(accent, 2)
    movable(twistBtn, twistBtn, function()
        task.spawn(executeTrueTwisted)
        twistBtn.BackgroundColor3 = PAL.DarkRed
        twistStroke.Color = PAL.Bright
        TweenSvc:Create(twistBtn, TweenInfo.new(0.22), { BackgroundColor3 = PAL.Panel }):Play()
        TweenSvc:Create(twistStroke, TweenInfo.new(0.22), { Color = PAL.Line }):Play()
    end)

    local panel = mk("Frame", {
        Name = "TwistMobilePanel",
        Size = UDim2.fromOffset(176, 66),
        Position = UDim2.new(0, 80, 0.28, 0),
        BackgroundColor3 = PAL.Panel,
        BackgroundTransparency = 0.05,
        BorderSizePixel = 0,
        ZIndex = 10,
    }, gui)
    applyCorner(panel, 10)
    local panelStroke = addStroke(panel, PAL.Line, 1, 0)
    mk("Frame", {
        Name = "Divider",
        Size = UDim2.new(1, -20, 0, 1),
        Position = UDim2.new(0, 10, 0, 30),
        BackgroundColor3 = PAL.Div,
        BorderSizePixel = 0,
        ZIndex = 11,
    }, panel)
    local function chip(text, w, x)
        local c = mk("TextButton", {
            Size = UDim2.fromOffset(w, 20),
            Position = UDim2.new(1, x, 0, 5),
            BackgroundColor3 = PAL.Chip,
            TextColor3 = PAL.Muted,
            Font = Enum.Font.GothamMedium,
            TextSize = 11,
            Text = text,
            AutoButtonColor = false,
            BorderSizePixel = 0,
            ZIndex = 12,
        }, panel)
        applyCorner(c, 6)
        return c, addStroke(c, PAL.Line, 1, 0)
    end
    local header = mk("Frame", {
        Name = "Header",
        Size = UDim2.new(1, -90, 0, 30),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ZIndex = 11,
    }, panel)
    mk("TextLabel", {
        Name = "Title",
        Size = UDim2.new(1, -12, 1, 0),
        Position = UDim2.new(0, 12, 0, 0),
        BackgroundTransparency = 1,
        Font = Enum.Font.GothamMedium,
        TextSize = 11,
        TextColor3 = PAL.Head,
        TextXAlignment = Enum.TextXAlignment.Left,
        Text = "TRUE TWISTED",
        ZIndex = 12,
    }, header)
    movable(header, panel, nil)
    local moveChip, moveStroke = chip("Move", 44, -80)
    local closeChip = chip("x", 24, -32)
    moveChip.MouseButton1Click:Connect(function()
        editing = not editing
        moveChip.Text = editing and "Done" or "Move"
        moveChip.BackgroundColor3 = editing and PAL.Red or PAL.Chip
        moveChip.TextColor3 = editing and PAL.White or PAL.Muted
        moveStroke.Color = editing and PAL.Red or PAL.Line
        for _, st in ipairs(strokes) do
            st.Color = editing and PAL.Red or PAL.Line
        end
        panelStroke.Color = editing and PAL.Red or PAL.Line
    end)
    closeChip.MouseButton1Click:Connect(function()
        if _G.KAMUI_TwistedCleanup then
            _G.KAMUI_TwistedCleanup()
        end
    end)

    --// settings row: show / hide the full settings window
    mk("TextLabel", {
        Name = "SettingsLabel",
        Size = UDim2.new(0, 110, 0, 34),
        Position = UDim2.new(0, 12, 0, 31),
        BackgroundTransparency = 1,
        Font = Enum.Font.GothamMedium,
        TextSize = 12,
        TextColor3 = PAL.Text,
        TextXAlignment = Enum.TextXAlignment.Left,
        Text = "Settings",
        ZIndex = 12,
    }, panel)
    local showBtn = mk("TextButton", {
        Name = "ShowSettings",
        Size = UDim2.fromOffset(56, 24),
        Position = UDim2.new(1, -68, 0, 36),
        BackgroundColor3 = PAL.Chip,
        BorderSizePixel = 0,
        AutoButtonColor = false,
        Font = Enum.Font.GothamMedium,
        TextSize = 12,
        TextColor3 = PAL.Text,
        Text = "Open",
        ZIndex = 12,
    }, panel)
    applyCorner(showBtn, 7)
    addStroke(showBtn, PAL.Line, 1, 0)
    showBtn.MouseButton1Click:Connect(function()
        main.Visible = not main.Visible
        showBtn.Text = main.Visible and "Hide" or "Open"
    end)
end
print("KAMUI True twisted loaded")
