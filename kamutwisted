    for _, c in ipairs(conns) do
        pcall(function()
            c:Disconnect()
        end)
    end
    table.clear(conns)
    pcall(function()
        RunService:UnbindFromRenderStep(FLICK_BIND)
    end)
    pcall(function()
        RunService:UnbindFromRenderStep(BACKTAP_BIND)
    end)
