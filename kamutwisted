--// AUTO FIRE (Touch mode OFF): same idea as the dash in the main menu. It watches your
--// animations; when your 4th M1 animation starts it waits "Auto delay" and fires.
local function onAnimationPlayed(track)
    if Settings.TouchMode or not Settings.Enabled then
        return
    end
    local animation = track.Animation
    local animId = animation and tostring(animation.AnimationId):match("%d+")
    if animId == FOURTH_M1_ANIM then
        task.spawn(function()
            if Settings.AutoDelay > 0 then
                task.wait(Settings.AutoDelay)
            end
            executeTrueTwisted()
        end)
    end
end
local animConn
local function hookCharacter(char)
    if animConn then
        pcall(function()
            animConn:Disconnect()
        end)
        animConn = nil
    end
    local humanoid = char:FindFirstChildOfClass("Humanoid") or char:WaitForChild("Humanoid", 10)
    if not humanoid then
        return
    end
    animConn = humanoid.AnimationPlayed:Connect(onAnimationPlayed)
    conns[#conns + 1] = animConn
end
if localPlayer.Character then
    task.spawn(hookCharacter, localPlayer.Character)
end
conns[#conns + 1] = localPlayer.CharacterAdded:Connect(function(char)
    task.spawn(hookCharacter, char)
end)

--// drag the window by its top bar
do
    local dragging = false
    local dragStart, startPosition
    conns[#conns + 1] = topBar.InputBegan:Connect(function(input)
        if isPress(input) then
            dragging = true
            dragStart = input.Position
            startPosition = main.Position
        end
    end)
    conns[#conns + 1] = UserInputService.InputEnded:Connect(function(input)
        if isPress(input) then
            dragging = false
        end
    end)
    conns[#conns + 1] = UserInputService.InputChanged:Connect(function(input)
        if dragging
            and (input.UserInputType == Enum.UserInputType.MouseMovement
                or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            main.Position = UDim2.new(
                startPosition.X.Scale,
                startPosition.X.Offset + delta.X,
                startPosition.Y.Scale,
                startPosition.Y.Offset + delta.Y
            )
        end
    end)
end

--// respawn: fresh cooldown guard, and give typing focus back to the game
conns[#conns + 1] = localPlayer.CharacterAdded:Connect(function()
    dashBusy = false
    local box = UserInputService:GetFocusedTextBox()
    if box and box:IsDescendantOf(gui) then
        pcall(function()
            box:ReleaseFocus()
        end)
    end
end)

