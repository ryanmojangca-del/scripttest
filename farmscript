_G.LoopTP_Cleanup = function()
    resetToken = resetToken + 1
    State.loop = false
    for _, c in ipairs(conns) do
        pcall(function()
            c:Disconnect()
        end)
    end
    pcall(function()
        gui:Destroy()
    end)
    _G.LoopTP_Cleanup = nil
end
