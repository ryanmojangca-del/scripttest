--// Loop teleport + auto reset menu
--//  * pick any player from the list, flip "Loop teleport" and you keep teleporting to them
--//  * "Force reset on respawn": every time you respawn it waits X seconds (adjustable) and then resets
--// Mobile friendly (touch drag, scales down on small screens). Toggle key on PC: see TOGGLE_KEY.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UIS = game:GetService("UserInputService")
local HttpService = game:GetService("HttpService")

local LocalPlayer = Players.LocalPlayer
local TOGGLE_KEY = Enum.KeyCode.L -- toggles the loop teleport (set to nil to disable)
local FILE = "LoopTP_Settings.json"

--// re-executing replaces the old copy
if _G.LoopTP_Cleanup then
    pcall(_G.LoopTP_Cleanup)
end

local State = {
    target = nil,     -- Player
    loop = false,
    offset = 2,       -- studs behind the target (negative = in front)
    rate = 0,         -- seconds between teleports (0 = every frame)
    autoReset = false,
    wait = 5,         -- seconds to wait after respawning before the forced reset
}

--// saved settings (not the target / loop state)
do
    local ok, data = pcall(function()
        if isfile and readfile and isfile(FILE) then
            return HttpService:JSONDecode(readfile(FILE))
        end
    end)
    if ok and type(data) == "table" then
        if type(data.offset) == "number" then State.offset = math.clamp(data.offset, -30, 30) end
        if type(data.rate) == "number" then State.rate = math.clamp(data.rate, 0, 5) end
        if type(data.wait) == "number" then State.wait = math.clamp(data.wait, 0, 120) end
        if type(data.autoReset) == "boolean" then State.autoReset = data.autoReset end
    end
end
local savePending = false
local function save()
    if savePending or not writefile then
        return
    end
    savePending = true
    task.delay(0.5, function()
        savePending = false
        pcall(function()
            writefile(FILE, HttpService:JSONEncode({
                offset = State.offset, rate = State.rate, wait = State.wait, autoReset = State.autoReset,
            }))
        end)
    end)
end

local conns = {}
local function connect(signal, fn)
    local c = signal:Connect(fn)
    conns[#conns + 1] = c
    return c
end

