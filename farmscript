----------------------------------------------------------------
-- logic: loop teleport
----------------------------------------------------------------
local acc = 0
connect(RunService.Heartbeat, function(dt)
    if not State.loop then
        return
    end
    local tp = State.target
    if not tp or not tp.Parent then
        setLoopUI(false)
        State.target = nil
        setStatus("Target left the game", true)
        return
    end
    acc = acc + dt
    if acc < State.rate then
        return
    end
    acc = 0
    local tChar = tp.Character
    local tHrp = tChar and tChar:FindFirstChild("HumanoidRootPart")
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if tHrp and hrp and hum and hum.Health > 0 then
        hrp.CFrame = tHrp.CFrame * CFrame.new(0, 0, State.offset)
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
    end
end)

connect(Players.PlayerAdded, rebuildList)
connect(Players.PlayerRemoving, function(p)
    task.defer(function()
        if State.target == p then
            State.target = nil
            if State.loop then
                setLoopUI(false)
            end
            setStatus("Target left the game", true)
        end
        rebuildList()
    end)
end)

if TOGGLE_KEY then
    connect(UIS.InputBegan, function(input, processed)
        if processed or input.KeyCode ~= TOGGLE_KEY then
            return
        end
        if State.loop then
            setLoopUI(false)
            setStatus("Loop teleport off")
        elseif State.target then
            setLoopUI(true)
            setStatus("Looping to " .. State.target.DisplayName)
        else
            setStatus("Pick a player first", true)
        end
    end)
end

----------------------------------------------------------------
-- logic: force reset after respawning
----------------------------------------------------------------
local function forceReset(char)
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then
        return
    end
    pcall(function()
        hum.Health = 0
    end)
    task.delay(0.25, function()
        if hum.Parent and hum.Health > 0 then
            pcall(function()
                hum:ChangeState(Enum.HumanoidStateType.Dead)
            end)
            pcall(function()
                char:BreakJoints()
            end)
        end
    end)
end

local resetToken = 0
local function onCharacter(char)
    resetToken = resetToken + 1
    local my = resetToken
    if not State.autoReset then
        return
    end
    local hum = char:WaitForChild("Humanoid", 10)
    if not hum then
        return
    end
    local startT = os.clock()
    while true do
        if my ~= resetToken or not State.autoReset or LocalPlayer.Character ~= char or hum.Health <= 0 then
            countdown.Text = State.autoReset and "Idle" or "Auto reset off"
            return
        end
        local left = State.wait - (os.clock() - startT)
        if left <= 0 then
            break
        end
        countdown.Text = string.format("Resetting in %.1fs", left)
        task.wait(0.1)
    end
    countdown.Text = "Resetting..."
    forceReset(char)
end
connect(LocalPlayer.CharacterAdded, function(char)
    task.spawn(onCharacter, char)
end)
resetNow.MouseButton1Click:Connect(function()
    forceReset(LocalPlayer.Character)
end)

