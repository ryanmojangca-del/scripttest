local function makeSwitch(parentCard, y, label, sub, onChanged)
    text(parentCard, label, 12, y + 5, 220, 18, 12, TEXT, FONT)
    text(parentCard, sub, 12, y + 23, 230, 14, 10, MUTED, Enum.Font.Gotham)
    local hit = new("TextButton", {
        Text = "", Size = UDim2.new(0, 64, 0, 42), Position = UDim2.new(1, -64, 0, y), BackgroundTransparency = 1, AutoButtonColor = false,
    }, parentCard)
    local track = new("Frame", {
        AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0), Size = UDim2.new(0, 36, 0, 20),
        BackgroundColor3 = OFFT, BorderSizePixel = 0,
    }, hit)
    corner(track, 10)
    local knob = new("Frame", { Size = UDim2.new(0, 14, 0, 14), Position = UDim2.new(0, 3, 0.5, -7), BackgroundColor3 = Color3.fromRGB(189, 184, 184), BorderSizePixel = 0 }, track)
    corner(knob, 7)
    local on = false
    local function set(v, silent)
        on = v
        track.BackgroundColor3 = on and RED or OFFT
        knob.Position = on and UDim2.new(1, -17, 0.5, -7) or UDim2.new(0, 3, 0.5, -7)
        knob.BackgroundColor3 = on and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(189, 184, 184)
        if not silent and onChanged then
            onChanged(on)
        end
    end
    hit.MouseButton1Click:Connect(function()
        set(not on)
    end)
    return set
end

local function makeNumber(parentCard, y, label, key, minV, maxV, decimals)
    text(parentCard, label, 12, y, 190, 34, 12, TEXT, FONT)
    local box = new("TextBox", {
        Size = UDim2.new(0, 74, 0, 24), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0, y + 17),
        BackgroundColor3 = CHIP, BorderSizePixel = 0, Font = Enum.Font.RobotoMono, TextSize = 12, TextColor3 = BRIGHT,
        ClearTextOnFocus = false, Text = string.format("%." .. decimals .. "f", State[key]),
    }, parentCard)
    corner(box, 6)
    stroke(box, LINE)
    box.FocusLost:Connect(function()
        local v = tonumber((box.Text:gsub("%s+", "")))
        if v then
            State[key] = math.clamp(v, minV, maxV)
            save()
        end
        box.Text = string.format("%." .. decimals .. "f", State[key])
    end)
    return box
end

