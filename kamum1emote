        and Settings.EmoteDash.Key
        and input.KeyCode == Settings.EmoteDash.Key then
        task.spawn(executeEmoteDash)
    end
end)
local dragging = false
local dragStart
local startPosition
conns[#conns + 1] = topBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPosition = main.Position
    end
end)
conns[#conns + 1] = UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)
conns[#conns + 1] = UserInputService.InputChanged:Connect(function(input)
    if dragging
        and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        main.Position = UDim2.new(
            startPosition.X.Scale,
            startPosition.X.Offset + delta.X,
            startPosition.Y.Scale,
            startPosition.Y.Offset + delta.Y
        )
    end
end)
--============================================================
-- MOBILE MODE (Others -> M1 reset and emote dash -> Mobile -> Open)
-- Same look as the main KAMUI menu: dark cards, thin borders, red only
-- as an accent. Two touch buttons fire on touch-down; the card holds
-- the Auto rotate switch. "Move" lets you drag the buttons and card.
--============================================================
if _G.KAMUI_M1Mobile then
    main.Visible = false

    local TweenSvc = game:GetService("TweenService")
    local PANEL = Color3.fromRGB(13, 13, 14)
    local CHIP = Color3.fromRGB(20, 20, 22)
    local LINE = Color3.fromRGB(36, 36, 38)
    local DIV = Color3.fromRGB(26, 26, 28)
    local HEAD = Color3.fromRGB(105, 105, 108)
    local MUTED = Color3.fromRGB(150, 145, 146)
    local TEXT = Color3.fromRGB(240, 236, 236)
    local RED = Color3.fromRGB(205, 18, 20)
    local BRIGHT = Color3.fromRGB(240, 30, 24)
    local DARK_RED = Color3.fromRGB(52, 8, 12)
    local OFF_TRACK = Color3.fromRGB(42, 42, 45)
    local OFF_KNOB = Color3.fromRGB(189, 184, 184)
    local WHITE = Color3.fromRGB(255, 255, 255)
    local editing = false
    local strokes = {}

    --// builds an instance; flags it so the main script's skin pass leaves it alone
    local function mkm(class, props, parent)
        local o = Instance.new(class)
        for k, v in pairs(props) do
            o[k] = v
        end
        if class == "TextButton" or class == "TextBox" or class == "Frame" then
            o:SetAttribute("KamuiSkinned", true)
        end
        o.Parent = parent
        return o
    end

    local function addBorder(obj, color)
        local st = Instance.new("UIStroke")
        st.Color = color
        st.Thickness = 1
        st.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
        st.Parent = obj
        return st
    end

    local function isPress(input)
        return input.UserInputType == Enum.UserInputType.Touch
            or input.UserInputType == Enum.UserInputType.MouseButton1
    end

    --// press = action, or drag when "Move" mode is on
    local function movable(handle, target, onPress)
        local dragging, dragStart, startPos, dragInput = false, nil, nil, nil
        handle.InputBegan:Connect(function(input)
            if not isPress(input) then
                return
            end
            if editing then
                dragging = true
                dragStart = input.Position
                startPos = target.Position
                input.Changed:Connect(function()
                    if input.UserInputState == Enum.UserInputState.End then
                        dragging = false
                    end
                end)
            elseif onPress then
                onPress()
            end
        end)
        handle.InputChanged:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseMovement
                or input.UserInputType == Enum.UserInputType.Touch then
                dragInput = input
            end
        end)
        conns[#conns + 1] = UserInputService.InputChanged:Connect(function(input)
            if dragging and input == dragInput then
                local d = input.Position - dragStart
                target.Position = UDim2.new(
                    startPos.X.Scale, startPos.X.Offset + d.X,
                    startPos.Y.Scale, startPos.Y.Offset + d.Y
                )
            end
        end)
    end

    --// touch button: icon + short label + red accent bar (fires on touch-down)
    local function touchButton(name, label, iconId, fallback, x, action)
        local b = mkm("TextButton", {
            Name = name,
            Size = UDim2.fromOffset(60, 60),
            Position = UDim2.new(0, x, 0.28, 0),
            BackgroundColor3 = PANEL,
            BackgroundTransparency = 0.05,
            BorderSizePixel = 0,
            AutoButtonColor = false,
            Text = "",
            ZIndex = 10,
        }, gui)
        applyCorner(b, 12)
        local st = addBorder(b, LINE)
        strokes[#strokes + 1] = st
        local id = tostring(iconId or ""):match("%d+")
        if id then
            mkm("ImageLabel", {
                Name = "Icon",
                Size = UDim2.fromOffset(22, 22),
                Position = UDim2.new(0.5, -11, 0, 7),
                BackgroundTransparency = 1,
                Image = "rbxassetid://" .. id,
                ImageColor3 = BRIGHT,
                ScaleType = Enum.ScaleType.Fit,
                ZIndex = 11,
            }, b)
        else
            mkm("TextLabel", {
                Name = "IconFallback",
                Size = UDim2.new(1, 0, 0, 22),
                Position = UDim2.fromOffset(0, 7),
                BackgroundTransparency = 1,
                Text = fallback,
                Font = Enum.Font.GothamBold,
                TextSize = 14,
                TextColor3 = BRIGHT,
                ZIndex = 11,
            }, b)
        end
        mkm("TextLabel", {
            Name = "Label",
            Size = UDim2.new(1, 0, 0, 16),
            Position = UDim2.fromOffset(0, 31),
            BackgroundTransparency = 1,
            Text = label,
            Font = Enum.Font.GothamMedium,
            TextSize = 12,
            TextColor3 = TEXT,
            ZIndex = 11,
        }, b)
        local accent = mkm("Frame", {
            Name = "Accent",
            Size = UDim2.fromOffset(14, 3),
            Position = UDim2.new(0.5, -7, 1, -11),
            BackgroundColor3 = RED,
            BorderSizePixel = 0,
            ZIndex = 11,
        }, b)
        applyCorner(accent, 2)
        movable(b, b, function()
            task.spawn(action)
            b.BackgroundColor3 = DARK_RED
            st.Color = BRIGHT
            TweenSvc:Create(b, TweenInfo.new(0.22), { BackgroundColor3 = PANEL }):Play()
            TweenSvc:Create(st, TweenInfo.new(0.22), { Color = LINE }):Play()
        end)
        return b
    end

    touchButton("M1ResetTouch", "M1", sharedIcons and sharedIcons.M1Reset, "M1", 14, function()
        local ok, err = pcall(executeTrueM1Reset)
        if not ok then
            warn("[KAMUI Macro] M1 Reset touch error:", err)
        end
    end)
    touchButton("EmoteDashTouch", "Dash", sharedIcons and sharedIcons.EmoteDash, ">>", 80, function()
        local ok, err = pcall(executeEmoteDash)
        if not ok then
            warn("[KAMUI Macro] Emote Dash touch error:", err)
        end
    end)

    --// card with the Auto rotate switch
    local Panel = mkm("Frame", {
        Name = "M1MobilePanel",
        Size = UDim2.fromOffset(176, 66),
        Position = UDim2.new(0, 152, 0.28, 0),
        BackgroundColor3 = PANEL,
        BackgroundTransparency = 0.05,
        BorderSizePixel = 0,
        ZIndex = 10,
    }, gui)
    applyCorner(Panel, 10)
    local panelStroke = addBorder(Panel, LINE)

    mkm("Frame", {
        Name = "Divider",
        Size = UDim2.new(1, -20, 0, 1),
        Position = UDim2.new(0, 10, 0, 30),
        BackgroundColor3 = DIV,
        BorderSizePixel = 0,
        ZIndex = 11,
    }, Panel)

    local function chip(text, w, x)
        local c = mkm("TextButton", {
            Size = UDim2.fromOffset(w, 20),
            Position = UDim2.new(1, x, 0, 5),
            BackgroundColor3 = CHIP,
            TextColor3 = MUTED,
            Font = Enum.Font.GothamMedium,
            TextSize = 11,
            Text = text,
            AutoButtonColor = false,
            BorderSizePixel = 0,
            ZIndex = 12,
        }, Panel)
        applyCorner(c, 6)
        return c, addBorder(c, LINE)
    end

    local Header = mkm("Frame", {
        Name = "Header",
        Size = UDim2.new(1, -90, 0, 30),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ZIndex = 11,
    }, Panel)
    mkm("TextLabel", {
        Name = "Title",
        Size = UDim2.new(1, -12, 1, 0),
        Position = UDim2.new(0, 12, 0, 0),
        BackgroundTransparency = 1,
        Font = Enum.Font.GothamMedium,
        TextSize = 11,
        TextColor3 = HEAD,
        TextXAlignment = Enum.TextXAlignment.Left,
        Text = "M1 RESET",
        ZIndex = 12,
    }, Header)
    movable(Header, Panel, nil)

    local MoveChip, MoveStroke = chip("Move", 44, -80)
    local CloseChip = chip("x", 24, -32)
    MoveChip.MouseButton1Click:Connect(function()
        editing = not editing
        MoveChip.Text = editing and "Done" or "Move"
        MoveChip.BackgroundColor3 = editing and RED or CHIP
        MoveChip.TextColor3 = editing and WHITE or MUTED
        MoveStroke.Color = editing and RED or LINE
        for _, st in ipairs(strokes) do
            st.Color = editing and RED or LINE
        end
        panelStroke.Color = editing and RED or LINE
    end)
    CloseChip.MouseButton1Click:Connect(function()
        if _G.KAMUI_M1Cleanup then
            _G.KAMUI_M1Cleanup()
        end
    end)

    --// Auto rotate row (same switch look as the main menu)
    mkm("TextLabel", {
        Name = "AutoRotateLabel",
        Size = UDim2.new(0, 110, 0, 34),
        Position = UDim2.new(0, 12, 0, 31),
        BackgroundTransparency = 1,
        Font = Enum.Font.GothamMedium,
        TextSize = 12,
        TextColor3 = TEXT,
        TextXAlignment = Enum.TextXAlignment.Left,
        Text = "Auto rotate",
        ZIndex = 12,
    }, Panel)
    local ARHit = mkm("TextButton", {
        Name = "AutoRotateHit",
        Size = UDim2.fromOffset(70, 34),
        Position = UDim2.new(1, -70, 0, 31),
        BackgroundTransparency = 1,
        Text = "",
        ZIndex = 12,
    }, Panel)
    local ARTrack = mkm("Frame", {
        Name = "Track",
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -12, 0.5, 0),
        Size = UDim2.fromOffset(36, 20),
        BorderSizePixel = 0,
        ZIndex = 13,
    }, ARHit)
    applyCorner(ARTrack, 10)
    local ARKnob = mkm("Frame", {
        Name = "Knob",
        Size = UDim2.fromOffset(14, 14),
        BorderSizePixel = 0,
        ZIndex = 14,
    }, ARTrack)
    applyCorner(ARKnob, 7)
    local function syncAutoRotate()
        local on = Settings.TrueM1Reset.AutoRotate
        ARTrack.BackgroundColor3 = on and RED or OFF_TRACK
        ARKnob.Position = on and UDim2.new(1, -17, 0.5, -7) or UDim2.new(0, 3, 0.5, -7)
        ARKnob.BackgroundColor3 = on and WHITE or OFF_KNOB
    end
    ARHit.MouseButton1Click:Connect(function()
        Settings.TrueM1Reset.AutoRotate = not Settings.TrueM1Reset.AutoRotate
        refreshAutoRotate()
        if currentHumanoid and not Settings.TrueM1Reset.AutoRotate then
            currentHumanoid.AutoRotate = true
        end
        syncAutoRotate()
    end)
    syncAutoRotate()
end
print("KAMUI DASH loaded: True M1 Reset + Emote Dash")
