--// Virtual keys we press are remembered, so a macro that gets cut short (death,
--// respawn, error) can never leave a key stuck down. Releases only what is held.
local heldKeys = {}
local function sendKeyEvent(key)
    heldKeys[key] = true
    VirtualInputManager:SendKeyEvent(true, key, false, game)
end
local function tapKey(key)
    heldKeys[key] = nil
    VirtualInputManager:SendKeyEvent(false, key, false, game)
end
local function releaseHeldKeys()
    for key in pairs(heldKeys) do
        heldKeys[key] = nil
        pcall(function()
            VirtualInputManager:SendKeyEvent(false, key, false, game)
        end)
    end
end
