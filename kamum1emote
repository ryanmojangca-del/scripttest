end
local function makeRotCFrame(position, yaw, pitch)
    local currentCamera = workspace.CurrentCamera
    if currentCamera then
        currentCamera.CFrame = CFrame.new(position) * CFrame.Angles(0, yaw, 0) * CFrame.Angles(pitch, 0, 0)
    end
end
local function computeLockAngles(angle, targetPosition, useCharacter, useCamera, _, smoothing)
    if not useCharacter and not useCamera and not angle then
        useCharacter = true
    end
    smoothing = smoothing or 1
    if not currentRootPart or not currentHumanoid then
        return
    end
    local cameraCFrame = camera.CFrame
    local cameraPosition = cameraCFrame.Position
    local rotateCharacter = useCharacter or useCamera
    local rotateCamera = not useCharacter or useCamera
    local position = cameraPosition
    if UserInputService.MouseBehavior == Enum.MouseBehavior.LockCenter then
        position = position - cameraCFrame.RightVector * 1.75
    end
    local pitch = math.asin(cameraCFrame.LookVector.Y)
    local baseYaw
    local targetYaw
    if targetPosition then
        local direction
        if rotateCharacter then
            direction = (targetPosition - currentRootPart.Position).Unit
            baseYaw = math.atan2(-currentRootPart.CFrame.LookVector.X, -currentRootPart.CFrame.LookVector.Z)
        else
            direction = (targetPosition - position).Unit
            baseYaw = math.atan2(-cameraCFrame.LookVector.X, -cameraCFrame.LookVector.Z)
        end
        targetYaw = math.atan2(-direction.X, -direction.Z)
    else
        local lookVector = rotateCharacter and currentRootPart.CFrame.LookVector or cameraCFrame.LookVector
        baseYaw = math.atan2(-lookVector.X, -lookVector.Z)
        targetYaw = baseYaw + math.rad(angle)
    end
    local delta = math.atan2(math.sin(targetYaw - baseYaw), math.cos(targetYaw - baseYaw))
    local finalYaw = baseYaw + delta * smoothing
    if rotateCharacter then
        currentHumanoid.AutoRotate = false
        currentRootPart.CFrame = CFrame.new(currentRootPart.Position) * CFrame.Angles(0, finalYaw, 0)
        if not rotateCamera then
            return
        end
    end
    makeRotCFrame(cameraPosition, finalYaw, pitch)
end
local function pingScaledDelay()
    local ok, ping = pcall(function()
        return DataPing:GetValue()
    end)
    if not ok or type(ping) ~= "number" then
        return 50
    end
    return ping
end
local function pingCompensatedRange(value)
    local adjusted = value + (pingScaledDelay() - 50) * -0.0003846
    return adjusted, value - adjusted
end
local function autoCounterClicks()
    if not currentCommunicate then
        return
    end
    task.wait()
    currentCommunicate:FireServer(leftclick.holdM1)
    task.wait()
    currentCommunicate:FireServer(leftclick.releaseM1)
    task.wait()
end
local function executeTrueM1Reset()
    if not Settings.TrueM1Reset.Enabled then
        return
    end
    if not currentCharacter or not currentHumanoid or not currentRootPart or not currentCommunicate then
        return
    end
    local delay = pingCompensatedRange(0.28)
    local startChar = currentCharacter
    autoCounterClicks()
    task.wait(delay)
    if currentCharacter ~= startChar or not currentHumanoid or currentHumanoid.Health <= 0 then
        return
    end
    if Settings.TrueM1Reset.AutoRotate then
        computeLockAngles(-90)
    end
    sendKeyEvent(keyD)
    tapKeyWithDelay(keyQ)
    task.wait(delay)
    tapKey(keyD)
    if Settings.TrueM1Reset.AutoRotate then
        computeLockAngles(90)
    end
    performFrontDash()
end
local function executeEmoteDash()
    if not Settings.EmoteDash.Enabled then
        return
    end
    if not currentCharacter or not currentHumanoid or not currentRootPart then
        return
    end
    tapKey(keyW)
    tapKey(keyS)
    if Settings.EmoteDash.Type == "Straight" then
        computeLockAngles(90)
    end
    if Settings.EmoteDash.Type == "Straight" or Settings.EmoteDash.Type == "Right" then
        sendKeyEvent(keyD)
    elseif Settings.EmoteDash.Type == "Left" then
        sendKeyEvent(keyA)
    end
    currentHumanoid:ChangeState(Enum.HumanoidStateType.Jumping)
    task.wait(0.005)
    tapKeyWithDelay(keyQ)
    task.wait(Settings.EmoteDash.Delay)
    local dodgeVelocity = currentRootPart:FindFirstChild("dodgevelocity")
    if dodgeVelocity then
        dodgeVelocity:Destroy()
        stopAnimation(animId2)
        stopAnimation(animId3)
    end
    tapKey(keyD)
    tapKey(keyA)
    if Settings.EmoteDash.Type == "Straight" then
        computeLockAngles(-90)
    end
end
