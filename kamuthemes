    local function setLockedWidth(width)
        local ratio = state.ratioW / state.ratioH
        -- Bound both dimensions without losing the requested ratio.
        local low = math.max(16, 16 * ratio)
        local high = math.min(2160, 1320 * ratio)
        if low > high then return false end
        state.manualWidth = math.clamp(width, low, high)
        state.manualHeight = state.manualWidth / ratio
        return true
    end
    local function validNumber(box, low, high)
        local n = tonumber(box.Text)
        if not n or n ~= n or n < low or n > high then return nil end
        return n
    end
    local function commitManual(box, kind)
        if kind == "ratioW" or kind == "ratioH" then
            local n = validNumber(box, 0.01, 1000)
            if n then
                local previous = state[kind]
                state[kind] = n
                if not setLockedWidth(state.manualWidth) then state[kind] = previous end
            end
        elseif kind == "manualWidth" then
            local n = validNumber(box, 16, 2160)
            if n then
                if state.lockRatio then setLockedWidth(n) else state.manualWidth = n end
            end
        elseif kind == "manualHeight" then
            local n = validNumber(box, 16, 1320)
            if n then
                if state.lockRatio then setLockedWidth(n * state.ratioW / state.ratioH) else state.manualHeight = n end
            end
        end
        paintLayout(); save()
    end
