do
    -- Match the original's custom mouse/touch drag, without treating controls
    -- or a scroll gesture as a window drag. Hit-testing is local to Lite.
    local drag, serial = nil, 0
    local function visibleInWindow(obj, pos)
        local current = obj
        while current and current ~= window do
            if current:IsA("GuiObject") then
                if not current.Visible then return false end
                if current ~= obj and (current.ClipsDescendants or current:IsA("ScrollingFrame")) then
                    local p, size = current.AbsolutePosition, current.AbsoluteSize
                    if pos.X < p.X or pos.X > p.X+size.X or pos.Y < p.Y or pos.Y > p.Y+size.Y then return false end
                end
            end
            current = current.Parent
        end
        return current == window
    end
    local function overInteractive(pos)
        for _, obj in ipairs(window:GetDescendants()) do
            if obj:IsA("GuiObject") and (obj:IsA("TextButton") or obj:IsA("ImageButton")
                or obj:IsA("TextBox") or obj:IsA("ScrollingFrame") or obj:GetAttribute("KamuiNoDrag")
                or obj.Name == "About") and visibleInWindow(obj, pos) then
                local p, z = obj.AbsolutePosition, obj.AbsoluteSize
                if pos.X >= p.X and pos.X <= p.X + z.X and pos.Y >= p.Y and pos.Y <= p.Y + z.Y then return true end
            end
        end
        return false
    end
    local began = window.InputBegan:Connect(function(input)
        if not bridge.valid() or not window.Visible or (_G.KAMUI_HideFX and _G.KAMUI_HideFX.Busy) then return end
        if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
        if drag or overInteractive(input.Position) then return end
        serial += 1
        local ticket, start, startPos = serial, input.Position, normalPosition
        -- Defer as the original does, so a slider/picker can claim the press first.
        task.defer(function()
            if ticket ~= serial or input.UserInputState == Enum.UserInputState.End or not screen.Parent
                or activeSlider or _G.KAMUI_SliderHeld or (_G.KAMUI_HideFX and _G.KAMUI_HideFX.Busy) then return end
            drag = {input=input, start=start, position=startPos, touch=input.UserInputType == Enum.UserInputType.Touch}
        end)
    end)
    local changed = UIS.InputChanged:Connect(function(input)
        local d = drag
        if not d then return end
        if not bridge.valid() or activeSlider or _G.KAMUI_SliderHeld or (_G.KAMUI_HideFX and _G.KAMUI_HideFX.Busy) then drag=nil;return end
        if (d.touch and input == d.input) or (not d.touch and input.UserInputType == Enum.UserInputType.MouseMovement) then
            local delta = input.Position - d.start
            normalPosition = UDim2.new(d.position.X.Scale, d.position.X.Offset + delta.X,
                d.position.Y.Scale, d.position.Y.Offset + delta.Y)
            window.Position = normalPosition
        end
    end)
    local ended = UIS.InputEnded:Connect(function(input)
        local d = drag
        if (d and ((d.touch and input == d.input) or (not d.touch and input.UserInputType == Enum.UserInputType.MouseButton1)))
            or (not d and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch)) then
            drag=nil;serial+=1
        end
    end)
    screen.Destroying:Connect(function() serial+=1;drag=nil;began:Disconnect();changed:Disconnect();ended:Disconnect() end)
end

do
-- Follow the original HideFX only while an animation is running, including
-- keybind and restore-button activation.
local originalGui = CoreGui:FindFirstChild("WOOjIEUI")
local originalWindow = originalGui and originalGui:FindFirstChild("MainFrame")
local originalScale = originalWindow and originalWindow:FindFirstChild("WindowScale")
local restoreGui = CoreGui:FindFirstChild("WOOjIEUI_Restore")
local normalOriginalCenter, normalTestCenter, normalOriginalScale
-- Reuse the original vortex instead of cloning and syncing its segments.
-- Its saved origin is separate from its displayed position because the main
-- HideFX continues to calculate the original window's pose from that origin.
local sourceVortex, sourceOrigin
local function releaseVortex()
    if sourceVortex and sourceVortex.Parent and restoreGui and restoreGui.Parent then
        if sourceOrigin then sourceVortex.Position=UDim2.fromOffset(sourceOrigin.X,sourceOrigin.Y) end
        sourceVortex.Parent=restoreGui
    end
    sourceVortex,sourceOrigin=nil,nil
end
local hideSync
local function stopHideSync()
    if hideSync then hideSync:Disconnect(); hideSync=nil end
    releaseVortex()
end
local function trackHideFrame()
    if not screen.Parent or not home.valid() then stopHideSync(); return end
    if not screen.Enabled then stopHideSync(); return end
    local fx = _G.KAMUI_HideFX
    if not (fx and fx.Busy and originalWindow and originalScale and normalOriginalCenter and normalTestCenter and normalOriginalScale) then
        stopHideSync()
        window.Rotation=0
        window.Position=normalPosition
        scale.Scale=baseScale
        window.Visible=home.visible()
        return
    end
    local vortex = (sourceVortex and sourceVortex.Parent and sourceVortex)
        or (restoreGui and restoreGui:FindFirstChild("KamuiVortex"))
    if not vortex then return end -- restore begins one frame before the vortex exists
    if sourceVortex~=vortex then
        releaseVortex()
        sourceVortex=vortex
        sourceOrigin=Vector2.new(vortex.Position.X.Offset,vortex.Position.Y.Offset)
        -- The same ScreenGui overlay keeps the original effect above Lite.
        vortex.Parent=screen
    end
    local origin=sourceOrigin
    local shift=Vector2.new(0,0)
    if (origin-normalOriginalCenter).Magnitude < 8 then shift=normalTestCenter-normalOriginalCenter end
    local testOrigin=origin+shift
    vortex.Position=UDim2.fromOffset(testOrigin.X,testOrigin.Y)
    -- Follow the original HideFX pose without running another vortex animation.
    local ratio=math.clamp(originalScale.Scale/normalOriginalScale,0.001,1)
    local u=math.clamp(1-ratio^(1/1.15),0,1)
    local phi=u*(math.pi*2.7)
    local rel=normalTestCenter-testOrigin
    local cs,sn=math.cos(phi*.7),math.sin(phi*.7)
    local center=testOrigin+Vector2.new(rel.X*cs-rel.Y*sn,rel.X*sn+rel.Y*cs)*(1-u)
    local delta=center-normalTestCenter
    window.Position=UDim2.new(normalPosition.X.Scale,normalPosition.X.Offset+delta.X,
        normalPosition.Y.Scale,normalPosition.Y.Offset+delta.Y)
    window.Rotation=math.deg(phi)
    scale.Scale=baseScale*ratio
    window.Visible=true
end
local function startHideSync()
    if not screen.Parent or not screen.Enabled or not home.valid() then return end
    if not (originalWindow and originalScale) then return end
    -- Capture fresh positions just before each animation, including after dragging.
    normalOriginalCenter=originalWindow.AbsolutePosition+originalWindow.AbsoluteSize*.5
    normalTestCenter=window.AbsolutePosition+window.AbsoluteSize*.5
    normalOriginalScale=originalScale.Scale > .01 and originalScale.Scale or 1
    if not hideSync then hideSync=RunService.RenderStepped:Connect(trackHideFrame) end
end
_G.KAMUI_LiteHideStart=startHideSync
screen.Destroying:Connect(function()
    stopHideSync()
    if _G.KAMUI_LiteHideStart==startHideSync then _G.KAMUI_LiteHideStart=nil end
end)
end -- temporary hide-sync locals
