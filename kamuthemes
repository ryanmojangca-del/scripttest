        manualWidth = 540, manualHeight = 330, ratioW = 18, ratioH = 11, lockRatio = false, manualSidesVersion = 1 }
    local fileOK, assetFn = type(writefile) == "function", getcustomasset or getsynasset
    local function make(class, props, parent)
        local obj = Instance.new(class)
        obj:SetAttribute("KamuiSkinned", true)
        for k, v in pairs(props or {}) do obj[k] = v end
        obj.Parent = parent
        return obj
    end
    local function corner(obj, radius)
        make("UICorner", { CornerRadius = UDim.new(0, radius or 7) }, obj)
    end
    local function stroke(obj, color)
        return make("UIStroke", { Color = color or Color3.fromRGB(43, 43, 46), Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, obj)
    end
    local function label(parent, text, pos, size, color, textSize, bold)
        return make("TextLabel", {
            BackgroundTransparency = 1, BorderSizePixel = 0, Position = pos, Size = size,
            Text = text, TextSize = textSize or 11, TextColor3 = color or THEME.Text,
            Font = bold and Enum.Font.GothamMedium or Enum.Font.Gotham,
            TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd
        }, parent)
    end
    local function button(parent, text, pos, size, color)
        local b = make("TextButton", {
            Position = pos, Size = size, BorderSizePixel = 0, BackgroundColor3 = color,
            Text = text, TextColor3 = THEME.Text, Font = Enum.Font.GothamMedium,
            TextSize = 11, AutoButtonColor = false
        }, parent)
        b:SetAttribute("KamuiNoDrag", true)
        corner(b, 6)
        return b
    end
    local function save()
        if not fileOK then return end
        pcall(function() writefile(STATE_FILE, HttpService:JSONEncode(state)) end)
    end
    if type(isfile) == "function" and type(readfile) == "function" then
        pcall(function()
            if isfile(STATE_FILE) then
                local data = HttpService:JSONDecode(readfile(STATE_FILE))
                if type(data) == "table" then
                    if type(data.url) == "string" then state.url = data.url end
                    if type(data.opacity) == "number" and data.opacity == data.opacity then state.opacity = math.clamp(data.opacity, 0, 1) end
                    if type(data.backgroundOpacity) == "number" and data.backgroundOpacity == data.backgroundOpacity then state.backgroundOpacity = math.clamp(data.backgroundOpacity, 0, 1) end
                    if data.imageMode == "Fit" or data.imageMode == "Fill" or data.imageMode == "Stretch" or data.imageMode == "Manual" then state.imageMode = data.imageMode end
                    if type(data.imageZoom) == "number" and data.imageZoom == data.imageZoom then state.imageZoom = math.clamp(data.imageZoom, 0.25, 2) end
                    if type(data.imageX) == "number" and data.imageX == data.imageX then state.imageX = math.clamp(data.imageX, -1, 1) end
                    if type(data.imageY) == "number" and data.imageY == data.imageY then state.imageY = math.clamp(data.imageY, -1, 1) end
