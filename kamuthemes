local function showTab(name)
    local tp=settings.tabTransition
    if not tp.pages[name] or (tp.initialized and viewingTab==name) then return end
    local previous=tp.initialized and viewingTab or nil
    tp.id=tp.id+1
    local thisId=tp.id
    for _, tween in ipairs(tp.tweens) do tween:Cancel() end
    tp.tweens={}
    -- On rapid clicks settle at the most recently selected tab before starting again.
    for pageName,p in pairs(tp.pages) do p.Position=UDim2.fromOffset(0,0);p.Visible=pageName==previous end
    viewingTab=name
    for tab, pair in pairs(tp.navigation) do
        local item,bar=pair[1],pair[2]
        local active=tab==name
        local label=item:FindFirstChildOfClass("TextLabel")
        bar.Visible=true
        if previous then
            local info=TweenInfo.new(.18,Enum.EasingStyle.Quad,Enum.EasingDirection.Out)
            local t=game:GetService("TweenService"):Create(item,info,{BackgroundTransparency=active and 0 or 1});t:Play();tp.tweens[#tp.tweens+1]=t
            local b=game:GetService("TweenService"):Create(bar,info,{BackgroundTransparency=active and 0 or 1});b:Play();tp.tweens[#tp.tweens+1]=b
            if label then local l=game:GetService("TweenService"):Create(label,info,{TextColor3=active and text or muted});l:Play();tp.tweens[#tp.tweens+1]=l end
        else
            item.BackgroundTransparency=active and 0 or 1;bar.BackgroundTransparency=active and 0 or 1
            if label then label.TextColor3=active and text or muted end
        end
    end
    pageTitle.Text=name
    tp.initialized=true
    local incoming=tp.pages[name]
    if not previous then incoming.Visible=true;return end
    local outgoing=tp.pages[previous]
    local dir=tp.order[name]>tp.order[previous] and 1 or -1
    local height=tp.holder.AbsoluteSize.Y/math.max(.01,scale.Scale)
    if height<1 then height=265 end
    incoming.Position=UDim2.fromOffset(0,dir*height);incoming.Visible=true;outgoing.Visible=true
    local info=TweenInfo.new(.42,Enum.EasingStyle.Quint,Enum.EasingDirection.Out)
    local out=game:GetService("TweenService"):Create(outgoing,info,{Position=UDim2.fromOffset(0,-dir*height)})
    local into=game:GetService("TweenService"):Create(incoming,info,{Position=UDim2.fromOffset(0,0)})
    tp.tweens[#tp.tweens+1]=out;tp.tweens[#tp.tweens+1]=into
    into.Completed:Connect(function(state)
        if tp.id~=thisId or state~=Enum.PlaybackState.Completed then return end
        for pageName,p in pairs(tp.pages) do p.Position=UDim2.fromOffset(0,0);p.Visible=pageName==name end
        tp.tweens={}
    end)
    out:Play();into:Play()
end
