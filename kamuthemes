local minimized, savedVisibility, sizeTween, cornerTween = false, {}, nil, nil
local function setMinimized(state)
    if minimized == state then return end
    minimized=state
    if sizeTween then sizeTween:Cancel() end
    if cornerTween then cornerTween:Cancel() end
    -- The pill owns the only visible border while minimized. Hiding the
    -- full-window background and stroke prevents doubled rounded outlines.
    window.BackgroundTransparency = state and 1 or 0
    windowChrome.stroke.Enabled = not state
    cornerTween=game:GetService("TweenService"):Create(windowChrome.corner,
        TweenInfo.new(.25,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),
        {CornerRadius=UDim.new(0,state and 18 or 12)})
    cornerTween:Play()
    if state then
        for _,child in ipairs(window:GetChildren()) do
            if child:IsA("GuiObject") and child~=pill then savedVisibility[child]=child.Visible; child.Visible=false end
        end
        pill.Visible=true
    else
        pill.Visible=false
        for child,visible in pairs(savedVisibility) do if child.Parent==window then child.Visible=visible end end
        table.clear(savedVisibility)
    end
    sizeTween=game:GetService("TweenService"):Create(window,TweenInfo.new(.25,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),
        {Size=state and UDim2.fromOffset(270,36) or UDim2.fromOffset(540,330)})
    sizeTween:Play()
end
