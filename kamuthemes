    local function setLite(on)
        if liteRunning == on then return end
        liteRunning = on
        if on then
            liteBackgroundTransparency = background.ImageTransparency
            background.ImageTransparency = 1
            liteSetupLayout()
            liteSetupCombat()
            local elapsed = 0
            liteConn = RunService.Heartbeat:Connect(function(dt)
                if not isCurrent() or not MainFrame.Parent then
                    if liteConn then liteConn:Disconnect(); liteConn = nil end
                    return
                end
                elapsed += dt
                if elapsed < 0.15 then return end
                elapsed = 0
                liteSweep()
                local combatPage = _G.KAMUI_CombatTab and _G.KAMUI_CombatTab.Page
                if combatPage then
                    for _, child in ipairs(combatPage:GetChildren()) do
                        if child:IsA("TextLabel") and child.Name == "SectionHeading" then child.Visible = false end
                    end
                end
                local combat = _G.KAMUI_Combat or {}
                for _, item in ipairs(liteCards) do
                    local label = item.row:FindFirstChild("RowLabel")
                    local name = label and label.Text
                    local active = (name == "M1 catch" and combat.Enabled) or (name == "Aimbot" and combat.Aimbot) or (name == "Auto block" and combat.Block)
                    item.row.BackgroundTransparency = active and 0 or 1
                    if active then item.row.BackgroundColor3 = BLUE end
                end
            end)
            liteSweep()
        else
            if liteConn then liteConn:Disconnect(); liteConn = nil end
            for _, item in ipairs(liteCards) do
                if item.dots then item.dots:Destroy() end
                if item.track and item.track.Parent then item.track.Position = item.trackPosition end
                if item.row and item.row.Parent then
                    item.row.BackgroundColor3 = item.rowColor; item.row.BackgroundTransparency = item.rowTransparency
                end
                if item.card and item.card.Parent then
                    item.card.AutomaticSize = item.auto; item.card.Size = item.size; item.card.ClipsDescendants = item.clips
                end
            end
            liteCards = {}
            liteRestoreLayout()
            for obj, props in pairs(liteSaved) do
                if obj.Parent then
                    for prop, entry in pairs(props) do
                        if entry.applied and obj[prop] == entry.applied then obj[prop] = entry.original end
                    end
                end
            end
            liteSaved = {}
            if liteBackgroundTransparency then background.ImageTransparency = liteBackgroundTransparency end
            liteBackgroundTransparency = nil
        end
    end
