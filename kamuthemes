    local drawing, touch, raw, live, lastFingerprint, lastColor = false, nil, {}, nil, nil, nil
    local function width() return math.max(1, canvas.AbsoluteSize.X / math.max(.01, scale.Scale)) end
    local function point(pos)
        local a, sz = canvas.AbsolutePosition, canvas.AbsoluteSize
        return Vector2.new(math.clamp((pos.X-a.X)/math.max(1,sz.X),0,1), math.clamp((pos.Y-a.Y)/math.max(1,sz.Y),0,1))
    end
    local function normalized(f)
        local w,h=width(),draw.height()
        return ((.5+31.2/h-f.Y)*h)/49.4, ((f.X-.5)*w)/49.4
