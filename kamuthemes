    -- Decode GIF87a/89a into composited RGBA frames for EditableImage.
    -- Limits keep malformed or very large animations from exhausting memory.
    local function decodeGif(bytes)
        local input = buffer.fromstring(bytes)
        local length, pos = buffer.len(input), 0
        local function take(n)
            if n < 0 or pos + n > length then error("Truncated GIF") end
            local old = pos; pos += n; return old
        end
        local function u8() return buffer.readu8(input, take(1)) end
        local function u16() return buffer.readu16(input, take(2)) end
        local signature = buffer.readstring(input, take(6), 6)
        if signature ~= "GIF87a" and signature ~= "GIF89a" then error("Invalid GIF header") end
        local width, height = u16(), u16()
        if width < 1 or height < 1 or width > 1024 or height > 1024 then error("GIF dimensions must be at most 1024x1024") end
        local packed, backgroundIndex = u8(), u8(); u8() -- flags, background index, pixel aspect
        local function palette(count)
            local colors = {}
            for i = 0, count - 1 do colors[i] = { u8(), u8(), u8() } end
            return colors
        end
        local globalPalette = bit32.band(packed, 128) ~= 0 and palette(2 ^ (bit32.band(packed, 7) + 1)) or nil
        local function blocks()
            local chunks, total = {}, 0
            while true do
                local n = u8()
                if n == 0 then break end
                total += n
                if total > 8 * 1024 * 1024 then error("GIF data too large") end
                chunks[#chunks + 1] = buffer.readstring(input, take(n), n)
            end
            return table.concat(chunks)
        end
        local function lzw(data, minCode, expected)
            if minCode < 2 or minCode > 8 then error("Unsupported GIF LZW code size") end
            local clear, finish = 2 ^ minCode, 2 ^ minCode + 1
            local prefix, suffix = {}, {}
            local nextCode, codeSize, bitPos = finish + 1, minCode + 1, 0
            local previous, first = nil, nil
            local result, count = buffer.create(expected), 0
            local function readCode()
                if bitPos + codeSize > #data * 8 then return nil end
                local v = 0
                for bit = 0, codeSize - 1 do
                    local at = bitPos + bit
                    local b = string.byte(data, math.floor(at / 8) + 1)
                    v += bit32.band(bit32.rshift(b, at % 8), 1) * 2 ^ bit
                end
                bitPos += codeSize
                return v
            end
            while true do
                local code = readCode()
                if code == nil then error("Truncated GIF image data") end
                if code == clear then
                    prefix, suffix = {}, {}; nextCode = finish + 1; codeSize = minCode + 1; previous = nil
                elseif code == finish then break
                else
                    local original, stack = code, {}
                    if code == nextCode and previous ~= nil then
                        stack[#stack + 1] = first; code = previous
                    elseif code >= nextCode then error("Invalid GIF LZW code") end
                    local guard = 0
                    while code >= clear do
                        guard += 1
                        if guard > 4096 or prefix[code] == nil then error("Invalid GIF LZW dictionary") end
                        stack[#stack + 1] = suffix[code]; code = prefix[code]
                    end
                    first = code
                    stack[#stack + 1] = code
                    for i = #stack, 1, -1 do
                        if count >= expected then error("GIF frame has too many pixels") end
                        buffer.writeu8(result, count, stack[i]); count += 1
                    end
                    if previous ~= nil and nextCode < 4096 then
                        prefix[nextCode], suffix[nextCode] = previous, first
                        nextCode += 1
                        if nextCode == 2 ^ codeSize and codeSize < 12 then codeSize += 1 end
                    end
                    previous = original
                end
            end
            if count ~= expected then error("Incomplete GIF frame") end
            return result
        end
        local canvas = buffer.create(width * height * 4)
        local frames, delays = {}, {}
        local disposal, delay, transparent = 0, 0.1, nil
        local previousDisposal, previousRect, previousCanvas = 0, nil, nil
        local previousClear = nil
        while pos < length do
            local marker = u8()
            if marker == 0x3B then break
            elseif marker == 0x21 then
                local kind = u8()
                if kind == 0xF9 then
                    if u8() ~= 4 then error("Invalid GIF control extension") end
                    local flags = u8(); local cs = u16(); local index = u8()
                    if u8() ~= 0 then error("Invalid GIF control terminator") end
                    disposal = bit32.band(bit32.rshift(flags, 2), 7)
                    delay = cs > 0 and math.max(cs / 100, 0.02) or 0.1
                    transparent = bit32.band(flags, 1) ~= 0 and index or nil
                else blocks() end
            elseif marker == 0x2C then
                if previousDisposal == 2 and previousRect then
                    for row = previousRect.y, previousRect.y + previousRect.h - 1 do
                        if previousClear then
                            for col = previousRect.x, previousRect.x + previousRect.w - 1 do
                                local at = (row * width + col) * 4
                                buffer.writeu8(canvas, at, previousClear[1]); buffer.writeu8(canvas, at + 1, previousClear[2])
                                buffer.writeu8(canvas, at + 2, previousClear[3]); buffer.writeu8(canvas, at + 3, 255)
                            end
                        else
                            buffer.fill(canvas, (row * width + previousRect.x) * 4, 0, previousRect.w * 4)
                        end
                    end
                elseif previousDisposal == 3 and previousCanvas then
                    buffer.copy(canvas, 0, previousCanvas, 0, width * height * 4)
                end
                local x, y, w, h, flags = u16(), u16(), u16(), u16(), u8()
                if w < 1 or h < 1 or x + w > width or y + h > height then error("Invalid GIF frame dimensions") end
                local colors = bit32.band(flags, 128) ~= 0 and palette(2 ^ (bit32.band(flags, 7) + 1)) or globalPalette
                if not colors then error("GIF has no color palette") end
                local minCode = u8(); local indices = lzw(blocks(), minCode, w * h)
                local clearColor = transparent == nil and globalPalette and globalPalette[backgroundIndex] or nil
                if #frames == 0 and clearColor then
                    for at = 0, width * height * 4 - 1, 4 do
                        buffer.writeu8(canvas, at, clearColor[1]); buffer.writeu8(canvas, at + 1, clearColor[2])
                        buffer.writeu8(canvas, at + 2, clearColor[3]); buffer.writeu8(canvas, at + 3, 255)
                    end
                end
                local saved = nil
                if disposal == 3 then
                    saved = buffer.create(width * height * 4)
                    buffer.copy(saved, 0, canvas, 0, width * height * 4)
                end
                local rows = {}
                if bit32.band(flags, 64) ~= 0 then
                    for _, pass in ipairs({{0, 8}, {4, 8}, {2, 4}, {1, 2}}) do
                        for row = pass[1], h - 1, pass[2] do rows[#rows + 1] = row end
                    end
                else for row = 0, h - 1 do rows[#rows + 1] = row end end
                local pixel = 0
                for _, row in ipairs(rows) do
                    for col = 0, w - 1 do
                        local index = buffer.readu8(indices, pixel); pixel += 1
                        if index ~= transparent then
                            local c = colors[index]
                            if not c then error("Invalid GIF palette index") end
                            local out = ((y + row) * width + x + col) * 4
                            buffer.writeu8(canvas, out, c[1]); buffer.writeu8(canvas, out + 1, c[2])
                            buffer.writeu8(canvas, out + 2, c[3]); buffer.writeu8(canvas, out + 3, 255)
                        end
                    end
                end
                if #frames >= 200 or (#frames + 1) * width * height * 4 > 64 * 1024 * 1024 then
                    error("GIF is too large to animate (200 frames / 64 MB decoded maximum)")
                end
                local frame = buffer.create(width * height * 4)
                buffer.copy(frame, 0, canvas, 0, width * height * 4)
                frames[#frames + 1] = frame; delays[#delays + 1] = delay
                previousDisposal, previousRect, previousCanvas = disposal, {x=x, y=y, w=w, h=h}, saved
                previousClear = clearColor
                disposal, delay, transparent = 0, 0.1, nil
                if #frames % 4 == 0 then task.wait() end
            else error("Invalid GIF block") end
        end
        if #frames == 0 then error("GIF contains no frames") end
        return { width = width, height = height, frames = frames, delays = delays }
    end
    local gifImage, gifConnection
    local function stopGif()
        if gifConnection then gifConnection:Disconnect(); gifConnection = nil end
