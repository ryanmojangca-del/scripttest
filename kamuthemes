        settingsPage.ScrollingEnabled=true
        _G.KAMUI_SliderHeld=false
        lastFingerprint=nil
    end
    local function finish()
        if not drawing then return end
        if not append(Vector2.new(.5,.5-18.2/draw.height())) then cancel();return end
        draw.finishLive(live)
        cancel()
    end
    lockButton.MouseButton1Click:Connect(function()
        if drawing then finish() end
        if settings.valid() then draw.toggleLock() end
    end)
    clearButton.MouseButton1Click:Connect(function()
        if drawing then cancel() end
        if settings.valid() then draw.setPoints({}); lastFingerprint=nil end
    end)
    canvas.InputBegan:Connect(function(input)
        if not settings.valid() or draw.locked() or home.mode() ~= "Draw" then return end
        if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
        live=draw.beginLive(); if not live then return end
        drawing=true;touch=input.UserInputType==Enum.UserInputType.Touch and input or nil
        settingsPage.ScrollingEnabled=false;_G.KAMUI_SliderHeld=true
        paths:ClearAllChildren();raw={};lastFingerprint=nil
        if not append(Vector2.new(.5,.5+31.2/draw.height())) or not append(point(input.Position)) then cancel() end
    end)
    local changed=UIS.InputChanged:Connect(function(input)
        if not drawing or not settings.valid() then return end
