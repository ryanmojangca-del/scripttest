        -- Try the direct GUI coordinates first; the inset variants support
        -- executors and devices that report pointer coordinates differently.
        for _, p in ipairs({ point, point - inset, point + inset }) do
            local best, bestDistance = nil, math.huge
            for _, h in ipairs(manualHandles) do
                local pos, size = h.button.AbsolutePosition, h.button.AbsoluteSize
                local cx, cy = pos.X + size.X / 2, pos.Y + size.Y / 2
                local dx, dy = p.X - cx, p.Y - cy
                if math.abs(dx) <= size.X / 2 + 2 and math.abs(dy) <= size.Y / 2 + 2 then
                    local distance = dx * dx + dy * dy
                    if distance < bestDistance then best, bestDistance = h, distance end
                end
            end
            if best then return best end
        end
        return nil
    end
    manualMove.InputBegan:Connect(function(input)
        local handle = handleAtPosition(input)
        if handle then startManualDrag(input, handle.sx, handle.sy, false)
        else startManualDrag(input, 0, 0, true) end
    end)
    for _, h in ipairs(manualHandles) do
        h.button.InputBegan:Connect(function(input) startManualDrag(input, h.sx, h.sy, false) end)
    end
    local function moveManual(input)
        local d = manualDrag
        if not d or manualPreview.AbsoluteSize.X <= 0 or manualPreview.AbsoluteSize.Y <= 0 then return end
        local dx = (input.Position.X - d.startX) / manualPreview.AbsoluteSize.X
        local dy = (input.Position.Y - d.startY) / manualPreview.AbsoluteSize.Y
        if d.moving then
            state.imageX = math.clamp(d.x + dx, -1, 1)
            state.imageY = math.clamp(d.y + dy, -1, 1)
        else
            local newW = d.width + d.sx * dx * 540
            local newH = d.height + d.sy * dy * 330
            if state.lockRatio then
                local ratio = state.ratioW / state.ratioH
                if d.sx == 0 then newW = newH * ratio
                elseif d.sy ~= 0 and math.abs((newH - d.height) / d.height) > math.abs((newW - d.width) / d.width) then newW = newH * ratio end
                setLockedWidth(newW)
            else
                state.manualWidth = math.clamp(newW, 16, 2160)
                state.manualHeight = math.clamp(newH, 16, 1320)
            end
            -- Move the center by half the size change so the opposite edge
            -- stays in place: side handles change only their own edge.
            state.imageX = math.clamp(d.x + d.sx * (state.manualWidth - d.width) / (2 * 540), -1, 1)
            state.imageY = math.clamp(d.y + d.sy * (state.manualHeight - d.height) / (2 * 330), -1, 1)
        end
        paintLayout()
    end
    local dragging, touchInput, activeTrack, activeProperty, activeMin, activeMax = false, nil, nil, nil, 0, 1
    local function setFromX(x)
        if not activeTrack or activeTrack.AbsoluteSize.X <= 0 then return end
        local fraction = math.clamp((x - activeTrack.AbsolutePosition.X) / activeTrack.AbsoluteSize.X, 0, 1)
        state[activeProperty] = activeMin + fraction * (activeMax - activeMin)
        paintOpacity()
    end
    local function bindSlider(sliderHit, sliderTrack, property, minValue, maxValue)
        sliderHit.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                activeTrack, activeProperty = sliderTrack, property
                activeMin, activeMax = minValue or 0, maxValue or 1
                touchInput = input.UserInputType == Enum.UserInputType.Touch and input or nil
                setFromX(input.Position.X)
            end
        end)
    end
    bindSlider(hit, track, "opacity")
    bindSlider(backgroundHit, backgroundTrack, "backgroundOpacity")
    bindSlider(zoomSlider.hit, zoomSlider.track, "imageZoom", 0.25, 2)
    bindSlider(xSlider.hit, xSlider.track, "imageX", -1, 1)
    bindSlider(ySlider.hit, ySlider.track, "imageY", -1, 1)
    if type(_G.KAMUI_ThemeDisconnect) == "function" then pcall(_G.KAMUI_ThemeDisconnect) end
    local changeConn, endConn
    changeConn = UIS.InputChanged:Connect(function(input)
        if not isCurrent() or not root.Parent then changeConn:Disconnect(); return end
        if dragging and ((touchInput and input == touchInput) or (not touchInput and input.UserInputType == Enum.UserInputType.MouseMovement)) then setFromX(input.Position.X) end
        if manualDrag and ((manualDrag.touch and input == manualDrag.touch) or (not manualDrag.touch and input.UserInputType == Enum.UserInputType.MouseMovement)) then moveManual(input) end
    end)
    endConn = UIS.InputEnded:Connect(function(input)
        if not isCurrent() or not root.Parent then endConn:Disconnect(); return end
        if dragging and ((touchInput and input == touchInput) or (not touchInput and input.UserInputType == Enum.UserInputType.MouseButton1)) then
            dragging = false; touchInput = nil; activeTrack = nil; activeProperty = nil; save()
        end
        if manualDrag and ((manualDrag.touch and input == manualDrag.touch) or (not manualDrag.touch and input.UserInputType == Enum.UserInputType.MouseButton1)) then
            manualDrag = nil; themePage.ScrollingEnabled = true; save()
        end
    end)
    _G.KAMUI_ThemeDisconnect = function()
        themePage.ScrollingEnabled = true
        changeConn:Disconnect(); endConn:Disconnect(); surfaceAddedConn:Disconnect()
        stopGif()
        setCustomSurfaces(false)
        for _, conn in ipairs(surfaceConnections) do conn:Disconnect() end
    end
    if state.active and state.path ~= "" and type(isfile) == "function" then
        if state.path:match("%.gif$") then
            -- Decode outside the UI setup so the controls stay responsive.
            generation += 1
            local ticket = generation
            setStatus("Restoring animated GIF...", false)
            task.spawn(function()
                local ok, result = pcall(function()
                    if type(readfile) ~= "function" or not isfile(state.path) then error("File unavailable") end
                    local bytes = readfile(state.path)
                    if #bytes > 8 * 1024 * 1024 then error("GIF exceeds 8 MB") end
                    return decodeGif(bytes)
                end)
                if ticket ~= generation or not isCurrent() or not root.Parent then return end
                if ok then ok, result = pcall(installGif, result) end
                if ok then setStatus("Saved GIF restored.", false); paintOpacity()
                else state.active = false; paintOpacity(); paintSelection(); setStatus("Saved GIF unavailable; press Apply again.", true) end
            end)
        else
            local ok, asset = pcall(function()
                if type(assetFn) ~= "function" or not isfile(state.path) then return nil end
                return assetFn(state.path)
            end)
            if ok and type(asset) == "string" and asset ~= "" then
                customImage.Image = asset
                setStatus("Saved image restored.", false)
            else
                state.active = false
                setStatus("Saved image unavailable; press Apply again.", true)
            end
        end
    elseif state.active then
        state.active = false
        setStatus("Saved image unavailable; press Apply again.", true)
    end
    paintOpacity()
    if state.lite then setLite(true) end
    paintSelection()
end
