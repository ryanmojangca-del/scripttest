    end
    local you = marker("YOU", Color3.fromRGB(70,205,120))
    local target = marker("TARGET", Color3.fromRGB(235,100,70))
    local controlRow = basicRow(card, 42, 2)
    local function control(label, x, width)
        local b = make("TextButton", { BackgroundColor3 = chip, BorderSizePixel = 0, Position = UDim2.new(x, 0, .5, -13),
            Size = UDim2.new(width, -6, 0, 26), Text = label, TextColor3 = text, Font = Enum.Font.GothamMedium,
            TextSize = 11, AutoButtonColor = false }, controlRow); corner(b, 6); return b
    end
    local resizeButton = control("Resize area", .025, .30)
    local lockButton = control("Draw: Unlocked", .35, .30)
    local clearButton = control("Clear Pattern", .675, .30)
    local resizeRow = movementSlider({sliders={ ["Height"] = {
