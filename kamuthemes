-- Lay out only visible rows inside the clipping body. This avoids hidden
-- mode-dependent controls leaving gaps while preserving the original Quint ease.
local function makeExpandable(parent, order)
    local clip = make("Frame", {BackgroundTransparency=1, BorderSizePixel=0,
        Size=UDim2.new(1,0,0,0), LayoutOrder=order, ClipsDescendants=true, Visible=false}, parent)
    local content = make("Frame", {BackgroundTransparency=1, BorderSizePixel=0,
        Size=UDim2.new(1,0,0,0)}, clip)
    local open, tween, generation, targetHeight = false, nil, 0, nil
    local function animate(height)
        height = math.max(0, math.ceil(height))
        if targetHeight == height and (tween or clip.Size.Y.Offset == height) then return end
        targetHeight = height
        generation += 1
        local id = generation
        if tween then tween:Cancel(); tween = nil end
        local current = game:GetService("TweenService"):Create(clip,
            TweenInfo.new(0.42, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
            {Size=UDim2.new(1,0,0,height)})
        tween = current
        current.Completed:Connect(function(state)
            if generation ~= id or state ~= Enum.PlaybackState.Completed then return end
            tween = nil
            if not open then clip.Visible = false end
        end)
        current:Play()
    end
    local function layoutVisibleRows()
        local rows = {}
        for _, child in ipairs(content:GetChildren()) do
            if child:IsA("GuiObject") and child.Visible then rows[#rows+1] = child end
        end
        table.sort(rows, function(a,b) return a.LayoutOrder < b.LayoutOrder end)
        local y = 0
        for _, row in ipairs(rows) do
            row.Position = UDim2.new(0, 0, 0, y)
            y += row.Size.Y.Offset
        end
        content.Size = UDim2.new(1,0,0,y)
        if open then animate(y) end
    end
    local pending = false
    local function scheduleLayout()
        if pending then return end
        pending = true
        task.defer(function()
            pending = false
            if clip.Parent then layoutVisibleRows() end
        end)
    end
    local function observe(child)
        if not child:IsA("GuiObject") then return end
        child:GetPropertyChangedSignal("Visible"):Connect(scheduleLayout)
        child:GetPropertyChangedSignal("Size"):Connect(scheduleLayout)
        child:GetPropertyChangedSignal("LayoutOrder"):Connect(scheduleLayout)
        scheduleLayout()
    end
    content.ChildAdded:Connect(observe)
    content.ChildRemoved:Connect(scheduleLayout)
    local function toggle()
        open = not open
        if open then
            clip.Visible = true
            layoutVisibleRows()
            scheduleLayout()
        else
            animate(0)
        end
    end
    return content, clip, toggle
end
