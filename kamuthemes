        make("Frame",{BorderSizePixel=0,BackgroundColor3=color,AnchorPoint=Vector2.new(.5,.5),
            Position=UDim2.fromOffset((x1+x2)/2,(y1+y2)/2),Size=UDim2.fromOffset(math.sqrt(dx*dx+dy*dy)+1,2),
            Rotation=math.deg(math.atan2(dy,dx)),ZIndex=3,Active=false},paths)
    end
    local function append(f)
        local x,y=normalized(f)
        if not draw.appendLive(live,x,y) then return false end
        raw[#raw+1]=f
        local n=#live
        if n>=2 then segment(live[n-1],live[n],width(),draw.height(),bridge.accent()) end
        return true
    end
    local function cancel()
