    local function isDarkNeutral(color)
        local hi = math.max(color.R, color.G, color.B)
        local lo = math.min(color.R, color.G, color.B)
        return hi <= 0.28 and hi - lo <= 0.10
    end
    local function applySurface(entry)
        local obj = entry.object
        if not obj.Parent then return end
        local shouldFade = customSurfacesOn and isDarkNeutral(obj[entry.colorProperty])
        local target = entry.intendedTransparency
        if shouldFade then
            -- Feature cards retain a faint backing, but the large sidebar
            -- background and its 20px cover must disappear completely.
            if obj.Name == "SidebarBG" or obj.Name == "SidebarCover" or obj:IsA("UIStroke") then
                target = 1
            else
                target = math.max(target, 0.80)
            end
        end
        entry.hidden = shouldFade
        if obj[entry.transparencyProperty] ~= target then
            entry.updating = true
            obj[entry.transparencyProperty] = target
            entry.updating = false
        end
    end
    local function trackSurface(obj)
        if surfaceState[obj] or obj == background or obj:IsDescendantOf(background) or obj:GetAttribute("KamuiThemeKeepBackground") then return end
        if not obj:IsDescendantOf(MainFrame) then return end
        local colorProperty, transparencyProperty
        if obj:IsA("GuiObject") then
            colorProperty, transparencyProperty = "BackgroundColor3", "BackgroundTransparency"
        elseif obj:IsA("UIStroke") then
            colorProperty, transparencyProperty = "Color", "Transparency"
        else
            return
        end
        local entry = {
            object = obj, colorProperty = colorProperty,
            transparencyProperty = transparencyProperty,
            intendedTransparency = obj[transparencyProperty], updating = false
        }
        surfaceState[obj] = entry
        surfaceConnections[#surfaceConnections + 1] = obj:GetPropertyChangedSignal(transparencyProperty):Connect(function()
            if entry.updating or (entry.hidden and obj[transparencyProperty] == 1) then return end
            entry.intendedTransparency = obj[transparencyProperty]
            applySurface(entry)
        end)
        surfaceConnections[#surfaceConnections + 1] = obj:GetPropertyChangedSignal(colorProperty):Connect(function()
            applySurface(entry)
        end)
