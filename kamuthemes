-- Settings reuse the original value setters, slider ranges, and mode-dependent visibility.
local function settingsGroup(title, index, originalRows)
    local dummy = { toggles = {}, sliders = {} }
    local group, body, heading, container = createGroup(title, nil, index, { page = settingsPage, group = dummy, noToggle = true })
    -- The original hides a section when none of its actual controls are visible.
    -- Check the original rows, not the collapsed body: closing a group must not hide it.
    local function syncVisibility()
        local anyVisible = false
        for _, originalRow in ipairs(originalRows) do
            if originalRow.Visible then anyVisible = true; break end
        end
        heading.Visible = anyVisible
        container.Visible = anyVisible
    end
    syncVisibility()
    watchers[#watchers + 1] = syncVisibility
    return group, body
end
local function settingsInput(body, name, order)
    local original = assert(settings.inputs[name], "Missing setting: " .. name)
    if original.range then
        local min, max = original.range()
        local wrapped = { min = min, max = max, row = original.row,
            get = function() return tonumber(original.get()) or min end,
            set = original.set, format = function() return tostring(original.get()) end }
        local group = { sliders = { [name] = wrapped } }
        local row = movementSlider(group, body, name, nil, order)
        watchers[#watchers + 1] = function()
            wrapped.min, wrapped.max = original.range()
            local caption = row:FindFirstChild("RowLabel")
            if caption then caption.Text = original.label() end
        end
    else
        local row = basicRow(body, 39, order); rowLabel(row, name); separator(row)
        local box = make("TextBox", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -14, 0.5, 0),
