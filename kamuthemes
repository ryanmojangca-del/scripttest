            TextSize = 11, TextColor3 = text, Text = tostring(original.get()), ClearTextOnFocus = false }, row)
        corner(box, 6); stroke(box, Color3.fromRGB(57, 52, 60))
        box.FocusLost:Connect(function() if settings.valid() then original.set(box.Text, false) end end)
        watchers[#watchers + 1] = function() row.Visible = original.row.Visible; if not box:IsFocused() then box.Text = tostring(original.get()) end end
