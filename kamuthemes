        you.Position=UDim2.new(.5,0,.5,31.2)
        target.Position=UDim2.new(.5,0,.5,-18.2)
        -- While drawing, append just the new segment; reconcile once on release.
        if drawing then return end
        local pts,color=draw.points(),bridge.accent()
        local fingerprint=tostring(w)..":"..tostring(h)
        for _,q in ipairs(pts) do fingerprint=fingerprint..":"..tostring(q[1])..","..tostring(q[2]) end
        if fingerprint~=lastFingerprint then
            lastFingerprint=fingerprint;lastColor=color;paths:ClearAllChildren()
            for i=2,#pts do segment(pts[i-1],pts[i],w,h,color) end
        elseif color~=lastColor then
            lastColor=color
            for _,line in ipairs(paths:GetChildren()) do if line:IsA("Frame") then line.BackgroundColor3=color end end
        end
    end
end
