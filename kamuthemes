-- KAMUI themes bundle, version 1.
-- Loaded by the matching Kamui main script. Keep both files on matching versions.
local function bindManager(context)
    local MainFrame, THEME = context.MainFrame, context.THEME
    local HttpService, RunService, UIS = context.HttpService, context.RunService, context.UIS
    local isCurrent, getCurrentTab = context.isCurrent, context.getCurrentTab
return function()
    local G = _G.KAMUI_GuiTab
    local root = G and G.Page
    local content = G and G.Content
    local background = MainFrame:FindFirstChild("BackgroundImage")
    if not (root and content and background) then return end
    local DEFAULT_IMAGE, DEFAULT_TRANSPARENCY = background.Image, background.ImageTransparency
    local DEFAULT_FRAME_TRANSPARENCY = MainFrame.BackgroundTransparency
    local DEFAULT_BACKGROUND_COLOR, DEFAULT_BACKGROUND_TRANSPARENCY = background.BackgroundColor3, background.BackgroundTransparency
    local DEFAULT_CLIPS = background.ClipsDescendants
    local STATE_FILE = "KAMUI_CustomTheme.json"
    local state = { url = "", opacity = 0.5, backgroundOpacity = 1 - DEFAULT_FRAME_TRANSPARENCY, path = "", active = false,
        selectedTheme = "Default", imageMode = "Fill", imageZoom = 1, imageX = 0, imageY = 0,
        manualWidth = 540, manualHeight = 330, ratioW = 18, ratioH = 11, lockRatio = false, manualSidesVersion = 1 }
    local fileOK, assetFn = type(writefile) == "function", getcustomasset or getsynasset
    local function make(class, props, parent)
        local obj = Instance.new(class)
        obj:SetAttribute("KamuiSkinned", true)
        for k, v in pairs(props or {}) do obj[k] = v end
        obj.Parent = parent
        return obj
    end
    local function corner(obj, radius)
        make("UICorner", { CornerRadius = UDim.new(0, radius or 7) }, obj)
    end
    local function stroke(obj, color)
        return make("UIStroke", { Color = color or Color3.fromRGB(43, 43, 46), Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, obj)
    end
    local function label(parent, text, pos, size, color, textSize, bold)
        return make("TextLabel", {
            BackgroundTransparency = 1, BorderSizePixel = 0, Position = pos, Size = size,
            Text = text, TextSize = textSize or 11, TextColor3 = color or THEME.Text,
            Font = bold and Enum.Font.GothamMedium or Enum.Font.Gotham,
            TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd
        }, parent)
    end
    local function button(parent, text, pos, size, color)
        local b = make("TextButton", {
            Position = pos, Size = size, BorderSizePixel = 0, BackgroundColor3 = color,
            Text = text, TextColor3 = THEME.Text, Font = Enum.Font.GothamMedium,
            TextSize = 11, AutoButtonColor = false
        }, parent)
        b:SetAttribute("KamuiNoDrag", true)
        corner(b, 6)
        return b
    end
    local function save()
        if not fileOK then return end
        pcall(function() writefile(STATE_FILE, HttpService:JSONEncode(state)) end)
    end
    if type(isfile) == "function" and type(readfile) == "function" then
        pcall(function()
            if isfile(STATE_FILE) then
                local data = HttpService:JSONDecode(readfile(STATE_FILE))
                if type(data) == "table" then
                    if type(data.url) == "string" then state.url = data.url end
                    if type(data.opacity) == "number" and data.opacity == data.opacity then state.opacity = math.clamp(data.opacity, 0, 1) end
                    if type(data.backgroundOpacity) == "number" and data.backgroundOpacity == data.backgroundOpacity then state.backgroundOpacity = math.clamp(data.backgroundOpacity, 0, 1) end
                    if data.imageMode == "Fit" or data.imageMode == "Fill" or data.imageMode == "Stretch" or data.imageMode == "Manual" then state.imageMode = data.imageMode end
                    if type(data.imageZoom) == "number" and data.imageZoom == data.imageZoom then state.imageZoom = math.clamp(data.imageZoom, 0.25, 2) end
                    if type(data.imageX) == "number" and data.imageX == data.imageX then state.imageX = math.clamp(data.imageX, -1, 1) end
                    if type(data.imageY) == "number" and data.imageY == data.imageY then state.imageY = math.clamp(data.imageY, -1, 1) end
                    if type(data.manualWidth) == "number" and data.manualWidth == data.manualWidth then state.manualWidth = math.clamp(data.manualWidth, 16, 2160) end
                    if type(data.manualHeight) == "number" and data.manualHeight == data.manualHeight then state.manualHeight = math.clamp(data.manualHeight, 16, 1320) end
                    if type(data.ratioW) == "number" and data.ratioW == data.ratioW then state.ratioW = math.clamp(data.ratioW, 0.01, 1000) end
                    if type(data.ratioH) == "number" and data.ratioH == data.ratioH then state.ratioH = math.clamp(data.ratioH, 0.01, 1000) end
                    -- Older versions defaulted to locked proportions, causing
                    -- a side handle to change both dimensions. Migrate once.
                    if data.manualSidesVersion == 1 and type(data.lockRatio) == "boolean" then state.lockRatio = data.lockRatio end
                    -- Only permit the exact cache filenames created by this feature.
                    if type(data.path) == "string" and data.path:match("^KAMUI_theme_%d+%.%a+$") then state.path = data.path end
                    state.active = data.active == true
                    if data.selectedTheme == "Lite" or data.selectedTheme == "Hacker" then
                        state.selectedTheme = data.selectedTheme
                        state.active = false
                    else
                        state.selectedTheme = state.active and "Custom" or "Default"
                    end
                end
            end
        end)
    end
