    -- Restrict inputs to direct images on known providers; never execute downloaded data.
    local function validateURL(raw)
        local url = tostring(raw or ""):match("^%s*(.-)%s*$")
        if #url > 2048 or url:find("[%c%s]") then return nil, "Invalid image URL." end
        local host, path = url:match("^https://([^/]+)(/[^?#]*)")
        if not host then return nil, "Use a direct HTTPS image link." end
        host = host:lower()
        local ext = path:match("%.([%a]+)$")
        ext = ext and ext:lower()
        local imgur = host == "i.imgur.com" and path:match("^/[%w]+%.[%a]+$")
        local pinterest = host == "i.pinimg.com" and path:match("^/[%w_/%-]+%.[%a]+$")
        local giphy = host:match("^media%d*%.giphy%.com$") and path:match("^/media/[%w_/%-%.]+%.gif$")
        if (imgur or pinterest) and (ext == "png" or ext == "jpg" or ext == "jpeg") then return url end
        if giphy and ext == "gif" then return url end
        return nil, "Use a direct Imgur/Pinterest PNG or JPG, or GIPHY GIF."
    end
    local function download(url)
        local req = request or http_request or (syn and syn.request) or (http and http.request)
        local body
        if type(req) == "function" then
            local ok, res = pcall(req, { Url = url, Method = "GET" })
            if ok and type(res) == "table" then
                local code = res.StatusCode or res.Status or res.status_code
                if code and (tonumber(code) == nil or tonumber(code) < 200 or tonumber(code) >= 300) then
                    return nil, "Image host returned HTTP " .. tostring(code) .. "."
                end
                body = res.Body or res.body
            end
        end
        if type(body) ~= "string" or body == "" then
            local ok, data = pcall(function() return game:HttpGet(url, true) end)
            if ok then body = data end
        end
        if type(body) ~= "string" or body == "" then return nil, "Download failed. Check the link or executor." end
        if #body > 8 * 1024 * 1024 then return nil, "Image is too large (8 MB maximum)." end
        local ext
        if body:sub(1, 8) == "\137PNG\13\10\26\10" then ext = "png"
        elseif body:sub(1, 3) == "\255\216\255" then ext = "jpg"
        elseif body:sub(1, 6) == "GIF87a" or body:sub(1, 6) == "GIF89a" then ext = "gif"
        else return nil, "Link did not return a PNG, JPG, or GIF image." end
        return body, ext
    end
