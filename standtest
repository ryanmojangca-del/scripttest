_G.Stand_Cleanup = function()
    State.active = false
    pcall(function()
        State.hidden = false
        releaseHidden()
    end)
    for _, c in ipairs(conns) do
        pcall(function()
            c:Disconnect()
        end)
    end
    pcall(function()
        gui:Destroy()
    end)
    _G.Stand_Cleanup = nil
end
