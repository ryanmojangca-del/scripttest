--// Stand menu
--//  * YOU are the stand. Pick a player from the list = they become your owner
--//  * you instantly spawn on the chosen side (Left / Right) of them and follow them around
--//  * switching the owner or the side moves you over automatically, click the owner again (or Release) to stop
--//  * the owner can command the stand from chat:  .attack <name>   .stop   .left   .right   .hide   .show
--//  * .awakening presses G (awakening), .annoy <name> follows the target's back and M1s them once a second
--//  * .hide puts the stand lying under the map (it still follows and still attacks from underneath), .show brings it back
--//  * .attack loops skills 1-4 on the target (keeps going through respawns) until .stop
--//  * M1 punches keep going in between, so whenever skills are on cooldown you are still hitting
--// Mobile friendly (touch drag, scales down on small screens). Hotkeys on PC: see TOGGLE_KEY / SWAP_KEY.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UIS = game:GetService("UserInputService")
local HttpService = game:GetService("HttpService")

local LocalPlayer = Players.LocalPlayer
local TOGGLE_KEY = Enum.KeyCode.Z -- pause / resume following (set to nil to disable)
local SWAP_KEY = Enum.KeyCode.X   -- swap left / right (set to nil to disable)
local FILE = "Stand_Settings.json"
local ATTACK_DIST = 3  -- studs behind the victim's back while attacking
local HIDE_DEPTH = 6   -- studs under the target / owner while hidden (.hide)
local ATTACK_TIME = 0  -- seconds before the stand returns on its own (0 = loop until .stop)
local SKILL_DELAY = 0.35 -- seconds between skill presses (1 > 2 > 3 > 4 > 1 ...)
local ANNOY_DELAY = 1   -- seconds between M1 punches in .annoy mode
local M1_DELAY = 0.15    -- seconds between M1 punches
local SKILL_LOCK = 0.3   -- M1 pauses this long after a skill press so it doesn't cancel the skill

--// re-executing replaces the old copy
if _G.Stand_Cleanup then
    pcall(_G.Stand_Cleanup)
end

local State = {
    owner = nil,      -- Player
    active = false,   -- true while you are bound to the owner
    side = "Right",   -- "Left" or "Right"
    sideDist = 3,     -- studs to the side of the owner
    height = 1.5,     -- studs above the owner's root part
    behind = 1.5,     -- studs behind the owner (negative = in front)
    smooth = 0.8,     -- 0 = snap instantly, closer to 1 = slower glide
    bob = 0.3,        -- floating bob amount in studs
    commands = true,  -- obey chat commands from the owner
    hidden = false,   -- stand is lying under the map (.hide / .show)
    mode = "follow",  -- "follow" or "attack"
    victim = nil,     -- Player being attacked
}
local attackStart = 0

--// saved settings (not the owner / summoned state)
do
    local ok, data = pcall(function()
        if isfile and readfile and isfile(FILE) then
            return HttpService:JSONDecode(readfile(FILE))
        end
    end)
    if ok and type(data) == "table" then
        if data.side == "Left" or data.side == "Right" then State.side = data.side end
        if type(data.sideDist) == "number" then State.sideDist = math.clamp(data.sideDist, 0, 30) end
        if type(data.height) == "number" then State.height = math.clamp(data.height, -10, 20) end
        if type(data.behind) == "number" then State.behind = math.clamp(data.behind, -20, 20) end
        if type(data.smooth) == "number" then State.smooth = math.clamp(data.smooth, 0, 0.95) end
        if type(data.bob) == "number" then State.bob = math.clamp(data.bob, 0, 3) end
        if type(data.commands) == "boolean" then State.commands = data.commands end
    end
end
local savePending = false
local function save()
    if savePending or not writefile then
        return
    end
    savePending = true
    task.delay(0.5, function()
        savePending = false
        pcall(function()
            writefile(FILE, HttpService:JSONEncode({
                side = State.side, sideDist = State.sideDist, height = State.height,
                behind = State.behind, smooth = State.smooth, bob = State.bob, commands = State.commands,
            }))
        end)
    end)
end

local conns = {}
local function connect(signal, fn)
    local c = signal:Connect(fn)
    conns[#conns + 1] = c
    return c
end

