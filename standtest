local VIM = nil
pcall(function()
    VIM = game:GetService("VirtualInputManager")
end)
local SKILL_KEYS = { Enum.KeyCode.One, Enum.KeyCode.Two, Enum.KeyCode.Three, Enum.KeyCode.Four }
local skillIdx = 1

-- presses hotbar key i (1-4); falls back to the i-th backpack tool if key simulation isn't available
local function useSkill(i)
    local ok = false
    if VIM then
        ok = pcall(function()
            VIM:SendKeyEvent(true, SKILL_KEYS[i], false, game)
            task.wait(0.05)
            VIM:SendKeyEvent(false, SKILL_KEYS[i], false, game)
        end)
    end
    if not ok then
        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
        if hum and bp then
            local tools = {}
            for _, t in ipairs(bp:GetChildren()) do
                if t:IsA("Tool") then
                    tools[#tools + 1] = t
                end
            end
            local t = tools[i]
            if t then
                pcall(function()
                    hum:EquipTool(t)
                end)
                task.wait(0.05)
                pcall(function()
                    t:Activate()
                end)
            end
        end
    end
end

-- M1 punch = a quick left click
local function useM1()
    local ok = false
    if VIM then
        ok = pcall(function()
            local m = UIS:GetMouseLocation()
            VIM:SendMouseButtonEvent(m.X, m.Y, 0, true, game, 0)
            task.wait(0.03)
            VIM:SendMouseButtonEvent(m.X, m.Y, 0, false, game, 0)
        end)
    end
    if not ok and mouse1click then
        pcall(mouse1click)
    end
end

-- awakening = press G
local function useAwakening()
    local ok = false
    if VIM then
        ok = pcall(function()
            VIM:SendKeyEvent(true, Enum.KeyCode.G, false, game)
            task.wait(0.05)
            VIM:SendKeyEvent(false, Enum.KeyCode.G, false, game)
        end)
    end
    return ok
end

