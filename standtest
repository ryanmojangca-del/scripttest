-- hide = lie under the map: no collision, lying flat, still following / attacking from underneath
local hideStore = setmetatable({}, { __mode = "k" })
local function enforceHidden(char, hum)
    hum.PlatformStand = true
    for _, d in ipairs(char:GetChildren()) do
        if d:IsA("BasePart") then
            if hideStore[d] == nil then
                hideStore[d] = d.CanCollide
            end
            d.CanCollide = false
        end
    end
end
local function releaseHidden()
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    for part, was in pairs(hideStore) do
        if part.Parent then
            part.CanCollide = was
        end
        hideStore[part] = nil
    end
    if hum then
        hum.PlatformStand = false
    end
end
setHidden = function(on)
    if State.hidden == on then
        return
    end
    State.hidden = on
    snap = true
    if not on then
        -- the stand jumps back above the floor first, collisions come back a moment later
        task.delay(0.2, function()
            if not State.hidden then
                releaseHidden()
            end
        end)
    end
end

local attackAcc = 0
local m1Acc = 0
local lockUntil = 0
local function boundText()
    return "Stand of " .. State.owner.DisplayName .. " (" .. State.side .. ")"
end
local function endAttack(msg)
    State.mode = "follow"
    State.victim = nil
    snap = false
    setStatus(msg or boundText())
end

connect(RunService.Heartbeat, function(dt)
    if not State.active then
        return
    end
    local owner = State.owner
    if not owner or not owner.Parent then
        selectOwner(nil)
        setStatus("Owner left the game", true)
        return
    end
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not (hrp and hum and hum.Health > 0) then
        return
    end

    if State.hidden then
        enforceHidden(char, hum)
    end

    local goal, smooth = nil, State.smooth
    if State.mode == "attack" or State.mode == "annoy" then
        local v = State.victim
        if not v or not v.Parent then
            endAttack("Target left, back to owner")
            return
        end
        if ATTACK_TIME > 0 and os.clock() - attackStart > ATTACK_TIME then
            endAttack("Attack finished, back to owner")
            return
        end
        local vChar = v.Character
        local vHrp = vChar and vChar:FindFirstChild("HumanoidRootPart")
        local vHum = vChar and vChar:FindFirstChildOfClass("Humanoid")
        if not vHrp or (vHum and vHum.Health <= 0) then
            return -- target is dead / respawning: wait here, the loop resumes when they are back
        end
        -- stay right behind the victim's back (+Z = behind them), facing them, and keep tracking as they turn
        if State.hidden then
            -- hidden: lie directly under the target, face up at them
            goal = CFrame.new(vHrp.Position - Vector3.new(0, HIDE_DEPTH, 0)) * vHrp.CFrame.Rotation * CFrame.Angles(math.rad(90), 0, 0)
        else
            local pos = (vHrp.CFrame * CFrame.new(0, 0, ATTACK_DIST)).Position
            goal = CFrame.lookAt(pos, vHrp.Position)
        end
        smooth = math.min(State.smooth, 0.3)

        local now = os.clock()

        if State.mode == "annoy" then
            -- .annoy: one M1 per second
            m1Acc = m1Acc + dt
            if m1Acc >= ANNOY_DELAY then
                m1Acc = 0
                task.spawn(useM1)
            end
        else
            -- loop skills 1 > 2 > 3 > 4 on the target (skips any that are on cooldown)
            attackAcc = attackAcc + dt
            if attackAcc >= SKILL_DELAY then
                attackAcc = 0
                for _ = 1, 4 do
                    local i = skillIdx
                    skillIdx = i % 4 + 1
                    if not skillOnCooldown(i) then
                        task.spawn(useSkill, i)
                        lockUntil = now + SKILL_LOCK
                        break
                    end
                end
            end

            -- M1 punches fill the time between skills / while they are on cooldown
            m1Acc = m1Acc + dt
            if m1Acc >= M1_DELAY and now >= lockUntil then
                m1Acc = 0
                task.spawn(useM1)
            end
        end
    else
        local oChar = owner.Character
        local oHrp = oChar and oChar:FindFirstChild("HumanoidRootPart")
        if not oHrp then
            return
        end
        local sign = State.side == "Right" and 1 or -1
        local bob = math.sin(os.clock() * 2.5) * State.bob
        -- local space: +X = owner's right, +Y = up, +Z = behind the owner
        if State.hidden then
            -- hidden: same side / behind spot, but lying under the floor
            local pos = (oHrp.CFrame * CFrame.new(sign * State.sideDist, 0, State.behind)).Position
            goal = CFrame.new(pos - Vector3.new(0, HIDE_DEPTH, 0)) * oHrp.CFrame.Rotation * CFrame.Angles(math.rad(90), 0, 0)
        else
            goal = oHrp.CFrame * CFrame.new(sign * State.sideDist, State.height + bob, State.behind)
        end
    end

    local alpha = 1
    if not snap and smooth > 0 then
        alpha = 1 - smooth ^ (dt * 60)
    end
    snap = false

    hrp.CFrame = hrp.CFrame:Lerp(goal, alpha)
    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.AssemblyAngularVelocity = Vector3.zero
end)

----------------------------------------------------------------
-- logic: chat commands from the owner
----------------------------------------------------------------
local function findPlayer(q)
    q = string.lower(q or "")
    if q == "" then
        return nil
    end
    local exact, prefix, partial
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p ~= State.owner then
            local n, d = string.lower(p.Name), string.lower(p.DisplayName)
            if n == q or d == q then
                exact = exact or p
            elseif string.sub(n, 1, #q) == q or string.sub(d, 1, #q) == q then
                prefix = prefix or p
            elseif string.find(n, q, 1, true) or string.find(d, q, 1, true) then
                partial = partial or p
            end
        end
    end
    return exact or prefix or partial
end

local function handleCommand(msg)
    if not State.commands or not State.owner or not State.active then
        return
    end
    local cmd, arg = string.match(msg, "^%s*%.(%a+)%s*(.-)%s*$")
    if not cmd then
        return
    end
    cmd = string.lower(cmd)
    if cmd == "attack" then
        local v = findPlayer(arg)
        if not v then
            setStatus("No player matching '" .. arg .. "'", true)
            return
        end
        State.mode = "attack"
        State.victim = v
        attackStart = os.clock()
        attackAcc = 0
        m1Acc = 0
        lockUntil = 0
        skillIdx = 1
        setStatus("Attacking " .. v.DisplayName .. " (skills + M1)")
    elseif cmd == "annoy" then
        local v = findPlayer(arg)
        if not v then
            setStatus("No player matching '" .. arg .. "'", true)
            return
        end
        State.mode = "annoy"
        State.victim = v
        attackStart = os.clock()
        m1Acc = 0
        setStatus("Annoying " .. v.DisplayName .. " (M1 every " .. ANNOY_DELAY .. "s)")
    elseif cmd == "awakening" or cmd == "awaken" then
        if useAwakening() then
            setStatus("Awakening (G) pressed")
        else
            setStatus("Couldn't press G (key simulation unavailable)", true)
        end
    elseif cmd == "stop" or cmd == "return" or cmd == "follow" or cmd == "back" then
        endAttack()
    elseif cmd == "hide" then
        setHidden(true)
        setStatus("Stand hidden under the map")
    elseif cmd == "show" or cmd == "unhide" then
        setHidden(false)
        setStatus(boundText())
    elseif cmd == "left" then
        setSide("Left")
    elseif cmd == "right" then
        setSide("Right")
    end
end

local lastKey, lastT = "", 0
local function onChat(plr, msg)
    if plr ~= State.owner or type(msg) ~= "string" then
        return
    end
    local key = plr.UserId .. msg
    if key == lastKey and os.clock() - lastT < 0.5 then
        return -- same message seen through both chat systems
    end
    lastKey, lastT = key, os.clock()
    handleCommand(msg)
end
local function hookPlayer(p)
    connect(p.Chatted, function(m)
        onChat(p, m)
    end)
end
for _, p in ipairs(Players:GetPlayers()) do
    hookPlayer(p)
end
connect(Players.PlayerAdded, hookPlayer)
pcall(function() -- new TextChatService chat
    connect(game:GetService("TextChatService").MessageReceived, function(m)
        local src = m.TextSource
        local p = src and Players:GetPlayerByUserId(src.UserId)
        if p then
            onChat(p, m.Text)
        end
    end)
end)

-- if you respawn while summoned, jump straight back to the owner's side
connect(LocalPlayer.CharacterAdded, function()
    snap = true
end)

connect(Players.PlayerAdded, rebuildList)
connect(Players.PlayerRemoving, function(p)
    task.defer(function()
        if State.owner == p then
            selectOwner(nil)
            setStatus("Owner left the game", true)
        end
        rebuildList()
    end)
end)

connect(UIS.InputBegan, function(input, processed)
    if processed then
        return
    end
    if TOGGLE_KEY and input.KeyCode == TOGGLE_KEY then
        if not State.owner then
            setStatus("Pick an owner first", true)
        elseif State.active then
            State.active = false
            refreshInfo()
            setStatus("Stand paused")
        else
            State.active = true
            snap = true
            refreshInfo()
            setStatus("Stand of " .. State.owner.DisplayName .. " (" .. State.side .. ")")
        end
    elseif SWAP_KEY and input.KeyCode == SWAP_KEY then
        setSide(State.side == "Right" and "Left" or "Right")
    end
end)

closeBtn.MouseButton1Click:Connect(function()
    if _G.Stand_Cleanup then
        _G.Stand_Cleanup()
    end
end)

