local function rebuildList()
    for _, r in pairs(rows) do
        r.btn:Destroy()
    end
    table.clear(rows)
    local q = string.lower(search.Text)
    local players = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            if q == "" or string.find(string.lower(p.DisplayName), q, 1, true) or string.find(string.lower(p.Name), q, 1, true) then
                players[#players + 1] = p
            end
        end
    end
    table.sort(players, function(a, b)
        return string.lower(a.DisplayName) < string.lower(b.DisplayName)
    end)
    emptyLabel.Visible = #players == 0
    for i, p in ipairs(players) do
        local btn = new("TextButton", {
            Size = UDim2.new(1, -6, 0, 30), BackgroundColor3 = CHIP, BackgroundTransparency = 1, BorderSizePixel = 0,
            AutoButtonColor = false, Text = "", LayoutOrder = i,
        }, list)
        corner(btn, 6)
        local barSel = new("Frame", { Size = UDim2.new(0, 3, 0, 16), Position = UDim2.new(0, 4, 0.5, -8), BackgroundColor3 = RED, BorderSizePixel = 0, Visible = false }, btn)
        corner(barSel, 2)
        local nameL = text(btn, p.DisplayName, 14, 0, 150, 30, 12, TEXT, FONT)
        text(btn, "@" .. p.Name, 150, 0, 120, 30, 10, MUTED, Enum.Font.Gotham, Enum.TextXAlignment.Right)
        rows[p] = { btn = btn, bar = barSel, name = nameL }
        btn.MouseButton1Click:Connect(function()
            selectOwner(State.owner ~= p and p or nil)
        end)
    end
    styleRows()
end
