--// DEATH COUNTER DETECTION
deathCounterConn = RunService.Heartbeat:Connect(function()
    if not isCurrent() or not deathCounterEnabled then return end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player then
            local backpack = plr:FindFirstChildOfClass("Backpack")
            local char = plr.Character
            if backpack and char then
                local skillType = getDeathCounterSkillType(backpack, char)
                local wasArmed = deathCounterArmed[plr] == true
                -- Strong skill arms the detector and shows ULTIMATE.
                if skillType == "strong" then
                    deathCounterArmed[plr] = true
                    deathCounterState[plr] = "strong"
                    createDeathCounterBillboard(char, "ULTIMATE")
                -- Once a strong skill has been seen, ANY tracked weak skill
                -- triggers COUNTER. This does not depend on the strong tool
                -- disappearing from Backpack at the exact same frame.
                elseif skillType == "weak" then
                    if wasArmed then
                        createDeathCounterBillboard(char, "COUNTER")
                        deathCounterState[plr] = "weak"
                        deathCounterArmed[plr] = false
                        task.delay(math.random(8, 9), function()
                            if deathCounterEnabled and deathCounterState[plr] == "weak" then
                                removeDeathCounterBillboard(char)
                                deathCounterState[plr] = nil
                            end
                        end)
                    else
                        deathCounterState[plr] = "weak"
                    end
                -- No tracked skill: keep the armed flag intact so a weak
                -- skill appearing a moment later can still trigger COUNTER.
                else
                    if deathCounterState[plr] ~= "weak" then
                        removeDeathCounterBillboard(char)
                    end
                    deathCounterState[plr] = nil
                end
            end
        end
    end
end)
Players.PlayerRemoving:Connect(function(plr)
    deathCounterState[plr] = nil
    deathCounterArmed[plr] = nil
end)

