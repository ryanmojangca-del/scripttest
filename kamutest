    ------------------------------------------------------------------ logic
    local VIM = nil
    pcall(function()
        VIM = game:GetService("VirtualInputManager")
    end)

    local function performM1()
        local char = player.Character
        if not char then
            return
        end
        if CC.Method == "Click" and VIM then
            local pos = UIS:GetMouseLocation()
            pcall(function()
                VIM:SendMouseButtonEvent(pos.X, pos.Y, 0, true, game, 0)
            end)
            task.delay(0.04, function()
                pcall(function()
                    VIM:SendMouseButtonEvent(pos.X, pos.Y, 0, false, game, 0)
                end)
            end)
            return
        end
        local communicate = char:FindFirstChild("Communicate")
        if communicate then
            pcall(function()
                communicate:FireServer({ Goal = "LeftClick", Mobile = true })
            end)
            task.delay(0.04, function()
                pcall(function()
                    communicate:FireServer({ Goal = "LeftClickRelease", Mobile = true })
                end)
            end)
        end
    end

    --// Lock Aim (aimbot style): for the duration of ONE M1 catch the character AND the camera are snapped onto
    --// the dasher every single frame (render + physics step, no smoothing), leading the target a little so the
    --// hit lands on where they are going. Released right after, the next catch locks its own dasher.
    local LOCK_TIME = 0.4
    local LEAD = 0.07 -- seconds of target movement to aim ahead
    local lockPart, lockUntil, lockConn = nil, 0, nil
    local function aimPoint(part)
        local v = part.AssemblyLinearVelocity
        return part.Position + Vector3.new(v.X, 0, v.Z) * LEAD
    end
    local function applyLock(camToo)
        local part = lockPart
        local char = player.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not part or not part.Parent or not root then
            return false
        end
        local p = aimPoint(part)
        root.CFrame = CFrame.lookAt(root.Position, Vector3.new(p.X, root.Position.Y, p.Z))
        if camToo then
            local cam = workspace.CurrentCamera
            if cam then
                cam.CFrame = CFrame.lookAt(cam.CFrame.Position, p)
            end
        end
        return true
    end
    local function stopLock()
        lockPart = nil
        if lockConn then
            lockConn:Disconnect()
            lockConn = nil
        end
        pcall(function()
            RunService:UnbindFromRenderStep("KAMUI_LockAim")
        end)
    end
    local function startLock(part)
        stopLock()
        lockPart = part
        lockUntil = os.clock() + LOCK_TIME
        applyLock(true) -- aimed before the M1 is sent
        RunService:BindToRenderStep("KAMUI_LockAim", Enum.RenderPriority.Camera.Value + 1, function()
            if not isCurrent() or os.clock() > lockUntil or not applyLock(true) then
                stopLock()
            end
        end)
        lockConn = RunService.Heartbeat:Connect(function()
            if os.clock() > lockUntil or not applyLock(false) then
                stopLock()
            end
        end)
    end

    local lastPos = {}
    local hot = {}
    local lastFire = 0
    local conn
    conn = RunService.Heartbeat:Connect(function(dt)
        if not isCurrent() then
            conn:Disconnect()
            return
        end
        if not CC.Enabled then
            if next(lastPos) ~= nil then
                lastPos = {}
                hot = {}
            end
            return
        end
        local char = player.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not root or not hum or hum.Health <= 0 or dt <= 0 or dt > 0.1 then
            return
        end
        local myPos = root.Position
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= player then
                local oc = plr.Character
                local oroot = oc and oc:FindFirstChild("HumanoidRootPart")
                local ohum = oc and oc:FindFirstChildOfClass("Humanoid")
                if oroot and ohum and ohum.Health > 0 then
                    local pos = oroot.Position
                    local prev = lastPos[plr]
                    lastPos[plr] = pos
                    if prev then
                        local v = Vector3.new(pos.X - prev.X, 0, pos.Z - prev.Z) / dt
                        local speed = v.Magnitude
                        local toMe = Vector3.new(myPos.X - pos.X, 0, myPos.Z - pos.Z)
                        local dist = toMe.Magnitude
                        --// "dashing at / around you" is confirmed from speed + direction alone (two frames in a
                        --// row), so the M1 fires on the first frame the dasher is INSIDE the range ring.
                        --// (Before, the range check was part of the confirmation, which made the M1 fire
                        --// 2+ frames late, i.e. several studs inside the ring.)
                        if speed >= CC.Speed and dist > 0.1 then
                            local dot = v.Unit:Dot(toMe.Unit)
                            -- front dash: heading at you. side dash: moving across / around you.
                            -- moving away from you (dot < -0.45) is ignored.
                            if dot > -0.45 then
                                hot[plr] = (hot[plr] or 0) + 1
                            else
                                hot[plr] = 0
                            end
                        else
                            hot[plr] = 0
                        end
                        if (hot[plr] or 0) >= 2 and dist <= CC.Range and os.clock() - lastFire >= CC.Cooldown then
                            lastFire = os.clock()
                            hot[plr] = 0
                            if CC.LockAim then
                                startLock(oroot)
                            end
                            performM1()
                        end
                    end
                else
                    lastPos[plr] = nil
                    hot[plr] = nil
                end
            end
        end
    end)

    ------------------------------------------------------------------ FOV Displays
    --// a flat ring on the ground around you (radius = range in studs) plus a "N studs" label at its edge.
    --// One for the M1 catch range and a separate one for the auto block range.
    local function makeFOV(name, isOn, getRange, getColor, suffix)
        local ring = Instance.new("CylinderHandleAdornment")
        ring.Name = "KAMUI_" .. name .. "Ring"
        ring.Height = 0.12
        ring.AlwaysOnTop = true
        ring.ZIndex = 1
        ring.Transparency = 0.25
        ring.Visible = false
        ring.Parent = ScreenGui
        local tag = Instance.new("BillboardGui")
        tag.Name = "KAMUI_" .. name .. "Tag"
        tag.Size = UDim2.new(0, 110, 0, 18)
        tag.AlwaysOnTop = true
        tag.Enabled = false
        tag.Parent = ScreenGui
        local tagText = Instance.new("TextLabel")
        tagText.BackgroundTransparency = 1
        tagText.Size = UDim2.new(1, 0, 1, 0)
        tagText.Font = Enum.Font.GothamBold
        tagText.TextSize = 13
        tagText.TextStrokeTransparency = 0.4
        tagText.Parent = tag
        local conn
        conn = RunService.RenderStepped:Connect(function()
            if not isCurrent() then
                conn:Disconnect()
                ring:Destroy()
                tag:Destroy()
                return
            end
            local char = player.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            if not isOn() or not root then
                ring.Visible = false
                tag.Enabled = false
                return
            end
            local r = getRange()
            ring.Adornee = root
            ring.Radius = r
            ring.InnerRadius = math.max(0, r - 0.3)
            ring.CFrame = CFrame.new(0, -2.9, 0) * CFrame.Angles(math.pi / 2, 0, 0)
            ring.Color3 = getColor()
            ring.Visible = true
            local cam = workspace.CurrentCamera
            local look = cam and cam.CFrame.LookVector or Vector3.new(0, 0, -1)
            local flat = Vector3.new(look.X, 0, look.Z)
            flat = flat.Magnitude > 0.01 and flat.Unit or Vector3.new(0, 0, -1)
            tag.Adornee = root
            tag.StudsOffsetWorldSpace = flat * r + Vector3.new(0, -2.4, 0)
            tag.Enabled = true
            tagText.Text = string.format("%d studs%s", math.floor(r + 0.5), suffix)
            tagText.TextColor3 = getColor()
        end)
    end
    makeFOV("FOV", function()
        return CC.FOV
    end, function()
        return CC.Range
    end, function()
        return THEME.BrightRed
    end, "")
    makeFOV("BlockFOV", function()
        return CC.BlockFOV
    end, function()
        return CC.BlockRange
    end, function()
        return THEME.BrightRed
    end, " (block)")

    ------------------------------------------------------------------ Auto block
    --// Blocks (F, through Communicate like the dash) the moment a nearby player STARTS an M1-like attack
    --// animation while facing you. The animation is caught through AnimationPlayed (an event, so there is no
    --// waiting for the next frame) and the block is sent in the same call. A per-frame check stays as a
    --// fallback for animations the event misses.
    --// M1 is recognised from the animation itself (short, non-looping, action priority), not from dashing:
    --// dash then M1 is blocked just the same, a plain dash (animation starting at dash speed) is not.
    local BLOCK_HOLD = 0.45
    local blocking, blockUntil = false, 0
    local seenTracks = setmetatable({}, { __mode = "k" })
    local lastBlockPos = {}
    local speedOf = {}
    local function sendBlock(down)
        local char = player.Character
        local comm = char and char:FindFirstChild("Communicate")
        if comm then
            pcall(function()
                comm:FireServer({ Goal = down and "KeyPress" or "KeyRelease", Key = Enum.KeyCode.F })
            end)
        end
    end
    _G.KAMUI_BlockRelease = function()
        if blocking then
            blocking = false
            sendBlock(false)
        end
    end
    --// judges one animation track of one player, once; blocks immediately when it looks like an M1 at you
    local function judge(plr, track)
        if seenTracks[track] then
            return
        end
        seenTracks[track] = true
        if not CC.Block then
            return
        end
        local char = player.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local oc = plr.Character
        local oroot = oc and oc:FindFirstChild("HumanoidRootPart")
        if not root or not hum or hum.Health <= 0 or not oroot then
            return
        end
        local toMe = Vector3.new(root.Position.X - oroot.Position.X, 0, root.Position.Z - oroot.Position.Z)
        local dist = toMe.Magnitude
        if dist > CC.BlockRange or dist <= 0.1 or (speedOf[plr] or 0) >= CC.Speed then
            return
        end
        if track.Looped or track.Length <= 0 or track.Length > 1.3
            or track.Priority.Value < Enum.AnimationPriority.Action.Value
            or track.TimePosition >= 0.25 then
            return
        end
        local look = Vector3.new(oroot.CFrame.LookVector.X, 0, oroot.CFrame.LookVector.Z)
        local facing = look.Magnitude > 0.01 and look.Unit:Dot(toMe.Unit) or 0
        if facing <= 0.3 then
            return
        end
        if not blocking then
            blocking = true
            sendBlock(true) -- instantly, inside the AnimationPlayed event
        end
        blockUntil = os.clock() + BLOCK_HOLD
    end

    local hookedAnimators = setmetatable({}, { __mode = "k" })
    local function hookCharacter(plr, char)
        task.spawn(function()
            local hum = char:WaitForChild("Humanoid", 5)
            local animator = hum and hum:WaitForChild("Animator", 5)
            if animator and not hookedAnimators[animator] then
                hookedAnimators[animator] = true
                animator.AnimationPlayed:Connect(function(track)
                    if isCurrent() then
                        judge(plr, track)
                    end
                end)
            end
        end)
    end
    local function hookPlayer(plr)
        if plr == player then
            return
        end
        plr.CharacterAdded:Connect(function(char)
            hookCharacter(plr, char)
        end)
        if plr.Character then
            hookCharacter(plr, plr.Character)
        end
    end
    for _, plr in ipairs(Players:GetPlayers()) do
        hookPlayer(plr)
    end
    Players.PlayerAdded:Connect(hookPlayer)

    --// per-frame part: tracks each player's speed, releases the block, and is the fallback detector
    local blockConn
    blockConn = RunService.Heartbeat:Connect(function(dt)
        if not isCurrent() then
            blockConn:Disconnect()
            return
        end
        if blocking and os.clock() > blockUntil then
            blocking = false
            sendBlock(false)
        end
        if dt <= 0 or dt > 0.1 then
            return
        end
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= player then
                local oc = plr.Character
                local oroot = oc and oc:FindFirstChild("HumanoidRootPart")
                if oroot then
                    local pos = oroot.Position
                    local prev = lastBlockPos[plr]
                    lastBlockPos[plr] = pos
                    speedOf[plr] = prev and (Vector3.new(pos.X - prev.X, 0, pos.Z - prev.Z) / dt).Magnitude or 0
                    if CC.Block then
                        local ohum = oc:FindFirstChildOfClass("Humanoid")
                        local animator = ohum and ohum:FindFirstChildOfClass("Animator")
                        if animator then
                            for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
                                judge(plr, track)
                            end
                        end
                    end
                else
                    lastBlockPos[plr] = nil
                    speedOf[plr] = nil
                end
            end
        end
    end)

    ------------------------------------------------------------------ Aimbot loop
    --// While ON: every frame the camera and your character are snapped onto the living player closest to your crosshair.
    --// (A Lock Aim catch in progress has priority for its short moment.)
    local AIM_RANGE = 120
    pcall(function()
        RunService:UnbindFromRenderStep("KAMUI_Aimbot")
    end)
    RunService:BindToRenderStep("KAMUI_Aimbot", Enum.RenderPriority.Camera.Value + 2, function(dt)
        if not isCurrent() then
            pcall(function()
                RunService:UnbindFromRenderStep("KAMUI_Aimbot")
            end)
            if mobBtn then
                mobBtn:Destroy()
            end
            return
        end
        if not CC.Aimbot or lockPart then
            return
        end
        local char = player.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not root or not hum or hum.Health <= 0 then
            return
        end
        --// sticky target: keep the same player until they die (or leave); then pick the player closest to the
        --// crosshair. Turning the aimbot off and on again also picks a new one.
        local best = nil
        if aimTarget and aimTarget.Parent then
            local tc = aimTarget.Character
            local troot = tc and tc:FindFirstChild("HumanoidRootPart")
            local thum = tc and tc:FindFirstChildOfClass("Humanoid")
            if troot and thum and thum.Health > 0 then
                best = troot
            else
                aimTarget = nil
            end
        else
            aimTarget = nil
        end
        if not best then
            local cam0 = workspace.CurrentCamera
            if not cam0 then
                return
            end
            local center = cam0.ViewportSize / 2
            local bestDist = math.huge
            local bestPlr = nil
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= player then
                    local oc = plr.Character
                    local oroot = oc and oc:FindFirstChild("HumanoidRootPart")
                    local ohum = oc and oc:FindFirstChildOfClass("Humanoid")
                    if oroot and ohum and ohum.Health > 0
                        and (oroot.Position - root.Position).Magnitude <= AIM_RANGE then
                        local sp, onScreen = cam0:WorldToViewportPoint(oroot.Position)
                        if onScreen and sp.Z > 0 then
                            local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                            if d < bestDist then
                                best, bestDist, bestPlr = oroot, d, plr
                            end
                        end
                    end
                end
            end
            aimTarget = bestPlr
        end
        if not best then
            return
        end
        local p = aimPoint(best)
        --// Smoothing: 0 = instant snap. Otherwise the aim glides towards the target; the factor is
        --// frame-rate independent (a = 1 - s^(dt*60)).
        local a = 1
        if CC.Smooth > 0.005 then
            a = 1 - math.pow(CC.Smooth, math.clamp((dt or 1 / 60) * 60, 0.2, 4))
        end
        local want = CFrame.lookAt(root.Position, Vector3.new(p.X, root.Position.Y, p.Z))
        root.CFrame = a >= 1 and want or root.CFrame:Lerp(want, a)
        local cam = workspace.CurrentCamera
        if cam then
            local camWant = CFrame.lookAt(cam.CFrame.Position, p)
            cam.CFrame = a >= 1 and camWant or cam.CFrame:Lerp(camWant, a)
        end
    end)

    ------------------------------------------------------------------ M1 Reach
    --// M1 hits are decided by the server from where your character is, so the reach is extended by putting
    --// you right in front of the target for the moment of the hit and then putting you back where you were:
    --//   1) you press M1 (PC: left click / Touch: the game's M1 button),
    --//   2) the closest player in front of you within "Reach (studs)" is picked (nobody closer than REACH_NEAR,
    --//      the normal M1 already connects there),
    --//   3) you are placed REACH_STAND studs in front of them (facing them, following them) for REACH_HOLD
    --//      seconds, then returned to your starting spot.
    --//   The teleport is hidden on YOUR screen only: the camera is frozen and your real character is made
    --//   invisible to you for the hit. The server still sees you at the target.
    CC.Reach = false
    CC.ReachStuds = 12
    CC.ReachFOV = false
    local REACH_DEFAULT = 12  -- studs: what the reset button goes back to
    local REACH_NEAR = 6      -- studs: closer than this the normal M1 already reaches, so nothing is done
    local REACH_STAND = 3.5   -- studs in front of the target you are placed during the hit
    local REACH_HOLD = 0.15   -- seconds you stay there before going back (lower = less noticeable, too low can miss)
    local reachBusy = false

    local function findReachTarget(root)
        local cam = workspace.CurrentCamera
        local look = cam and cam.CFrame.LookVector or root.CFrame.LookVector
        look = Vector3.new(look.X, 0, look.Z)
        look = look.Magnitude > 0.01 and look.Unit or Vector3.new(0, 0, -1)
        local best, bestD = nil, math.huge
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= player then
                local oc = plr.Character
                local oroot = oc and oc:FindFirstChild("HumanoidRootPart")
                local ohum = oc and oc:FindFirstChildOfClass("Humanoid")
                if oroot and ohum and ohum.Health > 0 then
                    local delta = oroot.Position - root.Position
                    local d = delta.Magnitude
                    local flat = Vector3.new(delta.X, 0, delta.Z)
                    --// only players in front of where you are looking
                    if d <= CC.ReachStuds and d < bestD and (flat.Magnitude < 0.1 or look:Dot(flat.Unit) > 0.2) then
                        best, bestD = oroot, d
                    end
                end
            end
        end
        return best, bestD
    end

    --// fireM1 = true: the script sends the M1 itself; false: the game's own M1 is already on its way
    local function startReach(fireM1)
        local char = player.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not CC.Reach or reachBusy or not root or not hum or hum.Health <= 0 then
            if fireM1 then
                performM1()
            end
            return
        end
        local target, dist = findReachTarget(root)
        if not target or dist <= REACH_NEAR then
            if fireM1 then
                performM1()
            end
            return
        end
        reachBusy = true
        local home = root.CFrame
        --// hide the teleport from your own screen: the real character is made invisible to you for the hit
        local hidden = {}
        local function hideReal()
            for _, d in ipairs(char:GetDescendants()) do
                if d:IsA("BasePart") then
                    if hidden[d] == nil then
                        hidden[d] = d.LocalTransparencyModifier
                    end
                    d.LocalTransparencyModifier = 1
                end
            end
        end
        hideReal()
        --// freeze the camera where it is for the hit so your screen does not jump with the teleport
        local cam = workspace.CurrentCamera
        local camType, camCF = nil, nil
        if cam then
            camType, camCF = cam.CameraType, cam.CFrame
            cam.CameraType = Enum.CameraType.Scriptable
            cam.CFrame = camCF
        end
        local function place()
            local tp = target.Position
            local away = Vector3.new(home.Position.X - tp.X, 0, home.Position.Z - tp.Z)
            away = away.Magnitude > 0.01 and away.Unit or Vector3.new(0, 0, 1)
            local spot = tp + away * REACH_STAND
            root.CFrame = CFrame.lookAt(spot, Vector3.new(tp.X, spot.Y, tp.Z))
            root.AssemblyLinearVelocity = Vector3.zero
            hideReal() -- the camera scripts may reset the see-through value, so it is kept every frame
        end
        place()
        if fireM1 then
            performM1()
        end
        local untilT = os.clock() + REACH_HOLD
        local conn
        conn = RunService.Heartbeat:Connect(function()
            if isCurrent() and os.clock() < untilT and target.Parent and root.Parent then
                place()
                return
            end
            conn:Disconnect()
            if root.Parent then
                local rot = root.CFrame - root.CFrame.Position
                root.CFrame = CFrame.new(home.Position) * rot
                root.AssemblyLinearVelocity = Vector3.zero
            end
            for part, v in pairs(hidden) do
                if part.Parent then
                    pcall(function()
                        part.LocalTransparencyModifier = v
                    end)
                end
            end
            if cam and camType then
                cam.CameraType = camType
            end
            reachBusy = false
        end)
    end

    local function isOurGui(o)
        return o:IsDescendantOf(ScreenGui) or o:IsDescendantOf(RestoreGui)
    end
    UIS.InputBegan:Connect(function(input, gp)
        if not isCurrent() or not CC.Reach then
            return
        end
        local t = input.UserInputType
        if t == Enum.UserInputType.MouseButton1 then
            if gp or UIS:GetFocusedTextBox() then
                return
            end
            startReach(false)
        elseif t == Enum.UserInputType.Touch and gp then
            --// a tap on a game button: only react when it looks like the M1 button (never on this menu)
            local pg = player:FindFirstChildOfClass("PlayerGui")
            if not pg then
                return
            end
            local ok, objs = pcall(pg.GetGuiObjectsAtPosition, pg, input.Position.X, input.Position.Y)
            if not ok then
                return
            end
            for _, o in ipairs(objs) do
                if isOurGui(o) then
                    return
                end
            end
            for _, o in ipairs(objs) do
                local n = string.lower(o.Name)
                local txt = (o:IsA("TextButton") or o:IsA("TextLabel")) and string.lower(o.Text) or ""
                if n:find("m1") or n:find("attack") or n:find("punch") or txt == "m1" then
                    startReach(false)
                    return
                end
            end
        end
    end)

    ------------------------------------------------------------------ M1 Reach UI
    local rbox = nil
    local reachCard = UI.card(page, "M1 reach")
    local reachRow = toggleRow("M1 reach", "Teleports you towards for 0.1 seconds then go back to original position", function()
        return CC.Reach
    end, function(v)
        CC.Reach = v
    end, reachCard)
    --// the description is long: two lines that shrink to fit, so it never runs under the toggle button
    do
        local sub = reachRow:FindFirstChild("RowSub")
        if sub then
            sub.TextWrapped = true
            sub.TextScaled = true
            sub.TextYAlignment = Enum.TextYAlignment.Top
            sub.Size = UDim2.new(1, -100, 0, 28)
            local fit = Instance.new("UITextSizeConstraint")
            fit.MaxTextSize = 11
            fit.MinTextSize = 7
            fit.Parent = sub
        end
        reachRow.Size = UDim2.new(1, 0, 0, 58)
    end
    do
        local rrow = mk("Frame", { BackgroundTransparency = 1, BorderSizePixel = 0 }, nil)
        UI.addRow(reachCard, rrow, UI.ROW)
        label(rrow, "Reach (studs)", nil)
        rbox = mk("TextBox", {
            BackgroundColor3 = CHIP,
            BorderSizePixel = 0,
            Position = UDim2.new(1, -68, 0.5, -13),
            Size = UDim2.new(0, 56, 0, 26),
            Font = Enum.Font.GothamMedium,
            TextSize = 12,
            TextColor3 = THEME.Text,
            ClearTextOnFocus = false,
            Text = tostring(CC.ReachStuds)
        }, rrow)
        UI.corner(rbox, 6)
        UI.stroke(rbox, LINE)
        rbox.FocusLost:Connect(function()
            local n = tonumber(rbox.Text)
            if n then
                CC.ReachStuds = math.max(n, 0) -- any number (never below 0)
            end
            rbox.Text = string.format("%g", CC.ReachStuds)
        end)
    end
    toggleRow("FOV Display", "Ring around you showing the reach", function()
        return CC.ReachFOV
    end, function(v)
        CC.ReachFOV = v
    end, reachCard)
    --// reset the studs back to the default
    do
        local rrow2 = mk("Frame", { BackgroundTransparency = 1, BorderSizePixel = 0 }, nil)
        UI.addRow(reachCard, rrow2, UI.ROW)
        local rbtn = mk("TextButton", {
            Name = "ResetReachStuds",
            Text = "Reset to default",
            Position = UDim2.new(0, 12, 0.5, -13),
            Size = UDim2.new(1, -24, 0, 26),
            AutoButtonColor = false,
            BorderSizePixel = 0
        }, rrow2)
        UI.button(rbtn, false)
        rbtn.MouseButton1Click:Connect(function()
            CC.ReachStuds = REACH_DEFAULT
            if rbox then
                rbox.Text = string.format("%g", REACH_DEFAULT)
            end
        end)
    end
    makeFOV("ReachFOV", function()
        return CC.ReachFOV
    end, function()
        return CC.ReachStuds
    end, function()
        return THEME.BrightRed -- follows the GUI color like the other rings
    end, " (reach)")
end

--// MOVEMENT TAB CONTENT: Dash multiplier (toggle + Distance slider)
_G.KAMUI_BuildMovement = function(UI)
    local G = _G.KAMUI_MovementTab
    local page = G and G.Page
    if not page then
        return
    end
    UI.setupPage(page)
    local M = _G.KAMUI_Movement
    local CHIP = UI.CHIP
    local conns = _G.KAMUI_MovementConns or {}
    _G.KAMUI_MovementConns = conns

    local function mk(class, props, parent)
        local o = UI.make(class, props, parent)
        o:SetAttribute("KamuiSkinned", true)
        return o
    end
    local function round2(v)
        return math.round(v * 100) / 100
    end

    --// slider row: label (+ optional small text under it), bar, value you can tap and type into.
    --// o = { label, sub, get, set, min, max, step, snap, snapZone, isOn }
    local function makeSlider(card, o)
        local hasSub = o.sub ~= nil
        local row = mk("Frame", { BackgroundTransparency = 1, BorderSizePixel = 0 }, nil)
        UI.addRow(card, row, hasSub and UI.ROW_SUB or UI.ROW)
        mk("TextLabel", {
            Name = "RowLabel",
            BackgroundTransparency = 1,
            Position = UDim2.new(0, 12, 0, hasSub and 5 or 0),
            Size = hasSub and UDim2.new(0.5, -12, 0, 20) or UDim2.new(0.5, -12, 1, 0),
            Font = Enum.Font.GothamMedium,
            TextSize = 12,
            TextColor3 = THEME.Text,
            TextXAlignment = Enum.TextXAlignment.Left,
            Text = o.label
        }, row)
        if hasSub then
            mk("TextLabel", {
                Name = "RowSub",
                BackgroundTransparency = 1,
                Position = UDim2.new(0, 12, 0, 24),
                Size = UDim2.new(0.5, -12, 0, 14),
                Font = Enum.Font.Gotham,
                TextSize = 11,
                TextColor3 = THEME.MutedText,
                TextXAlignment = Enum.TextXAlignment.Left,
                TextTruncate = Enum.TextTruncate.AtEnd,
                Text = o.sub
            }, row)
        end
        local back = mk("Frame", {
            Name = "SliderBack",
            BackgroundColor3 = CHIP,
            BorderSizePixel = 0,
            Position = UDim2.new(0.52, 0, 0.5, -3),
            Size = UDim2.new(0.28, 0, 0, 6)
        }, row)
        UI.corner(back, 3)
        back:SetAttribute("KamuiNoDrag", true)
        local fill = mk("Frame", {
            BackgroundColor3 = THEME.Red,
            BorderSizePixel = 0,
            Size = UDim2.new(0, 0, 1, 0)
        }, back)
        UI.corner(fill, 3)
        --// the value is a TextBox: tap the number and type an exact value
        local box = mk("TextBox", {
            Name = "ValueBox",
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            AnchorPoint = Vector2.new(1, 0.5),
            Position = UDim2.new(1, -12, 0.5, 0),
            Size = UDim2.new(0.18, 0, 0, 24),
            Font = Enum.Font.RobotoMono,
            TextSize = 12,
            TextColor3 = THEME.BrightRed,
            TextXAlignment = Enum.TextXAlignment.Right,
            ClearTextOnFocus = false,
            Text = ""
        }, row)
        box:SetAttribute("KamuiNoDrag", true)

        local function paint()
            local v = o.get()
            fill.Size = UDim2.new(math.clamp((v - o.min) / (o.max - o.min), 0, 1), 0, 1, 0)
            local on = o.isOn == nil or o.isOn()
            fill.BackgroundColor3 = on and THEME.Red or THEME.OffRed
            box.TextColor3 = on and THEME.BrightRed or THEME.MutedText
            if not box:IsFocused() then
                box.Text = string.format(o.fmt or "%.2fx", v)
            end
        end
        paint()

        local hit = mk("TextButton", {
            Name = "SliderHit",
            BackgroundTransparency = 1,
            Text = "",
            Position = UDim2.new(0.5, 0, 0, 0),
            Size = UDim2.new(0.32, 0, 1, 0)
        }, row)
        hit:SetAttribute("KamuiNoDrag", true)
        local dragging, dragInput = false, nil
        local function fromX(x)
            local a = math.clamp((x - back.AbsolutePosition.X) / math.max(1, back.AbsoluteSize.X), 0, 1)
            local v = round2(math.round((o.min + a * (o.max - o.min)) / o.step) * o.step)
            if o.snap and math.abs(v - o.snap) < o.snapZone then
                v = o.snap -- sticks to normal (1.00x)
            end
            o.set(math.clamp(v, o.min, o.max))
            paint()
        end
        hit.InputBegan:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                dragging, dragInput = true, i
                _G.KAMUI_SliderHeld = true
                fromX(i.Position.X)
            end
        end)
        conns[#conns + 1] = UIS.InputChanged:Connect(function(i)
            if not dragging or not isCurrent() then
                return
            end
            --// follow only the finger/button that started the drag (other touches are ignored)
            if i == dragInput
                or (i.UserInputType == Enum.UserInputType.MouseMovement
                    and dragInput.UserInputType == Enum.UserInputType.MouseButton1) then
                fromX(i.Position.X)
            end
        end)
        conns[#conns + 1] = UIS.InputEnded:Connect(function(i)
            if dragging and (i == dragInput or i.UserInputType == Enum.UserInputType.MouseButton1) then
                dragging, dragInput = false, nil
                _G.KAMUI_SliderHeld = false
            end
        end)

        --// manual entry: "2.5", "2,5" and "2.5x" all work; out-of-range values are clamped
        box.Focused:Connect(function()
            box.Text = string.format("%g", o.get())
        end)
        box.FocusLost:Connect(function()
            local txt = box.Text:gsub(",", "."):gsub("[xX%s]", "")
            local n = tonumber(txt)
            if n then
                o.set(math.clamp(round2(n), o.min, o.max))
            end
            paint()
        end)
        return paint
    end

