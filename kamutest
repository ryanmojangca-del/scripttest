    ------------------------------------------------------------------ keep the picker in sync
    local function paint(h, s, v)
        local eff = Color3.fromHSV(h, s, v)
        local r8, g8, b8 = math.floor(eff.R * 255 + 0.5), math.floor(eff.G * 255 + 0.5), math.floor(eff.B * 255 + 0.5)
        swatch.BackgroundColor3 = eff
        if not hexBox:IsFocused() then
            hexBox.Text = string.format("#%02X%02X%02X", r8, g8, b8)
        end
        if not rgbBox:IsFocused() then
            rgbBox.Text = string.format("%d  %d  %d", r8, g8, b8)
        end
        hexBox.TextColor3 = (v > 0.35) and eff or THEME.Text
        sv.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
        svMark.Position = UDim2.new(s, 0, 1 - v, 0)
        hueMark.Position = UDim2.new(0.5, 0, h, 0)
        for _, pr in ipairs(presetRings) do
            pr.stroke.Enabled = (not St.rainbow)
                and math.abs(pr.s - St.s) < 0.02 and math.abs(pr.v - St.v) < 0.02
                and (pr.s < 0.08 or math.min(math.abs(pr.h - St.h), 1 - math.abs(pr.h - St.h)) < 0.01)
        end
        rbTrack.BackgroundColor3 = St.rainbow and eff or OFF_TRACK
        rbKnob.Position = St.rainbow and UDim2.new(1, -17, 0.5, -7) or UDim2.new(0, 3, 0.5, -7)
        rbKnob.BackgroundColor3 = St.rainbow and WHITE or OFF_KNOB
        spFill.BackgroundColor3 = eff
        list.ScrollBarImageColor3 = eff
        for name, b in pairs(optionBtns) do
            b.TextColor3 = (name == St.font) and eff or THEME.MutedText
        end
    end

    --// first pass: register every accent-colored element that exists right now
    sweepAll()
    applyAccent()
    paint(St.h, St.s, St.v)
    if St.font ~= "Gotham" then
        applyFontAll()
    end
    hookRoots()
    ddText.Text = St.font

    local lastApply, lastSweep, lastFont = 0, os.clock(), os.clock()
    local conn
    conn = RunService.RenderStepped:Connect(function(dt)
        if not isCurrent() or not page.Parent then
            conn:Disconnect()
            return
        end
        local now = os.clock()
        if St.rainbow then
            dirty = true
            St.phase = (St.phase + (dt * 0.12 * St.speed)) % 1
        end
        local custom = St.rainbow or math.abs(St.h - DEFAULT.h) > 1e-4 or math.abs(St.s - DEFAULT.s) > 1e-4 or math.abs(St.v - DEFAULT.v) > 1e-4
        if dirty and now - lastApply >= 0.04 then
            dirty = false
            lastApply = now
            if now - lastSweep >= 0.4 then
                lastSweep = now
                sweepAll()
            end
            local h, s, v = applyAccent()
            if not St.rainbow then
                h, s, v = St.h, St.s, St.v
            end
            paint(h, s, v)
        elseif custom and now - lastSweep >= 1 then
            lastSweep = now
            sweepAll()
        end
        if now - lastFont >= 1 then
            lastFont = now
            hookRoots()
            if St.font ~= "Gotham" then
                applyFontAll()
            end
        end
    end)
end

