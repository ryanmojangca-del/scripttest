--// ============================================================
--// WINDOW DRAGGING
--// Replaces Roblox's built-in Draggable, which also moved the window
--// while dragging a slider. The window now only moves when you press
--// on empty space (title bar, sidebar, gaps) - never on a slider,
--// button or text box. Wrapped in a function: adds no top-level locals.
--// ============================================================
_G.KAMUI_DragInit = function()
    local dragging = false
    local dragStart
    local startPos
    local function overControl(position)
        local ok, objects = pcall(function()
            return UIS:GetGuiObjectsAtPosition(position.X, position.Y)
        end)
        if not ok then
            return false
        end
        for _, obj in ipairs(objects) do
            if obj ~= MainFrame and obj:IsDescendantOf(MainFrame) then
                if obj:GetAttribute("KamuiNoDrag")
                    or obj:IsA("TextButton")
                    or obj:IsA("TextBox")
                    or obj:IsA("ImageButton") then
                    return true
                end
            end
        end
        return false
    end
    MainFrame.InputBegan:Connect(function(input)
        if not isCurrent() then
            return
        end
        if input.UserInputType ~= Enum.UserInputType.MouseButton1
            and input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end
        if overControl(input.Position) then
            return
        end
        local pressPos = input.Position
        local pressFrame = MainFrame.Position
        -- Wait until all other handlers for this press have run. If a slider
        -- grabbed it, do NOT start moving the window.
        task.defer(function()
            if _G.KAMUI_SliderHeld then
                return
            end
            if input.UserInputState == Enum.UserInputState.End then
                return
            end
            dragging = true
            dragStart = pressPos
            startPos = pressFrame
        end)
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end)
    UIS.InputChanged:Connect(function(input)
        if not dragging or not isCurrent() then
            return
        end
        if _G.KAMUI_SliderHeld then
            dragging = false
            return
        end
        if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then
            local delta = input.Position - dragStart
            MainFrame.Position = UDim2.new(
                startPos.X.Scale,
                startPos.X.Offset + delta.X,
                startPos.Y.Scale,
                startPos.Y.Offset + delta.Y
            )
        end
    end)
    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
end
