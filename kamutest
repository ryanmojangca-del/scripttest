    local St = { h = baseH, s = baseS, v = baseV, rainbow = false, font = "Gotham", speed = 1, phase = 0 }

    --// saved settings
    if isfile and readfile then
        pcall(function()
            if isfile(FILE) then
                local d = HttpService:JSONDecode(readfile(FILE))
                if type(d) == "table" then
                    if type(d.h) == "number" and type(d.s) == "number" and type(d.v) == "number" then
                        St.h = math.clamp(d.h, 0, 1)
                        St.s = math.clamp(d.s, 0, 1)
                        St.v = math.clamp(d.v, 0, 1)
                    end
                    if type(d.rainbow) == "boolean" then
                        St.rainbow = d.rainbow
                    end
                    if type(d.font) == "string" then
                        St.font = d.font
                    end
                    if type(d.speed) == "number" then
