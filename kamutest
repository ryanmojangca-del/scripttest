_G.KAMUI_BuildSettings = function(UI)
    local S = SettingsContainer
    local rows = {}
    for _, c in ipairs(S:GetChildren()) do
        if c:IsA("Frame") then
            local l = c:FindFirstChildOfClass("TextLabel")
            if l then
                rows[l.Text] = c
            end
        end
    end
    UI.setupPage(S)

    local function addInput(card, r)
        if r then
            UI.addRow(card, r)
            UI.styleInput(r)
        end
    end
    local function addToggle(card, b)
        if b then
            UI.addRow(card, b)
            UI.flatten(b)
        end
    end

    --// ---------------- DRAW PATTERN (only visible in Draw mode)
    local drawCard = UI.card(S, "Draw pattern")
    local drawHolder = UI.make("Frame", {
        Name = "DrawHolder",
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Visible = false
    }, nil)
    UI.addRow(drawCard, drawHolder, 192)
    local DR = _G.KAMUI_Draw
    local YOU_F = Vector2.new(0.5, 0.74)
    local TGT_F = Vector2.new(0.5, 0.36)
    local canvas = UI.make("Frame", {
        Name = "DrawCanvas",
        BackgroundColor3 = Color3.fromRGB(10, 10, 11),
        BorderSizePixel = 0,
        Active = true,
        ClipsDescendants = true,
        Position = UDim2.new(0, 12, 0, 12),
        Size = UDim2.new(1, -24, 0, 130)
    }, drawHolder)
    canvas:SetAttribute("KamuiNoDrag", true)
    canvas:SetAttribute("KamuiSkinned", true)
    UI.corner(canvas, 8)
    UI.stroke(canvas, UI.LINE)
    UI.make("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 0, 0, 5),
        Size = UDim2.new(1, 0, 0, 14),
        Font = Enum.Font.GothamMedium,
        TextSize = 9,
        TextColor3 = THEME.MutedText,
        Text = "+ AWAY FROM CAMERA",
        Visible = false
    }, canvas)
    local strokes = UI.make("Frame", {
        Name = "Strokes",
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 1, 0)
    }, canvas)
    local function marker(frac, color, text, textBelow)
        local ring = UI.make("Frame", {
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.new(frac.X, 0, frac.Y, 0),
            Size = UDim2.new(0, 18, 0, 18),
            ZIndex = 5
        }, canvas)
        ring:SetAttribute("KamuiSkinned", true)
        UI.corner(ring, 9)
        local st = Instance.new("UIStroke")
        st.Color = color
        st.Thickness = 2
        st.Parent = ring
        local dot = UI.make("Frame", {
            BackgroundColor3 = color,
            BorderSizePixel = 0,
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.new(0.5, 0, 0.5, 0),
            Size = UDim2.new(0, 6, 0, 6),
            ZIndex = 6
        }, ring)
        UI.corner(dot, 3)
        UI.make("TextLabel", {
            BackgroundTransparency = 1,
            Position = textBelow and UDim2.new(0.5, -30, 1, 1) or UDim2.new(1, 6, 0.5, -7),
            Size = UDim2.new(0, textBelow and 60 or 40, 0, 14),
            Font = Enum.Font.GothamBold,
            TextSize = 9,
            TextColor3 = color,
            TextXAlignment = textBelow and Enum.TextXAlignment.Center or Enum.TextXAlignment.Left,
            Text = text,
            ZIndex = 6
        }, ring)
    end
    marker(TGT_F, Color3.fromRGB(235, 100, 70), "TARGET", true)
    marker(YOU_F, Color3.fromRGB(70, 205, 120), "YOU", false)

    local status = UI.make("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 12, 0, 148),
        Size = UDim2.new(1, -24, 0, 16),
        Font = Enum.Font.Gotham,
        TextSize = 11,
        TextColor3 = THEME.MutedText,
        TextXAlignment = Enum.TextXAlignment.Left,
        Text = "",
        Visible = false
    }, drawHolder)
    local clearBtn = UI.make("TextButton", {
        Name = "ClearPattern",
        Position = UDim2.new(0, 12, 0, 148),
        Size = UDim2.new(1, -24, 0, 34),
        Text = "Clear Pattern"
    }, drawHolder)
    UI.button(clearBtn, false)
    clearBtn.TextXAlignment = Enum.TextXAlignment.Center

    local raw = {} -- canvas fractions of every point (YOU first, TARGET last once finished)
    local function dims()
        local ws = MainFrame:FindFirstChild("WindowScale")
        local sc = (ws and ws.Scale > 0) and ws.Scale or 1
        local sz = canvas.AbsoluteSize
        local w, h = sz.X / sc, sz.Y / sc
        if w < 10 or h < 10 then
            w, h = 336, 130 -- page not laid out yet: use the design size
        end
        return w, h
    end
    local function addSegment(f1, f2)
        local W, H = dims()
        local x1, y1, x2, y2 = f1.X * W, f1.Y * H, f2.X * W, f2.Y * H
        local dx, dy = x2 - x1, y2 - y1
        local len = math.sqrt(dx * dx + dy * dy)
        if len < 0.5 then
            return
        end
        local seg = UI.make("Frame", {
            BackgroundColor3 = THEME.BrightRed,
            BorderSizePixel = 0,
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.new(0, (x1 + x2) / 2, 0, (y1 + y2) / 2),
            Size = UDim2.new(0, len + 1, 0, 2),
            Rotation = math.deg(math.atan2(dy, dx)),
            ZIndex = 3
        }, strokes)
        seg:SetAttribute("KamuiSkinned", true)
    end
    local function setStatus()
        if #DR.pts >= 2 then
            status.Text = string.format("Pattern ready  \u{B7}  %d points  \u{B7}  starts at you  \u{B7}  ends on target", #DR.pts)
        else
            status.Text = "Draw a path from YOU to TARGET (empty = straight dash)"
        end
    end
    local function rebuildNorm()
        local W, H = dims()
        local unit = math.max(1, (YOU_F.Y - TGT_F.Y) * H)
        local pts = {}
        for i, f in ipairs(raw) do
            pts[i] = { ((YOU_F.Y - f.Y) * H) / unit, ((f.X - YOU_F.X) * W) / unit }
        end
        DR.pts = pts
        setStatus()
    end
    local function clearPattern()
        raw = {}
        DR.pts = {}
        strokes:ClearAllChildren()
        setStatus()
    end
    clearBtn.MouseButton1Click:Connect(clearPattern)
    setStatus()
    --// used by profile codes: redraw a stored pattern (normalised points) in the box
    _G.KAMUI_DrawUI = {
        setPts = function(pts)
            strokes:ClearAllChildren()
            raw = {}
            DR.pts = {}
            if type(pts) == "table" and #pts >= 2 then
                local W, H = dims()
                local unit = math.max(1, (YOU_F.Y - TGT_F.Y) * H)
                for i, q in ipairs(pts) do
                    raw[i] = Vector2.new(YOU_F.X + (q[2] * unit) / W, YOU_F.Y - (q[1] * unit) / H)
                    if i > 1 then
                        addSegment(raw[i - 1], raw[i])
                    end
                end
                DR.pts = pts
            end
            setStatus()
        end
    }

    local drawing = false
    local function canvasFrac(pos)
        local ap, sz = canvas.AbsolutePosition, canvas.AbsoluteSize
        return Vector2.new(
            math.clamp((pos.X - ap.X) / math.max(1, sz.X), 0, 1),
            math.clamp((pos.Y - ap.Y) / math.max(1, sz.Y), 0, 1)
        )
    end
    local function isPress(i)
        return i.UserInputType == Enum.UserInputType.MouseButton1
            or i.UserInputType == Enum.UserInputType.Touch
    end
    canvas.InputBegan:Connect(function(i)
        if not isPress(i) or not isCurrent() then
            return
        end
        drawing = true
        _G.KAMUI_SliderHeld = true
        S.ScrollingEnabled = false
        clearPattern()
        raw[1] = YOU_F
        local f = canvasFrac(i.Position)
        raw[2] = f
        addSegment(YOU_F, f)
        rebuildNorm()
    end)
    UIS.InputChanged:Connect(function(i)
        if not drawing or not isCurrent() then
            return
        end
        if i.UserInputType ~= Enum.UserInputType.MouseMovement
            and i.UserInputType ~= Enum.UserInputType.Touch then
            return
        end
        local W, H = dims()
        local f = canvasFrac(i.Position)
        local last = raw[#raw]
        local dx, dy = (f.X - last.X) * W, (f.Y - last.Y) * H
        if dx * dx + dy * dy >= 36 and #raw < 150 then
            raw[#raw + 1] = f
            addSegment(last, f)
            rebuildNorm()
        end
    end)
    UIS.InputEnded:Connect(function(i)
        if drawing and isPress(i) then
            drawing = false
            _G.KAMUI_SliderHeld = false
            S.ScrollingEnabled = true
            local last = raw[#raw]
            if last then
                raw[#raw + 1] = TGT_F -- the path always ends on the target
                addSegment(last, TGT_F)
                rebuildNorm()
            end
        end
    end)

    _G.KAMUI_DrawRefresh = function()
        local mode = Config.LethalMode
        local draw = mode == "Draw"
        local kiba = mode == "Kiba"
        drawHolder.Visible = draw
        --// Draw / Kiba hide Accuracy, Cancel delay and Dash range.
        --// Draw keeps Jump power, Cam Smooth, Floater, Delay, Touch. Kiba keeps Delay, Connect delay (Magnet delay),
        --// Touch (Jump power, Floater and Cam Smooth are not used: Kiba has its own non-snapping camera).
        local function setVis(o, v)
            if o then
                o.Visible = v
            end
        end
        local special = draw or kiba
        setVis(AccInput, not special)
        setVis(rows["Cancel delay"], not special)
        setVis(rows["Dash range"], not special)
        setVis(rows["Jump power"], not kiba)
        setVis(FloaterBtn, not kiba)
        setVis(CamSmoothBtn, not kiba)
        setVis(CamSmoothDelayInput, not kiba)
        setVis(CamDurationInput, not kiba)
        setVis(rows["Magnet delay"], not kiba)
        setVis(rows["Connect delay"], kiba)
    end

    local lethal = UI.card(S, "Dash")
