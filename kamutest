    local ENUMS = {}
    local function fontEnum(name)
        local e = ENUMS[name]
        if e == nil then
            local ok, f = pcall(function()
                return Enum.Font[name]
            end)
            e = (ok and f) or false
            ENUMS[name] = e
        end
        return e or nil
    end
    local avail, famByName = {}, {}
    for _, f in ipairs(FAMILIES) do
        if fontEnum(f[2]) then
            local fam = { name = f[1], f = { f[2], f[3], f[4], f[5] } }
            avail[#avail + 1] = fam
            famByName[fam.name] = fam
        end
    end
    if not famByName[St.font] then
        St.font = "Gotham"
    end

    --// Some fonts are much wider / narrower / taller than Gotham at the same TextSize, which pushes
    --// text out of its row. Each font is measured against Gotham once and gets a size factor
    --// (halfway between "same width" and "same size") so it sits like Gotham does.
    local SCALE = {}
    do
        local TextService = game:GetService("TextService")
        local REF = "The quick brown fox jumps over the lazy dog"
        local function width(font)
            local ok, sz = pcall(function()
                return TextService:GetTextSize(REF, 12, font, Vector2.new(100000, 1000))
            end)
            return (ok and sz) and sz.X or nil
        end
        local baseW = width(Enum.Font.Gotham)
        for _, fam in ipairs(avail) do
            local sc = 1
            if baseW and fam.name ~= "Gotham" then
                local w = width(fontEnum(fam.f[1]))
                if w and w > 0 then
                    sc = math.clamp(math.sqrt(baseW / w), 0.8, 1.2)
                    sc = math.floor(sc * 20 + 0.5) / 20
                end
            end
            SCALE[fam.name] = sc
        end
    end

    local ORIGFONT = setmetatable({}, { __mode = "k" }) -- instance -> weight (1 regular .. 4 bold) or false
    local function weightOf(font)
        local n = font.Name
        if n:find("^Gotham") then
            if n:find("Bold") then
                return 4
            elseif n:find("Semibold") then
                return 3
            elseif n:find("Medium") then
                return 2
            end
            return 1
        end
        return nil
    end
    local function applyFontTo(inst, fam)
        if not (inst:IsA("TextLabel") or inst:IsA("TextButton") or inst:IsA("TextBox")) then
            return
        end
        if inst:GetAttribute("KamuiKeepFont") then
            return
        end
        local cw = weightOf(inst.Font)
        if cw then
            ORIGFONT[inst] = cw
        elseif ORIGFONT[inst] == nil then
            ORIGFONT[inst] = false
        end
        local w = ORIGFONT[inst]
        if not w then
            return -- mono / other fonts the script picked on purpose stay as they are
        end
        local f = fontEnum(fam.f[w]) or fontEnum(fam.f[1]) or Enum.Font.Gotham
        if inst.Font ~= f then
            inst.Font = f
        end
        if not inst.TextScaled then
            local base = inst:GetAttribute("KamuiBaseSize")
            local last = inst:GetAttribute("KamuiWantSize")
            if not base or (last and inst.TextSize ~= last) then
                base = inst.TextSize
                inst:SetAttribute("KamuiBaseSize", base)
            end
            local sc = SCALE[fam.name] or 1
            local want = (sc == 1) and base or math.max(8, math.floor(base * sc + 0.5))
            inst:SetAttribute("KamuiWantSize", want)
            if inst.TextSize ~= want then
                inst.TextSize = want
            end
        end
    end
    local function applyFontAll()
        local fam = famByName[St.font] or famByName.Gotham
        for _, root in ipairs(guiRoots()) do
            for _, d in ipairs(root:GetDescendants()) do
                applyFontTo(d, fam)
            end
        end
    end
    --// Labels indented with leading spaces ("  Status: ON", "  KAMUI Custom Dash", ...) move around
    --// when the font changes (every font has a different space width). The spaces are turned into
    --// a fixed pixel UIPadding measured with Gotham, so the label sits in the same place in every font.
    local INDENT = setmetatable({}, { __mode = "k" })
    local spaceCache = {}
    local function gothamSpace(size)
        local w = spaceCache[size]
        if not w then
            local ok, a = pcall(function()
                return game:GetService("TextService"):GetTextSize("a a", size, Enum.Font.Gotham, Vector2.new(100000, 1000)).X
            end)
            local ok2, b = pcall(function()
                return game:GetService("TextService"):GetTextSize("aa", size, Enum.Font.Gotham, Vector2.new(100000, 1000)).X
            end)
            w = (ok and ok2) and math.max(2, a - b) or (size * 0.28)
            spaceCache[size] = w
        end
        return w
    end
    local function fixIndent(inst)
        if not (inst:IsA("TextLabel") or inst:IsA("TextButton")) then
            return
        end
        if inst.TextXAlignment ~= Enum.TextXAlignment.Left then
            return
        end
        local txt = inst.Text
        local lead = txt:match("^( +)")
        local n = lead and #lead or 0
        if not INDENT[inst] then
            if n < 2 or inst:FindFirstChild("TabPad") then
                return
            end
            -- UIPadding also shifts children, so only plain text elements are converted
            for _, c in ipairs(inst:GetChildren()) do
                if c:IsA("GuiObject") then
                    return
                end
            end
            INDENT[inst] = true
            inst:GetPropertyChangedSignal("Text"):Connect(function()
                fixIndent(inst)
            end)
        end
        local pad = inst:FindFirstChild("KamuiIndent")
        if not pad then
            pad = Instance.new("UIPadding")
            pad.Name = "KamuiIndent"
            pad.Parent = inst
        end
        local size = inst:GetAttribute("KamuiBaseSize") or inst.TextSize
        pad.PaddingLeft = UDim.new(0, math.floor(n * gothamSpace(size) + 0.5))
        if n > 0 then
            inst.Text = txt:sub(n + 1)
        end
    end
    local hooked = setmetatable({}, { __mode = "k" })
    local function hookRoots()
        for _, root in ipairs(guiRoots()) do
            if not hooked[root] then
                hooked[root] = true
                root.DescendantAdded:Connect(function(d)
                    task.defer(function()
                        if d.Parent and isCurrent() then
                            fixIndent(d)
                            if St.font ~= "Gotham" then
                                applyFontTo(d, famByName[St.font] or famByName.Gotham)
                            end
