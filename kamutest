--// COLOR SLIDER CREATOR
local function CreateColorSlider(
    parent,
    name,
    yPosition,
    initialValue,
    fillColor,
    valueCallback
)
    local sliderFrame = Instance.new("Frame")
    sliderFrame.Parent = parent
    sliderFrame.Size = UDim2.new(0, 210, 0, 30)
    sliderFrame.Position = UDim2.new(0.5, -105, 0, yPosition)
    sliderFrame.BackgroundTransparency = 1
    local label = Instance.new("TextLabel")
    label.Parent = sliderFrame
    label.Size = UDim2.new(0, 25, 0, 20)
    label.Position = UDim2.new(0, 0, 0, 5)
    label.BackgroundTransparency = 1
    label.Text = name
    label.TextColor3 = THEME.MutedText
    label.Font = Enum.Font.GothamBold
    label.TextSize = 10
    local valueBox = Instance.new("TextBox")
    valueBox.Parent = sliderFrame
    valueBox.Size = UDim2.new(0, 35, 0, 20)
    valueBox.Position = UDim2.new(1, -35, 0, 5)
    valueBox.BackgroundColor3 = THEME.BackgroundMedium
    valueBox.BorderSizePixel = 0
    valueBox.TextColor3 = THEME.Text
    valueBox.Font = Enum.Font.Gotham
    valueBox.TextSize = 10
    valueBox.Text = tostring(initialValue)
    valueBox.ClearTextOnFocus = false
    valueBox.TextXAlignment = Enum.TextXAlignment.Center
    applyCorner(valueBox, 4)
    local sliderBack = Instance.new("Frame")
    sliderBack.Parent = sliderFrame
    sliderBack.Size = UDim2.new(0, 145, 0, 8)
    sliderBack.Position = UDim2.new(0, 30, 0.5, -4)
    sliderBack.BackgroundColor3 = THEME.BackgroundMedium
    sliderBack.BorderSizePixel = 0
    applyCorner(sliderBack, 4)
    sliderBack:SetAttribute("KamuiNoDrag", true)
    local sliderFill = Instance.new("Frame")
    sliderFill.Parent = sliderBack
    sliderFill.Size = UDim2.new(initialValue / 255, 0, 1, 0)
    sliderFill.BackgroundColor3 = fillColor
    sliderFill.BorderSizePixel = 0
    applyCorner(sliderFill, 4)
    local dragging = false
    local currentValue = initialValue
    local function setSliderValue(value)
        local numberValue = tonumber(value)
        if not numberValue then
            numberValue = currentValue
        end
        currentValue = math.clamp(math.floor(numberValue + 0.5), 0, 255)
        sliderFill.Size = UDim2.new(currentValue / 255, 0, 1, 0)
        valueBox.Text = tostring(currentValue)
        if valueCallback then
            valueCallback(currentValue)
        end
    end
    local function updateSlider(inputX)
        if sliderBack.AbsoluteSize.X <= 0 then
            return
        end
        local relativeX = math.clamp(inputX - sliderBack.AbsolutePosition.X, 0, sliderBack.AbsoluteSize.X)
        local newValue = math.floor((relativeX / sliderBack.AbsoluteSize.X) * 255 + 0.5)
        setSliderValue(newValue)
    end
    sliderBack.InputBegan:Connect(function(input)
        if input.UserInputType ==
            Enum.UserInputType.MouseButton1
            or input.UserInputType ==
            Enum.UserInputType.Touch then
            dragging = true
            _G.KAMUI_SliderHeld = true
            updateSlider(input.Position.X)
        end
    end)
    UIS.InputChanged:Connect(function(input)
        if not dragging then
            return
        end
        if input.UserInputType ==
            Enum.UserInputType.MouseMovement
            or input.UserInputType ==
            Enum.UserInputType.Touch then
            updateSlider(input.Position.X)
        end
    end)
    UIS.InputEnded:Connect(function(input)
        if input.UserInputType ==
            Enum.UserInputType.MouseButton1
            or input.UserInputType ==
            Enum.UserInputType.Touch then
            dragging = false
            _G.KAMUI_SliderHeld = false
        end
    end)
    valueBox.FocusLost:Connect(function()
        local typedValue = tonumber(valueBox.Text)
        if typedValue == nil then
            valueBox.Text = tostring(currentValue)
            return
        end
        typedValue = math.clamp(math.floor(typedValue + 0.5), 0, 255)
        setSliderValue(typedValue)
    end)
    return function()
        return currentValue
    end, setSliderValue
end

