--// PROFILE CODE FORMAT
--// Codes look like a script call:
--//   KAMUI.Load({Lethal={...},Magnet={...},...},"3F2A")
--// The last argument is a checksum so mistyped/edited codes are rejected.
--// Codes are NEVER executed (no loadstring). They are read by the small
--// parser below, which only understands tables, numbers, strings and booleans.
--// Stored on _G so it doesn't add another top-level local to this huge script.
_G.KAMUI_ProfileCodec = {}

function _G.KAMUI_ProfileCodec.checksum(str)
    local sum = 0
    for i = 1, #str do
        sum = (sum + (i * string.byte(str, i))) % 65536
    end
    return string.format("%04X", sum)
end

function _G.KAMUI_ProfileCodec.parse(src)
    local pos = 1
    local parseValue
    local function skip()
        pos = string.find(src, "%S", pos) or (#src + 1)
    end
    local function parseTable(depth)
        if depth > 4 then
            return false
        end
        -- current char is "{"
        pos = pos + 1
        local t = {}
        skip()
        if string.sub(src, pos, pos) == "}" then
            pos = pos + 1
            return true, t
        end
        while true do
            skip()
            local key = string.match(src, "^[%a_][%w_]*", pos)
            if not key then
                return false
            end
            pos = pos + #key
            skip()
            if string.sub(src, pos, pos) ~= "=" then
                return false
            end
            pos = pos + 1
            skip()
            local ok, value = parseValue(depth)
            if not ok then
                return false
            end
            t[key] = value
            skip()
            local ch = string.sub(src, pos, pos)
            if ch == "," then
                pos = pos + 1
                skip()
                if string.sub(src, pos, pos) == "}" then
                    pos = pos + 1
                    return true, t
                end
            elseif ch == "}" then
                pos = pos + 1
                return true, t
            else
                return false
            end
        end
    end
    parseValue = function(depth)
        skip()
        local ch = string.sub(src, pos, pos)
        if ch == "{" then
            return parseTable(depth + 1)
        end
        if ch == '"' then
            local str = string.match(src, '^"([^"\\]*)"', pos)
            if not str then
                return false
            end
            pos = pos + #str + 2
            return true, str
        end
        local num = string.match(src, "^%-?%d+%.?%d*", pos)
        if num then
            pos = pos + #num
            return true, tonumber(num)
        end
        if string.match(src, "^true%f[%W]", pos) then
            pos = pos + 4
            return true, true
        end
        if string.match(src, "^false%f[%W]", pos) then
            pos = pos + 5
            return true, false
        end
        return false
    end
    local ok, result = parseTable(0)
    if not ok then
        return nil
    end
    return result
end

-- Reads a KAMUI.Load(...) code and returns the flat profile table, or nil.
function _G.KAMUI_ProfileCodec.decodeScript(code)
    local Codec = _G.KAMUI_ProfileCodec
    local body, check = string.match(code, '^%s*KAMUI%.Load%((%b{}),%s*"(%x%x%x%x)"%s*%)%s*;?%s*$')
    if not body then
        return nil
    end
    if Codec.checksum(body) ~= string.upper(check) then
        return nil
    end
    local t = Codec.parse(body)
    if type(t) ~= "table" then
        return nil
    end
    local L, M, D, I, C = t.Lethal, t.Magnet, t.Dash, t.Input, t.Camera
    if type(L) ~= "table" or type(M) ~= "table" or type(D) ~= "table"
        or type(I) ~= "table" or type(C) ~= "table" then
        return nil
    end
    return {
        ProfileName = type(t.Name) == "string" and t.Name or nil,
        LethalDelay = L.Delay,
        LethalJump = L.Jump,
        LethalAccuracy = L.Accuracy,
        LethalCancelDelay = L.CancelDelay,
        LethalMode = L.Mode,
        MagnetDelay = M.Delay,
        FloaterMode = M.Floater,
        DashRange = D.Range,
        TouchMode = I.Touch,
        Platform = I.Platform,
        CooldownActive = t.Cooldown,
        CamSmooth = C.Smooth,
        CamSmoothDelay = C.Delay,
        CamDuration = C.Duration,
        DrawPts = (type(t.Draw) == "table" and type(t.Draw.Pts) == "string") and t.Draw.Pts or nil
    }
end

--// GENERATE PROFILE CODE
local function generateProfileCode()
    local data = getProfileData()
    --// the profile name travels inside the code (no quotes / braces / control characters)
    local namePart = ""
    if CurrentProfile then
        local cleanName = tostring(CurrentProfile):gsub('[%c"\\{}]', "")
        cleanName = cleanName:gsub("^%s+", ""):gsub("%s+$", "")
        cleanName = cleanName:sub(1, 24)
        if cleanName ~= "" then
            namePart = 'Name="' .. cleanName .. '",'
        end
    end
    local body = string.format(
        '{%sLethal={Delay=%s,Jump=%s,Accuracy=%s,CancelDelay=%s,Mode="%s"},Magnet={Delay=%s,Floater=%s},Dash={Range=%s},Input={Touch=%s,Platform="%s"},Camera={Smooth=%s,Delay=%s,Duration=%s},Draw={Pts="%s"},Cooldown=%s}',
        namePart,
        tostring(data.LethalDelay),
        tostring(data.LethalJump),
        tostring(data.LethalAccuracy),
        tostring(data.LethalCancelDelay),
        tostring(data.LethalMode),
        tostring(data.MagnetDelay),
        tostring(data.FloaterMode),
        tostring(data.DashRange),
        tostring(data.TouchMode),
        tostring(data.Platform),
        tostring(data.CamSmooth),
        tostring(data.CamSmoothDelay),
        tostring(data.CamDuration),
        tostring(data.DrawPts or ""),
        tostring(data.CooldownActive)
    )
    return 'KAMUI.Load(' .. body .. ',"' .. _G.KAMUI_ProfileCodec.checksum(body) .. '")'
end

--// DECODE PROFILE CODE
local function decodeProfileCode(code)
    if type(code) ~= "string" then
        return nil
    end
    -- New script-style code first: KAMUI.Load({...},"CHECKSUM")
    local data = _G.KAMUI_ProfileCodec.decodeScript(code)
    -- Fall back to the old JSON format so existing codes/saved profiles still load.
    if not data then
        local ok, decoded = pcall(function()
                return HttpService:JSONDecode(code)
            end)
        if not ok then
            return nil
        end
        data = decoded
    end
    if type(data) ~= "table" then
        return nil
    end
    if type(data.LethalDelay) ~= "number"
        or type(data.LethalJump) ~= "number"
        or type(data.LethalAccuracy) ~= "number"
        or type(data.LethalCancelDelay) ~= "number"
        or type(data.LethalMode) ~= "string"
        or (data.MagnetDelay ~= nil and type(data.MagnetDelay) ~= "number")
        or (data.FloaterMode ~= nil and type(data.FloaterMode) ~= "boolean")
        or type(data.DashRange) ~= "number"
        or type(data.TouchMode) ~= "boolean"
        or type(data.Platform) ~= "string"
        or type(data.CooldownActive) ~= "boolean"
        or type(data.CamSmooth) ~= "boolean"
        or type(data.CamSmoothDelay) ~= "number"
        or type(data.CamDuration) ~= "number"
        or (data.DrawPts ~= nil and type(data.DrawPts) ~= "string") then
        return nil
    end
    if data.LethalMode ~= "V1"
        and data.LethalMode ~= "V2"
        and data.LethalMode ~= "Draw"
        and data.LethalMode ~= "Kiba" then
        return nil
    end
    if data.Platform ~= "PC"
        and data.Platform ~= "Mobile" then
        return nil
    end
    -- Backward compatibility for profile codes created before Floater/Magnet
    -- settings were added to the profile format.
    if data.MagnetDelay == nil then
        data.MagnetDelay = Config.MagnetDelay
    end
    if data.FloaterMode == nil then
        data.FloaterMode = false
    end
    return data
end

--// PROFILE PERSISTENCE
--// Profiles are saved locally so they survive script re-execution.
local PROFILE_FILE = "KAMUI_Profiles.json"

local function saveProfilesToFile()
    if not writefile then
        return false
    end
    local ok = pcall(function()
        writefile(PROFILE_FILE, HttpService:JSONEncode(Profiles))
    end)
    return ok
end

local function loadProfilesFromFile()
    if not isfile or not readfile or not isfile(PROFILE_FILE) then
        return
    end
    local ok, saved = pcall(function()
        return HttpService:JSONDecode(readfile(PROFILE_FILE))
    end)
    if not ok or type(saved) ~= "table" then
        return
    end
    -- Only restore profiles that still pass the same validation used by
    -- imported profile codes. Invalid/corrupt entries are ignored.
    for profileName, profileData in pairs(saved) do
        if type(profileName) == "string" then
            local encoded = HttpService:JSONEncode(profileData)
            local decoded = decodeProfileCode(encoded)
            if decoded then
                Profiles[profileName] = decoded
            end
        end
    end
end

