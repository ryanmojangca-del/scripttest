_G.KAMUI_BuildHome = function(UI)
    UI.setupPage(HomeContainer)

    --// Dash icon: upload dash_icon.png to Roblox (Creator Hub -> Decal/Image) and paste its id here.
    --// While it is empty a small "»" symbol is shown instead.
    local DASH_ICON_ID = ""

    local GuiService = game:GetService("GuiService")
    local PILL_LINE = Color3.fromRGB(90, 18, 24)

    local function spacer()
        UI.make("Frame", {
            Name = "Spacer",
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            Size = UDim2.new(1, 0, 0, 8),
            LayoutOrder = UI.nextOrder(HomeContainer)
        }, HomeContainer)
    end

    ----------------------------------------------------------------
    --// card 1: Dash status (icon tile + title + live status + switch)
    ----------------------------------------------------------------
    local dashCard = UI.card(HomeContainer)
    UI.addRow(dashCard, ToggleBtn, 64)
    UI.flatten(ToggleBtn)
    ToggleBtn.TextTransparency = 1
    ToggleIndicator.Visible = false
    local oldLabel = ToggleBtn:FindFirstChild("RowLabel")
    if oldLabel then
        oldLabel.Visible = false
    end

    local tile = UI.make("Frame", {
        Name = "DashTile",
        BackgroundColor3 = THEME.DarkRed,
        BorderSizePixel = 0,
        Active = false,
        Position = UDim2.new(0, 12, 0.5, -19),
        Size = UDim2.new(0, 38, 0, 38)
    }, ToggleBtn)
    UI.corner(tile, 10)
    UI.stroke(tile, PILL_LINE)

    local iconId = tostring(DASH_ICON_ID):match("%d+")
    if iconId and _G.KAMUI_SetImage then
        local img = UI.make("ImageLabel", {
            Name = "DashIcon",
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            Active = false,
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.new(0.5, 0, 0.5, 0),
            Size = UDim2.new(0, 24, 0, 24),
            ScaleType = Enum.ScaleType.Fit,
            ImageColor3 = THEME.BrightRed
        }, tile)
        _G.KAMUI_SetImage(img, iconId)
    else
        UI.make("TextLabel", {
            Name = "DashIconFallback",
            BackgroundTransparency = 1,
            Size = UDim2.new(1, 0, 1, 0),
            Font = Enum.Font.GothamBold,
            TextSize = 20,
            TextColor3 = THEME.BrightRed,
            Text = "»"
        }, tile)
    end

    UI.make("TextLabel", {
        Name = "DashTitle",
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 62, 0, 11),
        Size = UDim2.new(1, -120, 0, 20),
        Font = Enum.Font.GothamMedium,
        TextSize = 13,
        TextColor3 = THEME.Text,
        TextXAlignment = Enum.TextXAlignment.Left,
        Text = "Dash"
    }, ToggleBtn)
    local statusDot = UI.make("Frame", {
        Name = "StatusDot",
        BackgroundColor3 = THEME.BrightRed,
        BorderSizePixel = 0,
        Active = false,
        Position = UDim2.new(0, 62, 0, 40),
        Size = UDim2.new(0, 8, 0, 8)
    }, ToggleBtn)
    UI.corner(statusDot, 4)
    local statusText = UI.make("TextLabel", {
        Name = "StatusText",
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 76, 0, 35),
        Size = UDim2.new(1, -130, 0, 18),
        Font = Enum.Font.Gotham,
        TextSize = 11,
        TextColor3 = THEME.MutedText,
        TextXAlignment = Enum.TextXAlignment.Left,
        Text = "Active"
    }, ToggleBtn)

    --// the switch comes from the skin pass (RowSwitch); build the same one if it is missing
    local rowSwitch = ToggleBtn:FindFirstChild("RowSwitch")
    local ownTrack, ownKnob
    if not rowSwitch then
        ownTrack = UI.make("Frame", {
            Name = "DashSwitch",
            BorderSizePixel = 0,
            Active = false,
            Position = UDim2.new(1, -48, 0.5, -10),
            Size = UDim2.new(0, 36, 0, 20)
        }, ToggleBtn)
        UI.corner(ownTrack, 10)
        ownKnob = UI.make("Frame", {
            BorderSizePixel = 0,
            Size = UDim2.new(0, 14, 0, 14)
        }, ownTrack)
        UI.corner(ownKnob, 7)
    end
    local function syncStatus()
        local on = Config.Enabled
        statusText.Text = on and "Active" or "Paused"
        statusDot.BackgroundColor3 = on and THEME.BrightRed or UI.HEAD
        if ownTrack then
            ownTrack.BackgroundColor3 = on and THEME.BrightRed or Color3.fromRGB(42, 42, 45)
            ownKnob.Position = on and UDim2.new(1, -17, 0.5, -7) or UDim2.new(0, 3, 0.5, -7)
            ownKnob.BackgroundColor3 = on and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(189, 184, 184)
        end
    end
    ToggleBtn:GetPropertyChangedSignal("Text"):Connect(syncStatus)
    syncStatus()

    ----------------------------------------------------------------
    --// card 2: Mode dropdown (V1 / V2)
    ----------------------------------------------------------------
    spacer()
    local modeCard = UI.card(HomeContainer)
    modeCard.ZIndex = 2 -- explicit z ladder (2 -> 12): works in Sibling and Global ZIndex modes
    local modeRow = UI.make("Frame", {
        Name = "ModeRow",
        ZIndex = 3,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, 74),
        LayoutOrder = UI.nextOrder(modeCard)
    }, modeCard)

    --// the old Mode button stays alive (hidden): its handler still does all the mode work
    ModeBtn:SetAttribute("KamuiSkinned", true)
    ModeBtn.Visible = false
    ModeBtn.Parent = modeRow

    UI.make("TextLabel", {
        Name = "ModeCaption",
        ZIndex = 4,
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 12, 0, 10),
        Size = UDim2.new(1, -24, 0, 14),
        Font = Enum.Font.Gotham,
        TextSize = 11,
        TextColor3 = THEME.MutedText,
        TextXAlignment = Enum.TextXAlignment.Left,
        Text = "Mode"
    }, modeRow)

    local field = Instance.new("TextButton")
    field:SetAttribute("KamuiSkinned", true)
    field.Name = "ModeField"
    field.AutoButtonColor = false
    field.ZIndex = 4
    field.Text = ""
    field.BackgroundColor3 = UI.CHIP
    field.BorderSizePixel = 0
    field.Position = UDim2.new(0, 12, 0, 30)
    field.Size = UDim2.new(1, -24, 0, 32)
    field.Parent = modeRow
    UI.corner(field, 7)
    local fieldStroke = UI.stroke(field, UI.LINE)

    local valueLabel = UI.make("TextLabel", {
        Name = "ModeValue",
        ZIndex = 5,
        BackgroundTransparency = 1,
        Active = false,
        Position = UDim2.new(0, 12, 0, 0),
        Size = UDim2.new(1, -44, 1, 0),
        Font = Enum.Font.GothamMedium,
        TextSize = 12,
        TextColor3 = THEME.Text,
        TextXAlignment = Enum.TextXAlignment.Left,
        Text = Config.LethalMode
    }, field)

    --// chevron: two thin bars forming a V (rotates when the menu opens)
    local chev = UI.make("Frame", {
        Name = "Chevron",
        ZIndex = 5,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Active = false,
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(1, -18, 0.5, 0),
        Size = UDim2.new(0, 12, 0, 12)
    }, field)
    for _, arm in ipairs({ { 3.9, 45 }, { 8.1, -45 } }) do
        local bar = Instance.new("Frame")
        bar:SetAttribute("KamuiSkinned", true)
        bar.BackgroundColor3 = THEME.MutedText
        bar.BorderSizePixel = 0
        bar.Active = false
        bar.AnchorPoint = Vector2.new(0.5, 0.5)
        bar.Position = UDim2.new(0, arm[1], 0, 5.5)
        bar.Size = UDim2.new(0, 7, 0, 2)
        bar.Rotation = arm[2]
        bar.ZIndex = 6
        bar.Parent = chev
    end

    local menu = Instance.new("Frame")
    menu:SetAttribute("KamuiSkinned", true)
    menu.Name = "ModeMenu"
    menu.BackgroundColor3 = Color3.fromRGB(20, 20, 22)
    menu.BorderSizePixel = 0
    menu.Visible = false
    menu.ZIndex = 10
    menu.Position = UDim2.new(0, 0, 1, 6)
    menu.Size = UDim2.new(1, 0, 0, 128)
    menu.Parent = field
    UI.corner(menu, 8)
    UI.stroke(menu, Color3.fromRGB(46, 46, 48))

    local options = {}
    for i, name in ipairs({ "V1", "V2", "Draw", "Kiba" }) do
        local opt = Instance.new("TextButton")
        opt:SetAttribute("KamuiSkinned", true)
        opt.Name = "Option" .. name
        opt.AutoButtonColor = false
        opt.ZIndex = 11
        opt.BackgroundColor3 = THEME.DarkRed
        opt.BorderSizePixel = 0
        opt.Position = UDim2.new(0, 4, 0, 4 + (i - 1) * 30)
        opt.Size = UDim2.new(1, -8, 0, 28)
        opt.Font = Enum.Font.GothamMedium
        opt.TextSize = 12
        opt.TextXAlignment = Enum.TextXAlignment.Left
        opt.Text = name
        opt.Parent = menu
        UI.corner(opt, 6)
        UI.make("UIPadding", { PaddingLeft = UDim.new(0, 10) }, opt)
        local mark = UI.make("Frame", {
            Name = "Mark",
            ZIndex = 12,
            BackgroundColor3 = THEME.BrightRed,
            BorderSizePixel = 0,
            Active = false,
            Position = UDim2.new(1, -20, 0.5, -3),
            Size = UDim2.new(0, 6, 0, 6)
        }, opt)
        UI.corner(mark, 3)
        options[name] = { btn = opt, mark = mark }
    end

    local isOpen = false
    local function setOpen(v)
        isOpen = v
        menu.Visible = v
        fieldStroke.Color = v and THEME.Red or UI.LINE
        TweenService:Create(chev, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Rotation = v and 180 or 0
        }):Play()
    end
    local function syncMode()
        valueLabel.Text = tostring(Config.LethalMode)
        for name, o in pairs(options) do
            local on = name == Config.LethalMode
            o.btn.BackgroundTransparency = on and 0 or 1
            o.btn.TextColor3 = on and THEME.Text or THEME.MutedText
            o.mark.Visible = on
        end
    end
    ModeBtn:GetPropertyChangedSignal("Text"):Connect(syncMode)
    syncMode()

    field.MouseButton1Click:Connect(function()
        if not isCurrent() then
            return
        end
        setOpen(not isOpen)
    end)
    for name, o in pairs(options) do
        o.btn.MouseButton1Click:Connect(function()
            if not isCurrent() then
                return
            end
            if Config.LethalMode ~= name and _G.KAMUI_SetLethalMode then
                _G.KAMUI_SetLethalMode(name)
            end
            syncMode()
            setOpen(false)
        end)
    end

    --// tap / click anywhere else closes the menu
    local function hits(gui, p)
        local ap, as = gui.AbsolutePosition, gui.AbsoluteSize
        return p.X >= ap.X and p.X <= ap.X + as.X and p.Y >= ap.Y and p.Y <= ap.Y + as.Y
    end
    UIS.InputBegan:Connect(function(input)
        if not isOpen or not isCurrent() then
            return
        end
        if input.UserInputType ~= Enum.UserInputType.MouseButton1
            and input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end
        local inset = GuiService:GetGuiInset()
        local p = Vector2.new(input.Position.X, input.Position.Y)
        local candidates = { p, p - inset, p + inset }
        for _, c in ipairs(candidates) do
            if hits(menu, c) or hits(field, c) then
                return
            end
        end
        setOpen(false)
    end)
    HomeContainer:GetPropertyChangedSignal("Visible"):Connect(function()
        if not HomeContainer.Visible then
            setOpen(false)
        end
    end)

    ----------------------------------------------------------------
    --// card 3: Hide GUI (button + keybind chip)
    ----------------------------------------------------------------
    spacer()
    local hideCard = UI.card(HomeContainer)
    UI.addRow(hideCard, HideGUIRow, 44)
    HideGUIBtn.Position = UDim2.new(0, 0, 0, 0)
    HideGUIBtn.Size = UDim2.new(1, -96, 1, 0)
    HideGUIBtn.TextTransparency = 1
    UI.flatten(HideGUIBtn)
    UI.make("TextLabel", {
        Name = "RowLabel",
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 12, 0, 0),
        Size = UDim2.new(1, -70, 1, 0),
        Font = Enum.Font.GothamMedium,
        TextSize = 12,
        TextColor3 = THEME.Text,
        TextXAlignment = Enum.TextXAlignment.Left,
        Text = "Hide GUI"
    }, HideGUIBtn)
    local pill = UI.make("Frame", {
        Name = "HidePill",
        BackgroundColor3 = THEME.DarkRed,
        BorderSizePixel = 0,
        Size = UDim2.new(0, 52, 0, 26),
        Position = UDim2.new(1, -60, 0.5, -13)
    }, HideGUIBtn)
    UI.corner(pill, 7)
    UI.stroke(pill, PILL_LINE)
    UI.make("TextLabel", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 1, 0),
        Font = Enum.Font.GothamMedium,
        TextSize = 12,
        TextColor3 = THEME.Text,
        Text = "Hide"
    }, pill)

    HideGUIKeyBtn.AnchorPoint = Vector2.new(1, 0.5)
    HideGUIKeyBtn.Position = UDim2.new(1, -12, 0.5, 0)
    HideGUIKeyBtn.AutomaticSize = Enum.AutomaticSize.X
    HideGUIKeyBtn.Size = UDim2.new(0, 0, 0, 26)
    HideGUIKeyBtn.BackgroundColor3 = UI.CHIP
    HideGUIKeyBtn.TextColor3 = THEME.Text
    HideGUIKeyBtn.Font = Enum.Font.GothamMedium
    HideGUIKeyBtn.TextSize = 11
    UI.make("UIPadding", {
        PaddingLeft = UDim.new(0, 10),
        PaddingRight = UDim.new(0, 10)
    }, HideGUIKeyBtn)
    UI.make("UISizeConstraint", { MinSize = Vector2.new(44, 26) }, HideGUIKeyBtn)
    UI.corner(HideGUIKeyBtn, 6)
    UI.stroke(HideGUIKeyBtn, UI.LINE)
end

