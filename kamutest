--// KAMUI HIDE / SHOW EFFECT
--// One timeline drives both directions. Hiding plays it forward, showing plays the exact same timeline backwards,
--// so the GUI spirals INTO the vortex when you hide it and unwinds back OUT of it when you bring it back.
--//  * the window shrinks with a UIScale (no re-layout / no clipping jank) while it rotates and orbits the vortex point
--//  * smooth start, strong pull at the end (like being absorbed)
--//  * the vortex itself (like the Kamui warp in the anime): a small red point with curved, pointed white / accent / dark
--//    streaks that shoot out, whirl faster and tighten into the point, plus a quick white flash when the window is swallowed
--// Stored on _G so it doesn't add another top-level local to this huge script.
_G.KAMUI_HideFX = {Time = 0.6, Tail = 0.3, Busy = false, Flash = false}

function _G.KAMUI_HideFX.play(vx, vy, reverse)
    local FX = _G.KAMUI_HideFX
    if FX.Busy or not MainFrame then
        return
    end
    FX.Busy = true
    local ws = MainFrame:FindFirstChild("WindowScale")
    if not ws then
        ws = Instance.new("UIScale")
        ws.Name = "WindowScale"
        ws.Parent = MainFrame
    end
    local sc = (ws.Scale > 0) and ws.Scale or 1
    local targetPos = MainFrame.Position
    local targetSize = MainFrame.Size
    local base = Vector2.new(targetSize.X.Offset, targetSize.Y.Offset)
    local total = FX.Time + FX.Tail
    local root, flash
    local ok, err = pcall(function()
        if reverse then
            -- show: put the (invisible, tiny) window back first so its real position can be measured
            ws.Scale = 0.001
            MainFrame.Rotation = 0
            ScreenGui.Enabled = true
            MainFrame.Visible = true
            RunService.RenderStepped:Wait()
        end
        local abs0 = MainFrame.AbsolutePosition -- top-left of the window at its normal spot
        local C1 = abs0 + base * (sc * 0.5)     -- center of the window at its normal spot
        local V = (vx and vy) and Vector2.new(vx, vy) or C1 -- the vortex point
        local maxR = math.max(base.X, base.Y) * sc * 0.6

        -- vortex (lives in the restore ScreenGui so it keeps playing while the main GUI is disabled)
        root = Instance.new("Frame")
        root.Name = "KamuiVortex"
        root.AnchorPoint = Vector2.new(0.5, 0.5)
        root.Position = UDim2.fromOffset(V.X, V.Y)
        root.Size = UDim2.fromOffset(0, 0)
        root.BackgroundTransparency = 1
        root.BorderSizePixel = 0
        root.ZIndex = 300
        root.Parent = RestoreGui
        -- quick white flash when the window is swallowed (set _G.KAMUI_HideFX.Flash = false to turn it off)
        if FX.Flash ~= false then
            flash = Instance.new("Frame")
            flash.Name = "KamuiFlash"
            flash.Position = UDim2.new(0, 0, 0, -80)
            flash.Size = UDim2.new(1, 0, 1, 160)
            flash.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            flash.BackgroundTransparency = 1
            flash.BorderSizePixel = 0
            flash.Active = false
            flash.ZIndex = 400
            flash.Parent = RestoreGui
        end
        -- the small red point everything is pulled into
        local eye = Instance.new("Frame")
        eye.AnchorPoint = Vector2.new(0.5, 0.5)
        eye.Position = UDim2.fromOffset(0, 0)
        eye.Size = UDim2.fromOffset(0, 0)
        eye.BackgroundColor3 = THEME.BrightRed
        eye.BorderSizePixel = 0
        eye.ZIndex = 305
        local eyeCorner = Instance.new("UICorner")
        eyeCorner.CornerRadius = UDim.new(1, 0)
        eyeCorner.Parent = eye
        eye.Parent = root
        -- curved, pointed streaks (white / light accent / dark "blades") that whirl around the point.
        -- Every streak is a chain of thin rotated segments laid along a curve and tapered at both ends.
        local NSEG, NSTREAK = 16, 9
        local streaks = {}
        for j = 1, NSTREAK do
            local dark = (j % 3 == 0)
            local color
            if dark then
                color = Color3.fromRGB(10, 10, 16)
            elseif j % 3 == 1 then
                color = Color3.fromRGB(238, 245, 255)
            else
                color = THEME.BrightRed:Lerp(Color3.fromRGB(255, 255, 255), 0.4)
            end
            local segs = {}
            for i = 1, NSEG do
                local f = Instance.new("Frame")
                f.AnchorPoint = Vector2.new(0.5, 0.5)
                f.BorderSizePixel = 0
                f.BackgroundColor3 = color
                f.ZIndex = dark and 301 or 302
                f.Size = UDim2.fromOffset(0, 0)
                f.Parent = root
                segs[i] = f
            end
            local r1, r2, r3 = ((j * 37) % 10) / 10, ((j * 53) % 10) / 10, ((j * 29) % 10) / 10
            streaks[j] = {
                segs = segs,
                a0 = (j - 1) * (2 * math.pi / NSTREAK) + r1 * 0.5,
                curl = 1.2 + r2 * 1.0,
                len = 0.75 + r3 * 0.4,
                width = dark and 7 or (4 + r1 * 6)
            }
        end
        local pts = {}

        local function swirl(p) -- p: 0 = start of hide, 1 = fully absorbed
            -- streaks shoot out of the point, whirl faster and faster while they tighten, then pull back into it
            local g = math.clamp(p / 0.15, 0, 1) * (1 - math.clamp((p - 0.85) / 0.15, 0, 1))
            local spin = p * p * math.pi * 5 + p * 1.2
            local rOut = maxR * 1.25 * (1 - 0.7 * p * p)
            local rIn = 5
            for _, st in ipairs(streaks) do
                local sMax = g * st.len
                local on = g > 0.02
                for i = 0, NSEG do
                    local u = i / NSEG
                    local sp = u * sMax
                    local rad = rIn + (rOut - rIn) * (sp ^ 1.1)
                    local ang = st.a0 + spin + st.curl * sp
                    pts[i] = Vector2.new(math.cos(ang) * rad, math.sin(ang) * rad)
                end
                for i = 1, NSEG do
                    local f = st.segs[i]
                    f.Visible = on
                    if on then
                        local p0, p1 = pts[i - 1], pts[i]
                        local d = p1 - p0
                        local mid = (p0 + p1) * 0.5
                        local um = (i - 0.5) / NSEG
                        local w = st.width * (math.sin(math.pi * um) ^ 0.7) * (0.5 + 0.5 * g)
                        f.Position = UDim2.fromOffset(mid.X, mid.Y)
                        f.Size = UDim2.fromOffset(d.Magnitude + 1.5, math.max(w, 0.5))
                        f.Rotation = math.deg(math.atan2(d.Y, d.X))
                        f.BackgroundTransparency = 0.1 + 0.6 * um
                    end
                end
            end
            local es = 10 * math.clamp(p / 0.06, 0, 1) * (1 - math.clamp((p - 0.9) / 0.1, 0, 1))
            eye.Size = UDim2.fromOffset(es, es)
            if flash then
                flash.BackgroundTransparency = 1 - 0.5 * math.clamp(1 - math.abs(p - 0.9) / 0.12, 0, 1)
            end
        end

        -- window pose: u = 0 at its normal spot, u = 1 absorbed into V
        local SPIN = math.pi * 2.7
        local function pose(u)
            local k = math.max(0.001, (1 - u) ^ 1.15)
            local phi = SPIN * u
            local rel = C1 - V
            local cs, sn = math.cos(phi * 0.7), math.sin(phi * 0.7) -- orbits a bit slower than it spins
            local c = V + Vector2.new(rel.X * cs - rel.Y * sn, rel.X * sn + rel.Y * cs) * (1 - u)
            local tl = c - base * (sc * k * 0.5)
            MainFrame.Position = UDim2.new(
                targetPos.X.Scale, targetPos.X.Offset + (tl.X - abs0.X),
                targetPos.Y.Scale, targetPos.Y.Offset + (tl.Y - abs0.Y)
            )
            MainFrame.Rotation = math.deg(phi)
            ws.Scale = sc * k
        end
        local function windowU(T) -- smooth start, strong pull at the end
            local x = math.clamp(T / FX.Time, 0, 1)
            local s = x * x * (3 - 2 * x)
            return 0.35 * s + 0.65 * x * x * x
        end

        local t0 = os.clock()
        while true do
            local el = math.min(os.clock() - t0, total)
            local T = reverse and (total - el) or el
            pose(windowU(T))
            swirl(T / total)
            if el >= total then
                break
            end
            RunService.RenderStepped:Wait()
        end
    end)
    if root then
        root:Destroy()
    end
    if flash then
        flash:Destroy()
    end
    -- reset so the window is exactly as before
    MainFrame.Rotation = 0
    MainFrame.Position = targetPos
    ws.Scale = sc
    if reverse then
        ScreenGui.Enabled = true
    else
        ScreenGui.Enabled = false
    end
    if not ok then
        warn("[KAMUI] hide effect failed:", err)
    end
    FX.Busy = false
end

