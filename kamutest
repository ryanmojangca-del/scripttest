--// MOBILE INPUT KEEPER
--// Virtual keyboard / mouse input (VirtualInputManager) flips Roblox's "last input type"
--// to Keyboard / Mouse. On a phone that makes Roblox's control module and the game think
--// a keyboard took over, so the on-screen buttons (dash, M1, block, jump) can stop
--// responding, and after a respawn they often never come back. This sends ONE harmless
--// virtual touch on the empty top strip of the screen to put the input type back on Touch.
--// Phones only (touch device without a keyboard). Disable: _G.KAMUI_NoTouchRestore = true
--// Emulator / touch laptop: _G.KAMUI_ForceTouchRestore = true
_G.KAMUI_RestoreTouchInput = function()
    if _G.KAMUI_NoTouchRestore then
        return
    end
    if not UIS.TouchEnabled then
        return
    end
    if UIS.KeyboardEnabled and not _G.KAMUI_ForceTouchRestore then
        return
    end
    if UIS.LastInputType == Enum.UserInputType.Touch then
        return
    end
    pcall(function()
        local cam = Workspace.CurrentCamera
        local vp = cam and cam.ViewportSize or Vector2.new(800, 400)
        local x = math.floor(vp.X * 0.5)
        VirtualInputManager:SendTouchEvent(99, 0, x, 3)
        VirtualInputManager:SendTouchEvent(99, 2, x, 3)
    end)
    if _G.KAMUI_DebugInput then
        print("[KAMUI input] restored touch controls, LastInputType =", UIS.LastInputType.Name)
    end
end

