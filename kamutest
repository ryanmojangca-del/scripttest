--// Upload the 3 files from the "modules" folder somewhere you control (a public GitHub
--// repo works well) and paste each RAW link below. They download the first time you
--// tap Open (and are pre-fetched a few seconds after the script loads), then stay cached.
--// ============================================================
_G.KAMUI_Modules = {
    M1Emote = "https://raw.githubusercontent.com/ryanmojangca-del/scripttest/refs/heads/main/kamum1emote",
    Backdash = "https://raw.githubusercontent.com/ryanmojangca-del/scripttest/refs/heads/main/kamubackdash",
    TrueTwisted = "https://raw.githubusercontent.com/ryanmojangca-del/scripttest/refs/heads/main/kamutwisted",
}
_G.KAMUI_ModuleCache = _G.KAMUI_ModuleCache or {}

--// downloads (or returns the cached) source text of a module: source, or nil + reason
_G.KAMUI_FetchModule = function(name)
    local cached = _G.KAMUI_ModuleCache[name]
    if cached then
        return cached
    end
    local url = _G.KAMUI_Modules[name]
    if type(url) ~= "string" or url == "" or url:find("YOUR_USER", 1, true) then
        return nil, "the '" .. tostring(name) .. "' link is not set - edit _G.KAMUI_Modules at the top of the script"
    end
    local body
    local ok = pcall(function()
        body = game:HttpGet(url, true)
    end)
    if not ok or type(body) ~= "string" or body == "" then
        --// some executors only expose request()
        pcall(function()
            local req = request or http_request or (syn and syn.request) or (http and http.request)
            if req then
                local res = req({ Url = url, Method = "GET" })
                body = res and (res.Body or res.body)
            end
        end)
    end
    if type(body) ~= "string" or body == "" then
        return nil, "could not download '" .. tostring(name) .. "' (check the link and your connection)"
    end
    if body:find("^%s*<") or body:find("^404: Not Found") then
        return nil, "the '" .. tostring(name) .. "' link did not return a script (wrong or private link?)"
    end
    _G.KAMUI_ModuleCache[name] = body
    return body
end

--// returns the compiled module function, or nil + reason
_G.KAMUI_LoadModule = function(name)
    local src, why = _G.KAMUI_FetchModule(name)
    if not src then
        return nil, why
    end
    local fn, compileErr = loadstring(src)
    if not fn then
        _G.KAMUI_ModuleCache[name] = nil --// drop a bad download so the next tap re-downloads
        return nil, compileErr or ("'" .. tostring(name) .. "' failed to compile")
    end
    return fn
end

