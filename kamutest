            button,
            TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
            { BackgroundTransparency = active and 0 or 1, TextColor3 = active and THEME.Text or THEME.MutedText }
        ):Play()
