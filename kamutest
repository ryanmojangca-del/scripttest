                    end
                end
            end
        end)
    end
    _G.KAMUI_GuiState = St

    local REV, HIST, NEUTRAL = {}, {}, {}
    local function lookup(k, forSweep)
        if ORIG[k] then
            return k
        end
        if forSweep and NEUTRAL[k] then
            return nil -- grey-ish accent colors could clash with normal UI greys
        end
        local r = REV[k]
        if r then
            return r
        end
        for i = 1, #HIST do
            r = HIST[i][k]
            if r then
                return r
            end
        end
        return nil
    end

    local function computeCur()
        local h, s, v = St.h, St.s, St.v
        if St.rainbow then
            h = St.phase % 1
            s = math.max(s, 0.7)
            v = math.max(v, 0.85)
        end
        for k, o in pairs(ORIG) do
            local dh = o.h - baseH
            if dh > 0.5 then
                dh = dh - 1
            elseif dh < -0.5 then
                dh = dh + 1
            end
            CUR[k] = Color3.fromHSV((h + dh) % 1, math.clamp(o.s * s / baseS, 0, 1), math.clamp(o.v * v / baseV, 0, 1))
        end
        return h, s, v
    end

    local CLASS_PROPS = {}
    local function propsFor(inst)
        local cn = inst.ClassName
        local p = CLASS_PROPS[cn]
        if p == nil then
            p = false
            if inst:IsA("UIStroke") then
                p = { "Color" }
            elseif inst:IsA("GuiObject") then
                p = { "BackgroundColor3", "BorderColor3" }
                if inst:IsA("TextLabel") or inst:IsA("TextButton") or inst:IsA("TextBox") then
                    p[#p + 1] = "TextColor3"
                    p[#p + 1] = "TextStrokeColor3"
                    if inst:IsA("TextBox") then
                        p[#p + 1] = "PlaceholderColor3"
                    end
                end
                if inst:IsA("ImageLabel") or inst:IsA("ImageButton") then
                    p[#p + 1] = "ImageColor3"
                end
                if inst:IsA("ScrollingFrame") then
                    p[#p + 1] = "ScrollBarImageColor3"
                end
            end
            CLASS_PROPS[cn] = p
        end
        return p or nil
    end

    local BIND = setmetatable({}, { __mode = "k" }) -- instance -> { Property = true }
    local function register(inst)
        local list = propsFor(inst)
        if not list or inst:IsDescendantOf(page) then
            return
        end
        for _, p in ipairs(list) do
            if lookup(key(inst[p]), true) then
                local b = BIND[inst]
                if not b then
                    b = {}
                    BIND[inst] = b
                end
                b[p] = true
            end
        end
    end

    local function guiRoots()
        local r = { ScreenGui }
        if RestoreGui and RestoreGui.Parent then
            r[#r + 1] = RestoreGui
        end
        local ok, kids = pcall(function()
            return game:GetService("CoreGui"):GetChildren()
        end)
        if ok then
            for _, g in ipairs(kids) do
                if g ~= ScreenGui and g:IsA("ScreenGui") and g.Name:find("^KAMUI_") and not g.Name:find("_Restore$") then
                    r[#r + 1] = g
                end
            end
        end
        return r
    end

    local function sweepAll()
        for _, root in ipairs(guiRoots()) do
            for _, d in ipairs(root:GetDescendants()) do
                register(d)
            end
        end
    end

    local function applyAccent()
        local h, s, v = computeCur()
        table.insert(HIST, 1, REV)
        if #HIST > 10 then
            table.remove(HIST)
        end
        REV = {}
        for k, c in pairs(CUR) do
            local ck = key(c)
            if REV[ck] == nil then
                REV[ck] = k
            end
            if math.max(c.R, c.G, c.B) - math.min(c.R, c.G, c.B) < 0.12 then
                NEUTRAL[ck] = true
            end
        end
        THEME.Red = CUR[K_RED]
        THEME.BrightRed = CUR[K_BRIGHT]
        THEME.DarkRed = CUR[K_DARK]
        THEME.Green = CUR[K_BRIGHT]
        for inst, props in pairs(BIND) do
            if inst.Parent then
                for p in pairs(props) do
                    local k = lookup(key(inst[p]), false)
                    if k then
                        local nc = CUR[k]
                        if inst[p] ~= nc then
                            inst[p] = nc
                        end
                    end
                end
            end
        end
        local seq0, grads = _G.KAMUI_BorderSeq, _G.KAMUI_BorderGradients
        if seq0 and grads then
            local pts = {}
            for i, kp in ipairs(seq0.Keypoints) do
                pts[i] = ColorSequenceKeypoint.new(kp.Time, CUR[key(kp.Value)] or kp.Value)
            end
            local ns = ColorSequence.new(pts)
            for _, g in ipairs(grads) do
                g.Color = ns
            end
        end
        return h, s, v
    end

