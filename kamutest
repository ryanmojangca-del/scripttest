-- Returns whether a player currently has one of the tracked skills.
-- Weak skills are checked first so a newly selected weak skill can trigger
-- COUNTER even if an old strong skill is still present elsewhere.
local function getDeathCounterSkillType(backpack, character)
    local hasStrong = false
    local hasWeak = false
    local function scan(container)
        if not container then return end
        for _, tool in ipairs(container:GetChildren()) do
            local name = tool.Name
            if deathCounterWeakSkills[name] then
                hasWeak = true
            elseif deathCounterStrongSkills[name] then
                hasStrong = true
            end
        end
    end
    scan(character)
    scan(backpack)
    if hasWeak then
        return "weak"
    end
    if hasStrong then
        return "strong"
    end
    return nil
end

