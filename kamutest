        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left,
        Text = "Paste a code and press Load to save it as a profile. Generate code copies your current settings."
    }, exportPage)

    --// action row (always visible): Generate code | Load default
    local btnRow = UI.make("Frame", {
        Name = "ActionRow",
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 36),
        LayoutOrder = 3
    }, R)
    GenerateCodeBtn.Parent = btnRow
    GenerateCodeBtn.Position = UDim2.new(0, 0, 0, 0)
    GenerateCodeBtn.Size = UDim2.new(0.5, -4, 1, 0)
    UI.button(GenerateCodeBtn, false)
    LoadDefaultBtn.Parent = btnRow
    LoadDefaultBtn.Position = UDim2.new(0.5, 4, 0, 0)
    LoadDefaultBtn.Size = UDim2.new(0.5, -4, 1, 0)
    UI.button(LoadDefaultBtn, false)

    --// optional icon in front of the button text. The icon and a copy of the text sit in a
    --// centered horizontal row, so they never overlap whatever the font or text length is.
    local btnIcons = _G.KAMUI_ProfileIcons or {}
    local function decorateButton(btn, rawId)
        local id = tostring(rawId or ""):match("%d+")
        if not id then
            return
        end
        local ICON, GAP = 14, 6
        local holder = UI.make("Frame", {
            Name = "IconRow",
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            Active = false,
            Size = UDim2.new(1, 0, 1, 0),
            ZIndex = btn.ZIndex + 1
        }, btn)
        local img = UI.make("ImageLabel", {
            Name = "BtnIcon",
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            Size = UDim2.new(0, ICON, 0, ICON),
            ImageColor3 = THEME.Text,
            Active = false,
            ZIndex = btn.ZIndex + 1
        }, holder)
        _G.KAMUI_SetImage(img, id)
        local lbl = UI.make("TextLabel", {
            Name = "BtnText",
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            TextWrapped = false,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextYAlignment = Enum.TextYAlignment.Center,
            ZIndex = btn.ZIndex + 1
        }, holder)
        lbl:SetAttribute("KamuiKeepFont", true) -- font follows the button (synced below)

        --// The icon + text group is centered with plain fixed positions (no auto-size / list
        --// layout): the text width is measured, the icon is placed right before the first
        --// letter, and the text starts right after the icon. They can never overlap.
        --// The button's own text is moved into the label and the button text is emptied, so
        --// only ONE copy of the text can ever be on screen (other code that sets btn.Text,
        --// like "Code generated", is picked up here and moved over the same way).
        local shown = btn.Text
        local function sync()
            if btn.Text ~= "" then
                shown = btn.Text
                btn.Text = ""
            end

            lbl.Text = shown
            lbl.Font = btn.Font
            lbl.TextSize = btn.TextSize
            lbl.TextColor3 = btn.TextColor3

            local width = #shown * btn.TextSize * 0.55
            local ok, bounds = pcall(function()
                return game:GetService("TextService"):GetTextSize(
                    shown, btn.TextSize, btn.Font, Vector2.new(10000, 1000)
                )
            end)
            if ok and bounds then
                width = bounds.X
            end
            width = math.ceil(width) + 2

            local left = -math.floor((ICON + GAP + width) / 2)
            img.Position = UDim2.new(0.5, left, 0.5, -ICON / 2)
            lbl.Position = UDim2.new(0.5, left + ICON + GAP, 0, 0)
            lbl.Size = UDim2.new(0, width, 1, 0)
        end
        btn.TextTransparency = 1 -- the real text stays on the button (other code sets it), just hidden
        sync()
        for _, prop in ipairs({ "Text", "Font", "TextSize", "TextColor3" }) do
            btn:GetPropertyChangedSignal(prop):Connect(sync)
        end
    end
    decorateButton(GenerateCodeBtn, btnIcons.Copy)
    decorateButton(LoadDefaultBtn, btnIcons.Refresh)

    --// switching
    local function showView(name)
        savedPage.Visible = name == "Saved"
        exportPage.Visible = name == "Export"
        for n, b in pairs(viewTabs) do
            local on = n == name
            TweenService:Create(b, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                BackgroundTransparency = on and 0 or 1,
                TextColor3 = on and THEME.Text or THEME.MutedText
            }):Play()
        end
    end
    viewTabs.Saved.MouseButton1Click:Connect(function()
        showView("Saved")
    end)
    viewTabs.Export.MouseButton1Click:Connect(function()
        showView("Export")
    end)
    -- generating a code shows it in the code box
    GenerateCodeBtn.MouseButton1Click:Connect(function()
        showView("Export")
    end)
    showView("Saved")
end

