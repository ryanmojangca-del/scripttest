--// DARK RED LIVE GRADIENT BORDER
--// Glow OUTSIDE the rounded border (separate frame behind MainFrame that mirrors
--// its position/size/rotation), plus a bright gradient edge line and a small inner glow.
--// The gradient slowly rotates and the glow gently pulses.
do
    local seq = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(110, 0, 10)),
        ColorSequenceKeypoint.new(0.25, Color3.fromRGB(255, 24, 30)),
        ColorSequenceKeypoint.new(0.5, Color3.fromRGB(80, 0, 8)),
        ColorSequenceKeypoint.new(0.75, Color3.fromRGB(215, 12, 22)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(110, 0, 10))
    })

    local gradients = {}
    _G.KAMUI_BorderGradients = gradients
    _G.KAMUI_BorderSeq = seq
    local strokes = {}
    local baseT = {}
    local INNER, OUTER = 3, 5
    local WHITE = Color3.fromRGB(255, 255, 255)

    local function addGradient(stroke)
        local g = Instance.new("UIGradient")
        g.Color = seq
        g.Parent = stroke
        gradients[#gradients + 1] = g
    end

    local function addLayer(parent, offset, thickness, transparency, radius)
        local layer = Instance.new("Frame")
        layer.BackgroundTransparency = 1
        layer.BorderSizePixel = 0
        layer.Active = false
        layer.ZIndex = 0
        layer.Position = UDim2.new(0, offset, 0, offset)
        layer.Size = UDim2.new(1, -(offset * 2), 1, -(offset * 2))
        layer.Parent = parent

        local c = Instance.new("UICorner")
        c.CornerRadius = UDim.new(0, math.max(radius, 2))
        c.Parent = layer

        local st = Instance.new("UIStroke")
        st.Color = WHITE
        st.Thickness = thickness
        st.Transparency = transparency
        st.Parent = layer

        addGradient(st)
        strokes[#strokes + 1] = st
        baseT[#baseT + 1] = transparency
    end

    -- bright edge line on the border itself
    GlowUIStroke.Color = WHITE
    GlowUIStroke.Thickness = 1.5
    GlowUIStroke.Transparency = 0.05
    addGradient(GlowUIStroke)

    -- inner glow (inside the GUI)
    for k = 1, INNER do
        addLayer(MainFrame, k, 1.5, 0.3 + ((k - 1) * 0.15), 16 - k)
    end

    -- outer glow (outside the GUI): a frame behind MainFrame that follows it
    local holder = Instance.new("Frame")
    holder.Name = "KamuiOuterGlow"
    holder.BackgroundTransparency = 1
    holder.BorderSizePixel = 0
    holder.Active = false
    holder.ZIndex = 0
    holder.ClipsDescendants = false
    holder.Parent = MainFrame.Parent

    local holderCorner = Instance.new("UICorner")
    holderCorner.CornerRadius = UDim.new(0, 16)
    holderCorner.Parent = holder

    -- mirror the window's UIScale so the outer glow stays aligned
    local windowScale = MainFrame:FindFirstChild("WindowScale")
    local holderScale = Instance.new("UIScale")
    holderScale.Parent = holder

    for k = 1, OUTER do
        addLayer(holder, -k, 2, 0.22 + ((k - 1) * 0.14), 16 + k)
    end

    local function sync()
        holder.AnchorPoint = MainFrame.AnchorPoint
        holder.Position = MainFrame.Position
        holder.Size = MainFrame.Size
        holder.Rotation = MainFrame.Rotation
        holder.Visible = MainFrame.Visible
        if windowScale then
            holderScale.Scale = windowScale.Scale
        end
    end

    sync()

    for _, prop in ipairs({"AnchorPoint", "Position", "Size", "Rotation", "Visible"}) do
        MainFrame:GetPropertyChangedSignal(prop):Connect(sync)
    end
    if windowScale then
        windowScale:GetPropertyChangedSignal("Scale"):Connect(sync)
    end

    local conn
    conn = RunService.RenderStepped:Connect(function()
        if not isCurrent() or not MainFrame or not MainFrame.Parent then
            conn:Disconnect()
            holder:Destroy()
            return
        end

        if not ScreenGui.Enabled then
            return
        end

        local t = os.clock()
        local rot = (t * 60) % 360
        local pulse = 0.5 + (0.5 * math.sin(t * 2))

        for _, g in ipairs(gradients) do
            g.Rotation = rot
        end

        GlowUIStroke.Transparency = 0.05 + (0.1 * pulse)

        for i, st in ipairs(strokes) do
            st.Transparency = math.clamp(baseT[i] - (0.12 * pulse), 0, 1)
        end
    end)
end

