--// ============================================================
--// GUI TAB (Extras): accent color picker, rainbow mode, font dropdown
--// Recolors only the RED accent (never the black surfaces). Everything lives in
--// this function, so no top-level locals are added. Saved in KAMUI_GUI.json.
--// ============================================================
_G.KAMUI_BuildGUI = function(UI)
    local G = _G.KAMUI_GuiTab
    local page = G and G.Page
    if not page then
        return
    end
    UI.setupPage(page)
    local PANEL, CHIP, LINE, HEAD = UI.PANEL, UI.CHIP, UI.LINE, UI.HEAD
    local WHITE = Color3.fromRGB(255, 255, 255)
    local OFF_TRACK = Color3.fromRGB(42, 42, 45)
    local OFF_KNOB = Color3.fromRGB(189, 184, 184)
    local FILE = "KAMUI_GUI.json"

    local function mk(class, props, parent)
        local o = UI.make(class, props, parent)
        o:SetAttribute("KamuiSkinned", true) -- keep the old skin pass away from these
        return o
    end

    ------------------------------------------------------------------ accent engine
    --// every red the script uses (hardcoded or via THEME). Skill colors (255,0,0) are NOT here.
    local FAMILY = {
        { 52, 8, 12 }, { 58, 10, 15 }, { 80, 0, 8 }, { 90, 18, 24 }, { 92, 12, 18 }, { 100, 12, 20 },
        { 110, 0, 10 }, { 205, 18, 20 }, { 215, 12, 22 }, { 235, 24, 22 }, { 240, 30, 24 }, { 255, 24, 30 }
    }
    local function key(c)
        return math.floor(c.R * 255 + 0.5) * 65536 + math.floor(c.G * 255 + 0.5) * 256 + math.floor(c.B * 255 + 0.5)
    end
    local ORIG, CUR = {}, {}
    for _, t in ipairs(FAMILY) do
        local c = Color3.fromRGB(t[1], t[2], t[3])
        local h, s, v = c:ToHSV()
        ORIG[key(c)] = { h = h, s = s, v = v }
    end
    local BASE = Color3.fromRGB(205, 18, 20)
    local baseH, baseS, baseV = BASE:ToHSV()
    local K_RED = key(BASE)
    local K_BRIGHT = key(Color3.fromRGB(240, 30, 24))
    local K_DARK = key(Color3.fromRGB(52, 8, 12))

