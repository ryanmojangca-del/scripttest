--// FLOATER MODE (V1 and V2)
--// "Solitude" magnet: after the Magnet delay the player is teleported onto the target (2 studs above
--// it), the dash velocity is removed, sideways drift is stopped and a short magnet pull toward the
--// target runs for 0.2s.
--// It is started by executeLethal right after the dash fires, so it works the same in PC mode
--// (after Delay) and in Touch mode (no Delay): the Magnet delay always counts from the dash.
--// Everything except FloaterMode / startFloaterMode lives inside this do-block so no new
--// top-level locals are added (the script is close to Luau's 200 local limit).
local FloaterMode = false
local startFloaterMode
do
    local MAX_START_RANGE = 12  -- how far away (horizontal studs) the target can be for the teleport to happen; change this number to adjust (height is ignored, so jumping does not block it)
    local PULL_TIME = 0.2       -- seconds the magnet pull lasts
    local PULL_STRENGTH = 50    -- studs/s the pull aims for
    local PULL_SMOOTH = 0.65    -- how fast the velocity is blended toward the pull (0..1)
    local pullConn = nil
    local runId = 0

    local function stopPull()
        if pullConn then
            pullConn:Disconnect()
            pullConn = nil
        end
    end

    local function startMagnetPull(root, targetRoot)
        stopPull()
        local startTime = os.clock()
        pullConn = RunService.Heartbeat:Connect(function()
            if not isCurrent()
                or not root.Parent
                or not targetRoot.Parent
                or os.clock() - startTime >= PULL_TIME then
                stopPull()
                return
            end
            local currentPos = root.Position
            local flatTarget = Vector3.new(targetRoot.Position.X, currentPos.Y, targetRoot.Position.Z)
            local direction = flatTarget - currentPos
            if direction.Magnitude > 1 then
                local desiredVel = direction.Unit * PULL_STRENGTH
                local currentVel = root.AssemblyLinearVelocity
                local newVel = currentVel:Lerp(desiredVel, PULL_SMOOTH)
                root.AssemblyLinearVelocity = Vector3.new(newVel.X * 0.85, currentVel.Y, newVel.Z * 0.85)
            end
        end)
    end

    --// Call right after the dash has been fired: waits the Magnet delay (counted from the dash fire),
    --// then runs the Solitude teleport + magnet pull.
    startFloaterMode = function(targetTorso)
        if not FloaterMode then
            return
        end
        local char = player.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not root or not targetTorso or not targetTorso.Parent then
            return
        end
        local model = targetTorso.Parent
        local targetRoot = model:FindFirstChild("HumanoidRootPart") or targetTorso
        local flat = Vector3.new(root.Position.X - targetRoot.Position.X, 0, root.Position.Z - targetRoot.Position.Z)
        --// The teleport works up to MAX_START_RANGE studs away (12), no matter what the Dash range is.
        if flat.Magnitude > MAX_START_RANGE then
            return
        end
        runId = runId + 1
        local myRun = runId
        task.spawn(function()
            local delay = math.clamp(tonumber(Config.MagnetDelay) or 0, 0, 1)
            if delay > 0 then
                task.wait(delay)
            end
            if myRun ~= runId
                or not isCurrent()
                or not FloaterMode
                or not root.Parent
                or not targetRoot.Parent then
                return
            end
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health <= 0 then
                return
            end
            -- teleport 2 studs above the target, keeping the current facing direction
            local pos = targetRoot.Position + Vector3.new(0, 2, 0)
            pcall(function()
                root.CFrame = CFrame.new(pos, pos + root.CFrame.LookVector)
            end)
            -- drop the dash velocity so the dash does not carry you past the target
            for _, child in ipairs(root:GetChildren()) do
                if child:IsA("BodyVelocity") or child:IsA("LinearVelocity") then
                    child:Destroy()
                end
            end
            local vel = root.AssemblyLinearVelocity
            if Config.LethalMode == "Draw" then
                vel = Vector3.new(0, 0, 0) -- Draw mode: no leftover vertical speed (no flying into the sky)
                if _G.KAMUI_Draw then
                    _G.KAMUI_Draw.released = true
                end
            end
            root.AssemblyLinearVelocity = Vector3.new(0, vel.Y, 0)
            startMagnetPull(root, targetRoot)
        end)
    end
end

--// FORCE CANCEL
local function forceCancel()
    clip()
    local char = player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if hrp then
        for _, obj in pairs(hrp:GetChildren()) do
            if obj:IsA("BodyVelocity")
                or obj:IsA("LinearVelocity")
                or obj:IsA("Attachment")
                or obj:IsA("BodyAngularVelocity") then
                obj:Destroy()
            end
        end
        hrp.AssemblyLinearVelocity = Vector3.zero
    end
end

--// COOLDOWN
local function startCooldown(duration)
    if not isCurrent() or isCooldown then
        return
    end
    isCooldown = true
    if MainFrame and CooldownBar and CooldownFill then
        CooldownBar.Visible = true
        CooldownFill.Size = UDim2.new(1, 0, 1, 0)
        local tween = TweenService:Create(
            CooldownFill,
            TweenInfo.new(duration, Enum.EasingStyle.Linear),
            { Size = UDim2.new(0, 0, 1, 0) }
        )
        tween:Play()
        task.delay(duration, function()
            isCooldown = false
            if CooldownBar then
                CooldownBar.Visible = false
            end
        end)
    else
        task.wait(duration)
        isCooldown = false
    end
end

--// TARGET DETECTION
--// ignoreHeight = true (Touch Mode presses): only the HORIZONTAL distance counts, so being
--// in the air (jumping) can never make the target "too far away" and cancel the dash.
local function getTorsoTarget(ignoreHeight)
    local char = player.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then
        return nil
    end
    local rootPos = char.HumanoidRootPart.Position
    local range = Config.DashRange
    local MAX_VERTICAL = 60 -- studs above/below that still count when ignoring height
    local radius = range
    if ignoreHeight then
        radius = math.sqrt(range * range + MAX_VERTICAL * MAX_VERTICAL)
    end
    local params = OverlapParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {char}
    local parts = Workspace:GetPartBoundsInRadius(rootPos, radius, params)
    local target = nil
    local dist = range
    local seen = {}
    for _, part in pairs(parts) do
        local model = part:FindFirstAncestorOfClass("Model")
        if model
            and not seen[model]
            and model:FindFirstChild("Humanoid")
            and model ~= char then
            seen[model] = true
            local torso = model:FindFirstChild("Torso")
                or model:FindFirstChild("UpperTorso") or model:FindFirstChild("HumanoidRootPart")
            if torso then
                local delta = rootPos - torso.Position
                local d
                if ignoreHeight then
                    if math.abs(delta.Y) <= MAX_VERTICAL then
                        d = Vector3.new(delta.X, 0, delta.Z).Magnitude
                    else
                        d = math.huge
                    end
                else
                    d = delta.Magnitude
                end
                if d < dist then
                    dist = d
                    target = torso
                end
            end
        end
    end
    return target
end

--// CAM SMOOTH
local isExecuting = false
local camSmoothConn = nil
local camSmoothAttached = false
local camSmoothPrevSubject = nil
local camSmoothDashStart = 0

local function stopCamSmooth()
    if camSmoothConn then
        camSmoothConn:Disconnect()
        camSmoothConn = nil
    end
    if camSmoothAttached then
        pcall(function()
            local char = player.Character
            local cam = workspace.CurrentCamera
            if cam then
                cam.CameraType = Enum.CameraType.Custom
                cam.CameraSubject = camSmoothPrevSubject or (char and char:FindFirstChildOfClass("Humanoid"))
            end
        end)
    end
    camSmoothAttached = false
    camSmoothPrevSubject = nil
    if _G.KAMUI_Kiba and _G.KAMUI_Kiba.camStop then
        _G.KAMUI_Kiba.camStop()
    end
end

local function updateCamSmooth()
    stopCamSmooth()
    if not Config.CamSmooth then
        return
    end
    camSmoothConn = RunService.RenderStepped:Connect(function()
        if not isCurrent() then
            stopCamSmooth()
            return
        end
        local char = player.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local cam = workspace.CurrentCamera
        if not root or not cam then
            return
        end
        local elapsed = os.clock() - camSmoothDashStart
        local inSmoothWindow = isExecuting
            and elapsed >= Config.CamSmoothDelay and elapsed <= (Config.CamSmoothDelay + Config.CamDuration)
        if not inSmoothWindow then
            if camSmoothAttached then
                pcall(function()
                    cam.CameraType = Enum.CameraType.Custom
                    cam.CameraSubject = camSmoothPrevSubject or char:FindFirstChildOfClass("Humanoid")
                end)
                camSmoothAttached = false
            end
            return
        end
        if not camSmoothAttached then
            camSmoothPrevSubject = cam.CameraSubject
            camSmoothAttached = true
        end
        pcall(function()
            cam.CameraType = Enum.CameraType.Attach
            cam.CameraSubject = root
        end)
    end)
end

--// DRAW MODE: follows the pattern drawn in Settings (GUI box with YOU / TARGET).
--// The pattern is stored normalised: a = distance along YOU->TARGET (1 = the target),
--// b = sideways (positive = right). Each frame the path is rebuilt from where the dash started
--// to where the target is NOW, so the drawn shape always ends on the target.
_G.KAMUI_Draw = _G.KAMUI_Draw or { pts = {} }
_G.KAMUI_Draw.time = 0.4 -- fixed: the drawn pattern is the only dash control
_G.KAMUI_Draw.follow = function(root, torso, origin, elapsed)
    local D = _G.KAMUI_Draw
    local pts = D.pts
    local n = #pts
    if D.released then
        return -- Floater teleported you onto the target: the path stops controlling
    end
    local T = D.time
    local p = math.clamp(elapsed / T, 0, 1)
    local a, b = p, 0 -- no pattern drawn: straight line to the target
    if n >= 2 then
        local f = p * (n - 1)
        local i = math.floor(f)
        local fr = f - i
        local p1 = pts[i + 1]
        local p2 = pts[math.min(i + 2, n)]
        a = p1[1] + (p2[1] - p1[1]) * fr
        b = p1[2] + (p2[2] - p1[2]) * fr
    end
    local tp = torso.Position
    local axis = Vector3.new(tp.X - origin.X, 0, tp.Z - origin.Z)
    local dist = axis.Magnitude
    if dist < 0.5 then
        return
    end
    local fwd = axis.Unit
    local right = fwd:Cross(Vector3.new(0, 1, 0))
    local goal = origin + fwd * (a * dist) + right * (b * dist)
    local rp = root.Position
    local delta = Vector3.new(goal.X - rp.X, 0, goal.Z - rp.Z)
    local h = Vector3.new(0, 0, 0)
    if delta.Magnitude > 0.01 then
        h = delta.Unit * math.min(delta.Magnitude / 0.03, 160)
    end
    for _, c in ipairs(root:GetChildren()) do
        if c:IsA("BodyVelocity") or c:IsA("LinearVelocity") then
            c:Destroy()
        end
    end
    --// Jump power becomes a small arc over the dash (peak = Jump * T / 4) that always lands back at the
    --// start height, so it can never carry you up into the sky
    local peak = (tonumber(Config.LethalJump) or 0) * T / 4
    local goalY = origin.Y + peak * 4 * p * (1 - p)
    local vy = math.clamp((goalY - rp.Y) / 0.05, -80, 80)
    root.AssemblyLinearVelocity = Vector3.new(h.X, vy, h.Z)
    root.CFrame = CFrame.lookAt(rp, Vector3.new(tp.X, rp.Y, tp.Z))
end

--// Profile code support: the drawn pattern travels inside profile codes as "a,b;a,b;..." (max 40 points).
_G.KAMUI_Draw.encode = function()
    local pts = _G.KAMUI_Draw.pts
    local n = #pts
    if n < 2 then
        return ""
    end
    local function fmt(x)
        local t = string.format("%.3f", x):gsub("0+$", ""):gsub("%.$", "")
        return t
    end
    local m = math.min(n, 40)
    local out = {}
    for i = 1, m do
        local q = pts[m == 1 and 1 or math.floor(1 + (i - 1) * (n - 1) / (m - 1) + 0.5)]
        out[i] = fmt(q[1]) .. "," .. fmt(q[2])
    end
    return table.concat(out, ";")
end
_G.KAMUI_Draw.decode = function(str)
    local pts = {}
    if type(str) ~= "string" then
        return pts
    end
    for pair in string.gmatch(str, "[^;]+") do
        local a, b = string.match(pair, "^(%-?[%d%.]+),(%-?[%d%.]+)$")
        a, b = tonumber(a), tonumber(b)
        if a and b and #pts < 200 then
            pts[#pts + 1] = { a, b }
        end
    end
    if #pts < 2 then
        return {}
    end
    return pts
end

--// KIBA MODE: dash in place. The dash plays where you stand (its push is removed); after the
--// "Magnet delay" (the moment the dash connects) you are put inside the opponent's torso looking
--// straight up, held there briefly, then stood upright again.
_G.KAMUI_Kiba = { hold = 0.5, pitch = 100 }
_G.KAMUI_Kiba.total = function()
    return math.clamp(tonumber(Config.KibaDelay) or 0, 0, 0.5) + _G.KAMUI_Kiba.hold
end
--// Own camera for Kiba: the camera keeps its angle and only its focus point glides to your character, so the
--// teleport and the tilt never snap the view (Cam Smooth's "Attach" camera copies the character's rotation).
_G.KAMUI_Kiba.camStart = function(root)
    local K = _G.KAMUI_Kiba
    local cam = workspace.CurrentCamera
    if not cam or K.cam then
        return
    end
    local off = cam.CFrame.Position - root.Position
    local rot = cam.CFrame - cam.CFrame.Position
    local focus = root.Position
    K.camPrev = cam.CameraType
    cam.CameraType = Enum.CameraType.Scriptable
    K.cam = RunService.RenderStepped:Connect(function(dt)
        if not isCurrent() or not root.Parent then
            K.camStop()
            return
        end
        focus = focus:Lerp(root.Position, math.clamp(dt * 14, 0, 1))
        cam.CFrame = CFrame.new(focus + off) * rot
    end)
end
_G.KAMUI_Kiba.camStop = function()
    local K = _G.KAMUI_Kiba
    if K.cam then
        K.cam:Disconnect()
        K.cam = nil
        local cam = workspace.CurrentCamera
        local char = player.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if cam then
            pcall(function()
                local t = K.camPrev
                if t == nil or t == Enum.CameraType.Scriptable or t == Enum.CameraType.Attach then
                    t = Enum.CameraType.Custom
                end
                cam.CameraType = t
                if hum then
                    cam.CameraSubject = hum
                end
            end)
        end
    end
end
_G.KAMUI_Kiba.step = function(root, torso, startPos, elapsed)
    local K = _G.KAMUI_Kiba
    local connect = math.clamp(tonumber(Config.KibaDelay) or 0, 0, 0.5)
    local tp = torso.Position
    local flat = Vector3.new(tp.X - root.Position.X, 0, tp.Z - root.Position.Z)
    if flat.Magnitude < 0.01 then
        flat = Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z)
    end
    if flat.Magnitude < 0.01 then
        flat = Vector3.new(0, 0, -1)
    end
    flat = flat.Unit
    for _, c in ipairs(root:GetChildren()) do
        if c:IsA("BodyVelocity") or c:IsA("LinearVelocity") then
            c:Destroy()
        end
    end
    local vel = root.AssemblyLinearVelocity
    if elapsed < connect then
        --// dash in place: stay where you are, face the opponent
        root.AssemblyLinearVelocity = Vector3.new(0, vel.Y, 0)
        root.CFrame = CFrame.lookAt(Vector3.new(startPos.X, root.Position.Y, startPos.Z), Vector3.new(tp.X, root.Position.Y, tp.Z))
    elseif elapsed < K.total() then
        --// connected: inside the opponent's torso, looking up
        root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        root.CFrame = CFrame.lookAt(tp, tp + flat) * CFrame.Angles(math.rad(K.pitch), 0, 0)
    else
        root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        root.CFrame = CFrame.lookAt(root.Position, root.Position + flat)
    end
end

--// LETHAL EXECUTION

--// forced = true when you press the Touch Mode button / keybind: it ignores height (jumping)
--// and clears a stuck "still executing" state, so a press always goes through.
local function executeLethal(forced)
    forced = forced == true
    if forced
        and isExecuting
        and os.clock() - (_G.KAMUI_ExecStart or 0) > 1.6 then
        isExecuting = false -- the last run can never last this long: it is stuck, reset it
    end
    if not isCurrent() or isExecuting or isCooldown then
        return
    end
    if not Config.Enabled or not Config.LethalEnabled then
        return
    end
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChild("Humanoid")
    if not root or not hum then
        return
    end
    local torso = getTorsoTarget(forced)
    if not torso then
        clip()
        return
    end
    isExecuting = true
    _G.KAMUI_ExecStart = os.clock()
    if not Config.TouchMode then
        task.wait(Config.LethalDelay)
    end
    if not isCurrent() then
        isExecuting = false
        return
    end
    if Config.LethalMode ~= "Draw" and Config.LethalMode ~= "Kiba" then -- Draw / Kiba: no jump boost
        root.AssemblyLinearVelocity = Vector3.new(root.AssemblyLinearVelocity.X, Config.LethalJump, root.AssemblyLinearVelocity.Z)
    end
    isNoclipping = true
    fireDash()
    --// Cam Smooth (V1 and V2): only attaches the camera to your root, it never touches the dash
    camSmoothDashStart = os.clock()
    if Config.LethalMode == "Kiba" then
        _G.KAMUI_Kiba.camStart(root)
    else
        updateCamSmooth()
    end
    --// Floater (V1 and V2): Magnet delay counts from here, in PC and Touch mode
    if Config.LethalMode ~= "Kiba" then
        startFloaterMode(torso)
    end
    local startT = tick()
    local flipped = false
    local forwardDir = (torso.Position - root.Position).Unit
    local sideVec = Vector3.new(-forwardDir.Z, 0, forwardDir.X)
    local bav = nil
    if Config.LethalMode == "V1" then
        bav = Instance.new("BodyAngularVelocity")
        bav.MaxTorque = Vector3.new(0, 1000000, 0)
        bav.P = 15000
        bav.Parent = root
    end
    local drawOrigin = root.Position
    _G.KAMUI_Draw.released = false
    local conn
    conn = RunService.Heartbeat:Connect(function()
        if not isCurrent()
            or not torso
            or not torso.Parent
            or not root
            or not root.Parent then
            if bav then
                bav:Destroy()
            end
            clip()
            isExecuting = false
            stopCamSmooth()
            if conn then
                conn:Disconnect()
            end
            return
        end
        local elapsed = tick() - startT
        local torsoPos = torso.Position
        local rootPos = root.Position
        hum.AutoRotate = false
        if Config.LethalMode == "V1" then
            local angle = (elapsed / 0.45) * (math.pi / 1.5)
            local radius = Config.LethalAccuracy * (1 - math.clamp(elapsed / 0.45, 0, 1))
            local targetLookPos = torsoPos + (sideVec * math.cos(angle) + forwardDir * math.sin(angle)) * radius
            local lookAtCF = CFrame.lookAt(rootPos, Vector3.new(targetLookPos.X, rootPos.Y, targetLookPos.Z))
            local relativeCF = root.CFrame:Inverse() * lookAtCF
            local _, y, _ = relativeCF:ToEulerAnglesXYZ()
            if bav and bav.Parent then
                bav.AngularVelocity = Vector3.new(0, y * 30, 0)
            end
        elseif Config.LethalMode == "Draw" then
            _G.KAMUI_Draw.follow(root, torso, drawOrigin, elapsed)
        elseif Config.LethalMode == "Kiba" then
            _G.KAMUI_Kiba.step(root, torso, drawOrigin, elapsed)
        else
            if elapsed >= Config.LethalAccuracy
                and not flipped then
                root.CFrame = root.CFrame * CFrame.Angles(0, math.pi, 0)
                flipped = true
            end
        end
        local distXZ = (Vector2.new(rootPos.X, rootPos.Z) - Vector2.new(torsoPos.X, torsoPos.Z)).Magnitude
        if Config.LethalMode ~= "Draw"
            and Config.LethalMode ~= "Kiba"
            and Config.CancelEnabled
            and elapsed > Config.LethalCancelDelay then
            if distXZ < 2.2 then
                if bav then
                    bav:Destroy()
                end
                forceCancel()
                isExecuting = false
                stopCamSmooth()
                conn:Disconnect()
                return
            end
        end
        if not Config.Enabled
            or elapsed > 1.5
            or (Config.LethalMode == "Draw" and elapsed > _G.KAMUI_Draw.time + 0.12)
            or (Config.LethalMode == "Kiba" and elapsed > _G.KAMUI_Kiba.total() + 0.05) then
            if bav then
                bav:Destroy()
            end
            clip()
            isExecuting = false
            stopCamSmooth()
            conn:Disconnect()
            return
        end
    end)
end

