    --// typed values
    local function parseHex(t)
        t = t:gsub("%s", ""):gsub("^#", "")
        if #t == 3 then
            t = t:sub(1, 1):rep(2) .. t:sub(2, 2):rep(2) .. t:sub(3, 3):rep(2)
        end
        if #t ~= 6 or t:find("%X") then
