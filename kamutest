        --// the list of features that are on right now: { id, cat (tab order), text, idx }
        local function entries()
            local out = {}
            local CC = _G.KAMUI_Combat or {}
            local M = _G.KAMUI_Movement or {}
            local wantKeys = CFG.Details == "Keys" or CFG.Details == "Both"
            local wantVals = CFG.Details == "Values" or CFG.Details == "Both"
            local function add(id, cat, on, text, key, val)
                if not on or hidden[id] then
                    return
                end
                if wantVals and val then
                    text = text .. " (" .. val .. ")"
                end
                if wantKeys and key then
                    text = text .. " [" .. tostring(key) .. "]"
                end
                if CFG.Suffix ~= "None" then
                    text = text .. " " .. CFG.Suffix
                end
                out[#out + 1] = { id = id, cat = cat, text = caseText(text), idx = #out + 1 }
            end
            add("dash", 1, Config.Enabled, "Dash (" .. tostring(Config.LethalMode) .. ")", Config.Keybind, nil)
            add("m1catch", 2, CC.Enabled, "M1 catch", nil, CC.Range and fmtNum(CC.Range))
            add("aimbot", 2, CC.Aimbot, "Aimbot", CC.AimKey, (CC.Smooth and CC.Smooth > 0) and ("smooth " .. fmtNum(CC.Smooth)) or nil)
            add("block", 2, CC.Block, "Auto block", nil, CC.BlockRange and fmtNum(CC.BlockRange))
            add("reach", 2, CC.Reach, "M1 reach", nil, CC.ReachStuds and fmtNum(CC.ReachStuds))
            add("dashmult", 3, M.Enabled and M.Distance ~= 1, "Dash multiplier", nil, M.Distance and string.format("%.2fx", M.Distance))
            add("nosidecd", 3, M.NoSideCD, "No side dash cooldown")
            add("nostun", 3, M.NoStun, "No stun")
            add("nofatigue", 3, M.NoFatigue, "No fatigue")
            add("walkjump", 3, M.SJEnabled, "WalkSpeed / Jump height", nil, M.WalkSpeed and (fmtNum(M.WalkSpeed) .. " / " .. fmtNum(M.JumpPower)))
            add("fps", 4, potatoEnabled, "FPS boost")
            add("death", 4, deathCounterEnabled, "Death counter")
            add("headless", 4, headlessKorbloxEnabled, "Headless & Korblox")
            if #out == 0 and CFG.Draggable and not CFG.Title then
                out[1] = { id = "__preview", cat = 0, text = caseText("Arraylist"), idx = 1 }
            end
            if CFG.Title then
                table.insert(out, 1, { id = "__title", cat = -1, text = "KAMUI", idx = 0, title = true })
            end
            return out
        end

        local function accentAt(offset)
            if St.rainbow then
                return Color3.fromHSV((St.phase + offset) % 1, math.max(St.s, 0.7), math.max(St.v, 0.85))
            end
            return Color3.fromHSV(St.h, St.s, St.v)
        end

        ---------------------------------------------------------------- rows
        local rows = {}

        --// fade / slide state of a row: r.vis.Value goes 0 -> 1 (in) or 1 -> 0 (out)
        local function updateVis(r)
            local v = r.vis.Value
            r.slot.Size = UDim2.new(0, r.w, 0, math.floor(r.h * v + 0.5))
            r.fr.Position = UDim2.new(0, r.dir * (1 - v) * (r.w + 24), 0, 0)
            r.fr.BackgroundTransparency = (CFG.BG and not r.title) and (1 - (1 - CFG.BGTrans) * v) or 1
            r.label.TextTransparency = 1 - v
            r.label.TextStrokeTransparency = r.title and (1 - 0.65 * v) or (CFG.Shadow and (1 - 0.45 * v) or 1)
            r.bar.BackgroundTransparency = 1 - v
            r.stroke.Transparency = 1 - (1 - r.strokeT) * v
        end

        local function tweenVis(r, goal, done)
            if r.tween then
                r.tween:Cancel()
                r.tween = nil
            end
            if not CFG.Anim then
                r.vis.Value = goal
                if done then
                    done()
                end
                return
            end
            local t = TweenService:Create(r.vis, TweenInfo.new(0.22 / CFG.AnimSpeed, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Value = goal })
            r.tween = t
            t.Completed:Connect(function(state)
                if state == Enum.PlaybackState.Completed and done then
                    done()
                end
            end)
            t:Play()
        end

        --// applies every setting to one row (size, font, bar, outline...)
        local function styleRow(r)
            local size, font = CFG.Size + (r.title and 10 or 0), curFont(r.title)
            local right, barOn = isRight(), CFG.Bar ~= "Off" and not r.title
            local th = barOn and CFG.BarThick or 0
            local li = CFG.Pad + ((CFG.Bar == "Left") and th or 0)
            local ri = CFG.Pad + ((CFG.Bar == "Right") and th or 0)
            local tw = TextService:GetTextSize(r.text, size, font, Vector2.new(1000, 100)).X
            r.w = math.ceil(tw) + li + ri
            r.h = size + 6
            r.dir = right and 1 or -1
            r.fr.Size = UDim2.new(0, r.w, 0, r.h)
            r.fr.Active = CFG.Draggable
            r.fr.ClipsDescendants = CFG.Radius > 0
            r.corner.CornerRadius = UDim.new(0, CFG.Radius)
            if r.title then
                r.stroke.Enabled, r.strokeT = false, 1
            elseif CFG.Outline == "Outline" then
                r.stroke.Enabled, r.stroke.Thickness, r.strokeT = true, 1, 0.15
            elseif CFG.Outline == "Glow" then
                r.stroke.Enabled, r.stroke.Thickness, r.strokeT = true, 3, 0.65
            else
                r.stroke.Enabled, r.strokeT = false, 1
            end
            local lb = r.label
            lb.Font = font
            lb.TextSize = size
            lb.Text = r.text
            lb.Position = UDim2.new(0, li, 0, 0)
            lb.Size = UDim2.new(1, -(li + ri), 1, 0)
            lb.TextXAlignment = right and Enum.TextXAlignment.Right or Enum.TextXAlignment.Left
            local inset = math.floor(CFG.Radius * 0.6)
            local bar = r.bar
            bar.Visible = barOn
            bar.Size = UDim2.new(0, th, 1, -2 * inset)
            if CFG.Bar == "Left" then
                bar.AnchorPoint, bar.Position = Vector2.new(0, 0), UDim2.new(0, 0, 0, inset)
            else
                bar.AnchorPoint, bar.Position = Vector2.new(1, 0), UDim2.new(1, 0, 0, inset)
            end
            r.ver = ver
            updateVis(r)
        end

        local drag = nil
        local function makeRow(id)
            local slot = Instance.new("Frame")
            slot.BackgroundTransparency = 1
            slot.BorderSizePixel = 0
            slot.Size = UDim2.new(0, 10, 0, 0)
            local fr = Instance.new("Frame")
            fr.BackgroundColor3 = Color3.fromRGB(8, 8, 9)
            fr.BorderSizePixel = 0
            fr:SetAttribute("KamuiSkinned", true)
            fr.Parent = slot
            local corner = Instance.new("UICorner")
            corner.Parent = fr
            local stroke = Instance.new("UIStroke")
            stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
            stroke.Enabled = false
            stroke.Parent = fr
            local lb = Instance.new("TextLabel")
            lb.BackgroundTransparency = 1
            lb.TextStrokeColor3 = Color3.new(0, 0, 0)
            lb:SetAttribute("KamuiSkinned", true)
            lb:SetAttribute("KamuiKeepFont", true)
            lb.Parent = fr
            local bar = Instance.new("Frame")
            bar.BorderSizePixel = 0
            bar:SetAttribute("KamuiSkinned", true)
            bar.Parent = fr
            local vis = Instance.new("NumberValue")
            vis.Parent = slot
            local r = {
                id = id, slot = slot, fr = fr, corner = corner, stroke = stroke, label = lb, bar = bar, vis = vis,
                text = "", cat = 0, idx = 0, w = 10, h = 18, dir = 1, strokeT = 1, ver = -1, leaving = false
            }
            vis.Changed:Connect(function()
                updateVis(r)
            end)
            fr.InputBegan:Connect(function(i)
                if CFG.Draggable and (i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch) then
                    drag = { input = i, sx = i.Position.X, sy = i.Position.Y, ox = CFG.OffX, oy = CFG.OffY }
                end
            end)
            slot.Parent = holder
            return r
        end

        myConns[#myConns + 1] = UIS.InputChanged:Connect(function(i)
            if not drag or not isCurrent() then
                return
            end
            if i == drag.input or (i.UserInputType == Enum.UserInputType.MouseMovement and drag.input.UserInputType == Enum.UserInputType.MouseButton1) then
                local dx, dy = i.Position.X - drag.sx, i.Position.Y - drag.sy
                CFG.OffX = math.floor(math.clamp(drag.ox + (isRight() and -dx or dx), RANGE.OffX[1], RANGE.OffX[2]) + 0.5)
                CFG.OffY = math.floor(math.clamp(drag.oy + (isBottom() and -dy or dy), RANGE.OffY[1], RANGE.OffY[2]) + 0.5)
                placeHolder()
            end
        end)
        myConns[#myConns + 1] = UIS.InputEnded:Connect(function(i)
            if drag and (i == drag.input or i.UserInputType == Enum.UserInputType.MouseButton1) then
                drag = nil
                saveSoon()
                repaintAll()
            end
        end)

        ---------------------------------------------------------------- update loop
        local acc, acc2 = 0, 0
        local conn
        conn = RunService.Heartbeat:Connect(function(dt)
            if not isCurrent() then
                conn:Disconnect()
                for _, c in ipairs(myConns) do
                    pcall(function()
                        c:Disconnect()
                    end)
                end
                pcall(function()
                    gui:Destroy()
                end)
                return
            end
            acc += dt
            if acc < 0.05 then
                return
            end
            acc2 += acc
            acc = 0
            if acc2 >= 0.15 then
                acc2 = 0 -- keep the controls' colors in step with the accent / rainbow
                repaintAll()
            end
            holder.Visible = _G.KAMUI_ArraylistOn == true
            if not holder.Visible then
                return
            end
            placeHolder()

            local want, list, titleRow = {}, {}, nil
            for _, e in ipairs(entries()) do
                want[e.id] = true
                local r = rows[e.id]
                if not r then
                    r = makeRow(e.id)
                    rows[e.id] = r
                    r.title = e.title
                    r.text = e.text
                    styleRow(r)
                    tweenVis(r, 1)
                else
                    if r.leaving then
                        r.leaving = false
                        tweenVis(r, 1)
                    end
                    if r.text ~= e.text or r.ver ~= ver then
                        r.text = e.text
                        styleRow(r)
                    end
                end
                r.cat, r.idx = e.cat, e.idx
                if e.title then
                    titleRow = r
                else
                    list[#list + 1] = r
                end
            end
            for id, r in pairs(rows) do
                if not want[id] and not r.leaving then
                    r.leaving = true
                    tweenVis(r, 0, function()
                        r.slot:Destroy()
                        if rows[id] == r then
                            rows[id] = nil
                        end
                    end)
                end
            end

            local mode = CFG.Sort
            table.sort(list, function(a, b)
                if mode == "Longest" then
                    if a.w ~= b.w then
                        return a.w > b.w
                    end
                elseif mode == "Shortest" then
                    if a.w ~= b.w then
                        return a.w < b.w
                    end
                elseif mode == "A-Z" then
                    local x, y = a.text:lower(), b.text:lower()
                    if x ~= y then
                        return x < y
                    end
                elseif mode == "By tab" then
                    if a.cat ~= b.cat then
                        return a.cat < b.cat
                    end
                end
                return a.idx < b.idx
            end)
            for n, r in ipairs(list) do
                r.slot.LayoutOrder = n
                local c = accentAt(n / math.max(#list, 1) * 0.25) -- rainbow fades down the list
                r.label.TextColor3 = c
                r.bar.BackgroundColor3 = c
                r.stroke.Color = c
            end
            if titleRow then
                titleRow.slot.LayoutOrder = 0
                local c = accentAt(0)
                titleRow.label.TextColor3 = c
                titleRow.bar.BackgroundColor3 = c
                titleRow.stroke.Color = c
            end
        end)
    end

    ------------------------------------------------------------------ reset button
    mk("Frame", { Name = "Spacer", BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 10), LayoutOrder = UI.nextOrder(page) }, page)
    local resetCard = mk("Frame", {
        Name = "ResetCard",
