--// MOVEMENT SETTINGS: DASH MULTIPLIER (toggle + Distance slider)
--// Distance scales the velocity of the game's dash (the "dodgevelocity" mover that appears in
--// your HumanoidRootPart while you dash), 0x - 10x. The dash time stays the same, so the
--// distance travelled scales by exactly that factor. 1.00x = normal: the script does nothing.
--// It only affects YOUR dashes, never the ones this script performs (fireDash stamps the time
--// with _G.KAMUI_MarkScriptDash; a dash mover that shows up right after is the script's).
--// Debug: run `_G.KAMUI_DebugDash = true` first to print every dash mover and who it belongs to.
_G.KAMUI_Movement = { Enabled = true, Distance = 1.0, DistMin = 0, DistMax = 10, NoSideCD = false, NoStun = false, NoFatigue = false,
    SJEnabled = false, WalkSpeed = 25, JumpPower = 50 }
for _, c in ipairs(_G.KAMUI_MovementConns or {}) do
    pcall(function()
        c:Disconnect()
    end)
end
_G.KAMUI_MovementConns = {}
do
    local M = _G.KAMUI_Movement
    local conns = _G.KAMUI_MovementConns
    local SCRIPT_WINDOW = 0.8 -- a dash mover appearing this soon after fireDash() = script dash
    local states = setmetatable({}, { __mode = "k" }) -- dash mover -> { base, last, script, applied }

    local function velProp(m)
        return m:IsA("LinearVelocity") and "VectorVelocity" or "Velocity"
    end
    local function findDash(root)
        local d = root:FindFirstChild("dodgevelocity")
        if d then
            return d
        end
        for _, c in ipairs(root:GetChildren()) do
            if c:IsA("BodyVelocity") or c:IsA("LinearVelocity") then
                local n = string.lower(c.Name)
                if n:find("dodge") or n:find("dash") then
                    return c
                end
            end
        end
        return nil
    end

    conns[#conns + 1] = RunService.Heartbeat:Connect(function()
        if not isCurrent() then
            return
        end
        local char = player.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not root then
            return
        end
        local dash = findDash(root)
        if not dash or not (dash:IsA("BodyVelocity") or dash:IsA("LinearVelocity")) then
            return
        end
        local prop = velProp(dash)
        local cur = dash[prop]
        local st = states[dash]
        if not st then
            --// first frame we see this dash: whose is it?
            st = {
                base = cur, last = cur, applied = false,
                script = (os.clock() - (_G.KAMUI_ScriptDashAt or -math.huge)) <= SCRIPT_WINDOW
            }
            states[dash] = st
            if _G.KAMUI_DebugDash then
                print("[KAMUI dash] mover:", dash.ClassName, dash.Name, st.script and "(script dash - untouched)" or "(your dash)")
            end
        end
        local mult = M.Distance
        local active = M.Enabled and not st.script and type(mult) == "number" and math.abs(mult - 1) >= 0.001
        if not active then
            if st.applied then -- turned off / reset mid-dash: give the normal speed back
                dash[prop] = st.base
                st.last = st.base
                st.applied = false
            end
            return
        end
        if (cur - st.last).Magnitude > 0.05 then
            st.base = cur -- the game changed it: that is the new unscaled value
        end
        local scaled = st.base * mult
        st.last = scaled
        st.applied = true
        dash[prop] = scaled
    end)
end

--// NO SIDE DASH COOLDOWN (toggle lives in the Movement tab, inside the Dash multiplier card)
--// Ported from the Rage tab of the other script. While ON it:
--//   1) sets your character attribute CustomSideDashCooldown to 0,
--//   2) sets the workspace flags NoDashCooldown = true / EffectAffects = 1 (the game's no-cooldown switch),
--//   3) destroys the dash cooldown markers (UsedDash / InDash / DashCooldown / SideDashCooldown) on your character.
--// Turning it OFF puts the workspace flags back to the values the game had and clears the attribute.
do
    local M = _G.KAMUI_Movement
    local conns = _G.KAMUI_MovementConns
    local MARKERS = { UsedDash = true, InDash = true, DashCooldown = true, SideDashCooldown = true }
    --// kept in _G so re-running the script can still restore the game's real values
    local orig = _G.KAMUI_NoSideCDOrig
    if not orig then
        orig = { captured = false }
        _G.KAMUI_NoSideCDOrig = orig
    end

    local function setServerFlags(on)
        pcall(function()
            if on then
                if not orig.captured then
                    orig.captured = true
                    orig.noDash = Workspace:GetAttribute("NoDashCooldown")
                    orig.effect = Workspace:GetAttribute("EffectAffects")
                end
                if Workspace:GetAttribute("NoDashCooldown") ~= true then
                    Workspace:SetAttribute("NoDashCooldown", true)
                end
                if Workspace:GetAttribute("EffectAffects") ~= 1 then
                    Workspace:SetAttribute("EffectAffects", 1)
                end
            elseif orig.captured then
                orig.captured = false
                Workspace:SetAttribute("NoDashCooldown", orig.noDash)
                Workspace:SetAttribute("EffectAffects", orig.effect)
            end
        end)
    end
    local function clearAttr(char)
        pcall(function()
            char:SetAttribute("CustomSideDashCooldown", nil)
            char:SetAttribute("AfterimageDash", nil)
        end)
    end

    --// a fresh run starts with the toggle OFF: give back anything an earlier run changed
    setServerFlags(false)

    --// kill the cooldown markers the moment the game adds them to your character
    local function hook(char)
        conns[#conns + 1] = char.DescendantAdded:Connect(function(d)
            if isCurrent() and M.NoSideCD and MARKERS[d.Name] then
                task.defer(function()
                    pcall(d.Destroy, d)
                end)
            end
        end)
    end
    if player.Character then
        hook(player.Character)
    end
    conns[#conns + 1] = player.CharacterAdded:Connect(hook)

    local wasOn = false
    conns[#conns + 1] = RunService.Heartbeat:Connect(function()
        if not isCurrent() then
            return
        end
        local char = player.Character
        if not M.NoSideCD then
            if wasOn then -- just turned off
                wasOn = false
                setServerFlags(false)
                if char then
                    clearAttr(char)
                end
            end
            return
        end
        wasOn = true
        setServerFlags(true)
        if not char then
            return
        end
        if char:GetAttribute("CustomSideDashCooldown") ~= 0 then
            pcall(char.SetAttribute, char, "CustomSideDashCooldown", 0)
        end
        for name in pairs(MARKERS) do
            local o = char:FindFirstChild(name)
            if o then
                pcall(o.Destroy, o)
            end
        end
    end)
end

--// NO STUN + NO FATIGUE (two separate toggles in the Movement tab, ported from the Rage tab of the other script)
--//   No stun    : destroys the "Freeze" stun marker as soon as the game puts it on your character.
--//   No fatigue : keeps your Humanoid JumpPower at 50 (the game lowers it while you are fatigued). It stays out of
--//                the way while you are in a state the game should control (Counter, HunterCounter, emotes,
--//                BeingLaunched, Ragdoll, Freeze, BarrageBind) or when the game marks you with NoJump.
do
    local M = _G.KAMUI_Movement
    local conns = _G.KAMUI_MovementConns
    local BLOCKERS = {
        "Counter", "HunterCounter", "DoingEmote", "CancelEmote", "CancelEmote2",
        "BeingLaunched", "Ragdoll", "Freeze", "BarrageBind", "NoJump"
    }
    local function blocked(char)
        for _, name in ipairs(BLOCKERS) do
            if char:FindFirstChild(name) then
                return true
            end
        end
        return false
    end

    --// remove Freeze the moment it appears (any depth under your character)
    local function hook(char)
        conns[#conns + 1] = char.DescendantAdded:Connect(function(d)
            if isCurrent() and M.NoStun and d.Name == "Freeze" then
                task.defer(function()
                    pcall(d.Destroy, d)
                end)
            end
        end)
    end
    if player.Character then
        hook(player.Character)
    end
    conns[#conns + 1] = player.CharacterAdded:Connect(hook)

    conns[#conns + 1] = RunService.Heartbeat:Connect(function()
        if not isCurrent() then
            return
        end
        if not (M.NoStun or M.NoFatigue) then
            return
        end
        local char = player.Character
        if not char then
            return
        end
        if M.NoStun then
            local f = char:FindFirstChild("Freeze")
            if f then
                pcall(f.Destroy, f)
            end
        end
        if M.NoFatigue then
            local hum = char:FindFirstChildOfClass("Humanoid")
            local target = M.SJEnabled and M.JumpPower or 50 -- follows the custom jump height when that is on
            if hum and hum.JumpPower ~= target and not blocked(char) then
                pcall(function()
                    hum.UseJumpPower = true
                    hum.JumpPower = target
                end)
            end
        end
    end)

    --// WALKSPEED / JUMP HEIGHT: while enabled, holds Humanoid.WalkSpeed and JumpPower at the slider values.
    --// Same hands-off rule as No fatigue (blocked states). Turning it off puts back the normal 16 / 50 once.
    local wasOn = false
    conns[#conns + 1] = RunService.Heartbeat:Connect(function()
        if not isCurrent() then
            return
        end
        local char = player.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not hum then
            return
        end
        if M.SJEnabled then
            wasOn = true
            if not blocked(char) then
                pcall(function()
                    if hum.WalkSpeed ~= M.WalkSpeed then
                        hum.WalkSpeed = M.WalkSpeed
                    end
                    if hum.JumpPower ~= M.JumpPower or not hum.UseJumpPower then
                        hum.UseJumpPower = true
                        hum.JumpPower = M.JumpPower
                    end
                end)
            end
        elseif wasOn then
            wasOn = false
            pcall(function()
                hum.WalkSpeed = 16
                hum.JumpPower = 50
            end)
        end
    end)
end

