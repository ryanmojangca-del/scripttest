        if accentBar then
            TweenService:Create(
                accentBar,
                TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
                { BackgroundTransparency = active and 0 or 1 }
            ):Play()
        end
        local tabIcon = button:FindFirstChild("TabIcon")
        if tabIcon then
            TweenService:Create(
                tabIcon,
                TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
                { ImageColor3 = active and THEME.BrightRed or THEME.MutedText }
            ):Play()
        end
        local glyph = button:FindFirstChild("TabGlyph")
        if glyph then
            local gcol = active and THEME.BrightRed or THEME.MutedText
            local gInfo = TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
            for _, d in ipairs(glyph:GetDescendants()) do
                if d:IsA("UIStroke") then
                    TweenService:Create(d, gInfo, { Color = gcol }):Play()
                elseif d:IsA("Frame") and d.Name == "Bar" then
                    TweenService:Create(d, gInfo, { BackgroundColor3 = gcol }):Play()
                end
            end
            local gStroke = glyph:FindFirstChildOfClass("UIStroke")
            if gStroke then
                TweenService:Create(gStroke, gInfo, { Color = gcol }):Play()
            end
            local gBar = glyph:FindFirstChild("Bar")
            if gBar then
                TweenService:Create(gBar, gInfo, { BackgroundColor3 = gcol }):Play()
            end
        end
    end
    local sectionTitle = MainFrame:FindFirstChild("SectionTitle")
    if sectionTitle then
        sectionTitle.Text = tostring(tab)
    end
end

