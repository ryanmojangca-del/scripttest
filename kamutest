                    end)
                end)
                for _, d in ipairs(root:GetDescendants()) do
                    fixIndent(d)
                end
                if St.font ~= "Gotham" then
                    local fam = famByName[St.font] or famByName.Gotham
                    for _, d in ipairs(root:GetDescendants()) do
                        applyFontTo(d, fam)
                    end
                end
            end
        end
    end

