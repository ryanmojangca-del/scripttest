        Name = "Knob",
        BorderSizePixel = 0,
        Size = UDim2.new(0, 14, 0, 14),
        Position = UDim2.new(0, 3, 0.5, -7),
        BackgroundColor3 = OFF_KNOB
    }, track)
    UI.corner(knob, 7)
    local function paintToggle(animate)
        local on = M.Enabled
        track.BackgroundColor3 = on and THEME.Red or OFF_TRACK
        local goalPos = on and UDim2.new(1, -17, 0.5, -7) or UDim2.new(0, 3, 0.5, -7)
        local goalCol = on and Color3.new(1, 1, 1) or OFF_KNOB
        if animate then
            TweenService:Create(knob, TweenInfo.new(0.14, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
                { Position = goalPos, BackgroundColor3 = goalCol }):Play()
        else
            knob.Position, knob.BackgroundColor3 = goalPos, goalCol
        end
    end
    paintToggle(false)

    --// the one slider of the dash multiplier: Distance (0x - 10x, tap the number to type a value)
    local paintDist
    trow.MouseButton1Click:Connect(function()
        M.Enabled = not M.Enabled
        paintToggle(true)
        if paintDist then
            paintDist()
        end
    end)
    paintDist = makeSlider(card, {
        label = "Distance",
        sub = "Distance the dash goes",
        get = function() return M.Distance end,
        set = function(v) M.Distance = v end,
        min = M.DistMin, max = M.DistMax, step = 0.1,
        snap = 1, snapZone = 0.15,
        isOn = function() return M.Enabled end
    })
    --// ===================== NO SIDE DASH COOLDOWN (toggle) =====================
    local srow = mk("TextButton", {
        Name = "NoSideDashCooldownToggle",
        Text = "",
        AutoButtonColor = false,
        BackgroundTransparency = 1,
        BorderSizePixel = 0
    }, nil)
    UI.addRow(card, srow, UI.ROW)
    mk("TextLabel", {
        Name = "RowLabel",
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 12, 0, 0),
        Size = UDim2.new(1, -100, 1, 0),
        Font = Enum.Font.GothamMedium,
        TextSize = 12,
        TextColor3 = THEME.Text,
        TextXAlignment = Enum.TextXAlignment.Left,
        Text = "No side dash cooldown"
    }, srow)
    local strack = mk("Frame", {
        Name = "Track",
        BorderSizePixel = 0,
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -12, 0.5, 0),
        Size = UDim2.new(0, 36, 0, 20),
        BackgroundColor3 = OFF_TRACK
    }, srow)
    UI.corner(strack, 10)
    local sknob = mk("Frame", {
        Name = "Knob",
        BorderSizePixel = 0,
        Size = UDim2.new(0, 14, 0, 14),
        Position = UDim2.new(0, 3, 0.5, -7),
        BackgroundColor3 = OFF_KNOB
    }, strack)
    UI.corner(sknob, 7)
    local function paintSide(animate)
        local on = M.NoSideCD
        strack.BackgroundColor3 = on and THEME.Red or OFF_TRACK
        local goalPos = on and UDim2.new(1, -17, 0.5, -7) or UDim2.new(0, 3, 0.5, -7)
        local goalCol = on and Color3.new(1, 1, 1) or OFF_KNOB
        if animate then
            TweenService:Create(sknob, TweenInfo.new(0.14, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
                { Position = goalPos, BackgroundColor3 = goalCol }):Play()
        else
            sknob.Position, sknob.BackgroundColor3 = goalPos, goalCol
        end
    end
    paintSide(false)
    srow.MouseButton1Click:Connect(function()
        M.NoSideCD = not M.NoSideCD
        paintSide(true)
    end)

    resetRow(card, "ResetDashDistance", "Reset to 1.00x", function()
        M.Distance = 1.0
        paintDist()
    end)

    --// one-row toggle card (same look as the dash multiplier toggle)
    local function makeToggle(tcard, rowName, label, get, set, sub)
        local row = mk("TextButton", {
            Name = rowName,
            Text = "",
            AutoButtonColor = false,
            BackgroundTransparency = 1,
            BorderSizePixel = 0
        }, nil)
        UI.addRow(tcard, row, sub and UI.ROW_SUB or UI.ROW)
        mk("TextLabel", {
            Name = "RowLabel",
            BackgroundTransparency = 1,
            Position = UDim2.new(0, 12, 0, sub and 5 or 0),
            Size = sub and UDim2.new(1, -100, 0, 20) or UDim2.new(1, -100, 1, 0),
            Font = Enum.Font.GothamMedium,
            TextSize = 12,
            TextColor3 = THEME.Text,
            TextXAlignment = Enum.TextXAlignment.Left,
            Text = label
        }, row)
        if sub then
            mk("TextLabel", {
                Name = "RowSub",
                BackgroundTransparency = 1,
                Position = UDim2.new(0, 12, 0, 24),
                Size = UDim2.new(1, -100, 0, 14),
                Font = Enum.Font.Gotham,
                TextSize = 11,
                TextColor3 = THEME.MutedText,
                TextXAlignment = Enum.TextXAlignment.Left,
                TextTruncate = Enum.TextTruncate.AtEnd,
                Text = sub
            }, row)
        end
        local ttrack = mk("Frame", {
            Name = "Track",
            BorderSizePixel = 0,
            AnchorPoint = Vector2.new(1, 0.5),
            Position = UDim2.new(1, -12, 0.5, 0),
            Size = UDim2.new(0, 36, 0, 20),
            BackgroundColor3 = OFF_TRACK
        }, row)
        UI.corner(ttrack, 10)
        local tknob = mk("Frame", {
            Name = "Knob",
            BorderSizePixel = 0,
            Size = UDim2.new(0, 14, 0, 14),
            Position = UDim2.new(0, 3, 0.5, -7),
            BackgroundColor3 = OFF_KNOB
        }, ttrack)
        UI.corner(tknob, 7)
        local function paint(animate)
            local on = get()
            ttrack.BackgroundColor3 = on and THEME.Red or OFF_TRACK
            local goalPos = on and UDim2.new(1, -17, 0.5, -7) or UDim2.new(0, 3, 0.5, -7)
            local goalCol = on and Color3.new(1, 1, 1) or OFF_KNOB
            if animate then
                TweenService:Create(tknob, TweenInfo.new(0.14, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
                    { Position = goalPos, BackgroundColor3 = goalCol }):Play()
            else
                tknob.Position, tknob.BackgroundColor3 = goalPos, goalCol
            end
        end
        paint(false)
        row.MouseButton1Click:Connect(function()
            set(not get())
            paint(true)
        end)
    end

    --// ===================== NO STUN =====================
    local stunCard = UI.card(page, "No stun")
    makeToggle(stunCard, "NoStunToggle", "No stun",
        function() return M.NoStun end,
        function(v) M.NoStun = v end)

    --// ===================== NO FATIGUE =====================
    local fatigueCard = UI.card(page, "No fatigue")
    makeToggle(fatigueCard, "NoFatigueToggle", "No fatigue",
        function() return M.NoFatigue end,
        function(v) M.NoFatigue = v end,
        "keeps same jump height forever")

    --// ===================== WALKSPEED / JUMP HEIGHT =====================
    local sjCard = UI.card(page, "WALKSPEED/JUMP HEIGHT")
    local paintWalk, paintJump
    makeToggle(sjCard, "WalkJumpToggle", "WalkSpeed / Jump height",
        function() return M.SJEnabled end,
        function(v)
            M.SJEnabled = v
            if paintWalk then paintWalk() end
            if paintJump then paintJump() end
        end,
        "default is 25 / 50")
    paintWalk = makeSlider(sjCard, {
        label = "WalkSpeed",
        sub = "How fast you walk (25 = default)",
        get = function() return M.WalkSpeed end,
        set = function(v) M.WalkSpeed = v end,
        min = 0, max = 150, step = 1,
        snap = 25, snapZone = 1.5,
        fmt = "%g",
        isOn = function() return M.SJEnabled end
    })
    paintJump = makeSlider(sjCard, {
        label = "Jump height",
        sub = "How high you jump (50 = default)",
        get = function() return M.JumpPower end,
        set = function(v) M.JumpPower = v end,
        min = 0, max = 300, step = 1,
        snap = 50, snapZone = 3,
        fmt = "%g",
        isOn = function() return M.SJEnabled end
    })
    resetRow(sjCard, "ResetWalkJump", "Reset to default", function()
        M.WalkSpeed, M.JumpPower = 25, 50
        paintWalk()
        paintJump()
    end)
end

_G.KAMUI_ContentInit = function()
    local ok, UI = pcall(_G.KAMUI_UIKit)
    if not ok then
        warn("[KAMUI] content kit failed:", UI)
        return
    end
    for _, name in ipairs({ "Home", "Settings", "Profiles", "Skills", "Others", "GUI", "Combat", "Movement" }) do
        local ok2, err = pcall(_G["KAMUI_Build" .. name], UI)
        if not ok2 then
            warn("[dw] " .. name .. " tab redesign failed:", err)
        end
    end
end
_G.KAMUI_ContentInit()

--// warm the module cache so Open feels instant (silent if a link is not set / offline)
task.delay(3, function()
    for name in pairs(_G.KAMUI_Modules) do
        task.spawn(function()
            pcall(_G.KAMUI_FetchModule, name)
        end)
    end
end)
