--// The IDs the Creator Dashboard shows for a Decal are not image IDs, so they can show up blank.
--// This looks up the real image behind a Decal ID once (GetObjects -> Decal.Texture), caches it,
--// and falls back to the ID itself when the lookup is not available (works for image IDs too).
_G.KAMUI_ImageCache = _G.KAMUI_ImageCache or {}
_G.KAMUI_SetImage = function(label, id)
    local cache = _G.KAMUI_ImageCache
    local plain = "rbxassetid://" .. id
    if cache[id] then
        label.Image = cache[id]
        return
    end
    label.Image = plain
    task.spawn(function()
        local tex = plain
        local ok, res = pcall(function()
            return game:GetObjects(plain)
        end)
        if ok and type(res) == "table" and res[1] then
            local obj = res[1]
            if obj:IsA("Decal") and obj.Texture ~= "" then
                tex = obj.Texture
            end
            pcall(function()
                obj:Destroy()
            end)
        end
        cache[id] = tex
        if label.Parent then
            label.Image = tex
        end
    end)
end

local function rebuildProfileList()
    --// helpers live inside this function so no extra top-level locals are needed
    local function naturalLess(x, y)
        --// "Profile 2" comes before "Profile 10"
        local px, nx = x:match("^(.-)%s*(%d+)$")
        local py, ny = y:match("^(.-)%s*(%d+)$")
        if px and py and px:lower() == py:lower() then
            return tonumber(nx) < tonumber(ny)
        end
        return x:lower() < y:lower()
    end

    --// returns true on success, or false + reason ("empty" / "same" / "taken")
    local function renameProfile(oldName, newName)
        newName = newName:gsub("%c", ""):gsub("^%s+", ""):gsub("%s+$", "")
        if #newName > 24 then
            newName = newName:sub(1, 24)
        end
        if newName == "" then
            return false, "empty"
        end
        if Profiles[oldName] == nil then
            return false, "missing"
        end
        if newName == oldName then
            return false, "same"
        end
        for existing in pairs(Profiles) do
            if existing ~= oldName and existing:lower() == newName:lower() then
                return false, "taken"
            end
        end
        Profiles[newName] = Profiles[oldName]
        Profiles[oldName] = nil
        if CurrentProfile == oldName then
            CurrentProfile = newName
        end
        saveProfilesToFile()
        return true
    end

    for _, child in pairs(
        ProfileList:GetChildren()
    ) do
        if child:IsA("GuiObject") then
            child:Destroy()
        end
    end

    local names = {}
    for profileName in pairs(Profiles) do
        table.insert(names, profileName)
    end
    table.sort(names, naturalLess)
    local total = #names

    for count, profileName in ipairs(names) do
        local profileData = Profiles[profileName]
        local row = Instance.new("Frame")
        row.Parent = ProfileList
        row.Size = UDim2.new(1, 0, 0, 38)
        row.BackgroundTransparency = 1
        row.BorderSizePixel = 0
        if count < total then
            local divider = Instance.new("Frame")
            divider.Name = "Divider"
            divider.Parent = row
            divider.BackgroundColor3 = Color3.fromRGB(26, 26, 28)
            divider.BorderSizePixel = 0
            divider.Size = UDim2.new(1, -24, 0, 1)
            divider.Position = UDim2.new(0, 12, 1, -1)
        end

        --// button layout (right to left): Delete, Rename, Load
        local profIcons = _G.KAMUI_ProfileIcons or {}
        local renId = tostring(profIcons.Rename or ""):match("%d+")
        local delId = tostring(profIcons.Delete or ""):match("%d+")
        local renW = renId and 26 or 56
        local delW = delId and 26 or 48
        local loadW = 46
        local delX = -(8 + delW)
        local renX = delX - 4 - renW
        local loadX = renX - 6 - loadW

        --// name (tap = load)
        local loadBtn = Instance.new("TextButton")
        loadBtn:SetAttribute("KamuiSkinned", true)
        loadBtn.Parent = row
        loadBtn.Size = UDim2.new(1, loadX - 8, 1, 0)
        loadBtn.BackgroundTransparency = 1
        loadBtn.TextColor3 = THEME.Text
        loadBtn.Text = profileName
        loadBtn.Font = Enum.Font.GothamMedium
        loadBtn.TextSize = 12
        loadBtn.TextXAlignment = Enum.TextXAlignment.Left
        loadBtn.TextTruncate = Enum.TextTruncate.AtEnd
        local loadPad = Instance.new("UIPadding")
        loadPad.PaddingLeft = UDim.new(0, 12)
        loadPad.Parent = loadBtn

        --// name editor (shown while renaming)
        local nameBox = Instance.new("TextBox")
        nameBox:SetAttribute("KamuiSkinned", true)
        nameBox.Parent = row
        nameBox.Visible = false
        nameBox.Position = UDim2.new(0, 8, 0.5, -13)
        nameBox.Size = UDim2.new(1, loadX - 16, 0, 26)
        nameBox.BackgroundColor3 = Color3.fromRGB(20, 20, 22)
        nameBox.TextColor3 = THEME.Text
        nameBox.Font = Enum.Font.GothamMedium
        nameBox.TextSize = 12
        nameBox.TextXAlignment = Enum.TextXAlignment.Left
        nameBox.ClearTextOnFocus = false
        nameBox.ClipsDescendants = true
        nameBox.PlaceholderText = "Profile name"
        nameBox.PlaceholderColor3 = THEME.MutedText
        nameBox.Text = profileName
        applyCorner(nameBox, 7)
        local namePad = Instance.new("UIPadding")
        namePad.PaddingLeft = UDim.new(0, 8)
        namePad.PaddingRight = UDim.new(0, 8)
        namePad.Parent = nameBox
        local nameStroke = Instance.new("UIStroke")
        nameStroke.Color = THEME.Red
        nameStroke.Thickness = 1
        nameStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
        nameStroke.Parent = nameBox

        local function makeChip(text, width, xOffset, bg, textColor, stroked)
            local chip = Instance.new("TextButton")
            chip:SetAttribute("KamuiSkinned", true)
            chip.Parent = row
            chip.Size = UDim2.new(0, width, 0, 26)
            chip.Position = UDim2.new(1, xOffset, 0.5, -13)
            chip.BackgroundColor3 = bg
            chip.TextColor3 = textColor
            chip.Text = text
            chip.Font = Enum.Font.GothamMedium
            chip.TextSize = 12
            applyCorner(chip, 7)
            if stroked then
                local st = Instance.new("UIStroke")
                st.Color = Color3.fromRGB(36, 36, 38)
                st.Thickness = 1
                st.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
                st.Parent = chip
            end
            return chip
        end
        --// Rename / Delete are flat (icon or muted text) and light up on hover
        local function flatChip(chip, iconId)
            chip.BackgroundTransparency = 1
            if iconId then
                chip.Text = ""
                local img = Instance.new("ImageLabel")
                img.Name = "ChipIcon"
                img.Parent = chip
                img.BackgroundTransparency = 1
                img.BorderSizePixel = 0
                img.AnchorPoint = Vector2.new(0.5, 0.5)
                img.Position = UDim2.new(0.5, 0, 0.5, 0)
                img.Size = UDim2.new(0, 14, 0, 14)
                _G.KAMUI_SetImage(img, iconId)
                img.ImageColor3 = chip.TextColor3
                img.Active = false
            end
            chip.MouseEnter:Connect(function()
                chip.BackgroundColor3 = THEME.DarkRed
                TweenService:Create(chip, TweenInfo.new(0.12), { BackgroundTransparency = 0.7 }):Play()
            end)
            chip.MouseLeave:Connect(function()
                TweenService:Create(chip, TweenInfo.new(0.12), { BackgroundTransparency = 1 }):Play()
            end)
        end
        local renameChip = makeChip("Rename", renW, renX, Color3.fromRGB(20, 20, 22), THEME.MutedText, false)
        local loadChip = makeChip("Load", loadW, loadX, THEME.DarkRed, THEME.Text, false)
        local deleteBtn = makeChip("Delete", delW, delX, Color3.fromRGB(20, 20, 22), THEME.BrightRed, false)
        flatChip(renameChip, renId)
        flatChip(deleteBtn, delId)
        local loadStroke = Instance.new("UIStroke")
        loadStroke.Color = Color3.fromRGB(90, 18, 24)
        loadStroke.Thickness = 1
        loadStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
        loadStroke.Parent = loadChip

        local function doLoad()
            loadProfileData(profileData)
            CurrentProfile = profileName
            ProfileCodeInput.Text = generateProfileCode()
        end
        loadBtn.MouseButton1Click:Connect(doLoad)
        loadChip.MouseButton1Click:Connect(doLoad)

        --// rename: tap Rename, type the new name, press Done / tap away
        renameChip.MouseButton1Click:Connect(function()
            nameBox.Text = profileName
            nameBox.Visible = true
            loadBtn.Visible = false
            task.defer(function()
                if nameBox.Parent then
                    nameBox:CaptureFocus()
                end
            end)
        end)
        nameBox.FocusLost:Connect(function()
            local typed = nameBox.Text
            nameBox.Visible = false
            loadBtn.Visible = true
            local ok, why = renameProfile(profileName, typed)
            if ok then
                rebuildProfileList()
            elseif why == "taken" then
                loadBtn.Text = "Name already used"
                loadBtn.TextColor3 = Color3.fromRGB(255, 120, 120)
                task.delay(1.2, function()
                    if loadBtn.Parent then
                        loadBtn.Text = profileName
                        loadBtn.TextColor3 = THEME.Text
                    end
                end)
            end
        end)

        deleteBtn.MouseButton1Click:Connect(function()
            Profiles[profileName] = nil
            saveProfilesToFile()
            if CurrentProfile ==
                profileName then
                CurrentProfile = nil
                ProfileCodeInput.Text = ""
            end
            rebuildProfileList()
        end)
    end
    ProfileList.Visible = total > 0
    ProfileList.Size = UDim2.new(1, 0, 0, math.max(total * 38, 1))
end

