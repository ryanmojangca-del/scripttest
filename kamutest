    --// drag helper (the window must not move while a picker is held)
    local function bindDrag(frame, onMove)
        local active = false
        frame.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                active = true
                _G.KAMUI_SliderHeld = true
                onMove(input.Position)
            end
        end)
        UIS.InputChanged:Connect(function(input)
            if active and isCurrent()
                and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                onMove(input.Position)
            end
        end)
        UIS.InputEnded:Connect(function(input)
            if active and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
                active = false
                _G.KAMUI_SliderHeld = false
                saveSoon()
            end
        end)
    end
    bindDrag(sv, function(pos)
        local a, sz = sv.AbsolutePosition, sv.AbsoluteSize
        if sz.X <= 0 or sz.Y <= 0 then
            return
        end
        St.s = math.clamp((pos.X - a.X) / sz.X, 0, 1)
        St.v = 1 - math.clamp((pos.Y - a.Y) / sz.Y, 0, 1)
        St.rainbow = false
        dirty = true
    end)
