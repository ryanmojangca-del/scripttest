    local LOGO_WHITE_B64 = ""
    local LOGO_VERSION = "v1" --// bump this if you ever replace the images

    local B64_CHARS = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    local B64_MAP = {}
    for i = 1, 64 do
        B64_MAP[B64_CHARS:byte(i)] = i - 1
    end
    local function b64decode(data)
        local out, n, buf, bits = {}, 0, 0, 0
        for i = 1, #data do
            local v = B64_MAP[data:byte(i)]
            if v then
                buf = buf * 64 + v
                bits = bits + 6
                if bits >= 8 then
                    bits = bits - 8
                    local p = 2 ^ bits
                    local byte = math.floor(buf / p)
                    buf = buf - byte * p
                    n = n + 1
                    out[n] = string.char(byte)
                end
            end
        end
        return table.concat(out)
    end
    local function logoAsset(name, data)
        if not (writefile and getcustomasset) then
            return nil
        end
        local file = "KAMUI_logo_" .. name .. "_" .. LOGO_VERSION .. ".png"
        local ok, asset = pcall(function()
            if not (isfile and isfile(file)) then
                writefile(file, b64decode(data))
            end
            return getcustomasset(file)
        end)
        if ok and asset and asset ~= "" then
            return asset
        end
        return nil
    end

    local holder = Instance.new("Frame")
    holder.Name = "KamuiLogo"
    holder.Parent = TopBar
    holder.BackgroundTransparency = 1
    holder.BorderSizePixel = 0
    holder.Size = UDim2.new(0, 26, 0, 28)
    holder.Position = UDim2.new(0, 10, 0.5, -14)

    local function addLayer(name, data, color)
        local asset = logoAsset(name, data)
        if not asset then
            return false
        end
        local img = Instance.new("ImageLabel")
        img.Name = "Logo" .. name
        img.Parent = holder
        img.BackgroundTransparency = 1
        img.BorderSizePixel = 0
        img.Size = UDim2.new(1, 0, 1, 0)
        img.Image = asset
        img.ScaleType = Enum.ScaleType.Fit
        img.ImageColor3 = color
        return true
    end
    local okWhite = addLayer("White", LOGO_WHITE_B64, THEME.Text)
    local okRed = addLayer("Red", LOGO_RED_B64, THEME.Red) --// this is the part the GUI editor recolors
    if not (okWhite or okRed) then
        holder:Destroy()
        Title.Position = UDim2.new(0, 12, 0, 4)
        TitleSub.Position = UDim2.new(0, 12, 0, 19)
    end
end

