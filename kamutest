--// LOAD CODE BUTTON
LoadCodeBtn.MouseButton1Click:Connect(function()
    local code = ProfileCodeInput.Text :gsub("^%s+", "") :gsub("%s+$", "")
    if code == "" then
        ProfileCodeInput.PlaceholderText = "Enter a profile code"
        return
    end
    local data = decodeProfileCode(code)
    if not data then
        LoadCodeBtn.Text = "Invalid code"
        task.delay(1.2, function()
            if LoadCodeBtn then
                LoadCodeBtn.Text = "Load code"
            end
        end)
        return
    end
    --// a code made from a named profile brings its name along
    local codeName = data.ProfileName
    data.ProfileName = nil
    if type(codeName) == "string" then
        codeName = codeName:gsub("%c", "")
        codeName = codeName:gsub("^%s+", ""):gsub("%s+$", "")
        codeName = codeName:sub(1, 24)
        if codeName == "" then
            codeName = nil
        end
    else
        codeName = nil
    end
    local function sameData(x, y)
        for k, v in pairs(x) do
            if y[k] ~= v then
                return false
            end
        end
        for k, v in pairs(y) do
            if x[k] ~= v then
                return false
            end
        end
        return true
    end
    local function nameTaken(nm)
        for existing in pairs(Profiles) do
            if existing:lower() == nm:lower() then
                return true
            end
        end
        return false
    end
    local profileName
    local isNew = true
    if codeName then
        --// same name + same settings = it is already saved, just load it
        for existing, existingData in pairs(Profiles) do
            if existing:lower() == codeName:lower() and sameData(existingData, data) then
                profileName = existing
                isNew = false
                break
            end
        end
        if not profileName then
            profileName = codeName
            local suffix = 1
            while nameTaken(profileName) do
                suffix += 1
                profileName = codeName .. " " .. suffix
            end
        end
    else
        local profileNumber = 1
        profileName = "Profile " .. profileNumber
        while Profiles[profileName] do
            profileNumber += 1
            profileName = "Profile " .. profileNumber
        end
    end
    if isNew then
        Profiles[profileName] = data
        saveProfilesToFile()
    end
    loadProfileData(data)
    CurrentProfile = profileName
    rebuildProfileList()
    LoadCodeBtn.Text = "Profile loaded"
    task.delay(1.2, function()
        if LoadCodeBtn then
            LoadCodeBtn.Text = "Load code"
        end
    end)
end)

