-- Search and HTTP logic retained from the working standalone player.
local function httpGet(url)
    if type(requestFn) ~= 'function' then return nil,'Executor lacks HTTP request support' end
    local ok, response = pcall(requestFn,{Url=url,Method='GET'})
    if not ok then return nil,tostring(response) end
    -- Real returns a string on a request error, not a response table.
    if type(response) == 'string' then return nil,response end
    if type(response) ~= 'table' then return nil,'Invalid HTTP response ('..type(response)..')' end
    local code = response.StatusCode or response.Status or response.status_code
    if tonumber(code) ~= 200 then return nil,'HTTP '..tostring(code or '?')..' '..tostring(response.StatusMessage or '') end
    local body = response.Body or response.body
    if type(body) ~= 'string' then return nil,'Empty response' end
    return body
end
local function json(text)
    local ok, value=pcall(function() return HttpService:JSONDecode(text) end)
    if ok and type(value)=='table' then return value end
    return nil
end
-- Search only: start with Real's request. If it stalls, also try HttpGet.
-- The first valid search response wins; late responses are ignored.
local function searchHttpGet(url, job)
    local state = {data=nil, done=0, errors={}}
    local function finish(method, body, err)
        if not jobActive(job) or state.data then return end
        local decoded = body and json(body)
        local videos = decoded and (decoded.videos or decoded.results or decoded.items)
        if type(videos) == 'table' then
            decoded.videos = videos
            state.data = decoded
        else
            state.done = state.done + 1
            table.insert(state.errors, method..': '..tostring(err or (decoded and (decoded.error or decoded.message)) or 'invalid search response'))
        end
    end
    task.spawn(function()
        local body, err = httpGet(url)
        finish('request', body, err)
    end)
    task.delay(3, function()
        if not jobActive(job) or state.data then return end
        say('Still searching; trying HttpGet…')
        local ok, body = pcall(function() return game:HttpGet(url, true) end)
        if ok and type(body) == 'string' and body ~= '' then
            finish('HttpGet', body, nil)
        else
            finish('HttpGet', nil, ok and 'empty response' or tostring(body))
        end
    end)
    local start = os.clock()
    while jobActive(job) and not state.data and state.done < 2 and os.clock()-start < 85 do
        task.wait(0.1)
    end
    if state.data then return state.data end
    if #state.errors > 0 then return nil, table.concat(state.errors, ' | ') end
    return nil, 'Both connection methods timed out'
end
-- Clean text robustly, including control characters inside pasted input.
-- Avoid relying on a pattern capture for text that comes from a TextBox.
local function cleanInput(value)
    if type(value) ~= 'string' then return '' end
    value = value:gsub('[%c]+', ' ')
    value = value:gsub('^%s+', '')
    value = value:gsub('%s+$', '')
    return value
end
-- Normalize common YouTube share URLs to one watch URL understood by the proxy.
local function normalizeYT(input)
    local url=cleanInput(input)
    if url=='' then return nil end
    -- Check exact YouTube host/path prefixes using plain string operations.
    -- Keep the original link intact for the same proxy the original player uses.
    local lower=url:lower()
    if lower:sub(1,7)~='http://' and lower:sub(1,8)~='https://' then
        url='https://'..url
        lower='https://'..lower
    end
    local prefixes={
        'https://www.youtube.com/watch?', 'http://www.youtube.com/watch?',
        'https://youtube.com/watch?', 'http://youtube.com/watch?',
        'https://m.youtube.com/watch?', 'http://m.youtube.com/watch?',
        'https://music.youtube.com/watch?', 'http://music.youtube.com/watch?',
        'https://youtu.be/', 'http://youtu.be/',
        'https://www.youtube.com/shorts/', 'https://youtube.com/shorts/',
        'https://m.youtube.com/shorts/', 'https://www.youtube.com/live/',
        'https://youtube.com/live/', 'https://m.youtube.com/live/'
    }
    for i = 1, #prefixes do
        local prefix = prefixes[i]
        if lower:sub(1,#prefix)==prefix and #lower>#prefix then return url end
    end
    return nil
end
local function validYT(url) return normalizeYT(url) ~= nil end
local function searchNow()
    local q=cleanInput(queryBox.Text)
    if q=='' then say('Enter a search term or URL',true); return end
    local normalized=normalizeYT(q)
    if normalized then selectedVideo={url=normalized}; queryBox.Text=normalized; say('Link selected; press Download'); return end
    if busy then say('A request is already running',true); return end
    local job=startJob(90,'Search timed out; check connection')
    say('Searching...')
    task.spawn(function()
        local ok,failure=pcall(function()
            local data,err=searchHttpGet(API..'/api/search?q='..HttpService:UrlEncode(q),job)
            if not jobActive(job) then return end
            busy=false
            if not data or data.success~=true or type(data.videos)~='table' then say('Search failed: '..tostring(err or (data and data.error) or 'invalid response'),true); return end
            clearButtons(results); selectedVideo=nil
            local shown=0
            for i,v in ipairs(data.videos) do
                if type(v)=='table' and type(v.url)=='string' and v.url~='' then
                    local title=tostring(v.title or 'Untitled')
                    local row=songRow(results,title,'YouTube result',i,false)
                    row.Activated:Connect(function()
                        selectedVideo={url=v.url,title=title}; queryBox.Text=v.url
                        for _,child in ipairs(results:GetChildren()) do if child:IsA('TextButton') then child.BackgroundTransparency=1 end end
                        row.BackgroundColor3=C.chip; row.BackgroundTransparency=0
                        say('Selected: '..title)
                    end)
                    shown=shown+1
                end
            end
            if shown==0 then say('No results with links returned',true) else say('Select a result to download') end
        end)
        if not ok then busy=false; say('Search error: '..tostring(failure),true) end
    end)
end
connect(goBtn.Activated,searchNow)
connect(queryBox.FocusLost,function(enter) if enter then searchNow() end end)
connect(copyBtn.Activated,function()
    local link=normalizeYT(queryBox.Text)
    if not link then say('Select a YouTube link first',true); return end
    if type(setclipboard)~='function' then say('Executor lacks clipboard support',true); return end
    local ok=pcall(setclipboard,link); say(ok and 'Link copied' or 'Clipboard failed',not ok)
end)
-- Preserve titles, replacing only characters Windows cannot use in a filename.
local function safeName(s)
    s=tostring(s or 'audio'):gsub('[%c/\\:*?"<>|]','_'):gsub('^%s+',''):gsub('%s+$',''):sub(1,100)
    if s=='' or s=='.' or s=='..' then s='audio' end
    return s
end
connect(download.Activated,function()
    local link=normalizeYT(queryBox.Text)
    if not link then say('Select a result or paste a YouTube link',true); return end
    if busy then say('A request is already running',true); return end
    if type(writefile)~='function' or type(isfile)~='function' then say('Executor lacks file support',true); return end
    local ok,err=ensureFolders(); if not ok then say('Folder error: '..tostring(err),true); return end
    local chosenTitle=(selectedVideo and normalizeYT(selectedVideo.url)==link and selectedVideo.title) or nil
    local job=startJob(75,'Download timed out; try again')
    say('Contacting audio service...')
    task.spawn(function()
        local success,problem=pcall(function()
            local body,why=httpGet(API..'/api/play?url='..HttpService:UrlEncode(link))
            if not jobActive(job) then return end
            local data=body and json(body)
            if not data or data.success~=true or type(data.url)~='string' or not (data.url:sub(1,8)=='https://' or data.url:sub(1,7)=='http://') then busy=false; say('Audio service failed: '..tostring(why or (data and (data.error or data.message)) or 'invalid response'),true); return end
            chosenTitle=chosenTitle or (type(data.title)=='string' and data.title) or 'YouTube audio'
            say('Downloading audio...')
            local audio,audioErr=httpGet(data.url)
            if not jobActive(job) then return end
            if not audio or #audio<1000 then busy=false; say('Audio download failed: '..tostring(audioErr or 'invalid file'),true); return end
            local name=safeName(chosenTitle); local path=MUSIC..'/'..name..'.mp3'; local n=2
            local fileOk,exists=pcall(isfile,path)
            if not fileOk then busy=false; say('File check failed: '..tostring(exists),true); return end
            while exists do
                path=MUSIC..'/'..name..' ('..n..').mp3'; n=n+1
                fileOk,exists=pcall(isfile,path)
                if not fileOk then busy=false; say('File check failed: '..tostring(exists),true); return end
            end
            local wrote,writeErr=pcall(writefile,path,audio); busy=false
            if not wrote then say('Save failed: '..tostring(writeErr),true); return end
            scan(); tab('Playlist'); say('Downloaded: '..basename(path))
        end)
        if not success then busy=false; say('Download error: '..tostring(problem),true) end
    end)
end)
scan()
end
