local function initializeFling()
if _G.KAMUI_FlingService and _G.KAMUI_FlingService.Destroy then
pcall(_G.KAMUI_FlingService.Destroy)
end
local Fling = (function()
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer
local Fling = {}
local loopEnabled, running, destroyed = false, false, false
local currentRun, antiConnection
local function resolveTarget(target)
if typeof(target) == "Instance" and target:IsA("Player") then
return target.Parent == Players and target or nil
end
if type(target) == "string" then
local found
for _, player in pairs(Players:GetPlayers()) do
if player.Name == target or player.DisplayName == target then found = player end
end
return found
end
end
local function attempt(targetCharacter, run)
local character = LocalPlayer.Character
local root = character and character:FindFirstChild("HumanoidRootPart")
local targetRoot = targetCharacter and targetCharacter:FindFirstChild("HumanoidRootPart")
local targetHumanoid = targetCharacter and targetCharacter:FindFirstChild("Humanoid")
if not (character and character.PrimaryPart and root and targetRoot and targetHumanoid) then
return false, "Character or target is not ready."
end
local origin = root.CFrame
local destroyHeight = workspace.FallenPartsDestroyHeight
local mover
local ok, err = xpcall(function()
mover = Instance.new("BodyVelocity")
mover.Velocity = Vector3.new(0, 0, 0)
mover.MaxForce = Vector3.new(9e9, 9e9, 9e9)
mover.Parent = root
pcall(function() workspace.FallenPartsDestroyHeight = 0 / 0 end)
local started, angle, phase = tick(), 0, 0
local function move(offset, rotation)
if not (character.PrimaryPart and root.Parent and targetRoot.Parent) then return end
local cf = CFrame.new(targetRoot.Position) * offset * rotation
root.CFrame = cf
character:SetPrimaryPartCFrame(cf)
root.Velocity = Vector3.new(9e7, 9e8, 9e7)
root.RotVelocity = Vector3.new(9e8, 9e8, 9e8)
end
repeat
if run.cancelled or destroyed or LocalPlayer.Character ~= character or not character.Parent or not targetCharacter.Parent or not targetRoot.Parent then break end
phase = phase + 1
if phase > 1 then phase = 0 end
if targetRoot.Velocity.Magnitude < 50 then
angle = angle + 100
local vertical = phase == 1 and 1.5 or -1.5
local direction = targetHumanoid.MoveDirection
move(CFrame.new(0, vertical, 0) + direction * targetRoot.Velocity.Magnitude / 1.25, CFrame.Angles(math.rad(angle), 0, 0))
move(CFrame.new(0, vertical, 0) + direction, CFrame.Angles(math.rad(angle), 0, 0))
elseif phase == 1 then
move(CFrame.new(0, 1.5, targetHumanoid.WalkSpeed), CFrame.Angles(math.rad(90), 0, 0))
move(CFrame.new(0, -1.5, 0), CFrame.Angles(math.rad(90), 0, 0))
else
move(CFrame.new(0, -1.5, -targetHumanoid.WalkSpeed), CFrame.Angles(0, 0, 0))
move(CFrame.new(0, -1.5, 0), CFrame.Angles(0, 0, 0))
end
task.wait()
until tick() > started + 3
end, debug.traceback)
if mover then pcall(function() mover:Destroy() end) end
pcall(function() workspace.FallenPartsDestroyHeight = destroyHeight end)
pcall(function()
if LocalPlayer.Character ~= character or not character.Parent or not root.Parent then return end
local deadline = tick() + 3
repeat
root.CFrame = origin * CFrame.new(0, 0.5, 0)
if character.PrimaryPart then character:SetPrimaryPartCFrame(origin * CFrame.new(0, 0.5, 0)) end
for _, part in pairs(character:GetChildren()) do
if part:IsA("BasePart") then part.Velocity, part.RotVelocity = Vector3.zero, Vector3.zero end
end
task.wait()
until (root.Position - origin.Position).Magnitude < 25 or tick() > deadline or not character.Parent or LocalPlayer.Character ~= character
end)
if not ok then warn("[Fling]", err); return false, "Fling failed; see console." end
return true
end
function Fling.SetLoop(enabled)
loopEnabled = enabled == true
end
function Fling.SetAntiFling(enabled)
if antiConnection then antiConnection:Disconnect(); antiConnection = nil end
if not enabled or destroyed then return end
local lastSafe, lastCharacter
antiConnection = RunService.Heartbeat:Connect(function()
if running then lastSafe = nil; return end
local character = LocalPlayer.Character
if character ~= lastCharacter then lastSafe, lastCharacter = nil, character end
local root = character and character:FindFirstChild("HumanoidRootPart")
if not root or not root.Parent then lastSafe = nil; return end
local dash = root:FindFirstChild("moveme") or root:FindFirstChild("dodgevelocity")
if (not dash and root.AssemblyLinearVelocity.Magnitude > 250) or root.AssemblyAngularVelocity.Magnitude > 250 then
root.AssemblyAngularVelocity = Vector3.zero
root.AssemblyLinearVelocity = Vector3.zero
if lastSafe then root.CFrame = lastSafe end
elseif root.AssemblyLinearVelocity.Magnitude < 50 and root.AssemblyAngularVelocity.Magnitude < 50 then
lastSafe = root.CFrame
end
end)
end
function Fling.Start(target, onStatus)
if destroyed then return false, "Module was destroyed." end
if running then return false, "A fling is already running." end
if not resolveTarget(target) then return false, "Fling target isn't on the server." end
local function report(message)
if type(onStatus) == "function" then
local ok, err = pcall(onStatus, message)
if not ok then warn("[Fling] Status callback:", err) end
end
end
local run = {cancelled = false}
currentRun, running = run, true
task.spawn(function()
repeat
local player = resolveTarget(target)
if not player then report("Fling target isn't on the server."); break end
if not player.Character then report("Target character is not ready."); break end
report("Flinging " .. player.Name)
local ok, err = attempt(player.Character, run)
if not ok then report(err); break end
if run.cancelled or destroyed then break end
report("Fling attempt finished.")
if loopEnabled then
local deadline = tick() + 3
while loopEnabled and not run.cancelled and not destroyed and tick() < deadline do task.wait(0.1) end
end
until not loopEnabled or run.cancelled or destroyed
if currentRun == run then currentRun = nil; running = false end
if run.cancelled then report("Fling stopped.") end
end)
return true
end
function Fling.Stop()
if currentRun then currentRun.cancelled = true end
end
function Fling.IsRunning()
return running
end
function Fling.Destroy()
destroyed, loopEnabled = true, false
Fling.Stop()
Fling.SetAntiFling(false)
end
return Fling
end)()
_G.KAMUI_FlingService = Fling
local state = { enabled = false, selected = nil, loop = false, anti = false, status = "Select a player." }
local bridge = {}
_G.KAMUI_FlingBridge = bridge
local manualQueue, workerRunning, activeKind, nextLoop = {}, false, nil, 0
local function report(message) state.status = message end
local function ensureWorker()
if workerRunning then return end
workerRunning = true
task.spawn(function()
while isCurrent() and state.enabled do
local target, kind
if #manualQueue > 0 then
target, kind = table.remove(manualQueue, 1), "manual"
elseif state.loop and state.selected and state.selected.Parent == Players and tick() >= nextLoop then
target, kind = state.selected, "loop"
elseif not state.loop then
break
end
if target then
activeKind = kind
Fling.SetLoop(false)
local ok, err = Fling.Start(target, report)
if not ok then state.status = err or "Unable to start Fling." end
if ok then
while Fling.IsRunning() and isCurrent() do task.wait(0.05) end
end
if kind == "loop" then nextLoop = tick() + 3 end
activeKind = nil
else
task.wait(0.1)
end
end
workerRunning = false
end)
end
function bridge.enabled() return state.enabled end
function bridge.setEnabled(value)
state.enabled = value == true
if not state.enabled then
state.loop = false; table.clear(manualQueue); Fling.Stop()
end
end
function bridge.loop() return state.loop end
function bridge.setLoop(value)
if not value then
state.loop = false
if activeKind == "loop" then Fling.Stop() end
return
end
if not state.enabled or not state.selected then state.status = "Select a player first."; return end
state.loop = true; nextLoop = 0; ensureWorker()
end
function bridge.anti() return state.anti end
function bridge.setAnti(value)
state.anti = value == true
Fling.SetAntiFling(state.anti)
end
function bridge.action()
if not state.enabled then return end
if not state.selected then state.status = "Select a player first."; return end
table.insert(manualQueue, state.selected)
ensureWorker()
end
function bridge.isRunning() return Fling.IsRunning() end
function bridge.status() return state.status end
