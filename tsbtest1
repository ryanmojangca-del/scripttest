local targetRow, actionRow = _G.KAMUI_BuildFlingRows(nil, {
    chip = Color3.fromRGB(20, 20, 22), text = THEME.Text, muted = THEME.MutedText,
    accent = THEME.Red, alwaysVisible = true,
})
addRow(actionRow, 39)
addRow(targetRow, 39)
local paintLoop = makeToggle("FlingLoopToggle", "Loop Fling", fling.loop, fling.setLoop)
local paintAnti = makeToggle("FlingAntiToggle", "Anti Fling", fling.anti, fling.setAnti)
local elapsed, lastLoop, lastAnti = 0, fling.loop(), fling.anti()
local sync = RunService.Heartbeat:Connect(function(dt)
    elapsed = elapsed + dt
    if elapsed < 0.15 or not isCurrent() then return end
    elapsed = 0
    if lastLoop ~= fling.loop() then lastLoop = fling.loop(); paintLoop(false) end
    if lastAnti ~= fling.anti() then lastAnti = fling.anti(); paintAnti(false) end
end)
ScreenGui.Destroying:Connect(function()
    sync:Disconnect()
    if _G.KAMUI_FlingOnlyGui == ScreenGui then _G.KAMUI_FlingOnlyGui = nil end
    if _G.KAMUI_FlingOnlyId == instanceId then _G.KAMUI_FlingOnlyId = nil end
end)
