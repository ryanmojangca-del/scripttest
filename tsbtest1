local opened, optionCount = false, 0
local function showList(on)
opened = on and state.enabled
list.Visible = opened
chevron.Rotation = opened and 180 or 0
if not opened then return end
local desired = math.min(listHeight, math.max(1, optionCount) * optionHeight + 8)
local scale = choose.AbsoluteSize.Y / math.max(buttonHeight, 1)
if scale < 0.01 then scale = 1 end
local top, bottom = 0, (workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize.Y) or 10000
local ancestor = choose.Parent
while ancestor do
if ancestor:IsA("GuiObject") and (ancestor.ClipsDescendants or ancestor:IsA("ScrollingFrame")) then
top = math.max(top, ancestor.AbsolutePosition.Y)
bottom = math.min(bottom, ancestor.AbsolutePosition.Y + ancestor.AbsoluteSize.Y)
end
ancestor = ancestor.Parent
end
local above = math.max(0, (choose.AbsolutePosition.Y - top) / scale - 4)
local below = math.max(0, (bottom - (choose.AbsolutePosition.Y + choose.AbsoluteSize.Y)) / scale - 4)
local openUp = below < desired and above > below
local available = openUp and above or below
local actual = math.max(1, math.min(desired, math.floor(available)))
list.Size = UDim2.new(1, 0, 0, actual)
list.Position = openUp and UDim2.new(0, 0, 0, -actual - 4) or UDim2.new(0, 0, 1, 4)
end
local function refreshPlayers()
if not targetRow.Parent then return end
if state.selected and state.selected.Parent ~= Players then state.selected = nil end
for _, child in ipairs(list:GetChildren()) do if child:IsA("GuiObject") then child:Destroy() end end
local candidates = {}
for _, p in ipairs(Players:GetPlayers()) do if p ~= Players.LocalPlayer then table.insert(candidates, p) end end
table.sort(candidates, function(a, b) return a.Name:lower() < b.Name:lower() end)
optionCount = #candidates
if opened then showList(true) end
if #candidates == 0 then
make("TextLabel", { BackgroundTransparency = 1, Size = UDim2.new(1, -4, 0, optionHeight),
Text = "No other players", Font = Enum.Font.Gotham, TextSize = fs,
TextColor3 = muted, ZIndex = z + 5 }, list)
end
for i, p in ipairs(candidates) do
local item = make("TextButton", { LayoutOrder = i, Size = UDim2.new(1, 0, 0, optionHeight),
