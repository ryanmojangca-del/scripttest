--// MOVEMENT SETTINGS: DASH MULTIPLIER (toggle + Distance slider)
--// Distance scales the velocity of the game's dash (the "dodgevelocity" mover that appears in
--// your HumanoidRootPart while you dash), 0x - 10x. The dash time stays the same, so the
--// distance travelled scales by exactly that factor. 1.00x = normal: the script does nothing.
--// It only affects YOUR dashes, never the ones this script performs (fireDash stamps the time
--// with _G.KAMUI_MarkScriptDash; a dash mover that shows up right after is the script's).
--// Debug: run `_G.KAMUI_DebugDash = true` first to print every dash mover and who it belongs to.
_G.KAMUI_Movement = { Enabled = true, Distance = 1.0, DistMin = 0, DistMax = 10, NoSideCD = false, NoStun = false, NoFatigue = false,
    SJEnabled = false, WalkSpeed = 25, JumpPower = 50,
    Blinking = false, BlinkMax = 2.0, BlinkKey = "X", AutoStop = false, BlinkMobile = false, BlinkCapturing = false,
    FakeLag = false, FakeLagMs = 50, FakeLagKey = "Z", FakeLagMobile = false, FakeLagCapturing = false }
for _, c in ipairs(_G.KAMUI_MovementConns or {}) do
    pcall(function()
        c:Disconnect()
    end)
end
_G.KAMUI_MovementConns = {}
do
    local M = _G.KAMUI_Movement
    local conns = _G.KAMUI_MovementConns
    local SCRIPT_WINDOW = 0.8 -- a dash mover appearing this soon after fireDash() = script dash
    local states = setmetatable({}, { __mode = "k" }) -- dash mover -> { base, last, script, applied }

    local function velProp(m)
        return m:IsA("LinearVelocity") and "VectorVelocity" or "Velocity"
    end
    local function findDash(root)
        local d = root:FindFirstChild("dodgevelocity")
        if d then
            return d
        end
        for _, c in ipairs(root:GetChildren()) do
            if c:IsA("BodyVelocity") or c:IsA("LinearVelocity") then
                local n = string.lower(c.Name)
                if n:find("dodge") or n:find("dash") then
                    return c
                end
            end
        end
        return nil
    end

    local function updateDashMultiplier()
        if not isCurrent() then
            return
        end
        local char = player.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not root then
            return
        end
        local dash = findDash(root)
        if not dash or not (dash:IsA("BodyVelocity") or dash:IsA("LinearVelocity")) then
            return
        end
        local prop = velProp(dash)
        local cur = dash[prop]
        local st = states[dash]
        if not st then
            --// first frame we see this dash: whose is it?
            st = {
                base = cur, last = cur, applied = false,
                script = (os.clock() - (_G.KAMUI_ScriptDashAt or -math.huge)) <= SCRIPT_WINDOW
            }
            states[dash] = st
            if _G.KAMUI_DebugDash then
                print("[KAMUI dash] mover:", dash.ClassName, dash.Name, st.script and "(script dash - untouched)" or "(your dash)")
            end
        end
        local mult = M.Distance
        local active = M.Enabled and not st.script and type(mult) == "number" and math.abs(mult - 1) >= 0.001
        if not active then
            if st.applied then -- turned off / reset mid-dash: give the normal speed back
                dash[prop] = st.base
                st.last = st.base
                st.applied = false
            end
            return
        end
        if (cur - st.last).Magnitude > 0.05 then
            st.base = cur -- the game changed it: that is the new unscaled value
        end
        local scaled = st.base * mult
        st.last = scaled
        st.applied = true
        dash[prop] = scaled
    end

    -- Touch dashes are updated before physics to reduce the chance that the
    -- mobile game's movement code overwrites the multiplier before simulation.
    -- Keyboard/mouse input keeps the original Heartbeat behavior.
    local function isTouchInput()
        return UIS.TouchEnabled and UIS:GetLastInputType() == Enum.UserInputType.Touch
    end
    conns[#conns + 1] = RunService.PreSimulation:Connect(function()
        if isTouchInput() then updateDashMultiplier() end
    end)
    conns[#conns + 1] = RunService.Heartbeat:Connect(function()
        if not isTouchInput() then updateDashMultiplier() end
    end)
end

--// NO SIDE DASH COOLDOWN (toggle lives in the Movement tab, inside the Dash multiplier card)
--// Ported from the Rage tab of the other script. While ON it:
--//   1) sets your character attribute CustomSideDashCooldown to 0,
--//   2) sets the workspace flags NoDashCooldown = true / EffectAffects = 1 (the game's no-cooldown switch),
--//   3) destroys the dash cooldown markers (UsedDash / InDash / DashCooldown / SideDashCooldown) on your character.
--// Turning it OFF puts the workspace flags back to the values the game had and clears the attribute.
do
    local M = _G.KAMUI_Movement
    local conns = _G.KAMUI_MovementConns
    local MARKERS = { UsedDash = true, InDash = true, DashCooldown = true, SideDashCooldown = true }
    --// kept in _G so re-running the script can still restore the game's real values
    local orig = _G.KAMUI_NoSideCDOrig
    if not orig then
        orig = { captured = false }
        _G.KAMUI_NoSideCDOrig = orig
    end

    local function setServerFlags(on)
        pcall(function()
            if on then
                if not orig.captured then
                    orig.captured = true
                    orig.noDash = Workspace:GetAttribute("NoDashCooldown")
                    orig.effect = Workspace:GetAttribute("EffectAffects")
                end
                if Workspace:GetAttribute("NoDashCooldown") ~= true then
                    Workspace:SetAttribute("NoDashCooldown", true)
                end
                if Workspace:GetAttribute("EffectAffects") ~= 1 then
                    Workspace:SetAttribute("EffectAffects", 1)
                end
            elseif orig.captured then
                orig.captured = false
                Workspace:SetAttribute("NoDashCooldown", orig.noDash)
                Workspace:SetAttribute("EffectAffects", orig.effect)
            end
        end)
    end
    local function clearAttr(char)
        pcall(function()
            char:SetAttribute("CustomSideDashCooldown", nil)
            char:SetAttribute("AfterimageDash", nil)
        end)
    end

    --// a fresh run starts with the toggle OFF: give back anything an earlier run changed
    setServerFlags(false)

    --// kill the cooldown markers the moment the game adds them to your character
    local function hook(char)
        conns[#conns + 1] = char.DescendantAdded:Connect(function(d)
            if isCurrent() and M.NoSideCD and MARKERS[d.Name] then
                task.defer(function()
                    pcall(d.Destroy, d)
                end)
            end
        end)
    end
    if player.Character then
        hook(player.Character)
    end
    conns[#conns + 1] = player.CharacterAdded:Connect(hook)

    local wasOn = false
    conns[#conns + 1] = RunService.Heartbeat:Connect(function()
        if not isCurrent() then
            return
        end
        local char = player.Character
        if not M.NoSideCD then
            if wasOn then -- just turned off
                wasOn = false
                setServerFlags(false)
                if char then
                    clearAttr(char)
                end
            end
            return
        end
        wasOn = true
        setServerFlags(true)
        if not char then
            return
        end
        if char:GetAttribute("CustomSideDashCooldown") ~= 0 then
            pcall(char.SetAttribute, char, "CustomSideDashCooldown", 0)
        end
        for name in pairs(MARKERS) do
            local o = char:FindFirstChild(name)
            if o then
                pcall(o.Destroy, o)
            end
        end
    end)
end

--// NO STUN + NO FATIGUE (two separate toggles in the Movement tab, ported from the Rage tab of the other script)
--//   No stun    : destroys the "Freeze" stun marker as soon as the game puts it on your character.
--//   No fatigue : keeps your Humanoid JumpPower at 50 (the game lowers it while you are fatigued). It stays out of
--//                the way while you are in a state the game should control (Counter, HunterCounter, emotes,
--//                BeingLaunched, Ragdoll, Freeze, BarrageBind) or when the game marks you with NoJump.
do
    local M = _G.KAMUI_Movement
    local conns = _G.KAMUI_MovementConns
    local BLOCKERS = {
        "Counter", "HunterCounter", "DoingEmote", "CancelEmote", "CancelEmote2",
        "BeingLaunched", "Ragdoll", "Freeze", "BarrageBind", "NoJump"
    }
    local function blocked(char)
        for _, name in ipairs(BLOCKERS) do
            if char:FindFirstChild(name) then
                return true
            end
        end
        return false
    end

    --// remove Freeze the moment it appears (any depth under your character)
    local function hook(char)
        conns[#conns + 1] = char.DescendantAdded:Connect(function(d)
            if isCurrent() and M.NoStun and d.Name == "Freeze" then
                task.defer(function()
                    pcall(d.Destroy, d)
                end)
            end
        end)
    end
    if player.Character then
        hook(player.Character)
    end
    conns[#conns + 1] = player.CharacterAdded:Connect(hook)

    conns[#conns + 1] = RunService.Heartbeat:Connect(function()
        if not isCurrent() then
            return
        end
        if not (M.NoStun or M.NoFatigue) then
            return
        end
        local char = player.Character
        if not char then
            return
        end
        if M.NoStun then
            local f = char:FindFirstChild("Freeze")
            if f then
                pcall(f.Destroy, f)
            end
        end
        if M.NoFatigue then
            local hum = char:FindFirstChildOfClass("Humanoid")
            local target = M.SJEnabled and M.JumpPower or 50 -- follows the custom jump height when that is on
            if hum and hum.JumpPower ~= target and not blocked(char) then
                pcall(function()
                    hum.UseJumpPower = true
                    hum.JumpPower = target
                end)
            end
        end
    end)

    --// WALKSPEED / JUMP HEIGHT: while enabled, holds Humanoid.WalkSpeed and JumpPower at the slider values.
    --// Same hands-off rule as No fatigue (blocked states). Turning it off puts back the normal 16 / 50 once.
    local wasOn = false
    local function updateWalkJump()
        if not isCurrent() then
            return
        end
        local char = player.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not hum then
            return
        end
        if M.SJEnabled then
            wasOn = true
            if not blocked(char) then
                pcall(function()
                    if hum.WalkSpeed ~= M.WalkSpeed then
                        hum.WalkSpeed = M.WalkSpeed
                    end
                    if hum.JumpPower ~= M.JumpPower or not hum.UseJumpPower then
                        hum.UseJumpPower = true
                        hum.JumpPower = M.JumpPower
                    end
                end)
            end
        elseif wasOn then
            wasOn = false
            pcall(function()
                hum.WalkSpeed = 16
                hum.JumpPower = 50
            end)
        end
    end
    -- For touch input, set properties before physics. Keep the original
    -- Heartbeat timing for keyboard/mouse and preserve all blocker checks.
    local function isTouchWalkJump()
        return UIS.TouchEnabled and UIS:GetLastInputType() == Enum.UserInputType.Touch
    end
    conns[#conns + 1] = RunService.PreSimulation:Connect(function()
        if isTouchWalkJump() then updateWalkJump() end
    end)
    conns[#conns + 1] = RunService.Heartbeat:Connect(function()
        if not isTouchWalkJump() then updateWalkJump() end
    end)

    -- Mobile fallback: if the game ignores JumpPower, apply the selected
    -- vertical speed once when a genuine humanoid jump begins. Never creates
    -- jumps itself, and preserves the same blocker checks as WalkSpeed.
    local jumpConn, pendingJump = nil, nil
    local function hookMobileJump(char)
        if jumpConn then jumpConn:Disconnect(); jumpConn = nil end
        pendingJump = nil
        task.spawn(function()
            local hum = char:FindFirstChildOfClass("Humanoid") or char:WaitForChild("Humanoid", 10)
            if not isCurrent() or player.Character ~= char or not hum or not hum:IsA("Humanoid") then return end
            jumpConn = hum.StateChanged:Connect(function(_, newState)
                if isCurrent() and player.Character == char and newState == Enum.HumanoidStateType.Jumping
                    and isTouchWalkJump() and M.SJEnabled and not M.Blinking and not blocked(char)
                    and math.abs(M.JumpPower - 50) > 0.001 then
                    pendingJump = { char = char, hum = hum, started = os.clock() }
                end
            end)
            conns[#conns + 1] = jumpConn
        end)
    end
    if player.Character then hookMobileJump(player.Character) end
    conns[#conns + 1] = player.CharacterAdded:Connect(hookMobileJump)
    conns[#conns + 1] = RunService.PreSimulation:Connect(function()
        local pending = pendingJump
        if not pending then return end
        pendingJump = nil -- one correction for each detected jump
        if not isCurrent() or player.Character ~= pending.char or not isTouchWalkJump()
            or not M.SJEnabled or M.Blinking or blocked(pending.char)
            or pending.hum.Health <= 0 or os.clock() - pending.started > 0.15 then return end
        local state = pending.hum:GetState()
        if state ~= Enum.HumanoidStateType.Jumping and state ~= Enum.HumanoidStateType.Freefall then return end
        local root = pending.char:FindFirstChild("HumanoidRootPart")
        if root and not root.Anchored then
            pcall(function()
                local velocity = root.AssemblyLinearVelocity
                root.AssemblyLinearVelocity = Vector3.new(velocity.X, math.max(0, M.JumpPower), velocity.Z)
            end)
        end
    end)
end

--// BLINK (Movement tab) - freeze in place, then snap to the new position
--// While ON:
--//   * your REAL character is frozen: its root is anchored on your client, so it stops sending physics updates and
--//     the server / other players keep seeing you standing where you started (you still see it as a "ghost"),
--//   * you move a LOCAL-ONLY clone of your character (Player.Character + camera point at the clone).
--// When you turn it OFF the real character is teleported to where the clone is, un-anchored, and you control it
--// again - everyone else sees you jump to the new spot.
--//   * Press the Blink keybind (default X, changeable in the Movement tab) or the on-screen button (Mobile mode).
--//   * Auto Stop (toggle): when ON it auto-releases after M.BlinkMax seconds (slider); when OFF the slider is ignored.
--//   * Always releases when either body dies, on respawn and on re-execute.
--// Heads up: while blinking, the frozen real body can still be hit by other players, and the game's server only
--// knows about the real body (abilities / dashes come from it). The console prints what happens;
--// `_G.KAMUI_DebugBlink = true` adds extra detail.
do
    local M = _G.KAMUI_Movement
    local conns = _G.KAMUI_MovementConns
    local startedAt = 0
    local S = nil -- state while blinking

    --// Swapping Player.Character makes Roblox reset every ScreenGui that has ResetOnSpawn = true, which wipes the
    --// game's HUD (skills 1-4, awakening bar). The game only fills it in when the server spawns you, so it never
    --// comes back. Fix: switch ResetOnSpawn off on the HUD guis while blinking and give the old value back afterwards.
    local keepGuis = {} -- gui -> its original ResetOnSpawn
    local function lockGuis()
        local pg = player:FindFirstChildOfClass("PlayerGui")
        if not pg then
            return
        end
        for _, g in ipairs(pg:GetChildren()) do
            if g:IsA("ScreenGui") and keepGuis[g] == nil then
                keepGuis[g] = g.ResetOnSpawn
                g.ResetOnSpawn = false
            end
        end
    end
    local function unlockGuis()
        for g, was in pairs(keepGuis) do
            if g.Parent then
                g.ResetOnSpawn = was
            end
            keepGuis[g] = nil
        end
    end

    local function cam()
        return Workspace.CurrentCamera
    end

    local function finish()
        local st = S
        if not st then
            return
        end
        S = nil
        for _, c in ipairs(st.conns) do
            pcall(function()
                c:Disconnect()
            end)
        end
        local cf, vel
        if st.cRoot and st.cRoot.Parent then
            cf = st.cRoot.CFrame
            vel = st.cRoot.AssemblyLinearVelocity
        end
        local realAlive = st.char.Parent ~= nil and st.root.Parent ~= nil and st.hum.Health > 0
        if realAlive then
            -- Mobile mirroring never changes Player.Character; don't trigger a
            -- second character swap when finishing that variant.
            if not st.mobileCloneDriving then
                player.Character = st.char
            end
            for part, was in pairs(st.collide) do
                if part.Parent then
                    part.CanCollide = was
                end
            end
            if cf then
                st.root.CFrame = cf -- while still anchored: no physics fight
            end
            st.root.Anchored = st.anchored
            if vel then
                st.root.AssemblyLinearVelocity = vel
            end
            local c = cam()
            if c then
                c.CameraSubject = st.hum
            end
        end
        pcall(function()
            st.clone:Destroy()
        end)
        -- Mobile: attempt to reconnect Roblox's standard controls after restoring the real character.
        -- This does not recreate or modify game-specific action button scripts.
        if UIS.TouchEnabled and M.BlinkMobile and realAlive and not st.mobileCloneDriving then
            task.delay(0.3, function()
                if not isCurrent() or S or player.Character ~= st.char then return end
                pcall(function()
                    local scripts = player:FindFirstChild("PlayerScripts")
                    local module = scripts and scripts:FindFirstChild("PlayerModule")
                    if not module then return end
                    local controls = require(module):GetControls()
                    if controls then controls:Enable() end
                end)
            end)
        end
        task.delay(1.5, function()
            if not S then
                unlockGuis()
            end
        end)
    end
    --// so a re-execution while blinking can put things back
    if _G.KAMUI_BlinkFinish then
        pcall(_G.KAMUI_BlinkFinish)
    end
    _G.KAMUI_BlinkFinish = finish

    --// returns true, or false + reason
    local function begin()
        local char = player.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not (hum and root) or hum.Health <= 0 then
            return false, "no living character"
        end
        local prevArch = char.Archivable
        char.Archivable = true
        local ok, clone = pcall(function()
            return char:Clone()
        end)
        char.Archivable = prevArch
        if not ok or not clone then
            return false, "could not clone the character"
        end
        local cHum = clone:FindFirstChildOfClass("Humanoid")
        local cRoot = clone:FindFirstChild("HumanoidRootPart")
        if not (cHum and cRoot) then
            pcall(function()
                clone:Destroy()
            end)
            return false, "clone has no Humanoid / HumanoidRootPart"
        end
        local st = {
            char = char, hum = hum, root = root, clone = clone, cHum = cHum, cRoot = cRoot,
            collide = {}, anchored = root.Anchored, conns = {}
        }
        --// the frozen real body must not push the clone around (client-side only, the server is unaffected)
        for _, d in ipairs(char:GetDescendants()) do
            if d:IsA("BasePart") then
                st.collide[d] = d.CanCollide
                d.CanCollide = false
            end
        end
        root.Anchored = true -- the freeze: no more position updates leave your client
        cRoot.CFrame = root.CFrame
        clone.Parent = Workspace
        S = st
        -- On mobile, leave the real character assigned so the game's action
        -- buttons do not rebind to the temporary clone. Mirror movement to it.
        st.mobileCloneDriving = UIS.TouchEnabled and M.BlinkMobile
        if st.mobileCloneDriving then
            st.conns[#st.conns + 1] = RunService.Heartbeat:Connect(function()
                if S ~= st or player.Character ~= char or not hum.Parent
                    or hum.Health <= 0 or not cHum.Parent or cHum.Health <= 0 then return end
                pcall(function()
                    cHum:Move(hum.MoveDirection, false)
                    if hum.Jump then cHum.Jump = true end
                end)
            end)
            st.conns[#st.conns + 1] = hum:GetPropertyChangedSignal("Jump"):Connect(function()
                if S == st and hum.Jump and cHum.Parent then
                    pcall(function() cHum.Jump = true end)
                end
            end)
        else
            lockGuis()
            player.Character = clone
        end
        local c = cam()
        if c then
            c.CameraSubject = cHum
        end
        st.conns[#st.conns + 1] = hum.Died:Connect(function()
            M.BlinkSet(false)
        end)
        st.conns[#st.conns + 1] = cHum.Died:Connect(function()
            M.BlinkSet(false)
        end)
        return true
    end

    --// on = true: start blinking, on = false: release
    M.BlinkSet = function(on)
        on = on and true or false
        if on == M.Blinking then
            return
        end
        if on then
            local ok, why = begin()
            if not ok then
                warn("[KAMUI blink] could not start: " .. tostring(why))
                if M.BlinkPaint then
                    pcall(M.BlinkPaint)
                end
                return
            end
            startedAt = os.clock()
            M.Blinking = true
            print("[KAMUI blink] ON - real body frozen, you control the clone")
        else
            M.Blinking = false
            finish()
            print("[KAMUI blink] released - snapped to the new position")
        end
        if M.BlinkPaint then
            pcall(M.BlinkPaint)
        end
    end

    conns[#conns + 1] = RunService.Heartbeat:Connect(function()
        if not isCurrent() then
            return
        end
        if M.Blinking and M.AutoStop and (os.clock() - startedAt) >= (M.BlinkMax or 2) then
            M.BlinkSet(false)
        end
    end)

    conns[#conns + 1] = UIS.InputBegan:Connect(function(input, processed)
        if not isCurrent() then
            return
        end
        --// the keybind chip in the Movement tab was clicked: the next key pressed becomes the Blink key
        if M.BlinkCapturing and input.UserInputType == Enum.UserInputType.Keyboard then
            M.BlinkCapturing = false
            if input.KeyCode ~= Enum.KeyCode.Escape then
                M.BlinkKey = input.KeyCode.Name
            end
            if M.BlinkKeyPaint then
                pcall(M.BlinkKeyPaint)
            end
            return
        end
        if processed or UIS:GetFocusedTextBox() or M.FakeLagCapturing then
            return
        end
        if input.UserInputType == Enum.UserInputType.Keyboard and M.BlinkKey ~= "None" and input.KeyCode.Name == M.BlinkKey then
            M.BlinkSet(not M.Blinking)
        end
    end)

    --// a character that is neither the real one nor our clone = the server respawned you: drop the blink
    conns[#conns + 1] = player.CharacterAdded:Connect(function(c)
        if S and (c == S.clone or c == S.char) then
            return
        end
        if M.Blinking then
            M.BlinkSet(false)
        end
    end)
end

--// FAKE LAG (Movement tab) - adds ping while ON
--// Uses settings().Network.IncomingReplicationLag (seconds): everything the server sends you arrives that much later,
--// so your connection behaves like it has +N ms of ping. Slider = N (50 - 5000 ms), tap the number to type an exact value.
--//   * Toggle it with the keybind (default Z, changeable in the Movement tab), the switch, or the on-screen button (Mobile mode).
--//   * The original value is put back when you turn it OFF and when the script is destroyed / re-executed.
--//   * If your executor does not allow settings().Network the console says so and it stays OFF.
do
    local M = _G.KAMUI_Movement
    local conns = _G.KAMUI_MovementConns
    local original = nil -- IncomingReplicationLag before we touched it

    local function net()
        local ok, n = pcall(function()
            return settings().Network
        end)
        if ok and n then
            return n
        end
        return nil
    end

    local function restore()
        local n = net()
        if n and original ~= nil then
            pcall(function()
                n.IncomingReplicationLag = original
            end)
        end
        original = nil
    end
    --// a re-execution while Fake lag is on puts the old value back first
    if _G.KAMUI_FakeLagRestore then
        pcall(_G.KAMUI_FakeLagRestore)
    end
    _G.KAMUI_FakeLagRestore = restore

    --// returns true, or false + reason
    local function apply()
        local n = net()
        if not n then
            return false, "settings().Network is not available in this executor"
        end
        local ok, err = pcall(function()
            if original == nil then
                original = n.IncomingReplicationLag
            end
            n.IncomingReplicationLag = math.clamp(M.FakeLagMs or 50, 0, 5000) / 1000
        end)
        if not ok then
            original = nil
            return false, tostring(err)
        end
        return true
    end

    --// called by the slider: re-applies the new ms while Fake lag is ON
    M.FakeLagApply = function()
        if M.FakeLag then
            apply()
        end
    end

    M.FakeLagSet = function(on)
        on = on and true or false
        if on == M.FakeLag then
            return
        end
        if on then
            local ok, why = apply()
            if not ok then
                warn("[KAMUI fakelag] could not start: " .. tostring(why))
                if M.FakeLagPaint then
                    pcall(M.FakeLagPaint)
                end
                return
            end
            M.FakeLag = true
            print("[KAMUI fakelag] ON - +" .. tostring(M.FakeLagMs) .. " ms")
        else
            M.FakeLag = false
            restore()
            print("[KAMUI fakelag] OFF")
        end
        if M.FakeLagPaint then
            pcall(M.FakeLagPaint)
        end
    end

    conns[#conns + 1] = UIS.InputBegan:Connect(function(input, processed)
        if not isCurrent() then
            return
        end
        --// the keybind chip in the Movement tab was clicked: the next key pressed becomes the Fake lag key
        if M.FakeLagCapturing and input.UserInputType == Enum.UserInputType.Keyboard then
            M.FakeLagCapturing = false
            if input.KeyCode ~= Enum.KeyCode.Escape then
                M.FakeLagKey = input.KeyCode.Name
            end
            if M.FakeLagPaint then
                pcall(M.FakeLagPaint)
            end
            return
        end
        if processed or UIS:GetFocusedTextBox() or M.BlinkCapturing then
            return
        end
        if input.UserInputType == Enum.UserInputType.Keyboard and M.FakeLagKey ~= "None" and input.KeyCode.Name == M.FakeLagKey then
            M.FakeLagSet(not M.FakeLag)
        end
    end)
end


