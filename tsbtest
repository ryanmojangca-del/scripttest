                TextColor3 = THEME.Text,
                TextXAlignment = Enum.TextXAlignment.Left,
                Text = label
            }, row)
            if sub then
                UI.subtitle(row, sub, 184)
            end
            local box = mk("Frame", {
                BackgroundColor3 = CHIP,
                BorderSizePixel = 0,
                AnchorPoint = Vector2.new(1, 0.5),
                Position = UDim2.new(1, -12, 0.5, 0),
                Size = UDim2.new(0, 160, 0, 26)
            }, row)
