                    if type(sv) == type(dv) then
                        if OPT[k] then
                            if table.find(OPT[k], sv) then
                                CFG[k] = sv
                            end
                        elseif RANGE[k] then
                            CFG[k] = math.clamp(sv, RANGE[k][1], RANGE[k][2])
