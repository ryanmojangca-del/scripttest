_G.KAMUI_LoadMusicTab = function()
    local tab = _G.KAMUI_MusicTab
    if tab.Loaded or tab.Loading then return end
    tab.Loading = true
    if not tab.Message then
        local message = Instance.new("TextLabel")
        message.Name = "MusicLoadMessage"
        message.Parent = tab.Page
        message.Size = UDim2.new(1, -24, 0, 78)
        message.Position = UDim2.new(0, 12, 0, 16)
        message.BackgroundTransparency = 1
        message.TextColor3 = THEME.MutedText
        message.Font = Enum.Font.Gotham
        message.TextSize = 11
        message.TextWrapped = true
        message.TextXAlignment = Enum.TextXAlignment.Left
        tab.Message = message
    end
    tab.Message.TextColor3 = THEME.MutedText
    tab.Message.Text = "Loading music player..."
    task.spawn(function()
        local callOk, fn, loadErr = pcall(_G.KAMUI_LoadModule, "Music")
        if not isCurrent() or _G.KAMUI_MusicTab ~= tab or not ScreenGui.Parent then return end
        if not callOk then loadErr = fn; fn = nil end
        if not fn then
            tab.Loading = false
            tab.Message.TextColor3 = THEME.BrightRed
            tab.Message.Text = "Music could not load: " .. tostring(loadErr) .. "\nCheck the raw GitHub link, then click Music to retry."
            return
        end
        local ran, built, buildErr = pcall(fn, {
            UIS = UIS, RunService = RunService, HttpService = HttpService,
            TweenService = TweenService, ScreenGui = ScreenGui
        })
        if not isCurrent() or _G.KAMUI_MusicTab ~= tab or not ScreenGui.Parent then return end
        tab.Loading = false
        if not ran or built ~= true then
            if type(_G.KamuiMusicCleanup) == "function" then pcall(_G.KamuiMusicCleanup) end
            for _, child in ipairs(tab.Page:GetChildren()) do
                if child ~= tab.Message then child:Destroy() end
            end
            tab.Message.TextColor3 = THEME.BrightRed
            tab.Message.Text = "Music setup failed: " .. tostring(ran and buildErr or built) .. "\nClick Music to retry."
            return
        end
        tab.Loaded = true
        tab.Message:Destroy()
        tab.Message = nil
    end)
end
