        local function isRight()
            return CFG.Corner == "TR" or CFG.Corner == "BR"
        end
        local function isBottom()
            return CFG.Corner == "BR" or CFG.Corner == "BL"
        end
        local function placeHolder()
            local r, b = isRight(), isBottom()
            holder.AnchorPoint = Vector2.new(r and 1 or 0, b and 1 or 0)
            holder.Position = UDim2.new(r and 1 or 0, r and -CFG.OffX or CFG.OffX, b and 1 or 0, b and -CFG.OffY or CFG.OffY)
