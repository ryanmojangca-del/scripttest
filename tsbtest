    mk("TextLabel", {Text="−",Size=UDim2.new(1,0,0,15),Position=UDim2.fromOffset(0,28),
        BackgroundTransparency=1,Font=Enum.Font.Gotham,TextSize=14,TextColor3=PAL.Text,ZIndex=12},mini)
    local miniDragging,miniStart,miniPos,miniMoved,miniInput=false,nil,nil,false,nil
    mini.InputBegan:Connect(function(input)
        if isPress(input) then miniDragging=true; miniStart=input.Position; miniPos=mini.Position; miniMoved=false; miniInput=input end
    end)
    conns[#conns+1]=UserInputService.InputChanged:Connect(function(input)
        if miniDragging and ((miniInput.UserInputType==Enum.UserInputType.MouseButton1 and input.UserInputType==Enum.UserInputType.MouseMovement) or input==miniInput) then
            local d=input.Position-miniStart
            if d.Magnitude>3 then miniMoved=true end
            mini.Position=UDim2.new(miniPos.X.Scale,miniPos.X.Offset+d.X,miniPos.Y.Scale,miniPos.Y.Offset+d.Y)
        end
    end)
    conns[#conns+1]=UserInputService.InputEnded:Connect(function(input)
        if miniDragging and (input==miniInput or (miniInput.UserInputType==Enum.UserInputType.MouseButton1 and input.UserInputType==Enum.UserInputType.MouseButton1)) then
            miniDragging=false
            if not miniMoved and mini.Visible then panel.Position=mini.Position; mini.Visible=false; panel.Visible=true end
        end
    end)
    miniChip.MouseButton1Click:Connect(function()
        if editing then editing=false; paintEdit() end
        main.Visible=false; mini.Position=panel.Position; panel.Visible=false; mini.Visible=true
    end)
end
