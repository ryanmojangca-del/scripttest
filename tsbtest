local function loadProfileData(data)
    if not data then
        return
    end
    Config.LethalDelay = data.LethalDelay
    Config.LethalJump = data.LethalJump
    Config.LethalAccuracy = data.LethalAccuracy
    Config.LethalCancelDelay = data.LethalCancelDelay
    Config.LethalMode = data.LethalMode
    Config.MagnetDelay = data.MagnetDelay
    FloaterMode = data.FloaterMode
    Config.DashRange = data.DashRange
    if data.Keybind ~= nil then
        Config.Keybind = data.Keybind
    end
    Config.TouchMode = data.TouchMode
    Config.Platform = data.Platform
    Config.CooldownActive = data.CooldownActive
    Config.CamSmooth = data.CamSmooth
    if Config.LethalMode == "Draw" then
        Config._DrawCamSmooth = Config.CamSmooth
    else
        Config._OtherCamSmooth = Config.CamSmooth
    end
    if not Config.CamSmooth then stopCamSmooth() end
    Config.CamSmoothDelay = data.CamSmoothDelay
    Config.CamDuration = data.CamDuration
    if data.DrawPts ~= nil and _G.KAMUI_DrawUI then
        _G.KAMUI_DrawUI.setPts(_G.KAMUI_Draw.decode(data.DrawPts))
    end
    refreshSettingsUI()
end

