--// Virtual keys we press are remembered, so a macro that gets cut short (death,
--// respawn, error) can never leave a key stuck down. Releases only what is held.
local heldKeys = {}
local conns = {}
local mobileCancel = function() end
local function sendKeyEvent(key)
    heldKeys[key] = true
    VirtualInputManager:SendKeyEvent(true, key, false, game)
end
local function tapKey(key)
    heldKeys[key] = nil
    VirtualInputManager:SendKeyEvent(false, key, false, game)
end
local function releaseHeldKeys()
    for key in pairs(heldKeys) do
        heldKeys[key] = nil
        pcall(function()
            VirtualInputManager:SendKeyEvent(false, key, false, game)
        end)
    end
end
local function setupCharacter(character)
    mobileCancel()
    releaseHeldKeys()
    camera = workspace.CurrentCamera
    currentCharacter = character
    currentHumanoid = character:WaitForChild("Humanoid", 10)
    currentRootPart = character:WaitForChild("HumanoidRootPart", 10)
    currentCommunicate = character:WaitForChild("Communicate", 10)
    currentAnimator = currentHumanoid and currentHumanoid:WaitForChild("Animator", 10)
end
if localPlayer.Character then
    setupCharacter(localPlayer.Character)
end
conns[#conns + 1] = localPlayer.CharacterAdded:Connect(setupCharacter)
local function tapKeyWithDelay(key)
    sendKeyEvent(key)
    task.wait()
