--// Muted icons that light up on hover. The close button turns bright red.
do
    local MUTED = THEME.MutedText
    local info = TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

    local function styleBtn(btn, hoverText, hoverBg, hoverBgT, line)
        btn.BackgroundColor3 = hoverBg
        btn.BackgroundTransparency = 1
        btn.AutoButtonColor = false
        btn.TextColor3 = MUTED
        btn.Font = Enum.Font.GothamMedium

        local corner = btn:FindFirstChildOfClass("UICorner")
        if corner then
            corner.CornerRadius = UDim.new(0, 6)
        end

        btn.MouseEnter:Connect(function()
            TweenService:Create(btn, info, {TextColor3 = hoverText, BackgroundTransparency = hoverBgT}):Play()
            if line then
                TweenService:Create(line, info, {BackgroundColor3 = hoverText}):Play()
            end
        end)

        btn.MouseLeave:Connect(function()
            TweenService:Create(btn, info, {TextColor3 = MUTED, BackgroundTransparency = 1}):Play()
            if line then
                TweenService:Create(line, info, {BackgroundColor3 = MUTED}):Play()
            end
        end)
    end

