        Name = "Title",
        Size = UDim2.new(1, -30, 1, 0),
        Position = UDim2.new(0, 30, 0, 0),
        BackgroundTransparency = 1,
        Font = Enum.Font.GothamMedium,
        TextSize = 11,
        TextColor3 = TEXT,
        TextXAlignment = Enum.TextXAlignment.Left,
        Text = "M1 reset & emote dash",
        TextTruncate = Enum.TextTruncate.AtEnd,
        ZIndex = 12,
    }, Header)
    movable(Header, Panel, nil)

    local MoveChip, MoveStroke = chip("Move", 42, -104)
    local MinChip = chip("−", 22, -56)
    local CloseChip = chip("×", 22, -28)
    MoveChip:SetAttribute("KamuiKeepColor", true)
    MoveStroke:SetAttribute("KamuiKeepColor", true)
    local function paintEditing()
        MoveChip.Text = editing and "Done" or "Move"
        MoveChip.BackgroundColor3 = editing and THEME.Red or CHIP
        MoveChip.TextColor3 = editing and WHITE or MUTED
        MoveStroke.Color = editing and THEME.Red or LINE
        for _, st in ipairs(strokes) do st.Color = editing and THEME.Red or LINE end
        panelStroke.Color = editing and THEME.Red or LINE
    end
    MoveChip.MouseButton1Click:Connect(function() editing = not editing; paintEditing() end)
    MUI.onColor(paintEditing)
    CloseChip.MouseButton1Click:Connect(function()
        if _G.KAMUI_M1Cleanup then
            _G.KAMUI_M1Cleanup()
        end
    end)

    -- A separate draggable circle restores the compact menu; action buttons stay visible.
    local Mini = mkm("TextButton", {
        Name="M1MobileMini", Size=UDim2.fromOffset(48,48), Position=Panel.Position,
        BackgroundColor3=PANEL, BorderSizePixel=0, AutoButtonColor=false,
        Text="", Visible=false, ZIndex=10,
    }, gui)
    applyCorner(Mini,24)
    local miniScale=Instance.new("UIScale"); miniScale.Scale=panelScale.Scale; miniScale.Parent=Mini
    MUI.makeBorder(Mini,24,miniScale)
    MUI.logo(Mini,UDim2.new(0.5,-10.5,0,6),UDim2.fromOffset(21,21),11)
    mkm("TextLabel", {BackgroundTransparency=1,Size=UDim2.new(1,0,0,15),
        Position=UDim2.fromOffset(0,27),Font=Enum.Font.GothamMedium,TextSize=15,
        TextColor3=TEXT,Text="−",ZIndex=12},Mini)
    MinChip.MouseButton1Click:Connect(function()
        Mini.Position=Panel.Position; Panel.Visible=false; Mini.Visible=true
    end)
    local miniDragging,miniMoved,miniStart,miniPos,miniInput=false,false,nil,nil,nil
    Mini.InputBegan:Connect(function(input)
        if isPress(input) then
            miniDragging,miniMoved,miniStart,miniPos,miniInput=true,false,input.Position,Mini.Position,input
        end
    end)
    conns[#conns+1]=UserInputService.InputChanged:Connect(function(input)
        local matches=input==miniInput or (miniInput and miniInput.UserInputType==Enum.UserInputType.MouseButton1
            and input.UserInputType==Enum.UserInputType.MouseMovement)
        if miniDragging and matches then
            local d=input.Position-miniStart
            if math.abs(d.X)>4 or math.abs(d.Y)>4 then miniMoved=true end
            if miniMoved then Mini.Position=UDim2.new(miniPos.X.Scale,miniPos.X.Offset+d.X,miniPos.Y.Scale,miniPos.Y.Offset+d.Y) end
        end
    end)
    conns[#conns+1]=UserInputService.InputEnded:Connect(function(input)
        if input==miniInput or (miniInput and miniInput.UserInputType==Enum.UserInputType.MouseButton1
            and input.UserInputType==Enum.UserInputType.MouseButton1) then miniDragging=false end
    end)
    Mini.Activated:Connect(function()
        if miniMoved then return end
        Panel.Position=Mini.Position; Mini.Visible=false; Panel.Visible=true
    end)

    --// Auto rotate row (same switch look as the main menu)
    mkm("TextLabel", {
        Name = "AutoRotateLabel",
        Size = UDim2.new(0, 110, 0, 34),
        Position = UDim2.new(0, 12, 0, 39),
        BackgroundTransparency = 1,
        Font = Enum.Font.GothamMedium,
        TextSize = 12,
        TextColor3 = TEXT,
        TextXAlignment = Enum.TextXAlignment.Left,
        Text = "Auto rotate",
        ZIndex = 12,
    }, Panel)
    local ARHit = mkm("TextButton", {
        Name = "AutoRotateHit",
        Size = UDim2.fromOffset(70, 34),
        Position = UDim2.new(1, -70, 0, 39),
        BackgroundTransparency = 1,
        Text = "",
        ZIndex = 12,
    }, Panel)
    local ARTrack = mkm("Frame", {
        Name = "Track",
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -12, 0.5, 0),
        Size = UDim2.fromOffset(36, 20),
        BorderSizePixel = 0,
        ZIndex = 13,
    }, ARHit)
    ARTrack:SetAttribute("KamuiKeepColor", true)
    applyCorner(ARTrack, 10)
    local ARKnob = mkm("Frame", {
        Name = "Knob",
        Size = UDim2.fromOffset(14, 14),
        BorderSizePixel = 0,
        ZIndex = 14,
    }, ARTrack)
    applyCorner(ARKnob, 7)
    local function syncAutoRotate()
        local on = Settings.TrueM1Reset.AutoRotate
        ARTrack.BackgroundColor3 = on and THEME.Red or OFF_TRACK
        ARKnob.Position = on and UDim2.new(1, -17, 0.5, -7) or UDim2.new(0, 3, 0.5, -7)
        ARKnob.BackgroundColor3 = on and WHITE or OFF_KNOB
    end
    ARHit.MouseButton1Click:Connect(function()
        Settings.TrueM1Reset.AutoRotate = not Settings.TrueM1Reset.AutoRotate
        refreshAutoRotate()
        if currentHumanoid and not Settings.TrueM1Reset.AutoRotate then
            currentHumanoid.AutoRotate = true
        end
        syncAutoRotate()
    end)
    MUI.onColor(syncAutoRotate)
    syncAutoRotate()
end
print("KAMUI DASH loaded: True M1 Reset + Emote Dash")
