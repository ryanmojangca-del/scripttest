        local function flat(v)
            return Vector3.new(v.X, 0, v.Z)
        end
        local function closestTarget(root)
            local best, bestDist = nil, math.huge
            for _, other in ipairs(Players:GetPlayers()) do
                if other ~= player then
                    local c = other.Character
                    local r = c and c:FindFirstChild("HumanoidRootPart")
                    local h = c and c:FindFirstChildOfClass("Humanoid")
                    if r and h and h.Health > 0 then
                        local dist = (r.Position - root.Position).Magnitude
                        if dist < bestDist then best, bestDist = r, dist end
                    end
                end
            end
            return best
        end
        local function findMover(root)
            for _, m in ipairs(root:GetChildren()) do
                if m:IsA("BodyVelocity") or m:IsA("LinearVelocity") then
                    local n = string.lower(m.Name)
                    if n:find("dodge") or n:find("dash") then return m end
                end
            end
            return nil
        end
        local function moverToWorld(m, v)
            if not m:IsA("LinearVelocity") or m.RelativeTo == Enum.ActuatorRelativeTo.World then return v end
            local a = m.RelativeTo == Enum.ActuatorRelativeTo.Attachment0 and m.Attachment0 or m.Attachment1
            return a and a.WorldCFrame:VectorToWorldSpace(v) or nil
        end
        local function moverFromWorld(m, v)
            if not m:IsA("LinearVelocity") or m.RelativeTo == Enum.ActuatorRelativeTo.World then return v end
            local a = m.RelativeTo == Enum.ActuatorRelativeTo.Attachment0 and m.Attachment0 or m.Attachment1
            return a and a.WorldCFrame:VectorToObjectSpace(v) or nil
        end
        -- With a mover, the user's mobile dash is already in progress; do not synthesize keys.
        -- Without one, keep the original PC keybind behavior.
        local function dashOnce(existingMover, mobileTrigger)
            if not SA.Enabled or SA.Busy or not isCurrent() then return end
            local char = player.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if not root or not hum or hum.Health <= 0 then return end
            if existingMover then
                if existingMover.Parent ~= root then return end
            elseif findMover(root) then return end
            local target = closestTarget(root)
            if not target or (not existingMover and not mobileTrigger and not VirtualInputManager) then return end
            -- Only the PC path synthesizes Q; do not interfere with a held Q key.
            if not existingMover and not mobileTrigger and UIS:IsKeyDown(Enum.KeyCode.Q) then return end
            local targetHum = target.Parent and target.Parent:FindFirstChildOfClass("Humanoid")
            local right = flat(target.CFrame.RightVector)
            if right.Magnitude < 0.01 then return end
            right = right.Unit
            local sideSign = flat(root.Position - target.Position):Dot(right) < 0 and -1 or 1
            local chosenMode = SA.Mode
            local function destination()
                if chosenMode == "Behind" then
                    local forward = flat(target.CFrame.LookVector)
                    if forward.Magnitude < 0.01 then return nil end
                    return target.Position - forward.Unit * 3.5
                end
                local side = flat(target.CFrame.RightVector)
                if side.Magnitude < 0.01 then return nil end
                return target.Position + side.Unit * (3.5 * sideSign)
            end
            local dest = destination()
            local cam = Workspace.CurrentCamera
            if not dest or not cam then return end
            local startPos = flat(root.Position)
            local sideGoal = flat(dest)
            -- Behind follows an arc around the target instead of aiming at
            -- time-based points that can make the dash cut across the middle.
            -- The target's position is followed; behind is based on the
            -- direction it was facing when the dash started.
            local curve, hook
            local delta = sideGoal - startPos
            if chosenMode == "Side" then
                local toward = flat(target.Position - root.Position)
                if toward.Magnitude < 0.1 then return end
                toward = toward.Unit
                local flank = Vector3.new(-toward.Z, 0, toward.X)
                if flank:Dot(right * sideSign) < 0 then flank = -flank end
                -- First travel beyond the nearest flank, then curl back inward.
                local entry = flat(target.Position) + flank * 5 + toward * 1.2
                local toEntry = entry - startPos
                if toEntry.Magnitude < 0.1 then return end
                hook = {
                    toward = toward,
                    flank = flank,
                    start = startPos,
                    initialDirection = toEntry.Unit,
                    entryDistance = toEntry.Magnitude,
                    progress = 0,
                }
                delta = toEntry
            end
            if chosenMode == "Behind" then
                local radial = flat(root.Position - target.Position)
                local back = flat(dest - target.Position)
                if radial.Magnitude < 0.1 or back.Magnitude < 0.1 then return end
                local startAngle = math.atan2(radial.Z, radial.X)
                local endAngle = math.atan2(back.Z, back.X)
                local side = right * sideSign
                local sideAngle = math.atan2(side.Z, side.X)
                local tau = 2 * math.pi
                local ccw = (endAngle - startAngle) % tau
                local viaSide = (sideAngle - startAngle) % tau
                local sweep = viaSide <= ccw and ccw or ccw - tau
                -- Avoid an unnecessary full circle if starting near behind.
                if math.abs(sweep) > math.pi * 1.25 then
                    sweep = sweep > 0 and math.pi * 1.25 or -math.pi * 1.25
                end
                if math.abs(sweep) > 0.1 then
                    curve = {
                        direction = sweep > 0 and 1 or -1,
                        sweep = math.abs(sweep),
                        lastAngle = startAngle,
                        travelled = 0,
                        radius = radial.Magnitude,
                        back = back.Unit,
                    }
                    local unit = radial.Unit
                    delta = Vector3.new(-unit.Z, 0, unit.X) * curve.direction
                end
            end
            if delta.Magnitude < (curve and 0.01 or 0.75) then return end
            -- Face the CAMERA perpendicular to the initial travel direction,
            -- so left/right dash input starts toward the intended path.
            local dashDirection = delta.Unit
            local rightDashFacing = Vector3.new(dashDirection.Z, 0, -dashDirection.X)
            local currentFacing = flat(cam.CFrame.LookVector)
            local useRight = currentFacing:Dot(rightDashFacing) >= 0
            local dashKey = useRight and Enum.KeyCode.D or Enum.KeyCode.A
            local cameraFacing = useRight and rightDashFacing or -rightDashFacing
            local cameraPitch = math.clamp(cam.CFrame.LookVector.Y, -0.99, 0.99)
            local function faceCameraSideways()
                if not cam.Parent or Workspace.CurrentCamera ~= cam then return false end
                local pos = cam.CFrame.Position
                local horizontal = math.sqrt(1 - cameraPitch * cameraPitch)
                local look = cameraFacing * horizontal + Vector3.new(0, cameraPitch, 0)
                cam.CFrame = CFrame.lookAt(pos, pos + look)
                return true
            end
            if not existingMover and not faceCameraSideways() then return end
            -- Mobile has already started its dash; PC still faces sideways before input.
            local moverSeen = existingMover ~= nil
            local cameraBinding = "KAMUI_SideAssistCamera_" .. tostring(scriptId)
            pcall(function()
                RunService:BindToRenderStep(cameraBinding, Enum.RenderPriority.Camera.Value + 1, function()
                    if not isCurrent() or not SA.Enabled or not SA.Busy then return end
                    if (chosenMode == "Behind" or chosenMode == "Side") and moverSeen then
                        pcall(function()
                            if cam.Parent and Workspace.CurrentCamera == cam and target.Parent then
                                local pos = cam.CFrame.Position
                                local focus = target.Position
                                if (focus - pos).Magnitude > 0.01 then
                                    cam.CFrame = CFrame.lookAt(pos, focus)
                                end
                            end
                        end)
                    else
                        pcall(faceCameraSideways)
                    end
                end)
            end)
            local function releaseCamera()
                pcall(function() RunService:UnbindFromRenderStep(cameraBinding) end)
            end
            SA.Busy = true
            if mobileTrigger then
                local ok = mobileTrigger(dashDirection, useRight, faceCameraSideways, char, root, hum)
                if not ok then releaseCamera(); SA.Busy = false; return end
            elseif not existingMover then
            _G.KAMUI_MarkScriptDash()
            -- Trigger the normal client-side dash path instead of sending only
            -- the remote (which can play the dash in place without its mover).
            -- Keep a movement key the user was already holding untouched.
            local directionAlreadyDown = UIS:IsKeyDown(dashKey)
            local directionSent = directionAlreadyDown or pcall(function()
                VirtualInputManager:SendKeyEvent(true, dashKey, false, game)
            end)
            if not directionSent then
                releaseCamera()
                SA.Busy = false
                return
            end
            task.spawn(function()
                local qSent = false
                task.wait(0.04)
                if isCurrent() and SA.Enabled and SA.Busy and player.Character == char
                    and not UIS:IsKeyDown(Enum.KeyCode.Q) and faceCameraSideways() then
                    qSent = pcall(function()
                        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Q, false, game)
                    end)
                end
                task.wait(0.05)
                if qSent then
                    pcall(function() VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Q, false, game) end)
                end
                if not directionAlreadyDown then
                    pcall(function() VirtualInputManager:SendKeyEvent(false, dashKey, false, game) end)
                end
                if _G.KAMUI_RestoreTouchInput then
                    task.delay(0.1, _G.KAMUI_RestoreTouchInput, SA.Mobile)
                end
            end)
            end -- PC simulated-input path; mobile uses the game's touch dash handler
            local started = os.clock()
            local conn
            local function finishAssist()
                if conn then conn:Disconnect(); conn = nil end
                releaseCamera()
                SA.Busy = false
            end
            -- The mobile dash may update its mover after Heartbeat steering.
            -- Test applying the same path immediately before physics instead.
            -- PC keeps its existing Heartbeat timing.
            local dashStep = mobileTrigger and RunService.PreSimulation or RunService.Heartbeat
            conn = dashStep:Connect(function(dt)
                if not isCurrent() or not SA.Enabled or not SA.Busy or player.Character ~= char
                    or not root.Parent or not target.Parent or not targetHum or targetHum.Health <= 0 then
                    finishAssist(); return
                end
                if os.clock() - started > 1.2 then
                    finishAssist(); return
                end
                local mover
                if existingMover then
                    mover = existingMover.Parent == root and existingMover or nil
                else
                    mover = findMover(root)
                end
                if not mover then
                    if moverSeen then
                        finishAssist()
                    end
                    return
                end
                moverSeen = true
                -- Mobile and PC use the same hook / curve mover steering.
                local goal = (hook and (flat(target.Position) + hook.flank * 2.6 + hook.toward * 1.2))
                    or (curve and (flat(target.Position) + curve.back * 3.5) or destination())
                if not goal then finishAssist(); return end
                local remaining = flat(goal - root.Position)
                local arrived = remaining.Magnitude <= 0.75
                local steer = remaining
                if hook and not arrived then
                    local entry = flat(target.Position) + hook.flank * 5 + hook.toward * 1.2
                    local toEntry = entry - flat(root.Position)
                    local travelled = (flat(root.Position) - hook.start):Dot(hook.initialDirection)
                    hook.progress = math.max(hook.progress,
                        math.clamp(travelled / math.max(hook.entryDistance, 0.1), 0, 1))
                    -- Progress-based steering begins outward and hooks back in
                    -- during the latter part of the game's normal side dash.
                    local blend = math.clamp((hook.progress - 0.45) / 0.35, 0, 1)
                    if toEntry.Magnitude > 0.05 then
                        steer = toEntry.Unit * (1 - blend) + remaining.Unit * blend
                    end
                elseif curve and not arrived then
                    local radial = flat(root.Position - target.Position)
                    if radial.Magnitude > 0.1 then
                        local angle = math.atan2(radial.Z, radial.X)
                        local step = (angle - curve.lastAngle + math.pi) % (2 * math.pi) - math.pi
                        curve.lastAngle = angle
                        curve.travelled = math.clamp(curve.travelled + step * curve.direction, 0, curve.sweep)
                        local progress = curve.travelled / curve.sweep
                        local unit = radial.Unit
                        local tangent = Vector3.new(-unit.Z, 0, unit.X) * curve.direction
                        -- Hold the orbit and gradually converge to the behind position.
                        local wantedRadius = curve.radius + (3.5 - curve.radius) * progress
                        local correction = math.clamp((wantedRadius - radial.Magnitude)
                            / math.max(radial.Magnitude, 3) * 1.4, -0.8, 0.8)
                        local arcSteer = tangent + unit * correction
                        -- Only aim at the endpoint at the end of the arc.
                        local blend = math.clamp((progress - 0.88) / 0.12, 0, 1)
                        steer = arcSteer * (1 - blend) + remaining.Unit * blend
                    end
                end
                pcall(function()
                    local prop = mover:IsA("LinearVelocity") and "VectorVelocity" or "Velocity"
                    local world = moverToWorld(mover, mover[prop])
                    if not world then return end
                    local speed = flat(world).Magnitude
                    if speed < 0.1 then return end
                    local v
                    if (chosenMode == "Behind" or chosenMode == "Side") and arrived then
                        -- Hold the endpoint, but keep camera lock until the mover ends.
                        v = Vector3.new(0, world.Y, 0)
                    elseif steer.Magnitude > 0.001 then
                        -- Keep the game's dash speed; only redirect its mover.
                        local capped = (chosenMode == "Behind" or chosenMode == "Side") and speed
                            or math.min(speed, steer.Magnitude / math.max(dt, 1/120))
                        v = steer.Unit * capped + Vector3.new(0, world.Y, 0)
                    else
                        return
                    end
                    local result = moverFromWorld(mover, v)
                    if result then mover[prop] = result end
                end)
            end)
        end
        -- Tap the game's real mobile DashButton without sending keyboard input.
        -- Its location is read each time so a moved button can still be found.
        local mobilePending = false
        local function activateMobileDash()
            if not isCurrent() then return end
            if not SA.Mobile then return end
            if not SA.Enabled then return end
            if SA.Busy or mobilePending then return end
            local character = player.Character
            local playerRoot = character and character:FindFirstChild("HumanoidRootPart")
            local playerHum = character and character:FindFirstChildOfClass("Humanoid")
            if not playerRoot or not playerHum or playerHum.Health <= 0 then return end
            if findMover(playerRoot) then return end
            if not closestTarget(playerRoot) then return end
            local pg = player:FindFirstChildOfClass("PlayerGui")
            local touch = pg and pg:FindFirstChild("TouchGui")
            local guiControls = touch and touch:FindFirstChild("TouchControlFrame")
            local jump = guiControls and guiControls:FindFirstChild("JumpButton")
            local button = jump and jump:FindFirstChild("DashButton")
            if not button or not button:IsA("GuiButton") then return end

            -- dashOnce calculates the complete PC path and camera orientation
            -- before calling this mobile-specific trigger.
            local function trigger(dashDirection, useRight, faceCamera, char, root, hum)
                local inputVector = Vector3.new(useRight and 1 or -1, 0, 0)
                local touchController, originalMove
                pcall(function()
                    local ps = player:FindFirstChild("PlayerScripts")
                    local module = ps and ps:FindFirstChild("PlayerModule")
                    local controls = module and require(module):GetControls()
                    local active = controls and controls.activeController
                    if active and typeof(active.moveVector) == "Vector3" then
                        touchController, originalMove = active, active.moveVector
                    end
                end)
                local pos, size = button.AbsolutePosition, button.AbsoluteSize
                local x, y = pos.X + size.X / 2, pos.Y + size.Y / 2
                mobilePending = true
                local binding = "KAMUI_MobileDashPrep_" .. tostring(scriptId)
                local prepared, prepCleaned = false, false
                local function cleanupPrep()
                    if prepCleaned then return end
                    prepCleaned = true
                    pcall(function() RunService:UnbindFromRenderStep(binding) end)
                    if touchController then
                        pcall(function()
                            if touchController.moveVector == inputVector then touchController.moveVector = originalMove end
                        end)
                    end
                end
                local bound, bindError = pcall(function()
                    RunService:BindToRenderStep(binding, Enum.RenderPriority.Character.Value + 1, function()
                        if not isCurrent() or not SA.Enabled or not SA.Mobile or not SA.Busy
                            or player.Character ~= char or not root.Parent then return end
                        if not faceCamera() then return end
                        if touchController then pcall(function() touchController.moveVector = inputVector end) end
                        local ok = pcall(function() hum:Move(dashDirection, false) end)
                        if ok then prepared = true end
                    end)
                end)
                if not bound then
                    mobilePending = false
                    return false
                end
                task.spawn(function()
                    task.wait(0.08)
                    if not isCurrent() or not SA.Mobile or not SA.Enabled or not SA.Busy
                        or player.Character ~= char or not root.Parent then
                        cleanupPrep(); mobilePending = false; return
                    end
                    if not prepared then
                        cleanupPrep(); mobilePending = false; SA.Busy = false
                        return
                    end
                    _G.KAMUI_MarkScriptDash()
                    local fired, reason = false, "No supported signal function"
                    if type(firesignal) == "function" then
                        local ok, err = pcall(function() firesignal(button.MouseButton1Down, x, y) end)
                        fired, reason = ok, tostring(err)
                    end
                    if not fired and type(getconnections) == "function" then
                        local ok, connections = pcall(function() return getconnections(button.MouseButton1Down) end)
                        if ok and connections then
                            for _, connection in ipairs(connections) do
                                if connection.Enabled ~= false then
                                    local success, err = pcall(function() connection:Fire(x, y) end)
                                    if success then fired = true else reason = tostring(err) end
                                end
                            end
                        elseif not ok then reason = tostring(connections) end
                    end
                    if not fired then
                        cleanupPrep(); mobilePending = false; SA.Busy = false
                        return
                    end
                    task.delay(0.06, function()
                        if type(firesignal) == "function" then
                            local ok = pcall(function() firesignal(button.MouseButton1Up, x, y) end)
                            if ok then return end
                        end
                        if type(getconnections) == "function" then
                            local ok, connections = pcall(function() return getconnections(button.MouseButton1Up) end)
                            if ok and connections then
                                for _, connection in ipairs(connections) do
                                    if connection.Enabled ~= false then pcall(function() connection:Fire(x, y) end) end
                                end
                            end
                        end
                    end)
                    task.delay(0.15, cleanupPrep)
                    local deadline = os.clock() + 0.8
                    while isCurrent() and SA.Mobile and SA.Enabled and SA.Busy
                        and player.Character == char and root.Parent and os.clock() < deadline do
                        if findMover(root) then
                            cleanupPrep(); mobilePending = false
                            return
                        end
                        RunService.Heartbeat:Wait()
                    end
                    cleanupPrep(); mobilePending = false
                end)
                return true
            end
            dashOnce(nil, trigger)
        end
        -- Detect a tap separately from dragging, including touch on mobile.
        local dashTouch, dashTouchStart = nil, nil
        mobileButton.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.Touch
                or input.UserInputType == Enum.UserInputType.MouseButton1 then
                dashTouch = input
                dashTouchStart = Vector2.new(input.Position.X, input.Position.Y)
            end
        end)
        UIS.InputEnded:Connect(function(input)
            if not dashTouch or not dashTouchStart then return end
            local matches = input == dashTouch or (dashTouch.UserInputType == Enum.UserInputType.MouseButton1
                and input.UserInputType == Enum.UserInputType.MouseButton1)
            if not matches then return end
            local finish = Vector2.new(input.Position.X, input.Position.Y)
            local wasTap = (finish - dashTouchStart).Magnitude <= 18
            dashTouch, dashTouchStart = nil, nil
            if wasTap then activateMobileDash() end
        end)
        UIS.InputBegan:Connect(function(input, processed)
            if not isCurrent() or input.UserInputType ~= Enum.UserInputType.Keyboard then return end
            if capturingKey then
                capturingKey = false
                if input.KeyCode ~= Enum.KeyCode.Escape and input.KeyCode ~= Enum.KeyCode.Unknown then
                    SA.Key = input.KeyCode.Name
                end
                key.Text = SA.Key
                return
            end
            if processed or UIS:GetFocusedTextBox() then return end
            if SA.Key ~= "None" and input.KeyCode.Name == SA.Key then dashOnce() end
        end)
    end
end

--// MOVEMENT TAB CONTENT: Dash multiplier (toggle + Distance slider)
_G.KAMUI_BuildMovement = function(UI)
    local G = _G.KAMUI_MovementTab
    local page = G and G.Page
    if not page then
        return
    end
    UI.setupPage(page)
    local M = _G.KAMUI_Movement
    local CHIP = UI.CHIP
    local conns = _G.KAMUI_MovementConns or {}
    _G.KAMUI_MovementConns = conns

    local function mk(class, props, parent)
        local o = UI.make(class, props, parent)
        o:SetAttribute("KamuiSkinned", true)
        return o
    end
    local function round2(v)
        return math.round(v * 100) / 100
    end

    --// slider row: label (+ optional small text under it), bar, value you can tap and type into.
    --// o = { label, sub, get, set, min, max, step, snap, snapZone, isOn }
    local function makeSlider(card, o)
        local hasSub = o.sub ~= nil
        local row = mk("Frame", { BackgroundTransparency = 1, BorderSizePixel = 0 }, nil)
        UI.addRow(card, row, hasSub and UI.ROW_SUB or UI.ROW)
        mk("TextLabel", {
            Name = "RowLabel",
            BackgroundTransparency = 1,
            Position = UDim2.new(0, 12, 0, hasSub and 5 or 0),
            Size = hasSub and UDim2.new(0.5, -12, 0, 20) or UDim2.new(0.5, -12, 1, 0),
            Font = Enum.Font.GothamMedium,
            TextSize = 12,
            TextColor3 = THEME.Text,
            TextXAlignment = Enum.TextXAlignment.Left,
            Text = o.label
        }, row)
        if hasSub then
            mk("TextLabel", {
                Name = "RowSub",
                BackgroundTransparency = 1,
                Position = UDim2.new(0, 12, 0, 24),
                Size = UDim2.new(0.5, -12, 0, 14),
                Font = Enum.Font.Gotham,
                TextSize = 11,
                TextColor3 = THEME.MutedText,
                TextXAlignment = Enum.TextXAlignment.Left,
                TextTruncate = Enum.TextTruncate.AtEnd,
                Text = o.sub
            }, row)
        end
        local back = mk("Frame", {
            Name = "SliderBack",
            BackgroundColor3 = CHIP,
            BorderSizePixel = 0,
            Position = UDim2.new(0.52, 0, 0.5, -3),
            Size = UDim2.new(0.28, 0, 0, 6)
        }, row)
        UI.corner(back, 3)
        back:SetAttribute("KamuiNoDrag", true)
        local fill = mk("Frame", {
            BackgroundColor3 = THEME.Red,
            BorderSizePixel = 0,
            Size = UDim2.new(0, 0, 1, 0)
        }, back)
        UI.corner(fill, 3)
        --// the value is a TextBox: tap the number and type an exact value
        local box = mk("TextBox", {
            Name = "ValueBox",
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            AnchorPoint = Vector2.new(1, 0.5),
            Position = UDim2.new(1, -12, 0.5, 0),
            Size = UDim2.new(0.18, 0, 0, 24),
            Font = Enum.Font.RobotoMono,
            TextSize = 12,
            TextColor3 = THEME.BrightRed,
            TextXAlignment = Enum.TextXAlignment.Right,
            ClearTextOnFocus = false,
            Text = ""
        }, row)
        box:SetAttribute("KamuiNoDrag", true)

        local function paint()
            local v = o.get()
            fill.Size = UDim2.new(math.clamp((v - o.min) / (o.max - o.min), 0, 1), 0, 1, 0)
            local on = o.isOn == nil or o.isOn()
            fill.BackgroundColor3 = on and THEME.Red or THEME.OffRed
            box.TextColor3 = on and THEME.BrightRed or THEME.MutedText
            if not box:IsFocused() then
                box.Text = string.format(o.fmt or "%.2fx", v)
            end
        end
        paint()

        local hit = mk("TextButton", {
            Name = "SliderHit",
            BackgroundTransparency = 1,
            Text = "",
            Position = UDim2.new(0.5, 0, 0, 0),
            Size = UDim2.new(0.32, 0, 1, 0)
        }, row)
        hit:SetAttribute("KamuiNoDrag", true)
        local dragging, dragInput = false, nil
        local function fromX(x)
            local a = math.clamp((x - back.AbsolutePosition.X) / math.max(1, back.AbsoluteSize.X), 0, 1)
            local v = round2(math.round((o.min + a * (o.max - o.min)) / o.step) * o.step)
            if o.snap and math.abs(v - o.snap) < o.snapZone then
                v = o.snap -- sticks to normal (1.00x)
            end
            o.set(math.clamp(v, o.min, o.max))
            paint()
        end
        hit.InputBegan:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                dragging, dragInput = true, i
                _G.KAMUI_SliderHeld = true
                fromX(i.Position.X)
            end
        end)
        conns[#conns + 1] = UIS.InputChanged:Connect(function(i)
            if not dragging or not isCurrent() then
                return
            end
            --// follow only the finger/button that started the drag (other touches are ignored)
            if i == dragInput
                or (i.UserInputType == Enum.UserInputType.MouseMovement
                    and dragInput.UserInputType == Enum.UserInputType.MouseButton1) then
                fromX(i.Position.X)
            end
        end)
        conns[#conns + 1] = UIS.InputEnded:Connect(function(i)
            if dragging and (i == dragInput or i.UserInputType == Enum.UserInputType.MouseButton1) then
                dragging, dragInput = false, nil
                _G.KAMUI_SliderHeld = false
            end
        end)

        --// manual entry: "2.5", "2,5" and "2.5x" all work; out-of-range values are clamped
        box.Focused:Connect(function()
            box.Text = string.format("%g", o.get())
        end)
        box.FocusLost:Connect(function()
            local txt = box.Text:gsub(",", "."):gsub("[xXmMsS%s]", "")
            local n = tonumber(txt)
            if n then
                o.set(math.clamp(round2(n), o.min, o.max))
            end
            paint()
        end)
        return paint
    end

