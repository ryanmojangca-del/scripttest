--============================================================
-- EXECUTE MACRO
--============================================================

local function executeMacro(index)
    local enabled = false
    local macroKey = nil
    if index == 1 then
        enabled = Settings.Macro.BackDashCancel1.Enabled
        macroKey = Enum.KeyCode.One
    elseif index == 2 then
        enabled = Settings.Macro.BackDashCancel2.Enabled
        macroKey = Enum.KeyCode.Two
    elseif index == 3 then
        enabled = Settings.Macro.BackDashCancel3.Enabled
        macroKey = Enum.KeyCode.Three
    elseif index == 4 then
        enabled = Settings.Macro.BackDashCancel4.Enabled
        macroKey = Enum.KeyCode.Four
    end
    if not enabled then
        return
    end
    -- Capture the nearest target before the backdash can change distances.
    magnetRequest = magnetRequest + 1
    local requestId = magnetRequest
    if pullConnection then pullConnection:Disconnect(); pullConnection = nil end
    local magnetCharacter = localPlayer.Character
    local magnetTarget = Settings.Magnet.Enabled and getClosestTarget() or nil
    --========================================================
    -- RUN ORIGINAL MACRO
    --========================================================
    task.spawn(function()
        local ok, result = pcall(performBackDashMacro, macroKey)
        task.delay(0.05, restoreTouchInput)
        if ok and result == false then
            return
        end
        if not ok then
            warn("[KAMUI] Backdash macro error:", result)
            if not _G.KAMUI_BackdashMobile then
                pcall(tapKey, keyS)
                pcall(tapKey, keyQ)
                pcall(tapKey, macroKey)
                pcall(function()
                    VirtualInputManager:SendMouseButtonEvent(halfViewportX, halfViewportY, 0, false, game, 0)
                end)
            else
                stopMobileRun(mobileRun)
                mobileStatus("Error: " .. tostring(result))
            end
            return
        end
        --====================================================
        -- RUN MAGNET AFTER MACRO
        --====================================================
        if Settings.Magnet.Enabled then
            executeMagnet(magnetTarget, magnetCharacter, requestId)
        end
    end)
end

