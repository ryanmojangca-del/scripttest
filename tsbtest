                    if saved.obj.Parent then saved.obj[saved.prop]=saved.value end
                end)
            end
        end
        local function hideObject(st, obj)
            if not obj or st.seen[obj] then return end
            local properties
            if obj:IsA("BasePart") then
                -- Some camera/game scripts overwrite LocalTransparencyModifier.
                -- Transparency is also client-local here and covers that case.
                properties={"Transparency", "LocalTransparencyModifier"}
            elseif obj:IsA("Decal") or obj:IsA("Texture") then
                properties={"Transparency"}
            else return end
            st.seen[obj]=true
            for _, prop in ipairs(properties) do
                local ok, value=pcall(function() return obj[prop] end)
                if ok then
                    st.hidden[#st.hidden+1]={obj=obj,prop=prop,value=value}
                    pcall(function() obj[prop]=1 end)
                end
            end
        end
        -- A visual accessory can be nested in a folder/model; never hide tools.
        local function relevant(char, item)
            local node, belongs = item, false
            while node and node~=char do
                if node:IsA("Tool") then return false end
                if node:IsA("Accessory") or node:IsA("Hat") then belongs=true end
                local name=string.lower(node.Name)
                if name:find("hair",1,true) or name:find("wig",1,true)
                    or name:find("hat",1,true) or name:find("beard",1,true)
                    or name:find("cosmetic",1,true) or name:find("accessor",1,true) then
                    belongs=true
                end
                if node.Parent==char and node:IsA("BasePart")
                    and node.Name~="HumanoidRootPart" and bodyNames[node.Name] then
                    belongs=true
                end
                node=node.Parent
            end
            return node==char and belongs
        end
        local function attachRig(char, model)
            -- The rig is parented to the local camera, not the character. Its
            -- anchored, non-queryable parts are moved visually each render frame;
            -- there are no physical joints connecting it to the real character.
            local hum=model:FindFirstChildOfClass("Humanoid")
            if hum then
                pcall(function() hum.RequiresNeck=false end)
                pcall(function() hum.BreakJointsOnDeath=false end)
                pcall(function() hum.DisplayDistanceType=Enum.HumanoidDisplayDistanceType.None end)
                pcall(function() hum.HealthDisplayType=Enum.HumanoidHealthDisplayType.AlwaysOff end)
                pcall(function() hum.EvaluateStateMachine=false end)
                pcall(function() hum.PlatformStand=true end)
            end
            local follow, overlayBody, overlayParts = {}, {}, {}
            local bodyCount=0
            for _, part in ipairs(model:GetChildren()) do
                if part:IsA("BasePart") and bodyNames[part.Name] then
                    local real=char:FindFirstChild(part.Name)
                    if real and real:IsA("BasePart") then
                        overlayBody[part]=real
                        follow[#follow+1]={visual=part, real=real, offset=CFrame.new()}
                        if part.Name~="HumanoidRootPart" then bodyCount=bodyCount+1 end
                    else
                        part.Transparency=1
                    end
                    if part.Name=="HumanoidRootPart" then part.Transparency=1 end
                end
            end
            if bodyCount==0 then return false end
            -- Retain the avatar's accessory positioning without retaining its welds.
            for _, accessory in ipairs(model:GetChildren()) do
                if accessory:IsA("Accessory") or accessory:IsA("Hat") then
                    local handle=accessory:FindFirstChild("Handle")
                    if handle and handle:IsA("BasePart") then
                        local body, relative
                        for _, joint in ipairs(handle:GetChildren()) do
                            if joint:IsA("Weld") then
                                if joint.Part0==handle and overlayBody[joint.Part1] then
                                    body=joint.Part1; relative=joint.C1 * joint.C0:Inverse(); break
                                elseif joint.Part1==handle and overlayBody[joint.Part0] then
                                    body=joint.Part0; relative=joint.C0 * joint.C1:Inverse(); break
                                end
                            end
                        end
                        if not body then
                            for _, a in ipairs(handle:GetChildren()) do
                                if a:IsA("Attachment") then
                                    for candidate in pairs(overlayBody) do
                                        local matching=candidate:FindFirstChild(a.Name)
                                        if matching and matching:IsA("Attachment") then
                                            body=candidate; relative=matching.CFrame * a.CFrame:Inverse(); break
                                        end
                                    end
                                end
                                if body then break end
                            end
                        end
                        if body and relative then
                            for _, p in ipairs(accessory:GetDescendants()) do
                                if p:IsA("BasePart") then
                                    local partOffset = p==handle and CFrame.new() or handle.CFrame:ToObjectSpace(p.CFrame)
                                    follow[#follow+1]={visual=p, real=overlayBody[body], offset=relative * partOffset}
                                end
                            end
                        else
                            -- An unmatchable accessory must not float in the scene.
                            for _, p in ipairs(accessory:GetDescendants()) do
                                if p:IsA("BasePart") then p.Transparency=1 end
                            end
                        end
                    end
                end
            end
            for _, d in ipairs(model:GetDescendants()) do
                if d:IsA("LuaSourceContainer") or d:IsA("JointInstance") or d:IsA("WeldConstraint") then
                    d:Destroy()
                elseif d:IsA("BasePart") then
                    d.Anchored=true; d.CanCollide=false; d.CanTouch=false; d.CanQuery=false; d.Massless=true
                    overlayParts[#overlayParts+1]=d
                end
            end
            local cam=Workspace.CurrentCamera
            if not cam then return false end
            model.Name="KamuiAvatarVisual"
            model.Parent=cam
            return true, follow, overlayParts
        end
        local function loadAvatar(id, char, token)
            local hum=char and char:FindFirstChildOfClass("Humanoid")
            if not hum then message("Character not ready. Try again."); return end
            local ok, result=pcall(function()
                local description
                local got, desc=pcall(function() return Players:GetHumanoidDescriptionFromUserIdAsync(id) end)
                if got then description=desc else description=Players:GetHumanoidDescriptionFromUserId(id) end
                local made, rig=pcall(function() return Players:CreateHumanoidModelFromDescriptionAsync(description, hum.RigType) end)
                if made then return rig end
                return Players:CreateHumanoidModelFromDescription(description, hum.RigType)
            end)
            if token~=seq or not isCurrent() or player.Character~=char then
                if ok and result then pcall(function() result:Destroy() end) end
                return
            end
            if not ok or not result or not result:IsA("Model") then
                message("Avatar couldn't load. Check the ID or try again.")
                return
            end
            -- Do not remove an existing spoof unless the replacement is ready.
            local attached, success, follow, overlayParts=pcall(attachRig,char,result)
            if not attached or not success then
                pcall(function() result:Destroy() end)
                message("Avatar couldn't attach to this character.")
                return
            end
            undo()
            local st={character=char,model=result,hidden={},seen={},follow=follow,parts=overlayParts}
            current=st
            for _, item in ipairs(char:GetDescendants()) do
                if relevant(char,item) then hideObject(st,item) end
            end
            -- Catch accessories, handles and face textures that finish loading later.
            st.connection=char.DescendantAdded:Connect(function(item)
                if current~=st or not relevant(char,item) then return end
                hideObject(st,item)
                for _, child in ipairs(item:GetDescendants()) do
                    if relevant(char,child) then hideObject(st,child) end
                end
            end)
            -- Keep the originals hidden after the camera and game have updated them.
            local function enforceHidden()
                if current~=st or not isCurrent() or player.Character~=char then return end
                for _, saved in ipairs(st.hidden) do
                    pcall(function()
                        if saved.obj.Parent and saved.obj[saved.prop]~=1 then saved.obj[saved.prop]=1 end
                    end)
                end
                local cam=Workspace.CurrentCamera
                if cam and st.model.Parent~=cam then st.model.Parent=cam end
                for _, part in ipairs(st.parts) do
                    if part.Parent then
                        -- Keep enforcing the same flags without rewriting unchanged values.
                        if not part.Anchored then part.Anchored=true end
                        if part.CanCollide then part.CanCollide=false end
                        if part.CanTouch then part.CanTouch=false end
                        if part.CanQuery then part.CanQuery=false end
                    end
                end
                for _, pair in ipairs(st.follow) do
                    if pair.visual.Parent and pair.real.Parent then
                        pair.visual.CFrame=pair.real.CFrame * pair.offset
                    end
                end
            end
            local binding="KAMUI_AvatarSpoofHide_" .. tostring(scriptId)
            local bound=pcall(function()
                RunService:BindToRenderStep(binding, Enum.RenderPriority.Last.Value + 1, enforceHidden)
            end)
            if bound then st.renderBinding=binding
            else st.renderConnection=RunService.RenderStepped:Connect(enforceHidden) end
            enforceHidden()
            desiredId=id
            message("Applied locally. Restore to undo.")
        end
        local function request(query)
            query=tostring(query or ""):match("^%s*(.-)%s*$")
            query=query:gsub("^@","")
            if query=="" then message("Enter a username or user ID."); return end
            seq=seq+1
            local token=seq
            message("Loading avatar...")
            task.spawn(function()
                local id=tonumber(query)
                if id then
                    if id<=0 or id%1~=0 then
                        if seq==token then message("Enter a valid user ID.") end
                        return
                    end
                else
                    local ok, value=pcall(function() return Players:GetUserIdFromNameAsync(query) end)
                    if token~=seq or not isCurrent() then return end
                    if not ok or not value then message("Username not found. Try again."); return end
                    id=value
                end
                if token~=seq or not isCurrent() then return end
                loadAvatar(id,player.Character,token)
            end)
        end
        apply.MouseButton1Click:Connect(function() if isCurrent() then request(input.Text) end end)
        restore.MouseButton1Click:Connect(function()
            if not isCurrent() then return end
            seq=seq+1; desiredId=nil; undo(); message("Original appearance restored.")
        end)
        respawnConnection=player.CharacterAdded:Connect(function(char)
            if not isCurrent() then return end
            seq=seq+1
            local token=seq
            undo()
            local id=desiredId
            if not id then return end
            message("Reapplying after respawn...")
            task.spawn(function()
                char:WaitForChild("Humanoid",10)
                task.wait(1.5)
                if token==seq and isCurrent() and player.Character==char and desiredId==id then
                    loadAvatar(id,char,token)
                end
            end)
        end)
        _G.KAMUI_AvatarSpoofCleanup=function()
            seq=seq+1; desiredId=nil; undo()
            if respawnConnection then respawnConnection:Disconnect(); respawnConnection=nil end
        end
    end

