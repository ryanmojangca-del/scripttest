    --// builds an instance; flags it so the main script's skin pass leaves it alone
    local function mkm(class, props, parent)
        local o = Instance.new(class)
        for k, v in pairs(props) do
            o[k] = v
        end
        if class == "TextButton" or class == "TextBox" or class == "Frame" then
            o:SetAttribute("KamuiSkinned", true)
        end
        o.Parent = parent
        return o
    end

    local function addBorder(obj, color)
        local st = Instance.new("UIStroke")
        st.Color = color
        st.Thickness = 1
        st.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
        st:SetAttribute("KamuiKeepColor", true)
        st.Parent = obj
        return st
    end

    local function isPress(input)
        return input.UserInputType == Enum.UserInputType.Touch
            or input.UserInputType == Enum.UserInputType.MouseButton1
    end

    --// press = action, or drag when "Move" mode is on
    local function movable(handle, target, onPress)
        local dragging, dragStart, startPos, dragInput = false, nil, nil, nil
        handle.InputBegan:Connect(function(input)
            if not isPress(input) then
                return
            end
            if editing then
                dragging = true
                dragStart = input.Position
                startPos = target.Position
                input.Changed:Connect(function()
                    if input.UserInputState == Enum.UserInputState.End then
                        dragging = false
                    end
                end)
            elseif onPress then
                onPress()
            end
        end)
        handle.InputChanged:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseMovement
                or input.UserInputType == Enum.UserInputType.Touch then
                dragInput = input
            end
        end)
        conns[#conns + 1] = UserInputService.InputChanged:Connect(function(input)
            if dragging and input == dragInput then
                local d = input.Position - dragStart
                target.Position = UDim2.new(
                    startPos.X.Scale, startPos.X.Offset + d.X,
                    startPos.Y.Scale, startPos.Y.Offset + d.Y
                )
            end
        end)
    end

