        UI.addRow(blockCard, nrow, UI.ROW)
        label(nrow, "Block range (studs)", nil)
        local nbox = mk("TextBox", {
            BackgroundColor3 = CHIP,
            BorderSizePixel = 0,
            Position = UDim2.new(1, -68, 0.5, -13),
            Size = UDim2.new(0, 56, 0, 26),
