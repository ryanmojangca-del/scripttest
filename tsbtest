--============================================================
-- NPC CACHE
--============================================================

local function updateNpcCache()
    npcList = {}
    for _, model in ipairs(
        Workspace:GetDescendants()
    ) do
        if model:IsA("Model")
            and model:FindFirstChild("Humanoid")
            and model:FindFirstChild("HumanoidRootPart") then
            local root = model:FindFirstChild("HumanoidRootPart")
            if root then
                table.insert(npcList, root)
            end
        end
    end
end
local npcCacheConnection = RunService.Heartbeat:Connect(
    function()
        --// scanning the whole workspace twice a second is heavy on phones and
        --// only the Magnet uses the result, so it runs only while Magnet is on
        if Settings.Magnet.Enabled and tick() - lastNpcUpdate > 0.5 then
            lastNpcUpdate = tick()
            updateNpcCache()
        end
    end
)

--============================================================
-- GET CLOSEST TARGET
--============================================================

local function horizontalDistance(a, b)
    local delta = a - b
    return Vector3.new(delta.X, 0, delta.Z).Magnitude
end

local function getClosestTarget()
    local character = localPlayer.Character
    if not character then
        return nil
    end
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then
        return nil
    end
    local closestRoot = nil
    local shortestDistance = Settings.Magnet.Range -- horizontal radius around you
    local myPos = rootPart.Position
    --========================================================
    -- PLAYERS
    --========================================================
    for _, plr in ipairs(
        Players:GetPlayers()
    ) do
        if plr ~= localPlayer
            and plr.Character then
            local root = plr.Character:FindFirstChild("HumanoidRootPart")
            if root then
                local humanoid = plr.Character:FindFirstChildOfClass("Humanoid")
                if humanoid
                    and humanoid.Health > 0 then
                    local distance = horizontalDistance(myPos, root.Position)
                    if distance <= shortestDistance
                        and distance > 0.1 then
                        shortestDistance = distance
                        closestRoot = root
                    end
                end
            end
        end
    end
    --========================================================
    -- NPCS
    --========================================================
    for _, npcRoot in ipairs(
        npcList
    ) do
        if npcRoot
            and npcRoot.Parent
            and npcRoot ~= rootPart then
            local model = npcRoot.Parent
            local humanoid = model:FindFirstChildOfClass("Humanoid")
            if humanoid
                and humanoid.Health > 0 then
                local distance = horizontalDistance(myPos, npcRoot.Position)
                if distance <= shortestDistance
                    and distance > 0.1 then
                    shortestDistance = distance
                    closestRoot = npcRoot
                end
            end
        end
    end
    return closestRoot
end

--============================================================
-- MAGNET FOLLOW (BACKDASH ATTACH TEST A06)
--============================================================
-- Attach to the target selected at macro start without retargeting.
local function startMagnetPull(targetRoot, character, requestId)
    if pullConnection then
        pullConnection:Disconnect()
        pullConnection = nil
    end
    if not Settings.Magnet.Enabled or localPlayer.Character ~= character then return end
    local rootPart = character and character:FindFirstChild("HumanoidRootPart")
    local targetModel = targetRoot and targetRoot.Parent
    local targetHumanoid = targetModel and targetModel:FindFirstChildOfClass("Humanoid")
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if not rootPart or not targetHumanoid or targetHumanoid.Health <= 0
        or not humanoid or humanoid.Health <= 0
        or horizontalDistance(rootPart.Position, targetRoot.Position) > Settings.Magnet.Range then return end

    -- Keep the side we are already on, rather than snapping through the target.
    local delta = rootPart.Position - targetRoot.Position
    local horizontal = Vector3.new(delta.X, 0, delta.Z)
    local offsetDirection
    if horizontal.Magnitude > 0.1 then
        offsetDirection = horizontal.Unit
    else
        local look = targetRoot.CFrame.LookVector
        local flatLook = Vector3.new(look.X, 0, look.Z)
        offsetDirection = flatLook.Magnitude > 0.1 and flatLook.Unit or Vector3.new(0, 0, 1)
    end
    local followOffset = offsetDirection * 2.5
    local startPosition = rootPart.Position
    local started = os.clock()
    local followDuration = 0.5
    local approachDuration = 0.12
    -- Positional follow rather than a velocity-only pull: converge quickly, then
    -- continually maintain the offset so the move ends close to a moving target.
    pullConnection = RunService.PreSimulation:Connect(function()
        if requestId ~= magnetRequest or not Settings.Magnet.Enabled
            or localPlayer.Character ~= character or not rootPart.Parent
            or not targetRoot.Parent or not humanoid.Parent or humanoid.Health <= 0
            or not targetHumanoid.Parent or targetHumanoid.Health <= 0
            or horizontalDistance(rootPart.Position, targetRoot.Position) > Settings.Magnet.Range then
            if pullConnection then pullConnection:Disconnect(); pullConnection = nil end
            return
        end
        local elapsed = os.clock() - started
        local targetPosition = targetRoot.Position
        local desiredPosition = targetPosition + followOffset
        local t = math.clamp(elapsed / approachDuration, 0, 1)
        local eased = t * t * (3 - 2 * t)
        local position = startPosition:Lerp(desiredPosition, eased)
        local facePoint = Vector3.new(targetPosition.X, position.Y, targetPosition.Z)
        if (facePoint - position).Magnitude > 0.01 then
            rootPart.CFrame = CFrame.lookAt(position, facePoint)
        else
            rootPart.CFrame = CFrame.new(position) * rootPart.CFrame.Rotation
        end
        -- Matching target velocity reduces separation when the lock ends.
        rootPart.AssemblyLinearVelocity = targetRoot.AssemblyLinearVelocity
        if elapsed >= followDuration then
            if pullConnection then pullConnection:Disconnect(); pullConnection = nil end
        end
    end)
end

--============================================================
-- EXECUTE MAGNET
--============================================================
local function executeMagnet(targetRoot, character, requestId)
    if not Settings.Magnet.Enabled or not targetRoot then return end
    local delayTime = tonumber(Settings.Magnet.Delay) or 0
    if delayTime > 0 then task.wait(delayTime) end
    if requestId ~= magnetRequest or not Settings.Magnet.Enabled
        or localPlayer.Character ~= character then return end
    startMagnetPull(targetRoot, character, requestId)
end

