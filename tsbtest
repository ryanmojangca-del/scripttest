            end
        end)
    end

    --// The shared card has ZIndex 2. The original Dash and Hide controls
    --// were created with the default ZIndex 1, which can put them behind
    --// the card in Roblox. Raise each existing control and its descendants
    --// above the card without changing their input handlers or appearance.
    local function raiseHomeTree(root, z)
        if root:IsA("GuiObject") then
            root.ZIndex = z
        end
        for _, child in ipairs(root:GetChildren()) do
            if child:IsA("GuiObject") then
                raiseHomeTree(child, z + 1)
            end
        end
    end
    raiseHomeTree(ToggleBtn, 3)
    raiseHomeTree(HideGUIRow, 3)
    local modeDivider = modeRow:FindFirstChild("Divider")
    if modeDivider then
        modeDivider.ZIndex = 4
    end
end

