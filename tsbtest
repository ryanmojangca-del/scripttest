do
    local LOGO_ACCENT = ""
    local LOGO_LIGHT = ""
    local B64 = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    local lookup = {}
    for i = 1, 64 do
        lookup[string.byte(B64, i)] = i - 1
    end
    local function decode(s)
        s = s:gsub("[^%w%+/=]", "")
        local out, n = {}, 0
        for i = 1, #s, 4 do
            local c1, c2, c3, c4 = string.byte(s, i, i + 3)
            local v1, v2 = lookup[c1], lookup[c2]
            local v3, v4 = c3 and lookup[c3], c4 and lookup[c4]
            local n24 = v1 * 262144 + v2 * 4096 + (v3 or 0) * 64 + (v4 or 0)
            n += 1
            out[n] = string.char(math.floor(n24 / 65536) % 256)
            if v3 then
                n += 1
                out[n] = string.char(math.floor(n24 / 256) % 256)
            end
            if v4 then
                n += 1
                out[n] = string.char(n24 % 256)
            end
        end
        return table.concat(out)
    end
    local function asset(fileName, b64)
        local ok, res = pcall(function()
            local gca = getcustomasset or getsynasset
            if not (writefile and gca) then
                return nil
            end
            writefile(fileName, decode(b64))
            return gca(fileName)
        end)
        if ok and type(res) == "string" and res ~= "" then
            return res
        end
        return nil
    end
    -- Embed the white Music icon locally, using the same loader as the Kamui logo.
    _G.KAMUI_MusicIconAsset = asset("KAMUI_music_sidebar_icon.png", "")
    local lightImg = asset("KAMUI_logo_light.png", LOGO_LIGHT)
    local accentImg = asset("KAMUI_logo_accent.png", LOGO_ACCENT)
    _G.KAMUI_LogoLight, _G.KAMUI_LogoAccent = lightImg, accentImg --// reused by the arraylist title
    if lightImg and accentImg then
        local function layer(name, img, color)
            local l = Instance.new("ImageLabel")
            l.Name = name
            l.Parent = TopBar
            l.BackgroundTransparency = 1
            l.BorderSizePixel = 0
            l.Image = img
            l.ImageColor3 = color
            l.ScaleType = Enum.ScaleType.Fit
            l.Size = UDim2.new(0, 20, 0, 20)
            l.Position = UDim2.new(0, 12, 0.5, -10)
            return l
        end
        layer("LogoLight", lightImg, Color3.fromRGB(255, 255, 255))
        layer("LogoAccent", accentImg, THEME.BrightRed)
        Title.Position = UDim2.new(0, 38, 0, 0)
    end
end

