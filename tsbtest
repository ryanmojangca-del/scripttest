_G.KAMUI_BuildGlyph = function(btn, parts)
    local glyph = Instance.new("Frame")
    glyph.Name = "TabGlyph"
    glyph.Parent = btn
    glyph.BackgroundTransparency = 1
    glyph.BorderSizePixel = 0
    glyph.Active = false
    glyph.Size = UDim2.new(0, 16, 0, 16)
    glyph.Position = UDim2.new(0, 16 - 40, 0.5, -8)
    local function part(cx, cy, w, h, rot)
        local f = Instance.new("Frame")
        f.BorderSizePixel = 0
        f.AnchorPoint = Vector2.new(0.5, 0.5)
        f.Position = UDim2.new(0, cx, 0, cy)
        f.Size = UDim2.new(0, w, 0, h)
        f.Rotation = rot or 0
        f.Active = false
        f.Parent = glyph
        return f
    end
    for _, p in ipairs(parts) do
        local kind = p[1]
        if kind == "line" then
            local x1, y1, x2, y2, t = p[2], p[3], p[4], p[5], p[6]
            local f = part((x1 + x2) / 2, (y1 + y2) / 2, math.sqrt((x2 - x1) ^ 2 + (y2 - y1) ^ 2), t,
                math.deg(math.atan2(y2 - y1, x2 - x1)))
            f.Name = "Bar"
            f.BackgroundColor3 = THEME.MutedText
            local c = Instance.new("UICorner")
            c.CornerRadius = UDim.new(0.5, 0)
            c.Parent = f
        elseif kind == "dot" then
            local f = part(p[2], p[3], p[4], p[4])
            f.Name = "Bar"
            f.BackgroundColor3 = THEME.MutedText
            local c = Instance.new("UICorner")
            c.CornerRadius = UDim.new(0.5, 0)
            c.Parent = f
        else -- ring (the head)
            local f = part(p[2], p[3], p[4], p[4])
            f.BackgroundTransparency = 1
            local c = Instance.new("UICorner")
            c.CornerRadius = UDim.new(0.5, 0)
            c.Parent = f
            local st = Instance.new("UIStroke")
            st.Color = THEME.MutedText
            st.Thickness = p[5]
            st.Parent = f
        end
    end
    return glyph
end

