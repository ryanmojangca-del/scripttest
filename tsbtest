        v = math.floor(math.clamp(v,0,60)*100+0.5)/100
        Settings.Magnet.Delay = v
        DelayBox.Text = string.format("%.2f",v); ValueBox.Text = string.format("%.2f",v)
        if BDUI.refreshDelay then BDUI.refreshDelay() end
        local alpha = math.clamp(v/SLIDER_MAX,0,1)
        Fill.Size = UDim2.new(alpha,0,1,0); Knob.Position = UDim2.new(alpha,-6,0.5,-6)
    end
    local sliding = false
    local function fromInput(pos)
        local alpha = math.clamp((pos.X-Track.AbsolutePosition.X)/math.max(Track.AbsoluteSize.X,1),0,1)
        setDelay(alpha*SLIDER_MAX)
    end
    SHit.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
            sliding = true; fromInput(input.Position)
            input.Changed:Connect(function() if input.UserInputState == Enum.UserInputState.End then sliding = false end end)
        end
    end)
    conns[#conns+1] = UserInputService.InputChanged:Connect(function(input)
        if sliding and (input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseMovement) then fromInput(input.Position) end
    end)
    ValueBox.FocusLost:Connect(function()
        local v = tonumber((ValueBox.Text:gsub("%s+","")))
        setDelay(v or Settings.Magnet.Delay)
    end)
