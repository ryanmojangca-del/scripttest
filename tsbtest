        camSmoothConn = nil
    end
    if camSmoothAttached then
        pcall(function()
            local char = player.Character
            local cam = workspace.CurrentCamera
            if cam then
                cam.CameraType = Enum.CameraType.Custom
                cam.CameraSubject = camSmoothPrevSubject or (char and char:FindFirstChildOfClass("Humanoid"))
