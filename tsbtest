end
local function performFrontDash()
    if not currentCommunicate or dashBusy then
        return
    end
    currentCommunicate:FireServer(leftclick.frontDash)
    if not workspace:GetAttribute("NoDashCooldown") then
        dashBusy = true
        task.delay(5, function()
            dashBusy = false
        end)
    end
end
local function stopAnimation(animationId)
    if not currentAnimator then
        return
    end
    for _, track in ipairs(currentAnimator:GetPlayingAnimationTracks()) do
        if track.Animation and track.Animation.AnimationId == "rbxassetid://" .. tostring(animationId) then
            track:Stop()
        end
    end
end
local function makeRotCFrame(position, yaw, pitch)
    local currentCamera = workspace.CurrentCamera
    if currentCamera then
        currentCamera.CFrame = CFrame.new(position) * CFrame.Angles(0, yaw, 0) * CFrame.Angles(pitch, 0, 0)
    end
end
local function computeLockAngles(angle, targetPosition, useCharacter, useCamera, _, smoothing)
    if not useCharacter and not useCamera and not angle then
        useCharacter = true
    end
    smoothing = smoothing or 1
    if not currentRootPart or not currentHumanoid then
        return
    end
    local cameraCFrame = camera.CFrame
    local cameraPosition = cameraCFrame.Position
    local rotateCharacter = useCharacter or useCamera
    local rotateCamera = not useCharacter or useCamera
    local position = cameraPosition
    if UserInputService.MouseBehavior == Enum.MouseBehavior.LockCenter then
        position = position - cameraCFrame.RightVector * 1.75
    end
    local pitch = math.asin(cameraCFrame.LookVector.Y)
    local baseYaw
    local targetYaw
    if targetPosition then
        local direction
        if rotateCharacter then
            direction = (targetPosition - currentRootPart.Position).Unit
            baseYaw = math.atan2(-currentRootPart.CFrame.LookVector.X, -currentRootPart.CFrame.LookVector.Z)
        else
            direction = (targetPosition - position).Unit
            baseYaw = math.atan2(-cameraCFrame.LookVector.X, -cameraCFrame.LookVector.Z)
        end
        targetYaw = math.atan2(-direction.X, -direction.Z)
    else
        local lookVector = rotateCharacter and currentRootPart.CFrame.LookVector or cameraCFrame.LookVector
        baseYaw = math.atan2(-lookVector.X, -lookVector.Z)
        targetYaw = baseYaw + math.rad(angle)
    end
    local delta = math.atan2(math.sin(targetYaw - baseYaw), math.cos(targetYaw - baseYaw))
    local finalYaw = baseYaw + delta * smoothing
    if rotateCharacter then
        currentHumanoid.AutoRotate = false
        currentRootPart.CFrame = CFrame.new(currentRootPart.Position) * CFrame.Angles(0, finalYaw, 0)
        if not rotateCamera then
            return
        end
    end
    makeRotCFrame(cameraPosition, finalYaw, pitch)
end
local function pingScaledDelay()
    local ok, ping = pcall(function()
        return DataPing:GetValue()
    end)
    if not ok or type(ping) ~= "number" then
        return 50
    end
    return ping
end
local function pingCompensatedRange(value)
    local adjusted = value + (pingScaledDelay() - 50) * -0.0003846
    return adjusted, value - adjusted
end
local function autoCounterClicks()
    if not currentCommunicate then
        return
    end
    task.wait()
    currentCommunicate:FireServer(leftclick.holdM1)
    task.wait()
    currentCommunicate:FireServer(leftclick.releaseM1)
    task.wait()
end
local function executeTrueM1Reset()
    if not Settings.TrueM1Reset.Enabled then
        return
    end
    if not currentCharacter or not currentHumanoid or not currentRootPart or not currentCommunicate then
        return
    end
    local delay = pingCompensatedRange(0.28)
    local startChar = currentCharacter
    autoCounterClicks()
    task.wait(delay)
    if currentCharacter ~= startChar or not currentHumanoid or currentHumanoid.Health <= 0 then
        return
    end
    if Settings.TrueM1Reset.AutoRotate then
        computeLockAngles(-90)
    end
    sendKeyEvent(keyD)
    tapKeyWithDelay(keyQ)
    task.wait(delay)
    tapKey(keyD)
    if Settings.TrueM1Reset.AutoRotate then
        computeLockAngles(90)
    end
    performFrontDash()
end
local function executeEmoteDash()
    if not Settings.EmoteDash.Enabled then
        return
    end
    if not currentCharacter or not currentHumanoid or not currentRootPart then
        return
    end
    tapKey(keyW)
    tapKey(keyS)
    if Settings.EmoteDash.Type == "Straight" then
        computeLockAngles(90)
    end
    if Settings.EmoteDash.Type == "Straight" or Settings.EmoteDash.Type == "Right" then
        sendKeyEvent(keyD)
    elseif Settings.EmoteDash.Type == "Left" then
        sendKeyEvent(keyA)
    end
    currentHumanoid:ChangeState(Enum.HumanoidStateType.Jumping)
    task.wait(0.005)
    tapKeyWithDelay(keyQ)
    task.wait(Settings.EmoteDash.Delay)
    local dodgeVelocity = currentRootPart:FindFirstChild("dodgevelocity")
    if dodgeVelocity then
        dodgeVelocity:Destroy()
        stopAnimation(animId2)
        stopAnimation(animId3)
    end
    tapKey(keyD)
    tapKey(keyA)
    if Settings.EmoteDash.Type == "Straight" then
        computeLockAngles(-90)
    end
end
-- Mobile-only input path: use the game's existing DashButton rather than
-- virtual keyboard events, so activating a macro does not switch away from touch.
local mobileOp = nil
local function mobileMessage(message)
    warn("[KAMUI mobile] " .. tostring(message))
    pcall(function()
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title="Kamui mobile", Text=tostring(message), Duration=5,
        })
    end)
end
local function gameButtonSignal(button, signalName)
    if not button or not button.Parent then return false, "Game button disappeared" end
    local ok, signal = pcall(function() return button[signalName] end)
    if not ok or not signal then return false, "Game button signal unavailable" end
    local connections
    if type(getconnections) == "function" then
        local got, result = pcall(getconnections, signal)
        if got and type(result) == "table" then
            connections = result
            local count = 0
            for _,c in ipairs(result) do if c.Enabled ~= false then count = count + 1 end end
            if count == 0 then return false, "No active " .. signalName .. " handler" end
        end
    end
    local pos,size=button.AbsolutePosition,button.AbsoluteSize
    local x,y=pos.X+size.X/2,pos.Y+size.Y/2
    if type(firesignal) == "function" then
        local fired,err=pcall(firesignal,signal,x,y)
        if fired then return true end
        if not connections then return false,tostring(err) end
    end
    if connections then
        local fired,reason=false,"Game button handler could not be fired"
        for _,c in ipairs(connections) do
            if c.Enabled ~= false then
                local worked,err=pcall(function() c:Fire(x,y) end)
                if worked then fired=true else reason=tostring(err) end
            end
        end
        return fired,reason
    end
    return false,"Executor cannot fire game button handlers"
end
local function stopMobileOperation(op)
    if not op or op.stopped then return end
    op.stopped = true
    if op.binding then pcall(function() RunService:UnbindFromRenderStep(op.binding) end) end
    if op.controller then
        pcall(function()
            if op.controller.moveVector == op.inputVector then op.controller.moveVector = op.originalMove end
        end)
    end
    if op.dashHeld then
        op.dashHeld = false
        pcall(function() gameButtonSignal(op.button,"MouseButton1Up") end)
    end
    if op.punchHeld then
        op.punchHeld = false
        pcall(function() gameButtonSignal(op.punchButton,"MouseButton1Up") end)
    end
    if mobileOp == op then mobileOp = nil end
end
mobileCancel = function() stopMobileOperation(mobileOp) end
local function newMobileOperation()
    if mobileOp then return nil,"A macro is already running" end
    local char=currentCharacter
    local hum=currentHumanoid
    local root=currentRootPart
    if not char or localPlayer.Character ~= char or not hum or hum.Health <= 0 or not root or not root.Parent then
        return nil,"Character not ready"
    end
    local pg=localPlayer:FindFirstChildOfClass("PlayerGui")
    local touch=pg and pg:FindFirstChild("TouchGui")
    local controls=touch and touch:FindFirstChild("TouchControlFrame")
    local jump=controls and controls:FindFirstChild("JumpButton")
    local button=jump and jump:FindFirstChild("DashButton")
    if not button or not button:IsA("GuiButton") then return nil,"Game dash button not found" end
    if type(firesignal) ~= "function" and type(getconnections) ~= "function" then
        return nil,"Executor cannot fire game button handlers"
    end
    local punch=jump and jump:FindFirstChild("PunchButton")
    local op={character=char,humanoid=hum,root=root,button=button,punchButton=punch,stopped=false,
        binding="KAMUI_M1MobileDash_" .. tostring(math.floor(os.clock()*1000000))}
    mobileOp=op
    return op
end
local function mobileValid(op)
    return op and mobileOp==op and not op.stopped and localPlayer.Character==op.character
        and op.root.Parent and op.humanoid.Parent and op.humanoid.Health>0
end
local function prepareMobileSideDash(op, right)
    if not mobileValid(op) then return false,"Character changed" end
    op.inputVector=Vector3.new(right and 1 or -1,0,0)
    pcall(function()
        local ps=localPlayer:FindFirstChild("PlayerScripts")
        local module=ps and ps:FindFirstChild("PlayerModule")
        local controls=module and require(module):GetControls()
        local active=controls and controls.activeController
        if active and typeof(active.moveVector)=="Vector3" then
            op.controller,op.originalMove=active,active.moveVector
        end
    end)
    local prepared=false
    local bound,err=pcall(function()
        RunService:BindToRenderStep(op.binding,Enum.RenderPriority.Character.Value+1,function()
            if not mobileValid(op) then return end
            if op.controller then pcall(function() op.controller.moveVector=op.inputVector end) end
            local cam=workspace.CurrentCamera
            if not cam then return end
            local side=cam.CFrame.RightVector
            local flat=Vector3.new(side.X,0,side.Z)
            if flat.Magnitude>0.001 then
                op.humanoid:Move(flat.Unit*(right and 1 or -1),false)
                prepared=true
            end
        end)
    end)
    if not bound then return false,"Could not prepare touch movement: " .. tostring(err) end
    task.wait(0.08)
    if not mobileValid(op) then return false,"Character changed" end
    if not prepared then return false,"Could not prepare side direction" end
    return true
end
local function startMobileDash(op)
    if not mobileValid(op) then return false,"Character changed" end
    local ok,err=gameButtonSignal(op.button,"MouseButton1Down")
    if not ok then return false,err end
    op.dashHeld=true
    task.delay(0.06,function()
        if op.dashHeld then
            op.dashHeld=false
            pcall(function() gameButtonSignal(op.button,"MouseButton1Up") end)
        end
    end)
    return true
end
local function executeMobileM1Reset()
    if not Settings.TrueM1Reset.Enabled or not currentCommunicate then return end
    local op,reason=newMobileOperation()
    if not op then mobileMessage(reason); return end
    local rotated=false
    local ok,err=pcall(function()
        local delay=math.max(0,pingCompensatedRange(0.28))
        -- Use the game's real touch M1 press/release handlers, matching the
        -- original three-frame click sequence without virtual mouse input.
        if not op.punchButton or not op.punchButton:IsA("GuiButton") then
            error("Game M1 button not found")
        end
        task.wait()
        if not mobileValid(op) then return end
        local m1Down,whyDown=gameButtonSignal(op.punchButton,"MouseButton1Down")
        if not m1Down then error("M1 press: " .. tostring(whyDown)) end
        op.punchHeld=true
        task.wait()
        if not mobileValid(op) then return end
        local m1Up,whyUp=gameButtonSignal(op.punchButton,"MouseButton1Up")
        if not m1Up then error("M1 release: " .. tostring(whyUp)) end
        op.punchHeld=false
        task.wait()
        if not mobileValid(op) then return end
        -- Prepare movement during the existing delay rather than adding 0.08s to it.
        if delay > 0.08 then task.wait(delay-0.08) end
        if not mobileValid(op) then return end
        if Settings.TrueM1Reset.AutoRotate then computeLockAngles(-90); rotated=true end
        local ready,why=prepareMobileSideDash(op,true)
        if not ready then error(why) end
        local fired,whyDash=startMobileDash(op)
        if not fired then error(whyDash) end
        task.wait(delay)
        if not mobileValid(op) then return end
        stopMobileOperation(op)
        if rotated then computeLockAngles(90); rotated=false end
        performFrontDash()
    end)
    if rotated and mobileValid(op) then pcall(function() computeLockAngles(90) end) end
    stopMobileOperation(op)
    if not ok then mobileMessage("M1 reset stopped: " .. tostring(err)) end
end
local function executeMobileEmoteDash()
    if not Settings.EmoteDash.Enabled then return end
    local op,reason=newMobileOperation()
    if not op then mobileMessage(reason); return end
    local rotated=false
    local ok,err=pcall(function()
        if Settings.EmoteDash.Type=="Straight" then computeLockAngles(90); rotated=true end
        local ready,why=prepareMobileSideDash(op,Settings.EmoteDash.Type~="Left")
        if not ready then error(why) end
        op.humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
        task.wait(0.005)
        if not mobileValid(op) then return end
        local fired,whyDash=startMobileDash(op)
        if not fired then error(whyDash) end
        task.wait(Settings.EmoteDash.Delay)
        if not mobileValid(op) then return end
        local dodgeVelocity=op.root:FindFirstChild("dodgevelocity")
        if dodgeVelocity then
            dodgeVelocity:Destroy(); stopAnimation(animId2); stopAnimation(animId3)
        end
        stopMobileOperation(op)
        if rotated then computeLockAngles(-90); rotated=false end
    end)
    if rotated and mobileValid(op) then pcall(function() computeLockAngles(-90) end) end
    stopMobileOperation(op)
    if not ok then mobileMessage("Emote dash stopped: " .. tostring(err)) end
end

do
    local rawM1Reset, rawEmoteDash = executeTrueM1Reset, executeEmoteDash
