-- Reset in place so the shared saved-settings table and all controls stay in sync.
local waitingForKey = false
local function resetDefaults()
    local focused = UserInputService:GetFocusedTextBox()
    if focused and focused:IsDescendantOf(gui) then
        pcall(function() focused:ReleaseFocus() end)
    end
    waitingForKey = false
    for key, value in pairs(DefaultSettings) do Settings[key] = value end
    for key, box in pairs(numberBoxes) do box.Text = fmt(Settings[key]) end
    keyButton.Text = keyName(Settings.Key)
    if repaintDirection then repaintDirection() end
    refreshMode()
end

local function makeResetButton(parent, size, position, z)
    local button = mk("TextButton", {
        Name = "ResetToDefault", Text = "Reset to default", Size = size, Position = position,
        BackgroundColor3 = PAL.Chip, BorderSizePixel = 0, AutoButtonColor = false,
        Font = Enum.Font.GothamMedium, TextSize = 11, TextColor3 = PAL.Text, ZIndex = z,
    }, parent)
    applyCorner(button, 7)
