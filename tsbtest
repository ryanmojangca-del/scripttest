end
-- Shared Kamui color and border styling, without changing the main GUI registry.
local THEME = {
    Background = Color3.fromRGB(6,6,7), BackgroundLight = Color3.fromRGB(13,13,14),
    BackgroundMedium = Color3.fromRGB(20,20,22), Red = Color3.fromRGB(205,18,20),
    BrightRed = Color3.fromRGB(240,30,24), DarkRed = Color3.fromRGB(52,8,12),
    Text = Color3.fromRGB(240,236,236), MutedText = Color3.fromRGB(150,145,146),
}
local MUI = {
    Line = Color3.fromRGB(36,36,38), Div = Color3.fromRGB(26,26,28),
    Chip = Color3.fromRGB(20,20,22), Head = Color3.fromRGB(105,105,108),
    OffTrack = Color3.fromRGB(42,42,45), OffKnob = Color3.fromRGB(189,184,184),
    White = Color3.fromRGB(255,255,255), colorUpdates = {},
}
function MUI.mk(class, props, parent)
    local obj = Instance.new(class)
    for k,v in pairs(props) do obj[k] = v end
    if class == "TextButton" or class == "TextBox" or class == "Frame" then
        obj:SetAttribute("KamuiSkinned", true)
    end
    obj.Parent = parent
    return obj
end
function MUI.stroke(obj, color, thickness, transparency)
    local st = Instance.new("UIStroke")
    st.Color, st.Thickness, st.Transparency = color, thickness or 1, transparency or 0
    st.Parent = obj
    return st
end
function MUI.onColor(fn)
    table.insert(MUI.colorUpdates, fn)
    pcall(fn)
end
function MUI.refreshTheme()
    local state = _G.KAMUI_GuiState
    if type(state) == "table" and type(state.h) == "number"
        and type(state.s) == "number" and type(state.v) == "number" then
        local h, sat, val = state.h, state.s, state.v
        if state.rainbow then
            h = (state.phase or h) % 1
            sat, val = math.max(sat, 0.7), math.max(val, 0.85)
        end
        local bh, bs, bv = Color3.fromRGB(205,18,20):ToHSV()
        local function mapped(source)
            local oh, osat, oval = source:ToHSV()
            local dh = oh - bh
            if dh > 0.5 then dh = dh - 1 elseif dh < -0.5 then dh = dh + 1 end
            return Color3.fromHSV((h + dh) % 1, math.clamp(osat*sat/bs,0,1), math.clamp(oval*val/bv,0,1))
        end
        THEME.Red = mapped(Color3.fromRGB(205,18,20))
        THEME.BrightRed = mapped(Color3.fromRGB(240,30,24))
        THEME.DarkRed = mapped(Color3.fromRGB(52,8,12))
    end
    if MUI.lastRed == THEME.Red and MUI.lastBright == THEME.BrightRed and MUI.lastDark == THEME.DarkRed then return end
    MUI.lastRed, MUI.lastBright, MUI.lastDark = THEME.Red, THEME.BrightRed, THEME.DarkRed
    for _,fn in ipairs(MUI.colorUpdates) do pcall(fn) end
end
function MUI.logo(parent, pos, size, z)
    local light, accent = _G.KAMUI_LogoLight, _G.KAMUI_LogoAccent
    if not (light and accent) then return end
    MUI.mk("ImageLabel", {Name="LogoLight", Image=light, BackgroundTransparency=1,
        Position=pos, Size=size, ScaleType=Enum.ScaleType.Fit, ZIndex=z}, parent)
    local a = MUI.mk("ImageLabel", {Name="LogoAccent", Image=accent, BackgroundTransparency=1,
        Position=pos, Size=size, ScaleType=Enum.ScaleType.Fit, ZIndex=z+1}, parent)
    a:SetAttribute("KamuiKeepColor", true)
    MUI.onColor(function() if a.Parent then a.ImageColor3 = THEME.BrightRed end end)
end
-- Match the main GUI's rotating gradient and layered inner/outer glow.
function MUI.makeBorder(window, radius, windowScale)
    local gradients, glowStrokes, baseAlpha = {}, {}, {}
    local sourceSequence = _G.KAMUI_BorderSeq or ColorSequence.new(THEME.Red)
    local function gradient(stroke)
        local g = Instance.new("UIGradient")
        g.Color, g.Parent = sourceSequence, stroke
        table.insert(gradients, g)
    end
    local function layer(parent, offset, thickness, transparency, layerRadius, z)
        local frame = MUI.mk("Frame", {Name="M1GlowLayer", BackgroundTransparency=1,
            BorderSizePixel=0, Active=false, ZIndex=z, Position=UDim2.fromOffset(offset,offset),
            Size=UDim2.new(1,-2*offset,1,-2*offset)}, parent)
        local corner = applyCorner(frame, math.max(layerRadius,2))
        local st = MUI.stroke(frame, Color3.new(1,1,1), thickness, transparency)
        st:SetAttribute("KamuiKeepColor", true)
        gradient(st)
        table.insert(glowStrokes, {stroke=st, corner=corner, offset=offset})
        table.insert(baseAlpha, transparency)
    end
    local edge = MUI.stroke(window, Color3.new(1,1,1), 1.5, 0.05)
    edge.Name = "M1GradientEdge"; edge:SetAttribute("KamuiKeepColor", true)
    edge.ApplyStrokeMode = Enum.ApplyStrokeMode.Border; gradient(edge)
    for k=1,3 do layer(window,k,1.5,0.3+(k-1)*0.15,radius-k,window.ZIndex) end
    local holder = MUI.mk("Frame", {Name="M1OuterGlow", BackgroundTransparency=1,
        BorderSizePixel=0, Active=false, ClipsDescendants=false,
        ZIndex=math.max(0,window.ZIndex-1), Visible=false}, gui)
    local holderScale = Instance.new("UIScale"); holderScale.Parent = holder
    for k=1,5 do layer(holder,-k,2,0.22+(k-1)*0.14,radius+k,holder.ZIndex) end
    local corner = window:FindFirstChildOfClass("UICorner")
    conns[#conns+1] = RunService.RenderStepped:Connect(function()
        if not window.Parent then holder.Visible=false; return end
        holder.Visible = window.Visible
        if not window.Visible then return end
        holder.AnchorPoint, holder.Position, holder.Size, holder.Rotation = window.AnchorPoint, window.Position, window.Size, window.Rotation
        holderScale.Scale = windowScale and windowScale.Scale or 1
        local rounded = corner and corner.CornerRadius.Offset or radius
        local t = os.clock(); local pulse = 0.5 + 0.5 * math.sin(t*2)
        local source = _G.KAMUI_BorderGradients and _G.KAMUI_BorderGradients[1]
        local seq = source and source.Parent and source.Color or ColorSequence.new(THEME.Red)
        local rotation = source and source.Parent and source.Rotation or ((t*60)%360)
        for _,g in ipairs(gradients) do g.Color, g.Rotation = seq, rotation end
        edge.Transparency = 0.05 + 0.1*pulse
        for i,entry in ipairs(glowStrokes) do
            entry.stroke.Transparency = math.clamp(baseAlpha[i]-0.12*pulse,0,1)
            entry.corner.CornerRadius = UDim.new(0,math.max(rounded-entry.offset,2))
        end
    end)
