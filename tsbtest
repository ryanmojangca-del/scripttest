    }, drawHolder)
    resizePanel:SetAttribute("KamuiNoDrag", true)
    UI.corner(resizePanel, 8)
    UI.stroke(resizePanel, UI.LINE)
    UI.make("TextLabel", {
        Name = "HeightTitle", BackgroundTransparency = 1,
        Position = UDim2.fromOffset(10, 4), Size = UDim2.new(0.6, -10, 0, 16),
        Font = Enum.Font.GothamMedium, TextSize = 10, TextColor3 = THEME.Text,
        TextXAlignment = Enum.TextXAlignment.Left, Text = "Area height"
    }, resizePanel)
    local heightValue = UI.make("TextLabel", {
        Name = "HeightValue", BackgroundTransparency = 1,
        Position = UDim2.new(0.6, 0, 0, 4), Size = UDim2.new(0.4, -10, 0, 16),
        Font = Enum.Font.GothamMedium, TextSize = 10, TextColor3 = THEME.BrightRed,
        TextXAlignment = Enum.TextXAlignment.Right, Text = "100%"
    }, resizePanel)
    local heightTrack = UI.make("Frame", {
        Name = "HeightTrack", BackgroundColor3 = Color3.fromRGB(54, 54, 58),
        BorderSizePixel = 0, Position = UDim2.new(0, 12, 0, 35), Size = UDim2.new(1, -24, 0, 5)
    }, resizePanel)
    heightTrack:SetAttribute("KamuiNoDrag", true)
    UI.corner(heightTrack, 3)
    local heightFill = UI.make("Frame", {
        Name = "HeightFill", BackgroundColor3 = THEME.Red, BorderSizePixel = 0,
        Size = UDim2.new(0, 0, 1, 0)
    }, heightTrack)
    UI.corner(heightFill, 3)
    local heightKnob = UI.make("Frame", {
        Name = "HeightKnob", BackgroundColor3 = Color3.fromRGB(245, 245, 245),
        BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0, 0, 0.5, 0), Size = UDim2.fromOffset(12, 12)
    }, heightTrack)
    UI.corner(heightKnob, 6)
    local heightHit = UI.make("TextButton", {
        Name = "HeightHit", BackgroundTransparency = 1, Text = "", AutoButtonColor = false,
        Position = UDim2.new(0, 0, 0, 22), Size = UDim2.new(1, 0, 0, 34)
    }, resizePanel)
    heightHit:SetAttribute("KamuiNoDrag", true)

    local raw = {} -- canvas fractions of every point (YOU first, TARGET last once finished)
    local function dims()
        local ws = MainFrame:FindFirstChild("WindowScale")
        local sc = (ws and ws.Scale > 0) and ws.Scale or 1
        local sz = canvas.AbsoluteSize
        local w = sz.X / sc
        if w < 10 then w = 336 end -- page not laid out yet
        return w, drawHeight
    end
    local function addSegment(f1, f2)
        local W, H = dims()
        local x1, y1, x2, y2 = f1.X * W, f1.Y * H, f2.X * W, f2.Y * H
        local dx, dy = x2 - x1, y2 - y1
        local len = math.sqrt(dx * dx + dy * dy)
        if len < 0.5 then
            return
        end
        local seg = UI.make("Frame", {
            BackgroundColor3 = THEME.BrightRed,
            BorderSizePixel = 0,
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.new(0, (x1 + x2) / 2, 0, (y1 + y2) / 2),
            Size = UDim2.new(0, len + 1, 0, 2),
            Rotation = math.deg(math.atan2(dy, dx)),
            ZIndex = 3
        }, strokes)
        seg:SetAttribute("KamuiSkinned", true)
    end
    local function setStatus()
        if #DR.pts >= 2 then
            status.Text = string.format("Pattern ready  \u{B7}  %d points  \u{B7}  starts at you  \u{B7}  ends on target", #DR.pts)
        else
            status.Text = "Draw a path from YOU to TARGET (empty = straight dash)"
        end
    end
    local function rebuildNorm()
        local W, H = dims()
        local unit = math.max(1, (YOU_F.Y - TGT_F.Y) * H)
        local pts = {}
        for i, f in ipairs(raw) do
            pts[i] = { ((YOU_F.Y - f.Y) * H) / unit, ((f.X - YOU_F.X) * W) / unit }
        end
        DR.pts = pts
        setStatus()
    end
    local function clearPattern()
        raw = {}
        DR.pts = {}
        strokes:ClearAllChildren()
        setStatus()
    end
    clearBtn.MouseButton1Click:Connect(clearPattern)
    setStatus()
    --// used by profile codes: redraw a stored pattern (normalised points) in the box
    _G.KAMUI_DrawUI = {
        setPts = function(pts)
            strokes:ClearAllChildren()
            raw = {}
            DR.pts = {}
            if type(pts) == "table" and #pts >= 2 then
                local W, H = dims()
                local unit = math.max(1, (YOU_F.Y - TGT_F.Y) * H)
                for i, q in ipairs(pts) do
                    raw[i] = Vector2.new(YOU_F.X + (q[2] * unit) / W, YOU_F.Y - (q[1] * unit) / H)
                    if i > 1 then
                        addSegment(raw[i - 1], raw[i])
                    end
                end
                DR.pts = pts
            end
            setStatus()
        end
    }

    local function canvasFrac(pos)
        local ap, sz = canvas.AbsolutePosition, canvas.AbsoluteSize
        return Vector2.new(
            math.clamp((pos.X - ap.X) / math.max(1, sz.X), 0, 1),
            math.clamp((pos.Y - ap.Y) / math.max(1, sz.Y), 0, 1)
        )
    end
    local function isPress(i)
        return i.UserInputType == Enum.UserInputType.MouseButton1
            or i.UserInputType == Enum.UserInputType.Touch
    end
    canvas.InputBegan:Connect(function(i)
        if not isPress(i) or not isCurrent() or DR.Locked then
            return
        end
        drawing = true
        _G.KAMUI_SliderHeld = true
        S.ScrollingEnabled = false
        clearPattern()
        raw[1] = YOU_F
        local f = canvasFrac(i.Position)
        raw[2] = f
        addSegment(YOU_F, f)
        rebuildNorm()
    end)
    UIS.InputChanged:Connect(function(i)
        if not drawing or not isCurrent() then
            return
        end
        if i.UserInputType ~= Enum.UserInputType.MouseMovement
            and i.UserInputType ~= Enum.UserInputType.Touch then
            return
        end
        local W, H = dims()
        local f = canvasFrac(i.Position)
        local last = raw[#raw]
        local dx, dy = (f.X - last.X) * W, (f.Y - last.Y) * H
        if dx * dx + dy * dy >= 36 and #raw < 150 then
            raw[#raw + 1] = f
            addSegment(last, f)
            rebuildNorm()
        end
    end)
    finishDrawing = function()
        if not drawing then return end
        drawing = false
        _G.KAMUI_SliderHeld = false
        S.ScrollingEnabled = true
        local last = raw[#raw]
        if last then
            raw[#raw + 1] = TGT_F -- the path always ends on the target
            addSegment(last, TGT_F)
            rebuildNorm()
        end
    end
    UIS.InputEnded:Connect(function(i)
        if drawing and isPress(i) then finishDrawing() end
    end)

    local function paintDrawControls()
        resizeChevron.Rotation = resizeOpen and 180 or 0
        resizeBtn.BackgroundColor3 = resizeOpen and Color3.fromRGB(40, 24, 27) or UI.CHIP
        local border = resizeBtn:FindFirstChildOfClass("UIStroke")
        if border then border.Color = resizeOpen and THEME.Red or UI.LINE end
        drawState.Text = DR.Locked and "Locked" or "Unlocked"
        drawState.TextColor3 = DR.Locked and THEME.MutedText or Color3.fromRGB(90, 205, 140)
        stateDot.BackgroundColor3 = DR.Locked and THEME.MutedText or Color3.fromRGB(90, 205, 140)
        shackle.Position = DR.Locked and UDim2.fromOffset(3, 1) or UDim2.fromOffset(1, 1)
        local alpha = (drawHeight - MIN_DRAW_HEIGHT) / (MAX_DRAW_HEIGHT - MIN_DRAW_HEIGHT)
        heightFill.Size = UDim2.new(alpha, 0, 1, 0)
        heightKnob.Position = UDim2.new(alpha, 0, 0.5, 0)
        heightValue.Text = string.format("%d%%", math.floor(drawHeight / MIN_DRAW_HEIGHT * 100 + 0.5))
    end
    local function layoutDrawControls()
        -- Anchor the marker pair around the centre with fixed 49.4px spacing.
        YOU_F = Vector2.new(0.5, (drawHeight / 2 + 31.2) / drawHeight)
        TGT_F = Vector2.new(0.5, (drawHeight / 2 - 18.2) / drawHeight)
        youMarker.Position = UDim2.new(YOU_F.X, 0, YOU_F.Y, 0)
        targetMarker.Position = UDim2.new(TGT_F.X, 0, TGT_F.Y, 0)
        canvas.Size = UDim2.new(1, -24, 0, drawHeight)
        local rowY = drawHeight + 20
        resizeBtn.Position = UDim2.new(0, 12, 0, rowY)
        resizeBtn.Size = UDim2.new(0.5, -17, 0, 34)
        lockBtn.Position = UDim2.new(0.5, 5, 0, rowY)
        lockBtn.Size = UDim2.new(0.5, -17, 0, 34)
        resizePanel.Position = UDim2.new(0, 12, 0, drawHeight + 62)
        resizePanel.Visible = resizeOpen
        local clearY = drawHeight + 62 + (resizeOpen and 64 or 0)
        clearBtn.Position = UDim2.new(0, 12, 0, clearY)
        status.Position = UDim2.new(0, 12, 0, clearY)
        drawHolder.Size = UDim2.new(1, 0, 0, clearY + 44)
        paintDrawControls()
    end
    local function setDrawHeight(height)
        if drawing then finishDrawing() end
        local nextHeight = math.clamp(math.floor(height + 0.5), MIN_DRAW_HEIGHT, MAX_DRAW_HEIGHT)
        if nextHeight == drawHeight then return end
        drawHeight = nextHeight
        DR.AreaHeight = drawHeight
        layoutDrawControls()
        -- Reconstruct the visual from the unchanged normalized points.
        _G.KAMUI_DrawUI.setPts(DR.pts)
    end
    resizeBtn.MouseButton1Click:Connect(function()
        if not isCurrent() then return end
        resizeOpen = not resizeOpen
        layoutDrawControls()
    end)
    lockBtn.MouseButton1Click:Connect(function()
        if not isCurrent() then return end
        if not DR.Locked and drawing then finishDrawing() end
        DR.Locked = not DR.Locked
        paintDrawControls()
    end)
    local heightInput, heightDragging = nil, false
    local function updateHeightFromX(x)
        local alpha = math.clamp((x - heightTrack.AbsolutePosition.X) / math.max(1, heightTrack.AbsoluteSize.X), 0, 1)
        setDrawHeight(MIN_DRAW_HEIGHT + alpha * (MAX_DRAW_HEIGHT - MIN_DRAW_HEIGHT))
    end
    heightHit.InputBegan:Connect(function(i)
        if not isCurrent() or not isPress(i) then return end
        if drawing then finishDrawing() end
        heightDragging, heightInput = true, i
        _G.KAMUI_SliderHeld = true
        S.ScrollingEnabled = false
        updateHeightFromX(i.Position.X)
    end)
    UIS.InputChanged:Connect(function(i)
        if not heightDragging or not isCurrent() then return end
        local matches = i == heightInput or (heightInput.UserInputType == Enum.UserInputType.MouseButton1
            and i.UserInputType == Enum.UserInputType.MouseMovement)
        if matches then updateHeightFromX(i.Position.X) end
    end)
    UIS.InputEnded:Connect(function(i)
        if not heightDragging then return end
        local matches = i == heightInput or (heightInput.UserInputType == Enum.UserInputType.MouseButton1
            and i.UserInputType == Enum.UserInputType.MouseButton1)
        if matches then
            heightDragging, heightInput = false, nil
            _G.KAMUI_SliderHeld = false
            S.ScrollingEnabled = true
        end
    end)
    canvas:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
        if isCurrent() and not drawing then _G.KAMUI_DrawUI.setPts(DR.pts) end
    end)
    layoutDrawControls()
    _G.KAMUI_DrawUI.setPts(DR.pts)

    _G.KAMUI_DrawRefresh = function()
        local mode = Config.LethalMode
        local draw = mode == "Draw"
        local kiba = mode == "Kiba"
        drawHolder.Visible = draw
        --// Draw / Kiba hide Accuracy, Cancel delay and Dash range.
        --// Draw keeps Jump power, Cam Smooth, Floater, Delay, Touch. Kiba keeps Delay, Connect delay (Magnet delay),
        --// Touch (Jump power, Floater and Cam Smooth are not used: Kiba has its own non-snapping camera).
        local function setVis(o, v)
            if o then
                o.Visible = v
            end
        end
        local special = draw or kiba
        setVis(AccInput, not special)
        setVis(rows["Cancel delay"], not special)
        setVis(rows["Dash range"], not special)
        setVis(rows["Jump power"], not kiba)
        setVis(FloaterBtn, not kiba)
        setVis(CamSmoothBtn, not kiba)
        setVis(CamSmoothDelayInput, not kiba)
        setVis(CamDurationInput, not kiba)
        setVis(rows["Magnet delay"], not kiba)
        setVis(rows["Connect delay"], kiba)
    end

    local lethal = UI.card(S, "Dash")
    addInput(lethal, DelayInput)
    addInput(lethal, rows["Jump power"])
    addInput(lethal, AccInput)
    addInput(lethal, rows["Cancel delay"])

    local move = UI.card(S, "Movement")
    addInput(move, rows["Magnet delay"])
    addInput(move, rows["Connect delay"])
    addInput(move, rows["Dash range"])
    addToggle(move, FloaterBtn)
    addToggle(move, CooldownBtn)

    local cam = UI.card(S, "Camera")
    addToggle(cam, CamSmoothBtn)
    addInput(cam, CamSmoothDelayInput)
    addInput(cam, CamDurationInput)

    --// Touch mode first, so Platform / Keybind appear BELOW it when enabled
    local inp = UI.card(S, "Input")
    addToggle(inp, TouchBtn)
    addToggle(inp, PlatformBtn)
    UI.segmented(PlatformBtn, { "PC", "Mobile" })
    addInput(inp, KeyInput)
    _G.KAMUI_DrawRefresh()
end

