--// Everything we press virtually is remembered, so a macro that gets cut short
--// (death / respawn / error) can never leave a key or mouse button stuck down.
local heldKeys = {}
local mouseHeld = false
local lifeEpoch = 0 -- +1 on every respawn; a running macro stops when it changes

local function sendKeyEvent(
    keyCode
)
    heldKeys[keyCode] = true
    VirtualInputManager:SendKeyEvent(true, keyCode, false, game)
end

local function tapKey(
    keyCode
)
    heldKeys[keyCode] = nil
    VirtualInputManager:SendKeyEvent(false, keyCode, false, game)
end

--// releases only what is actually still held (sends nothing when nothing is stuck)
local function releaseHeldInput()
    for keyCode in pairs(heldKeys) do
        heldKeys[keyCode] = nil
        pcall(function()
            VirtualInputManager:SendKeyEvent(false, keyCode, false, game)
        end)
    end
    if mouseHeld then
        mouseHeld = false
        pcall(function()
            VirtualInputManager:SendMouseButtonEvent(halfViewportX, halfViewportY, 0, false, game, 0)
        end)
    end
end

--// phone only: puts the game's mobile buttons back after virtual keyboard/mouse input
local function restoreTouchInput()
    -- The native mobile path sends no virtual keyboard/mouse input.
    if _G.KAMUI_BackdashMobile then return end
    if _G.KAMUI_RestoreTouchInput then
        pcall(_G.KAMUI_RestoreTouchInput)
    end
end

local function tapKeyWithDelay(
    keyCode
)
    sendKeyEvent(keyCode)
    task.wait()
    tapKey(keyCode)
end

local BACKDASH_PAYLOAD = { Dash = keyS, Key = keyQ, Goal = "KeyPress" }
local M1_DOWN_PAYLOAD = { Goal = "LeftClick" }
local M1_UP_PAYLOAD = { Goal = "LeftClickRelease" }
local dashBusy = false

local function getCommunicate()
    local character = localPlayer.Character
    return character and character:FindFirstChild("Communicate")
end

local function simulateM1Click(
    keyCode
)
    sendKeyEvent(keyCode)
    task.wait()
    tapKey(keyCode)
    if not sAutoUnequip then
        task.wait()
        local remote = Settings.Remote.M1 and getCommunicate()
        if remote then
            remote:FireServer(M1_DOWN_PAYLOAD)
            task.wait()
            remote:FireServer(M1_UP_PAYLOAD)
        else
            mouseHeld = true
            VirtualInputManager:SendMouseButtonEvent(halfViewportX, halfViewportY, 0, true, game, 0)
            task.wait()
            mouseHeld = false
            VirtualInputManager:SendMouseButtonEvent(halfViewportX, halfViewportY, 0, false, game, 0)
        end
    end
end

-- Mobile path: invoke the game's existing GUI handlers without synthetic
-- keyboard/mouse events, so Roblox should stay in touch input mode.
local mobileStatus = function(message) warn("[KAMUI mobile backdash] " .. tostring(message)) end
local mobileRun = nil
local mobileCancelDelay = 0 -- seconds from dash handler to skill handler; temporary
local function mobileSignal(button, name)
    if not button or not button.Parent then return false, "Game button disappeared" end
    local ok, signal = pcall(function() return button[name] end)
    if not ok or not signal then return false, name .. " unavailable" end
    local connections
    if type(getconnections) == "function" then
        local got, result = pcall(getconnections, signal)
        if got and type(result) == "table" then
            connections = result
            local enabled = 0
            for _, connection in ipairs(result) do
                if connection.Enabled ~= false then enabled = enabled + 1 end
            end
            if enabled == 0 then return false, name .. " has no active handlers" end
        end
    end
    local pos, size = button.AbsolutePosition, button.AbsoluteSize
    local x, y = pos.X + size.X / 2, pos.Y + size.Y / 2
    if type(firesignal) == "function" then
        local fired, err = pcall(firesignal, signal, x, y)
        if fired then return true end
        if not connections then return false, tostring(err) end
    end
    if connections then
        local fired, lastError = false, "No enabled handler could be fired"
        for _, connection in ipairs(connections) do
            if connection.Enabled ~= false then
                local worked, err = pcall(function() connection:Fire(x, y) end)
                if worked then fired = true else lastError = tostring(err) end
            end
        end
        return fired, fired and nil or lastError
    end
    return false, "Executor does not expose signal firing"
end
local function stopMobileRun(run)
    if not run or run.stopped then return end
    run.stopped = true
    if run.binding then pcall(function() RunService:UnbindFromRenderStep(run.binding) end) end
    if run.controller then
        pcall(function()
            if run.controller.moveVector == run.inputVector then run.controller.moveVector = run.originalMove end
        end)
    end
    for button in pairs(run.held) do
        pcall(function() mobileSignal(button, "MouseButton1Up") end)
        run.held[button] = nil
    end
    if mobileRun == run then mobileRun = nil end
end
local function performMobileBackdash(keyCode)
    if mobileRun then mobileStatus("Already running"); return false end
    local char = localPlayer.Character
    local humanoid = char and char:FindFirstChildOfClass("Humanoid")
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local pg = localPlayer:FindFirstChildOfClass("PlayerGui")
    local hotbar = pg and pg:FindFirstChild("Hotbar")
    hotbar = hotbar and hotbar:FindFirstChild("Backpack")
    hotbar = hotbar and hotbar:FindFirstChild("Hotbar")
    local indices = {[Enum.KeyCode.One] = "1", [Enum.KeyCode.Two] = "2", [Enum.KeyCode.Three] = "3", [Enum.KeyCode.Four] = "4"}
    local slot = hotbar and hotbar:FindFirstChild(indices[keyCode] or "")
    local skill = slot and slot:FindFirstChild("Base")
    local touch = pg and pg:FindFirstChild("TouchGui")
    local controlFrame = touch and touch:FindFirstChild("TouchControlFrame")
    local jump = controlFrame and controlFrame:FindFirstChild("JumpButton")
    local punch = jump and jump:FindFirstChild("PunchButton")
    local dash = jump and jump:FindFirstChild("DashButton")
    if not humanoid or humanoid.Health <= 0 or not root then mobileStatus("Character not ready"); return false end
    if not skill or not skill:IsA("GuiButton") then mobileStatus("Skill " .. tostring(indices[keyCode]) .. " button not found"); return false end
    if not sAutoUnequip and (not punch or not punch:IsA("GuiButton")) then mobileStatus("Game M1 button not found"); return false end
    if not dash or not dash:IsA("GuiButton") then mobileStatus("Game dash button not found"); return false end
    if type(firesignal) ~= "function" and type(getconnections) ~= "function" then mobileStatus("Executor cannot fire button handlers"); return false end
    local run = {held = {}, inputVector = Vector3.new(0, 0, 1), binding = "KAMUI_BackdashTouch_" .. tostring(math.floor(os.clock() * 1000000))}
    mobileRun = run
    local epoch = lifeEpoch
    local function valid() return mobileRun == run and not run.stopped and lifeEpoch == epoch and localPlayer.Character == char and humanoid.Parent and humanoid.Health > 0 and root.Parent end
    local function press(button)
        local ok, err = mobileSignal(button, "MouseButton1Down")
        if not ok then error(err) end
        run.held[button] = true
    end
    local function release(button)
        local ok, err = mobileSignal(button, "MouseButton1Up")
        if not ok then error(err) end
        run.held[button] = nil
    end
    local ok, err = pcall(function()
        -- Prepare the backward direction before the dash and skill, so the
        -- 0.08 s touch-controller setup finishes before the cancel.
        pcall(function()
            local ps = localPlayer:FindFirstChild("PlayerScripts")
            local module = ps and ps:FindFirstChild("PlayerModule")
            local controls = module and require(module):GetControls()
            local active = controls and controls.activeController
            if active and typeof(active.moveVector) == "Vector3" then
                run.controller, run.originalMove = active, active.moveVector
            end
        end)
        local prepared = false
        RunService:BindToRenderStep(run.binding, Enum.RenderPriority.Character.Value + 1, function()
            if not valid() then return end
            if run.controller then pcall(function() run.controller.moveVector = run.inputVector end) end
            local cam = Workspace.CurrentCamera
            if not cam then return end
            local look = cam.CFrame.LookVector
            local flat = Vector3.new(look.X, 0, look.Z)
            if flat.Magnitude > 0.001 then
                humanoid:Move(-flat.Unit, false)
                prepared = true
            end
        end)
        task.wait(0.08)
        if not valid() then error("Character changed") end
        if not prepared then error("Could not prepare backward direction") end
        -- A backdash cancel begins the backdash, then immediately uses the move.
        -- Unlike PC slot keys, the mobile slot can activate the skill directly.
        press(dash)
        local dashSentAt = os.clock()
        -- Zero is same-thread; positive values wait on Roblox's scheduler.
        local requestedDelay = mobileCancelDelay
        if requestedDelay > 0 then task.wait(requestedDelay) end
        if not valid() then error("Character changed") end
        run.actualDelay = os.clock() - dashSentAt
        press(skill)
        task.wait()
        if not valid() then error("Character changed") end
        release(skill)
        local clicked, why = mobileSignal(skill, "MouseButton1Click")
        if not clicked then error("Skill click: " .. tostring(why)) end
        release(dash)
        if not sAutoUnequip then
            task.wait()
            if not valid() then error("Character changed") end
            press(punch)
            task.wait()
            if not valid() then error("Character changed") end
            release(punch)
        end
        task.wait(0.04)
    end)
    stopMobileRun(run)
    if not ok then mobileStatus("Stopped: " .. tostring(err)); return false end
    mobileStatus(string.format("Dash → skill handlers sent | actual wait %.3fs%s",
        run.actualDelay or 0, sAutoUnequip and " | auto-unequip" or ""))
    return true
end

--============================================================
-- BACKDASH MACRO
--============================================================

local function isAlive()
    local character = localPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    return humanoid ~= nil
        and humanoid.Health > 0
        and character:FindFirstChild("HumanoidRootPart") ~= nil
end

local function performBackDashMacro(
    keyCode
)
    if not isAlive() then
        return false
    end
    if _G.KAMUI_BackdashMobile then
        return performMobileBackdash(keyCode)
    end
    local epoch = lifeEpoch
    simulateM1Click(keyCode)
    task.wait()
    if not isAlive() or epoch ~= lifeEpoch then
        releaseHeldInput()
        return false
    end
    local remote = Settings.Remote.Dash and getCommunicate()
    if remote then
        if not dashBusy then
            remote:FireServer(BACKDASH_PAYLOAD)
            if not workspace:GetAttribute("NoDashCooldown") then
                dashBusy = true
                task.delay(5, function()
                    dashBusy = false
                end)
            end
        end
        task.wait(0.1)
    else
        sendKeyEvent(keyS)
        tapKeyWithDelay(keyQ)
        task.wait(0.1)
        tapKey(keyS)
    end
    return true
end

