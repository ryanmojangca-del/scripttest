function TUI.refreshTheme()
    local state = _G.KAMUI_GuiState
    if type(state) == "table" and type(state.h) == "number"
        and type(state.s) == "number" and type(state.v) == "number" then
        local h, sat, val = state.h, state.s, state.v
        if state.rainbow then
            h = (state.phase or h) % 1
            sat, val = math.max(sat, 0.7), math.max(val, 0.85)
        end
        local bh, bs, bv = Color3.fromRGB(205,18,20):ToHSV()
        local function mapped(source)
            local oh, osat, oval = source:ToHSV()
            local dh = oh - bh
            if dh > 0.5 then dh = dh - 1 elseif dh < -0.5 then dh = dh + 1 end
            return Color3.fromHSV((h + dh) % 1, math.clamp(osat*sat/bs,0,1), math.clamp(oval*val/bv,0,1))
        end
        THEME.Red = mapped(Color3.fromRGB(205,18,20))
        THEME.BrightRed = mapped(Color3.fromRGB(240,30,24))
        THEME.DarkRed = mapped(Color3.fromRGB(52,8,12))
    end
    if TUI.lastRed == THEME.Red and TUI.lastBright == THEME.BrightRed and TUI.lastDark == THEME.DarkRed then return end
    TUI.lastRed, TUI.lastBright, TUI.lastDark = THEME.Red, THEME.BrightRed, THEME.DarkRed
    PAL.Red, PAL.Bright, PAL.DarkRed = THEME.Red, THEME.BrightRed, THEME.DarkRed
    for _,fn in ipairs(TUI.colorUpdates) do pcall(fn) end
end
