--// builds an instance; flags it so the main script's skin pass leaves it alone
function BDUI.mk(class, props, parent)
    local o = Instance.new(class)
    for k, v in pairs(props) do
        o[k] = v
    end
    if class == "TextButton" or class == "TextBox" or class == "Frame" then
        o:SetAttribute("KamuiSkinned", true)
    end
    o.Parent = parent
    return o
end
function BDUI.stroke(obj, color, thickness, transparency)
    local st = Instance.new("UIStroke")
    st.Color = color
    st.Thickness = thickness or 1
    st.Transparency = transparency or 0
    st.Parent = obj
    return st
end

