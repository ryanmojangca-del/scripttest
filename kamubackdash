--============================================================
-- EXECUTE MACRO
--============================================================

local function executeMacro(index)
    local enabled = false
    local macroKey = nil
    if index == 1 then
        enabled = Settings.Macro.BackDashCancel1.Enabled
        macroKey = Enum.KeyCode.One
    elseif index == 2 then
        enabled = Settings.Macro.BackDashCancel2.Enabled
        macroKey = Enum.KeyCode.Two
    elseif index == 3 then
        enabled = Settings.Macro.BackDashCancel3.Enabled
        macroKey = Enum.KeyCode.Three
    elseif index == 4 then
        enabled = Settings.Macro.BackDashCancel4.Enabled
        macroKey = Enum.KeyCode.Four
    end
    if not enabled then
        return
    end
    --========================================================
    -- RUN ORIGINAL MACRO
    --========================================================
    task.spawn(function()
        local ok, result = pcall(performBackDashMacro, macroKey)
        task.delay(0.05, restoreTouchInput)
        if ok and result == false then
            return
        end
        if not ok then
            warn("[KAMUI] Backdash macro error:", result)
            pcall(tapKey, keyS)
            pcall(tapKey, keyQ)
            pcall(tapKey, macroKey)
            pcall(function()
                VirtualInputManager:SendMouseButtonEvent(halfViewportX, halfViewportY, 0, false, game, 0)
            end)
            return
        end
        --====================================================
        -- RUN MAGNET AFTER MACRO
        --====================================================
        if Settings.Magnet.Enabled then
            executeMagnet()
        end
    end)
end

