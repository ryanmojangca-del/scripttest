        applyCorner(c, 6)
        local cs = addStroke(c, LINE)
        return c, cs
    end

    local Header = Instance.new("Frame")
    Header.Parent = Panel
    Header.BackgroundTransparency = 1
    Header.Size = UDim2.new(1, -90, 0, 30)
    Header.ZIndex = 11
    local Title = Instance.new("TextLabel")
    Title.Parent = Header
    Title.BackgroundTransparency = 1
    Title.Size = UDim2.new(1, -12, 1, 0)
    Title.Position = UDim2.new(0, 12, 0, 0)
    Title.Font = Enum.Font.GothamMedium
    Title.TextSize = 11
    Title.TextColor3 = HEAD
    Title.TextXAlignment = Enum.TextXAlignment.Left
    Title.Text = "BACKDASH"
    Title.ZIndex = 12
    movable(Header, Panel, nil)

    local MoveChip, MoveStroke = chip("Move", 44, -80)
    local CloseChip = chip("x", 24, -32)
    MoveChip.MouseButton1Click:Connect(function()
        editing = not editing
        MoveChip.Text = editing and "Done" or "Move"
        MoveChip.BackgroundColor3 = editing and THEME.Red or CHIP
        MoveChip.TextColor3 = editing and WHITE or THEME.MutedText
        MoveStroke.Color = editing and THEME.Red or LINE
        for _, st in ipairs(strokes) do
            st.Color = editing and THEME.Red or LINE
        end
        panelStroke.Color = editing and THEME.Red or LINE
    end)
    CloseChip.MouseButton1Click:Connect(function()
        Settings.Magnet.Enabled = false
        if _G.KAMUI_BackdashCleanup then
            _G.KAMUI_BackdashCleanup()
            return
        end
        if pullConnection then
            pullConnection:Disconnect()
            pullConnection = nil
        end
        pcall(function() ScreenGui:Destroy() end)
        pcall(function() RestoreGui:Destroy() end)
    end)

    --// row 1: Magnet switch (same switch as the main menu)
    local MLabel = Instance.new("TextLabel")
    MLabel.Parent = Panel
    MLabel.BackgroundTransparency = 1
    MLabel.Size = UDim2.new(0, 90, 0, 34)
    MLabel.Position = UDim2.new(0, 12, 0, 31)
    MLabel.Font = Enum.Font.GothamMedium
    MLabel.TextSize = 12
    MLabel.TextColor3 = THEME.Text
    MLabel.TextXAlignment = Enum.TextXAlignment.Left
    MLabel.Text = "Magnet"
    MLabel.ZIndex = 12
    local MHit = Instance.new("TextButton")
    MHit.Parent = Panel
    MHit.BackgroundTransparency = 1
    MHit.Text = ""
    MHit.Size = UDim2.new(0, 70, 0, 34)
    MHit.Position = UDim2.new(1, -70, 0, 31)
    MHit.ZIndex = 12
    local MTrack = Instance.new("Frame")
    MTrack.Parent = MHit
    MTrack.AnchorPoint = Vector2.new(1, 0.5)
    MTrack.Position = UDim2.new(1, -12, 0.5, 0)
    MTrack.Size = UDim2.new(0, 36, 0, 20)
    MTrack.BorderSizePixel = 0
    MTrack.ZIndex = 13
    applyCorner(MTrack, 10)
    local MKnob = Instance.new("Frame")
    MKnob.Parent = MTrack
    MKnob.Size = UDim2.new(0, 14, 0, 14)
    MKnob.BorderSizePixel = 0
    MKnob.ZIndex = 14
    applyCorner(MKnob, 7)
    local function syncMagnet()
        local on = Settings.Magnet.Enabled
        MTrack.BackgroundColor3 = on and THEME.Red or OFF_TRACK
        MKnob.Position = on and UDim2.new(1, -17, 0.5, -7) or UDim2.new(0, 3, 0.5, -7)
        MKnob.BackgroundColor3 = on and WHITE or OFF_KNOB
    end
    MHit.MouseButton1Click:Connect(function()
        Settings.Magnet.Enabled = not Settings.Magnet.Enabled
        if not Settings.Magnet.Enabled and pullConnection then
            pullConnection:Disconnect()
            pullConnection = nil
        end
        syncMagnet()
    end)
    syncMagnet()

    --// row 2: delay slider + typeable red readout (like the main menu sliders)
    local SHit = Instance.new("TextButton")
    SHit.Parent = Panel
    SHit.BackgroundTransparency = 1
    SHit.Text = ""
    SHit.Size = UDim2.new(0, 106, 0, 34)
    SHit.Position = UDim2.new(0, 4, 0, 66)
    SHit.ZIndex = 12
    local Track = Instance.new("Frame")
    Track.Parent = SHit
    Track.Position = UDim2.new(0, 8, 0.5, -2)
    Track.Size = UDim2.new(1, -16, 0, 4)
    Track.BackgroundColor3 = Color3.fromRGB(38, 38, 41)
    Track.BorderSizePixel = 0
    Track.ZIndex = 13
    applyCorner(Track, 2)
    local Fill = Instance.new("Frame")
    Fill.Parent = Track
    Fill.BackgroundColor3 = THEME.Red
    Fill.BorderSizePixel = 0
    Fill.Size = UDim2.new(0, 0, 1, 0)
    Fill.ZIndex = 14
    applyCorner(Fill, 2)
    local Knob = Instance.new("Frame")
    Knob.Parent = Track
    Knob.Size = UDim2.new(0, 12, 0, 12)
    Knob.BackgroundColor3 = WHITE
    Knob.BorderSizePixel = 0
    Knob.ZIndex = 15
    applyCorner(Knob, 6)
    local ValueBox = Instance.new("TextBox")
    ValueBox.Parent = Panel
    ValueBox.BackgroundTransparency = 1
    ValueBox.Size = UDim2.new(0, 56, 0, 24)
    ValueBox.Position = UDim2.new(1, -62, 0, 71)
    ValueBox.Font = Enum.Font.RobotoMono
    ValueBox.TextSize = 12
    ValueBox.TextColor3 = THEME.BrightRed
    ValueBox.TextXAlignment = Enum.TextXAlignment.Right
    ValueBox.ClearTextOnFocus = false
    ValueBox.BorderSizePixel = 0
    ValueBox.ZIndex = 12

    local function setDelay(v)
        v = math.clamp(v, 0, 60)
        v = math.floor(v * 100 + 0.5) / 100
        Settings.Magnet.Delay = v
        DelayBox.Text = string.format("%.2f", v)
        ValueBox.Text = string.format("%.2f", v)
        local a = math.clamp(v / SLIDER_MAX, 0, 1)
        Fill.Size = UDim2.new(a, 0, 1, 0)
        Knob.Position = UDim2.new(a, -6, 0.5, -6)
    end
    local sliding = false
    local function fromInput(pos)
        local a = math.clamp((pos.X - Track.AbsolutePosition.X) / math.max(Track.AbsoluteSize.X, 1), 0, 1)
        setDelay(a * SLIDER_MAX)
    end
    SHit.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch
            or input.UserInputType == Enum.UserInputType.MouseButton1 then
            sliding = true
            fromInput(input.Position)
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    sliding = false
                end
            end)
        end
    end)
    conns[#conns + 1] = UserInputService.InputChanged:Connect(function(input)
        if sliding and (input.UserInputType == Enum.UserInputType.Touch
            or input.UserInputType == Enum.UserInputType.MouseMovement) then
            fromInput(input.Position)
        end
    end)
    ValueBox.FocusLost:Connect(function()
        local v = tonumber((ValueBox.Text:gsub("%s+", "")))
        setDelay(v or Settings.Magnet.Delay)
    end)
    setDelay(Settings.Magnet.Delay)
end
