--============================================================
-- NPC CACHE
--============================================================

local function updateNpcCache()
    npcList = {}
    for _, model in ipairs(
        Workspace:GetDescendants()
    ) do
        if model:IsA("Model")
            and model:FindFirstChild("Humanoid")
            and model:FindFirstChild("HumanoidRootPart") then
            local root = model:FindFirstChild("HumanoidRootPart")
            if root then
                table.insert(npcList, root)
            end
        end
    end
end
local npcCacheConnection = RunService.Heartbeat:Connect(
    function()
        --// scanning the whole workspace twice a second is heavy on phones and
        --// only the Magnet uses the result, so it runs only while Magnet is on
        if Settings.Magnet.Enabled and tick() - lastNpcUpdate > 0.5 then
            lastNpcUpdate = tick()
            updateNpcCache()
        end
    end
)

--============================================================
-- GET CLOSEST TARGET
--============================================================

local function getClosestTarget()
    local character = localPlayer.Character
    if not character then
        return nil
    end
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then
        return nil
    end
    local closestRoot = nil
    local shortestDistance = math.huge
    local myPos = rootPart.Position
    --========================================================
    -- PLAYERS
    --========================================================
    for _, plr in ipairs(
        Players:GetPlayers()
    ) do
        if plr ~= localPlayer
            and plr.Character then
            local root = plr.Character:FindFirstChild("HumanoidRootPart")
            if root then
                local humanoid = plr.Character:FindFirstChildOfClass("Humanoid")
                if humanoid
                    and humanoid.Health > 0 then
                    local distance = (myPos - root.Position).Magnitude
                    if distance <
                        shortestDistance
                        and distance > 0.1 then
                        shortestDistance = distance
                        closestRoot = root
                    end
                end
            end
        end
    end
    --========================================================
    -- NPCS
    --========================================================
    for _, npcRoot in ipairs(
        npcList
    ) do
        if npcRoot
            and npcRoot.Parent
            and npcRoot ~= rootPart then
            local model = npcRoot.Parent
            local humanoid = model:FindFirstChildOfClass("Humanoid")
            if humanoid
                and humanoid.Health > 0 then
                local distance = (myPos - npcRoot.Position).Magnitude
                if distance <
                    shortestDistance
                    and distance > 0.1 then
                    shortestDistance = distance
                    closestRoot = npcRoot
                end
            end
        end
    end
    return closestRoot
end

--============================================================
-- MAGNET PULL
--============================================================

local function startMagnetPull(
    targetRoot
)
    if pullConnection then
        pullConnection:Disconnect()
        pullConnection = nil
    end
    if not Settings.Magnet.Enabled then
        return
    end
    local character = localPlayer.Character
    if not character then
        return
    end
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then
        return
    end
    if not targetRoot
        or not targetRoot.Parent then
        return
    end
    local startTime = tick()
    local pullDuration = 0.5
    local pullStrength = 50
    local smoothness = 0.65
    pullConnection = RunService.Heartbeat:Connect(
            function()
                if not Settings.Magnet.Enabled then
                    pullConnection:Disconnect()
                    pullConnection = nil
                    return
                end
                if not rootPart
                    or not rootPart.Parent
                    or not targetRoot
                    or not targetRoot.Parent then
                    pullConnection:Disconnect()
                    pullConnection = nil
                    return
                end
                local elapsed = tick() - startTime
                if elapsed >=
                    pullDuration then
                    pullConnection:Disconnect()
                    pullConnection = nil
                    return
                end
                local currentPos = rootPart.Position
                local targetHorizontal = Vector3.new(targetRoot.Position.X, currentPos.Y, targetRoot.Position.Z)
                local direction = targetHorizontal - currentPos
                local distance = direction.Magnitude
                if distance > 0.1 then
                    direction = direction.Unit
                    local desiredVel = direction * pullStrength
                    local currentVel = rootPart.AssemblyLinearVelocity
                    local newVel = currentVel:Lerp(desiredVel, smoothness)
                    rootPart.AssemblyLinearVelocity = Vector3.new(newVel.X * 0.85, currentVel.Y, newVel.Z * 0.85)
                end
            end
        )
end

--============================================================
-- EXECUTE MAGNET
--============================================================

local function executeMagnet()
    if not Settings.Magnet.Enabled then
        return
    end
    --========================================================
    -- MAGNET DELAY
    --========================================================
    local delayTime = tonumber(Settings.Magnet.Delay)
    if not delayTime then
        delayTime = 0
    end
    if delayTime > 0 then
        task.wait(delayTime)
    end
    -- Magnet may have been disabled
    -- while waiting.
    if not Settings.Magnet.Enabled then
        return
    end
    --========================================================
    -- CHARACTER
    --========================================================
    local character = localPlayer.Character
    if not character then
        return
    end
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then
        return
    end
    --========================================================
    -- FIND TARGET
    --========================================================
    local targetRoot = getClosestTarget()
    if not targetRoot then
        return
    end
    --========================================================
    -- TELEPORT BEHIND TARGET
    --========================================================
    local targetPos = targetRoot.Position + targetRoot.CFrame.LookVector * 2
    rootPart.CFrame = CFrame.new(targetPos, targetRoot.Position)
    --========================================================
    -- START MAGNET
    --========================================================
    startMagnetPull(targetRoot)
end

