--// Everything we press virtually is remembered, so a macro that gets cut short
--// (death / respawn / error) can never leave a key or mouse button stuck down.
local heldKeys = {}
local mouseHeld = false
local lifeEpoch = 0 -- +1 on every respawn; a running macro stops when it changes

local function sendKeyEvent(
    keyCode
)
    heldKeys[keyCode] = true
    VirtualInputManager:SendKeyEvent(true, keyCode, false, game)
end

local function tapKey(
    keyCode
)
    heldKeys[keyCode] = nil
    VirtualInputManager:SendKeyEvent(false, keyCode, false, game)
end

--// releases only what is actually still held (sends nothing when nothing is stuck)
local function releaseHeldInput()
    for keyCode in pairs(heldKeys) do
        heldKeys[keyCode] = nil
        pcall(function()
            VirtualInputManager:SendKeyEvent(false, keyCode, false, game)
        end)
    end
    if mouseHeld then
        mouseHeld = false
        pcall(function()
            VirtualInputManager:SendMouseButtonEvent(halfViewportX, halfViewportY, 0, false, game, 0)
        end)
    end
end

--// phone only: puts the game's mobile buttons back after virtual keyboard/mouse input
local function restoreTouchInput()
    if _G.KAMUI_RestoreTouchInput then
        pcall(_G.KAMUI_RestoreTouchInput)
    end
end

local function tapKeyWithDelay(
    keyCode
)
    sendKeyEvent(keyCode)
    task.wait()
    tapKey(keyCode)
end

local BACKDASH_PAYLOAD = { Dash = keyS, Key = keyQ, Goal = "KeyPress" }
local M1_DOWN_PAYLOAD = { Goal = "LeftClick" }
local M1_UP_PAYLOAD = { Goal = "LeftClickRelease" }
local dashBusy = false

local function getCommunicate()
    local character = localPlayer.Character
    return character and character:FindFirstChild("Communicate")
end

local function simulateM1Click(
    keyCode
)
    sendKeyEvent(keyCode)
    task.wait()
    tapKey(keyCode)
    if not sAutoUnequip then
        task.wait()
        local remote = Settings.Remote.M1 and getCommunicate()
        if remote then
            remote:FireServer(M1_DOWN_PAYLOAD)
            task.wait()
            remote:FireServer(M1_UP_PAYLOAD)
        else
            mouseHeld = true
            VirtualInputManager:SendMouseButtonEvent(halfViewportX, halfViewportY, 0, true, game, 0)
            task.wait()
            mouseHeld = false
            VirtualInputManager:SendMouseButtonEvent(halfViewportX, halfViewportY, 0, false, game, 0)
        end
    end
end

--============================================================
-- BACKDASH MACRO
--============================================================

local function isAlive()
    local character = localPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    return humanoid ~= nil
        and humanoid.Health > 0
        and character:FindFirstChild("HumanoidRootPart") ~= nil
end

local function performBackDashMacro(
    keyCode
)
    if not isAlive() then
        return false
    end
    local epoch = lifeEpoch
    simulateM1Click(keyCode)
    task.wait()
    if not isAlive() or epoch ~= lifeEpoch then
        releaseHeldInput()
        return false
    end
    local remote = Settings.Remote.Dash and getCommunicate()
    if remote then
        if not dashBusy then
            remote:FireServer(BACKDASH_PAYLOAD)
            if not workspace:GetAttribute("NoDashCooldown") then
                dashBusy = true
                task.delay(5, function()
                    dashBusy = false
                end)
            end
        end
        task.wait(0.1)
    else
        sendKeyEvent(keyS)
        tapKeyWithDelay(keyQ)
        task.wait(0.1)
        tapKey(keyS)
    end
    return true
end

