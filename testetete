--============================================================
-- DELAY INPUT VALIDATION
--============================================================

local function updateDelayFromText()
    local text = DelayBox.Text
    text = text:gsub("%s+", "")
    local value = tonumber(text)
    if value == nil then
        DelayBox.Text = string.format("%.2f", Settings.Magnet.Delay)
        return
    end
    value = math.max(0, value)
    value = math.min(60, value)
    Settings.Magnet.Delay = value
    DelayBox.Text = string.format("%.2f", Settings.Magnet.Delay)
end
DelayBox.FocusLost:Connect(
    function(enterPressed)
        updateDelayFromText()
        if BDUI.refreshDelay then
            BDUI.refreshDelay()
        end
    end
)

--============================================================
-- KEYBOARD INPUT
--============================================================
conns[#conns + 1] = UserInputService.InputBegan:Connect(
    function(
        input,
        gameProcessed
    )
        if input.UserInputType
            ~= Enum.UserInputType.Keyboard then
            return
        end
        if DelayBox:IsFocused() then
            return
        end
        --====================================================
        -- KEYBIND ASSIGNMENT
        --====================================================
        if WaitingForKey then
            local index = WaitingForKey
            if input.KeyCode
                == Enum.KeyCode.Escape then
                Keybinds[index] = nil
                KeyButtons[index].Text = "Bind key"
            else
                Keybinds[index] = input.KeyCode
                KeyButtons[index].Text = input.KeyCode.Name
            end
            WaitingForKey = nil
            return
        end
        --====================================================
        -- EXECUTE CUSTOM KEYBINDS
        --====================================================
        for index = 1, 4 do
            if Keybinds[index]
                and Keybinds[index]
                == input.KeyCode then
                executeMacro(index)
                return
            end
        end
        --====================================================
        -- GAME PROCESSED
        --====================================================
        if gameProcessed then
            return
        end
    end
)

