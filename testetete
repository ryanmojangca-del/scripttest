    local rotateCharacter = useCharacter or useCamera
    local rotateCamera = not useCharacter or useCamera
    local position = cameraPosition
    if UserInputService.MouseBehavior == Enum.MouseBehavior.LockCenter then
        position = position - cameraCFrame.RightVector * 1.75
    end
    local pitch = math.asin(cameraCFrame.LookVector.Y)
    local baseYaw
    local targetYaw
    if targetPosition then
        local direction
        if rotateCharacter then
            direction = (targetPosition - currentRootPart.Position).Unit
            baseYaw = math.atan2(-currentRootPart.CFrame.LookVector.X, -currentRootPart.CFrame.LookVector.Z)
        else
            direction = (targetPosition - position).Unit
            baseYaw = math.atan2(-cameraCFrame.LookVector.X, -cameraCFrame.LookVector.Z)
        end
        targetYaw = math.atan2(-direction.X, -direction.Z)
    else
        local lookVector = rotateCharacter and currentRootPart.CFrame.LookVector or cameraCFrame.LookVector
        baseYaw = math.atan2(-lookVector.X, -lookVector.Z)
        targetYaw = baseYaw + math.rad(angle)
    end
    local delta = math.atan2(math.sin(targetYaw - baseYaw), math.cos(targetYaw - baseYaw))
    local finalYaw = baseYaw + delta * smoothing
    if rotateCharacter then
        currentHumanoid.AutoRotate = false
        currentRootPart.CFrame = CFrame.new(currentRootPart.Position) * CFrame.Angles(0, finalYaw, 0)
        if not rotateCamera then
