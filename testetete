--// EFFECT CLASSES
local EFF_CLS = {
    "ParticleEmitter",
    "Fire",
    "Smoke",
    "Sparkles",
    "Beam",
    "Trail",
    "Decal",
    "Texture",
    "SelectionBox",
    "SelectionSphere",
    "BillboardGui"
}
local LFXCLS = { "BloomEffect", "BlurEffect", "ColorCorrectionEffect", "DepthOfFieldEffect", "SunRaysEffect" }

--// FPS BOOST HELPERS
local function fpsDisableProp(obj, prop, val)
    if not obj then
        return
    end
    local oldValue
    local success = pcall(function()
        oldValue = obj[prop]
    end)
    if not success then
        return
    end
    table.insert(fpsRestored, { obj = obj, prop = prop, old = oldValue })
    pcall(function()
        obj[prop] = val
    end)
end

local function fpsRestoreWhere(fn)
    for i = #fpsRestored, 1, -1 do
        local r = fpsRestored[i]
        local shouldRestore = false
        pcall(function()
            shouldRestore = fn(r.obj)
        end)
        if shouldRestore then
            pcall(function()
                r.obj[r.prop] = r.old
            end)
            table.remove(fpsRestored, i)
        end
    end
end

--// FPS QUALITY / LIGHTING
local function applyFPS(on)
    if on then
        pcall(function()
            settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
        end)
        Lighting.GlobalShadows = false
        Lighting.Brightness = 0.7
        Lighting.Ambient = Color3.fromRGB(70, 70, 70)
        Lighting.EnvironmentDiffuseScale = 0
        Lighting.EnvironmentSpecularScale = 0
        for _, v in ipairs(
            Lighting:GetDescendants()
        ) do
            for _, cls in ipairs(
                LFXCLS
            ) do
                if v:IsA(cls)
                    and v.Enabled then
                    fpsDisableProp(v, "Enabled", false)
                    break
                end
            end
        end
    else
        pcall(function()
            settings().Rendering.QualityLevel = Enum.QualityLevel.Automatic
        end)
        Lighting.GlobalShadows = OriginalLighting.GlobalShadows
        Lighting.Brightness = OriginalLighting.Brightness
        Lighting.Ambient = OriginalLighting.Ambient
        Lighting.EnvironmentDiffuseScale = OriginalLighting.EnvDiff
        Lighting.EnvironmentSpecularScale = OriginalLighting.EnvSpec
        fpsRestoreWhere(function(o)
            for _, cls in ipairs(
                LFXCLS
            ) do
                if o:IsA(cls) then
                    return true
                end
            end
            return false
        end)
    end
end

--// ANTI LAG
local function disableEffObj(v)
    for _, cls in ipairs(
        EFF_CLS
    ) do
        if v:IsA(cls) then
            local prop = (v:IsA("Decal") or v:IsA("Texture")) and "Transparency" or "Enabled"
            local bad = prop == "Transparency" and 1 or false
            pcall(function()
                if v[prop] ~= bad then
                    fpsDisableProp(v, prop, bad)
                end
            end)
            break
        end
    end
end

local function scanAll()
    for _, v in ipairs(
        Workspace:GetDescendants()
    ) do
        disableEffObj(v)
    end
end

local function applyLag(on)
    if on then
        scanAll()
        if not fpsDescConn then
            fpsDescConn = Workspace.DescendantAdded:Connect(
                    function(v)
                        task.defer(function()
                            if potatoEnabled then
                                disableEffObj(v)
                            end
                        end)
                    end
                )
        end
    else
        if fpsDescConn then
            fpsDescConn:Disconnect()
            fpsDescConn = nil
        end
        fpsRestoreWhere(function(o)
            for _, cls in ipairs(
                EFF_CLS
            ) do
                if o:IsA(cls) then
                    return true
                end
            end
            return false
        end)
    end
end

--// FULL FOG OFF
local function applyFog(on)
    if on then
        Lighting.FogEnd = 1e10
        Lighting.FogStart = 9e9
        Lighting.FogColor = Color3.fromRGB(0, 0, 0)
        for _, v in ipairs(
            Lighting:GetChildren()
        ) do
            if v:IsA("Atmosphere") then
                for _, prop in ipairs({
                    "Density",
                    "Haze",
                    "Glare",
                    "Offset"
                }) do
                    fpsDisableProp(v, prop, 0)
                end
            elseif v:IsA("Sky") then
                fpsDisableProp(v, "MoonTextureId", "")
                fpsDisableProp(v, "SunTextureId", "")
                fpsDisableProp(v, "StarCount", 0)
            end
        end
    else
        Lighting.FogEnd = OriginalLighting.FogEnd
        Lighting.FogStart = OriginalLighting.FogStart
        Lighting.FogColor = OriginalLighting.FogColor
        fpsRestoreWhere(function(o)
            return o:IsA("Atmosphere") or o:IsA("Sky")
        end)
    end
end

--// NO TEXTURES
local function applyTex(on)
    if on then
        for _, v in ipairs(
            Workspace:GetDescendants()
        ) do
            if v:IsA("BasePart")
                and v.Material ~=
                    Enum.Material.SmoothPlastic then
                table.insert(fpsTexCache, { obj = v, old = v.Material })
                pcall(function()
                    v.Material = Enum.Material.SmoothPlastic
                end)
            end
        end
    else
        for _, r in ipairs(
            fpsTexCache
        ) do
            pcall(function()
                if r.obj
                    and r.obj.Parent then
                    r.obj.Material = r.old
                end
            end)
        end
        table.clear(fpsTexCache)
    end
end

--// ANTI FREEZE
--// CAMERA IS NOT MODIFIED.
local function applyAntiFreeze(on)
    if on then
        pcall(function()
            Workspace.StreamingMinRadius = 64
            Workspace.StreamingTargetRadius = 128
        end)
        local budget = 0
        fpsFreezeConn = RunService.Heartbeat:Connect(
                function(dt)
                    budget = budget + dt
                    if budget > 0.05 then
                        budget = 0
                        pcall(function()
                            collectgarbage("step", 64)
                        end)
                    end
                end
            )
    else
        pcall(function()
            Workspace.StreamingMinRadius = 64
            Workspace.StreamingTargetRadius = 512
        end)
        if fpsFreezeConn then
            fpsFreezeConn:Disconnect()
            fpsFreezeConn = nil
        end
    end
end

--// FPS BOOST MODE
local function applyBoost(on)
    potatoEnabled = on
    if on then
        --// FPS BOOST
        applyFPS(true)
        --// ANTI LAG
        applyLag(true)
        --// FOG OFF
        applyFog(true)
        --// NO TEXTURES
        applyTex(true)
        --// ANTI FREEZE
        applyAntiFreeze(true)
        --// LIGHTING
        Lighting.ClockTime = 14
        Lighting.GeographicLatitude = 0
        Lighting.Brightness = 0.5
        --// REMOVE / DISABLE VISUAL EFFECTS
        for _, v in ipairs(
            Lighting:GetChildren()
        ) do
            if v:IsA("PostEffect") then
                if v.Enabled then
                    fpsDisableProp(v, "Enabled", false)
                end
            elseif v:IsA("Sky")
                or v:IsA("Atmosphere") then
                local oldParent = v.Parent
                pcall(function()
                    v.Parent = nil
                end)
                table.insert(fpsRestored, { obj = v, prop = "Parent", old = oldParent })
            end
        end
        --// CAMERA
        --// NOTHING IS CHANGED.
        --// TERRAIN
        pcall(function()
            Workspace.Terrain.WaterWaveSize = 0
            Workspace.Terrain.WaterWaveSpeed = 0
            Workspace.Terrain.WaterReflectance = 0
            Workspace.Terrain.Decoration = false
        end)
        --// SWITCH ON
        animSW(PSW, PKN, true)
        TweenService:Create(MainStroke, TweenInfo.new(0.18), { Color = Color3.fromRGB(235, 24, 22) }):Play()
        TweenService:Create(boostStroke, TweenInfo.new(0.18), { Color = Color3.fromRGB(235, 24, 22) }):Play()
        BoostPanel.BackgroundColor3 = Color3.fromRGB(10, 24, 17)
    else
        --// TURN EVERYTHING OFF
        applyFPS(false)
        applyLag(false)
        applyFog(false)
        applyTex(false)
        applyAntiFreeze(false)
        --// RESTORE LIGHTING
        Lighting.ClockTime = OriginalLighting.ClockTime
        Lighting.GeographicLatitude = OriginalLighting.GeoLat
        --// RESTORE EFFECTS
        fpsRestoreWhere(function(o)
            return o:IsA("PostEffect") or o:IsA("Sky") or o:IsA("Atmosphere")
        end)
        --// CAMERA
        --// NOTHING IS CHANGED.
        --// RESTORE TERRAIN
        pcall(function()
            Workspace.Terrain.WaterWaveSize = 0.15
            Workspace.Terrain.WaterWaveSpeed = 0.5
            Workspace.Terrain.WaterReflectance = 0.5
            Workspace.Terrain.Decoration = true
        end)
        --// SWITCH OFF
        animSW(PSW, PKN, false)
        TweenService:Create(MainStroke, TweenInfo.new(0.18), { Color = THEME.Red }):Play()
        TweenService:Create(boostStroke, TweenInfo.new(0.18), { Color = THEME.Red }):Play()
        BoostPanel.BackgroundColor3 = THEME.BackgroundMedium
    end
end

