UIS.InputBegan:Connect(function(input, gpe)
    if not isCurrent() then
        return
    end
    if input.UserInputType == Enum.UserInputType.Keyboard
        and input.KeyCode ~= Enum.KeyCode.Unknown then
        -- Keybind capture for Hide GUI.
        if capturingHideGUIKey then
            Config.HideGUIKeybind = input.KeyCode.Name
            HideGUIKeyBtn.Text = Config.HideGUIKeybind
            capturingHideGUIKey = false
            return
        end
        -- Hide/show the entire GUI without stopping the script.
        -- Keybind mode uses the same clean expanding/collapsing effect,
        -- but does NOT create or use the draggable restore button.
        if input.KeyCode == Enum.KeyCode[Config.HideGUIKeybind] then
            if keybindTransitioning then
                return
            end
            keybindTransitioning = true
            hideRestoreButton()
            if ScreenGui.Enabled then
                -- Kamui: twist the GUI into a vortex at its own center, then hide it.
                local centerX = MainFrame.AbsolutePosition.X + (MainFrame.AbsoluteSize.X * 0.5)
                local centerY = MainFrame.AbsolutePosition.Y + (MainFrame.AbsoluteSize.Y * 0.5)
                _G.KAMUI_HideFX.hide(centerX, centerY)
                ScreenGui.Enabled = false
            else
                -- Bring the GUI back by expanding it from its center.
                local targetPosition = MainFrame.Position
                local targetSize = MainFrame.Size
                local targetCenterX = MainFrame.AbsolutePosition.X + (MainFrame.AbsoluteSize.X * 0.5)
                local targetCenterY = MainFrame.AbsolutePosition.Y + (MainFrame.AbsoluteSize.Y * 0.5)
                ScreenGui.Enabled = true
                MainFrame.Visible = true
                -- Start from the center of where the GUI normally sits.
                local ws = MainFrame:FindFirstChild("WindowScale")
                local sc = (ws and ws.Scale > 0) and ws.Scale or 1
                local startSize = UDim2.fromOffset(8 / sc, 8 / sc)
                local startPosition = UDim2.fromOffset(targetCenterX - 4, targetCenterY - 4)
                MainFrame.Position = startPosition
                MainFrame.Size = startSize
                MainFrame.ClipsDescendants = true
                local expandTween = TweenService:Create(
                    MainFrame,
                    TweenInfo.new(0.38, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
                    { Position = targetPosition, Size = targetSize }
                )
                expandTween:Play()
                expandTween.Completed:Wait()
                MainFrame.Position = targetPosition
                MainFrame.Size = targetSize
            end
            keybindTransitioning = false
        end
    end
    if gpe then
        return
    end
    if Config.TouchMode
        and Config.Platform == "PC" then
        if input.KeyCode ==
            Enum.KeyCode[
                Config.Keybind:upper()
            ] then
            executeLethal()
        end
    end
end)

