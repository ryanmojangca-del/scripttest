end

local function tapKeyWithDelay(
    keyCode
)
    sendKeyEvent(keyCode)
    task.wait()
    tapKey(keyCode)
end

local BACKDASH_PAYLOAD = { Dash = keyS, Key = keyQ, Goal = "KeyPress" }
local M1_DOWN_PAYLOAD = { Goal = "LeftClick" }
local M1_UP_PAYLOAD = { Goal = "LeftClickRelease" }
local dashBusy = false

local function getCommunicate()
    local character = localPlayer.Character
    return character and character:FindFirstChild("Communicate")
end

local function simulateM1Click(
    keyCode
)
    sendKeyEvent(keyCode)
    task.wait()
    tapKey(keyCode)
    if not sAutoUnequip then
        task.wait()
        local remote = Settings.Remote.M1 and getCommunicate()
        if remote then
            remote:FireServer(M1_DOWN_PAYLOAD)
            task.wait()
            remote:FireServer(M1_UP_PAYLOAD)
        else
            mouseHeld = true
            VirtualInputManager:SendMouseButtonEvent(halfViewportX, halfViewportY, 0, true, game, 0)
            task.wait()
            mouseHeld = false
            VirtualInputManager:SendMouseButtonEvent(halfViewportX, halfViewportY, 0, false, game, 0)
        end
    end
end

