--// FLOATER MODE
local FloaterMode = false

local function startFloaterMode(targetTorso)
    if Config.LethalMode ~= "V2" or not FloaterMode then
        return
    end
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root or not targetTorso or not targetTorso.Parent then
        return
    end
    -- Teleport 2 studs above the target before starting the magnet pull.
    -- Keep the player's current facing direction while changing only position.
    pcall(function()
        root.CFrame = CFrame.new(
            targetTorso.Position + Vector3.new(0, 2, 0),
            targetTorso.Position + Vector3.new(0, 2, 0) + root.CFrame.LookVector
        )
    end)
    local startTime = tick()
    local floaterConn
    floaterConn = RunService.Heartbeat:Connect(function()
        if not isCurrent()
            or Config.LethalMode ~= "V2"
            or not FloaterMode
            or not root.Parent
            or not targetTorso.Parent
            or tick() - startTime >= 0.5 then
            if floaterConn then
                floaterConn:Disconnect()
            end
            return
        end
        local offset = targetTorso.Position - root.Position
        local horizontal = Vector3.new(offset.X, 0, offset.Z)
        if horizontal.Magnitude > 0.05 then
            local direction = horizontal.Unit
            local yVelocity = root.AssemblyLinearVelocity.Y
            root.AssemblyLinearVelocity = Vector3.new(direction.X * 65, yVelocity, direction.Z * 65)
        end
    end)
end

--// FORCE CANCEL
local function forceCancel()
    clip()
    local char = player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if hrp then
        for _, obj in pairs(hrp:GetChildren()) do
            if obj:IsA("BodyVelocity")
                or obj:IsA("LinearVelocity")
                or obj:IsA("Attachment")
                or obj:IsA("BodyAngularVelocity") then
                obj:Destroy()
            end
        end
        hrp.AssemblyLinearVelocity = Vector3.zero
    end
end

--// COOLDOWN
local function startCooldown(duration)
    if not isCurrent() or isCooldown then
        return
    end
    isCooldown = true
    if MainFrame and CooldownBar and CooldownFill then
        CooldownBar.Visible = true
        CooldownFill.Size = UDim2.new(1, 0, 1, 0)
        local tween = TweenService:Create(
            CooldownFill,
            TweenInfo.new(duration, Enum.EasingStyle.Linear),
            { Size = UDim2.new(0, 0, 1, 0) }
