--// KAMUI HIDE EFFECT
--// Replaces the old collapse animation. The GUI twists and gets pulled into a
--// spiral vortex, then vanishes into the center point (like Kamui absorbing it).
--// Stored on _G so it doesn't add another top-level local to this huge script.
_G.KAMUI_HideFX = {Time = 0.5, Tail = 0.25, Busy = false}

function _G.KAMUI_HideFX.hide(vx, vy)
    local FX = _G.KAMUI_HideFX
    if FX.Busy or not MainFrame then
        return
    end
    FX.Busy = true
    local targetPos = MainFrame.Position
    local targetSize = MainFrame.Size
    local total = FX.Time + FX.Tail
    -- Vortex lives in the restore ScreenGui so it keeps playing after
    -- ScreenGui.Enabled is set to false.
    local root = Instance.new("Frame")
    root.Name = "KamuiVortex"
    root.AnchorPoint = Vector2.new(0.5, 0.5)
    root.Position = UDim2.fromOffset(vx, vy)
    root.Size = UDim2.fromOffset(0, 0)
    root.BackgroundTransparency = 1
    root.BorderSizePixel = 0
    root.ZIndex = 300
    root.Parent = RestoreGui
    -- dark center that the GUI gets sucked into
    local hole = Instance.new("Frame")
    hole.Name = "Core"
    hole.AnchorPoint = Vector2.new(0.5, 0.5)
    hole.Position = UDim2.fromOffset(0, 0)
    hole.Size = UDim2.fromOffset(0, 0)
    hole.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    hole.BorderSizePixel = 0
    hole.ZIndex = 300
    hole.Parent = root
    local holeCorner = Instance.new("UICorner")
    holeCorner.CornerRadius = UDim.new(1, 0)
    holeCorner.Parent = hole
    local holeStroke = Instance.new("UIStroke")
    holeStroke.Color = THEME.BrightRed
    holeStroke.Thickness = 2
    holeStroke.Parent = hole
    -- spiral arms made of dots
    local arms, perArm = 4, 16
    local maxRadius = math.max(MainFrame.AbsoluteSize.X, MainFrame.AbsoluteSize.Y) * 0.6
    local dots = {}
    for a = 1, arms do
        for i = 1, perArm do
            local t = i / perArm
            local dot = Instance.new("Frame")
            dot.AnchorPoint = Vector2.new(0.5, 0.5)
            dot.BorderSizePixel = 0
            dot.BackgroundColor3 = (a % 2 == 0) and THEME.BrightRed or Color3.fromRGB(235, 235, 235)
            dot.ZIndex = 301
            dot.Size = UDim2.fromOffset(0, 0)
            dot.Parent = root
            local c = Instance.new("UICorner")
            c.CornerRadius = UDim.new(1, 0)
            c.Parent = dot
            dots[#dots + 1] = { Obj = dot, T = t, Base = ((a - 1) * (2 * math.pi / arms)) + (t * math.pi * 1.6) }
        end
    end
    local startTime = os.clock()
    local conn
    conn = RunService.RenderStepped:Connect(function()
        local p = math.clamp((os.clock() - startTime) / total, 0, 1)
        local fadeIn = math.clamp(p / 0.2, 0, 1)
        local fadeOut = math.clamp((p - 0.8) / 0.2, 0, 1)
        local pull = p * p
        local spin = p * p * math.pi * 5
        local twist = 1 + p * 2.5
        for _, d in ipairs(dots) do
            local radius = maxRadius * d.T * (1 - pull)
            local ang = d.Base * twist + spin
            local size = (3 + 7 * d.T) * (1 - p * 0.6) * fadeIn
            d.Obj.Position = UDim2.fromOffset(math.cos(ang) * radius, math.sin(ang) * radius)
            d.Obj.Size = UDim2.fromOffset(size, size)
            d.Obj.BackgroundTransparency = math.clamp((1 - fadeIn) + fadeOut, 0, 1)
        end
        local holeSize = (10 + 34 * math.sin(math.clamp(p * 1.4, 0, 1) * math.pi)) * (1 - fadeOut)
        hole.Size = UDim2.fromOffset(holeSize, holeSize)
        hole.BackgroundTransparency = fadeOut
        holeStroke.Transparency = fadeOut
        if p >= 1 then
            conn:Disconnect()
            root:Destroy()
        end
    end)
    -- GUI gets twisted and sucked into the vortex point
    MainFrame.ClipsDescendants = true
    local tween = TweenService:Create(
        MainFrame,
        TweenInfo.new(FX.Time, Enum.EasingStyle.Exponential, Enum.EasingDirection.In),
        { Position = UDim2.fromOffset(vx - 3, vy - 3), Size = UDim2.fromOffset(6, 6), Rotation = 540 }
    )
    tween:Play()
    tween.Completed:Wait()
    ScreenGui.Enabled = false
    -- reset so the normal restore animations still work
    MainFrame.Rotation = 0
    MainFrame.Position = targetPos
    MainFrame.Size = targetSize
    FX.Busy = false
end
