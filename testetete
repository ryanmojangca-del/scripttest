--// DIRECTIONAL PUSH TAB TRANSITION
--// Moving down the sidebar pushes the old page up and the new page in from
--// below; moving up reverses it. Both pages travel together as one piece.
--// State lives in a table (no extra top-level locals).
ContainerHolder.ClipsDescendants = true
_G.KAMUI_TabPush = {
    pages = {
        ["Home"] = HomeContainer,
        ["Settings"] = SettingsContainer,
        ["Profiles"] = ProfilesContainer,
        ["Skills Color"] = SkillsColorContainer,
        ["Others"] = FPSBoosterContainer
    },
    index = {
        ["Home"] = 1,
        ["Settings"] = 2,
        ["Profiles"] = 3,
        ["Skills Color"] = 4,
        ["Others"] = 5
    },
    tweens = {},
    id = 0
}
_G.KAMUI_TabPush.settle = function(show)
    local tp = _G.KAMUI_TabPush
    for _, t in ipairs(tp.tweens) do
        t:Cancel()
    end
    table.clear(tp.tweens)
    for name, page in pairs(tp.pages) do
        page.Position = UDim2.new(0, 0, 0, 0)
        page.Visible = (name == show)
    end
end

local function setTab(tab)
    if not isCurrent() then
        return
    end
    if currentTab == tab then
        return
    end
    local tp = _G.KAMUI_TabPush
    local prevTab = currentTab
    local newPage = tp.pages[tab]
    local oldPage = prevTab and tp.pages[prevTab] or nil
    currentTab = tab
    updateTabVisuals(tab)
    tp.id += 1
    local myId = tp.id
    -- stop any push still running and snap the pages to rest
    tp.settle(prevTab)
    if not oldPage or not newPage then
        tp.settle(tab)
        return
    end
    local dir = (tp.index[tab] > tp.index[prevTab]) and 1 or -1
    local dist = ContainerHolder.AbsoluteSize.Y
    if dist <= 0 then
        dist = 268
    end
    newPage.Position = UDim2.new(0, 0, 0, dir * dist)
    newPage.Visible = true
    oldPage.Visible = true
    local info = TweenInfo.new(0.42, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
    local outTween = TweenService:Create(oldPage, info, {Position = UDim2.new(0, 0, 0, -dir * dist)})
    local inTween = TweenService:Create(newPage, info, {Position = UDim2.new(0, 0, 0, 0)})
    tp.tweens = {outTween, inTween}
    inTween.Completed:Connect(function(state)
        if myId ~= tp.id or state ~= Enum.PlaybackState.Completed then
            return
        end
        tp.settle(tab)
    end)
    outTween:Play()
    inTween:Play()
end
