--// SKILLS COLOR APPLICATION
local function ApplySkillColorToInstance(instance)
    if not SkillsColorEnabled then
        return
    end
    if not instance or not instance.Parent then
        return
    end
    if instance:IsA("ParticleEmitter") then
        instance.Color = ColorSequence.new(AppliedSkillColor)
    elseif instance:IsA("Trail") then
        instance.Color = ColorSequence.new(AppliedSkillColor)
    elseif instance:IsA("Beam") then
        instance.Color = ColorSequence.new(AppliedSkillColor)
    elseif instance:IsA("PointLight")
        or instance:IsA("SpotLight")
        or instance:IsA("SurfaceLight") then
        instance.Color = AppliedSkillColor
    elseif instance:IsA("Highlight") then
        instance.FillColor = AppliedSkillColor
        instance.OutlineColor = AppliedSkillColor
    elseif instance:IsA("BasePart") then
        if instance.Material ==
            Enum.Material.Neon then
            instance.Color = AppliedSkillColor
        end
    end
end

local function ApplySkillColorToWorkspace()
    if not SkillsColorEnabled then
        return
    end
    for _, instance in ipairs(
        Workspace:GetDescendants()
    ) do
        ApplySkillColorToInstance(instance)
    end
end

