--// ============================================================
--// KAMUI CONTENT REDESIGN
--// Window, title bar and sidebar are untouched. This only rebuilds
--// what is INSIDE each tab: grouped cards, switch rows, segmented
--// selectors, a clean Skills layout and a tidy Others list.
--// Everything lives in _G functions so no top-level locals are added.
--// Each tab is built in its own pcall, so one failing tab can never
--// break the others.
--// ============================================================
_G.KAMUI_UIKit = function()
    local UI = {}
    local PANEL = Color3.fromRGB(13, 13, 14)
    local CHIP = Color3.fromRGB(20, 20, 22)
    local LINE = Color3.fromRGB(36, 36, 38)
    local DIV = Color3.fromRGB(26, 26, 28)
    local HEAD = Color3.fromRGB(105, 105, 108)
    local OFF_TRACK = Color3.fromRGB(42, 42, 45)
    local OFF_KNOB = Color3.fromRGB(189, 184, 184)
    local WHITE = Color3.fromRGB(255, 255, 255)
    UI.PANEL, UI.CHIP, UI.LINE, UI.DIV, UI.HEAD = PANEL, CHIP, LINE, DIV, HEAD
    UI.ROW, UI.ROW_SUB = 38, 44

    local orders = setmetatable({}, { __mode = "k" })

    function UI.make(class, props, parent)
        local o = Instance.new(class)
        for k, v in pairs(props) do
            o[k] = v
        end
        o.Parent = parent
        return o
    end

    function UI.corner(o, r)
        local c = o:FindFirstChildOfClass("UICorner")
        if not c then
            c = Instance.new("UICorner")
            c.Parent = o
        end
        c.CornerRadius = UDim.new(0, r)
        return c
    end

    function UI.stroke(o, color)
        local s = o:FindFirstChildOfClass("UIStroke")
        if not s then
            s = Instance.new("UIStroke")
            s.Parent = o
        end
        s.Color = color
        s.Thickness = 1
        s.Transparency = 0
        s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
        s.Enabled = true
        return s
    end

    function UI.nextOrder(o)
        orders[o] = (orders[o] or 0) + 1
        return orders[o]
    end

    --// page = one tab's ScrollingFrame
    function UI.setupPage(page)
        page.CanvasSize = UDim2.new(0, 0, 0, 0)
        page.AutomaticCanvasSize = Enum.AutomaticSize.Y
        page.ScrollingDirection = Enum.ScrollingDirection.Y
        page.ScrollBarThickness = 2
        page.ScrollBarImageColor3 = THEME.Red
        local layout = page:FindFirstChildOfClass("UIListLayout")
        if not layout then
            layout = Instance.new("UIListLayout")
            layout.Parent = page
        end
        layout.FillDirection = Enum.FillDirection.Vertical
        layout.SortOrder = Enum.SortOrder.LayoutOrder
        layout.HorizontalAlignment = Enum.HorizontalAlignment.Left
        layout.Padding = UDim.new(0, 0)
        local pad = page:FindFirstChildOfClass("UIPadding")
        if not pad then
            pad = Instance.new("UIPadding")
            pad.Parent = page
        end
        pad.PaddingTop = UDim.new(0, 2)
        pad.PaddingRight = UDim.new(0, 6)
        pad.PaddingBottom = UDim.new(0, 10)
        return layout
    end

    function UI.heading(page, text)
        local n = UI.nextOrder(page)
        local h = UI.make("TextLabel", {
            Name = "SectionHeading",
            BackgroundTransparency = 1,
            Size = UDim2.new(1, 0, 0, n == 1 and 22 or 30),
            Font = Enum.Font.GothamMedium,
            TextSize = 11,
            TextColor3 = HEAD,
            Text = string.upper(text),
            TextXAlignment = Enum.TextXAlignment.Left,
            TextYAlignment = Enum.TextYAlignment.Bottom,
            LayoutOrder = n
        }, page)
        UI.make("UIPadding", {
            PaddingLeft = UDim.new(0, 4),
            PaddingBottom = UDim.new(0, 6)
        }, h)
        return h
    end

    --// a card that hides itself (and its heading) when every row inside is hidden,
    --// and draws a divider under every visible row except the last one
    function UI.card(page, headingText)
        local h = headingText and UI.heading(page, headingText) or nil
        local card = UI.make("Frame", {
            Name = "Card",
            BackgroundColor3 = PANEL,
            BorderSizePixel = 0,
            Size = UDim2.new(1, 0, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y,
            LayoutOrder = UI.nextOrder(page)
        }, page)
        UI.corner(card, 10)
        UI.stroke(card, LINE)
        UI.make("UIListLayout", {
            SortOrder = Enum.SortOrder.LayoutOrder,
            Padding = UDim.new(0, 0)
        }, card)
        local function refresh()
            local vis = {}
            for _, c in ipairs(card:GetChildren()) do
                if c:IsA("GuiObject") then
                    local d = c:FindFirstChild("Divider")
                    if d then
                        d.Visible = false
                    end
                    if c.Visible then
                        table.insert(vis, c)
                    end
                end
            end
            table.sort(vis, function(a, b)
                return a.LayoutOrder < b.LayoutOrder
            end)
            for i, c in ipairs(vis) do
                local d = c:FindFirstChild("Divider")
                if d then
                    d.Visible = i < #vis
                end
            end
            card.Visible = #vis > 0
            if h then
                h.Visible = #vis > 0
            end
        end
        card.ChildAdded:Connect(function(c)
            if c:IsA("GuiObject") then
                c:GetPropertyChangedSignal("Visible"):Connect(refresh)
                task.defer(refresh)
            end
        end)
        card.ChildRemoved:Connect(function()
            task.defer(refresh)
        end)
        return card
    end

    --// strip the old button look so the row sits flat inside a card
    function UI.flatten(row)
        row.BackgroundTransparency = 1
        local c = row:FindFirstChildOfClass("UICorner")
        if c then
            c.CornerRadius = UDim.new(0, 0)
        end
        local s = row:FindFirstChildOfClass("UIStroke")
        if s then
            s.Enabled = false
        end
    end

    function UI.addRow(card, row, height)
        row.Parent = card
        row.LayoutOrder = UI.nextOrder(card)
        row.Size = UDim2.new(1, 0, 0, height or UI.ROW)
        row.BackgroundTransparency = 1
        if not row:FindFirstChild("Divider") then
            UI.make("Frame", {
                Name = "Divider",
                BackgroundColor3 = DIV,
                BorderSizePixel = 0,
                Size = UDim2.new(1, -24, 0, 1),
                Position = UDim2.new(0, 12, 1, -1)
            }, row)
        end
        return row
    end

    --// small muted line under a row title
    function UI.subtitle(row, text, rightPad)
        local label = row:FindFirstChild("RowLabel")
        if label then
            label.Position = UDim2.new(0, 12, 0, 5)
            label.Size = UDim2.new(1, -(rightPad or 100), 0, 20)
        end
        return UI.make("TextLabel", {
            Name = "RowSub",
            BackgroundTransparency = 1,
            Position = UDim2.new(0, 12, 0, 24),
            Size = UDim2.new(1, -(rightPad or 100), 0, 14),
            Font = Enum.Font.Gotham,
            TextSize = 11,
            TextColor3 = THEME.MutedText,
            TextXAlignment = Enum.TextXAlignment.Left,
            Text = text
        }, row)
    end

    --// "Label: V1" button  ->  segmented selector (the whole row still clicks)
    function UI.segmented(btn, options)
        btn:SetAttribute("KamuiSegmented", true)
        local value = btn:FindFirstChild("RowValue")
        local widths, total = {}, 4
        for i, o in ipairs(options) do
            widths[i] = (#o > 3) and 58 or 44
            total = total + widths[i]
        end
        local holder = UI.make("Frame", {
            Name = "Segmented",
            BackgroundColor3 = CHIP,
            BorderSizePixel = 0,
            Size = UDim2.new(0, total, 0, 26),
            Position = UDim2.new(1, -(total + 12), 0.5, -13)
        }, btn)
        UI.corner(holder, 7)
        local segs, x = {}, 2
        for i, o in ipairs(options) do
            local s = UI.make("TextLabel", {
                BackgroundColor3 = THEME.Red,
                BackgroundTransparency = 1,
                BorderSizePixel = 0,
                Size = UDim2.new(0, widths[i], 0, 22),
                Position = UDim2.new(0, x, 0, 2),
                Font = Enum.Font.GothamMedium,
                TextSize = 11,
                Text = o,
                TextColor3 = THEME.MutedText
            }, holder)
            UI.corner(s, 5)
            segs[i] = s
            x = x + widths[i]
        end
        local function sync()
            local val = tostring(btn.Text):match(":%s*(.-)%s*$") or ""
            if value then
                value.Visible = false
            end
            for i, o in ipairs(options) do
                local on = val:lower() == o:lower()
                segs[i].BackgroundTransparency = on and 0 or 1
                segs[i].TextColor3 = on and WHITE or THEME.MutedText
            end
        end
        btn:GetPropertyChangedSignal("Text"):Connect(sync)
        sync()
    end

    --// old 56x28 switch button -> invisible hit area + new 36x20 switch visual.
    --// The original click handler and its colour tween keep running untouched;
    --// the new switch just mirrors the colour the old one is tweening to.
    function UI.switch(sw)
        sw.Size = UDim2.new(0, 72, 1, 0)
        sw.Position = UDim2.new(1, -72, 0, 0)
        sw.BackgroundTransparency = 1
        local oldKnob = sw:FindFirstChild("Knob")
        if oldKnob then
            oldKnob.Visible = false
        end
        local track = UI.make("Frame", {
            Name = "NewTrack",
            BorderSizePixel = 0,
            AnchorPoint = Vector2.new(1, 0.5),
            Position = UDim2.new(1, -12, 0.5, 0),
            Size = UDim2.new(0, 36, 0, 20),
            BackgroundColor3 = OFF_TRACK
        }, sw)
        UI.corner(track, 10)
        local knob = UI.make("Frame", {
            Name = "NewKnob",
            BorderSizePixel = 0,
            Size = UDim2.new(0, 14, 0, 14),
            Position = UDim2.new(0, 3, 0.5, -7),
            BackgroundColor3 = OFF_KNOB
        }, track)
        UI.corner(knob, 7)
        local function sync()
            local on = sw.BackgroundColor3.R > 0.5
            track.BackgroundColor3 = on and THEME.Red or OFF_TRACK
            knob.Position = on and UDim2.new(1, -17, 0.5, -7) or UDim2.new(0, 3, 0.5, -7)
            knob.BackgroundColor3 = on and WHITE or OFF_KNOB
        end
        sw:GetPropertyChangedSignal("BackgroundColor3"):Connect(sync)
        sync()
    end

    --// secondary / primary button look
    function UI.button(btn, primary)
        btn:SetAttribute("KamuiSkinned", true)
        btn.BackgroundColor3 = primary and THEME.Red or CHIP
        btn.TextColor3 = primary and WHITE or THEME.Text
        btn.Font = Enum.Font.GothamMedium
        btn.TextSize = 12
        UI.corner(btn, 8)
        if primary then
            local s = btn:FindFirstChildOfClass("UIStroke")
            if s then
                s.Enabled = false
            end
        else
            UI.stroke(btn, LINE)
        end
    end

    --// "OPEN" -> small "Open" chip on the right of a row
    function UI.openButton(btn)
        btn:SetAttribute("KamuiSkinned", true)
        btn.Size = UDim2.new(0, 60, 0, 26)
        btn.Position = UDim2.new(1, -72, 0.5, -13)
        btn.Text = "Open"
        btn.Font = Enum.Font.GothamMedium
        btn.TextSize = 12
        btn.TextColor3 = THEME.Text
        btn.BackgroundColor3 = CHIP
        UI.corner(btn, 7)
        UI.stroke(btn, LINE)
    end

    --// slider rows (CreateInput) and plain value rows (Keybind)
    function UI.styleInput(frame)
        local slider = frame:FindFirstChild("SliderHit") ~= nil
        local label = frame:FindFirstChildOfClass("TextLabel")
        local input = frame:FindFirstChildOfClass("TextBox")
        if label then
            label.Position = UDim2.new(0, 12, 0, 0)
            label.Size = slider and UDim2.new(0.34, -12, 1, 0) or UDim2.new(0.5, -12, 1, 0)
            label.Font = Enum.Font.GothamMedium
            label.TextSize = 12
            label.TextColor3 = THEME.Text
        end
        if input then
            local s = input:FindFirstChildOfClass("UIStroke")
            if slider then
                input.BackgroundTransparency = 1
                input.Size = UDim2.new(0.24, -12, 0, 24)
                input.Position = UDim2.new(0.76, 0, 0.5, -12)
                input.TextXAlignment = Enum.TextXAlignment.Right
                input.Font = Enum.Font.RobotoMono
                input.TextSize = 12
                input.TextColor3 = THEME.BrightRed
                if s then
                    s.Enabled = false
                end
            else
                input.Size = UDim2.new(0, 56, 0, 26)
                input.Position = UDim2.new(1, -68, 0.5, -13)
                input.BackgroundColor3 = CHIP
                input.TextXAlignment = Enum.TextXAlignment.Center
                input.Font = Enum.Font.GothamMedium
                input.TextSize = 12
                input.TextColor3 = THEME.Text
                UI.corner(input, 6)
                UI.stroke(input, LINE)
            end
        end
    end

    --// PC / Mobile picker that sits left of an Open button.
    --// Writes _G[flag] (default KAMUI_BackdashMobile), which the launched script reads when it opens.
    function UI.modePicker(panel, rightOffset, subLabel, flag)
        flag = flag or "KAMUI_BackdashMobile"
        local init = _G[flag]
        if init == nil then
            init = game:GetService("UserInputService").TouchEnabled
            _G[flag] = init
        end
        local holder = UI.make("Frame", {
            Name = "ModePicker",
            BackgroundColor3 = CHIP,
            BorderSizePixel = 0,
            Size = UDim2.new(0, 106, 0, 26),
            Position = UDim2.new(1, -(rightOffset + 106), 0.5, -13)
        }, panel)
        UI.corner(holder, 7)
        local btns = {}
        local function paint(mobile)
            for i, b in ipairs(btns) do
                local on = (i == 2) == mobile
                b.BackgroundTransparency = on and 0 or 1
                b.TextColor3 = on and WHITE or THEME.MutedText
            end
            if subLabel then
                subLabel.Text = mobile and "Opens touch buttons" or "Opens separate window"
            end
        end
        local x = 2
        for i, name in ipairs({ "PC", "Mobile" }) do
            local w = i == 1 and 44 or 58
            local b = Instance.new("TextButton")
            b:SetAttribute("KamuiSkinned", true)
            b.BackgroundColor3 = THEME.Red
            b.BorderSizePixel = 0
            b.AutoButtonColor = false
            b.Size = UDim2.new(0, w, 0, 22)
            b.Position = UDim2.new(0, x, 0, 2)
            b.Font = Enum.Font.GothamMedium
            b.TextSize = 11
            b.Text = name
            b.Parent = holder
            UI.corner(b, 5)
            btns[i] = b
            x = x + w
            b.MouseButton1Click:Connect(function()
                _G[flag] = (i == 2)
                paint(i == 2)
            end)
        end
        paint(init)
    end

    return UI
end

