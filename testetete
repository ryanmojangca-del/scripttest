--// RESPONSIVE SCALE
--// A UIScale shrinks the whole window (and everything inside it) so it fits
--// small screens such as phones. Capped at 1 so PC looks exactly as before.
--// UIScale does not scale Position, so the window is re-centered with
--// offsets multiplied by the scale (AnchorPoint stays 0,0 so every existing
--// animation that uses top-left positions keeps working).
do
    local DESIGN_W, DESIGN_H = 540, 330
    local MARGIN = 24
    local MIN_SCALE = 0.55
    local windowScale = Instance.new("UIScale")
    windowScale.Name = "WindowScale"
    windowScale.Parent = MainFrame

    local function getViewport()
        local v = ScreenGui.AbsoluteSize
        if v.X == 0 or v.Y == 0 then
            local cam = Workspace.CurrentCamera
            v = cam and cam.ViewportSize or Vector2.new(1280, 720)
        end
        return v
    end

    local function updateWindowScale()
        local vp = getViewport()
        local newScale = math.clamp(
            math.min((vp.X - MARGIN) / DESIGN_W, (vp.Y - MARGIN) / DESIGN_H),
            MIN_SCALE,
            1
        )
        if math.abs(newScale - windowScale.Scale) < 0.001 and MainFrame:GetAttribute("ScaleInit") then
            return
        end
        windowScale.Scale = newScale
        MainFrame:SetAttribute("ScaleInit", true)
        -- Re-center (skip while the hide animation is running).
        if not (_G.KAMUI_HideFX and _G.KAMUI_HideFX.Busy) then
            MainFrame.Position = UDim2.new(0.5, -(DESIGN_W / 2) * newScale, 0.45, -(DESIGN_H / 2) * newScale)
        end
    end

    updateWindowScale()
    ScreenGui:GetPropertyChangedSignal("AbsoluteSize"):Connect(updateWindowScale)
    local cam = Workspace.CurrentCamera
    if cam then
        cam:GetPropertyChangedSignal("ViewportSize"):Connect(updateWindowScale)
    end
end

