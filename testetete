--// MOBILE INPUT KEEPER
--// Virtual keyboard / mouse input (VirtualInputManager) flips Roblox's "last input type"
--// to Keyboard / Mouse. The game rebuilds its mobile buttons when the NEW character spawns
--// and reads the input type at that moment, so if the last macro left it on Keyboard the
--// rebuilt buttons come up dead. To prevent that, Touch is restored:
--//   1) after every macro (M1 reset / emote dash / backdash cancel),
--//   2) continuously while the character is dead (before the new one exists),
--//   3) again when the new character spawns.
--// Phones only (touch device; keyboard devices only once real touch was seen).
--// Disable: _G.KAMUI_NoTouchRestore = true
--// Emulator / touch laptop: _G.KAMUI_ForceTouchRestore = true
do
    local keeperSrc = [====[
local UIS, player, Workspace, VirtualInputManager, isCurrent = ...
    local touchState = {
        usesTouch = UIS:GetLastInputType() == Enum.UserInputType.Touch,
        virtualUntil = 0,
        retryQueued = false,
        dirty = false,
    }

    --// remember that this device is really played by touch (ignores our own virtual touch)
    UIS.LastInputTypeChanged:Connect(function(t)
        if not isCurrent() then
            return
        end
        if t == Enum.UserInputType.Touch then
            if os.clock() > touchState.virtualUntil then
                touchState.usesTouch = true
            end
        elseif t == Enum.UserInputType.Keyboard or t == Enum.UserInputType.MouseButton1 then
            touchState.dirty = true
        end
    end)

    _G.KAMUI_RestoreTouchInput = function()
        if _G.KAMUI_NoTouchRestore then
            return
        end
        if not UIS.TouchEnabled then
            return
        end
        if UIS.KeyboardEnabled and not (touchState.usesTouch or _G.KAMUI_ForceTouchRestore) then
            return
        end
        if UIS:GetLastInputType() == Enum.UserInputType.Touch then
            return
        end
        --// a virtual touch is already in flight: queue ONE retry so the last call of a burst is never lost
        if os.clock() < touchState.virtualUntil then
            if not touchState.retryQueued then
                touchState.retryQueued = true
                task.delay(touchState.virtualUntil - os.clock() + 0.05, function()
                    touchState.retryQueued = false
                    if _G.KAMUI_RestoreTouchInput then
                        _G.KAMUI_RestoreTouchInput()
                    end
                end)
            end
            return
        end
        touchState.virtualUntil = os.clock() + 0.3
        task.spawn(function()
            local okTouch, errTouch = pcall(function()
                local cam = Workspace.CurrentCamera
                local vp = cam and cam.ViewportSize or Vector2.new(800, 400)
                local x = math.floor(vp.X * 0.5)
                VirtualInputManager:SendTouchEvent(99, 0, x, 3)
                task.wait()
                VirtualInputManager:SendTouchEvent(99, 2, x, 3)
            end)
            if _G.KAMUI_DebugInput then
                if not okTouch then
                    warn("[KAMUI input] SendTouchEvent FAILED (executor may not support it):", errTouch)
                end
                print("[KAMUI input] restored touch controls, LastInputType =", UIS:GetLastInputType().Name)
            end
        end)
    end

    --// Direct refresh of Roblox's own touch controls (jump button / thumbstick / TouchGui).
    --// Used on respawn when a macro left the input type on Keyboard: re-selects the touch
    --// controller even if the virtual touch above did not register.
    _G.KAMUI_RefreshTouchControls = function()
        if _G.KAMUI_NoTouchRestore or not UIS.TouchEnabled then
            return
        end
        if UIS.KeyboardEnabled and not (touchState.usesTouch or _G.KAMUI_ForceTouchRestore) then
            return
        end
        local okA, errA = pcall(function()
            local pg = player:FindFirstChildOfClass("PlayerGui")
            local tg = pg and pg:FindFirstChild("TouchGui")
            if tg and tg:IsA("ScreenGui") then
                tg.Enabled = false
                task.wait()
                tg.Enabled = true
            end
        end)
        local okB, errB = pcall(function()
            local ps = player:FindFirstChild("PlayerScripts")
            local pm = ps and ps:FindFirstChild("PlayerModule")
            if pm then
                local controls = require(pm):GetControls()
                controls:Enable(false)
                task.wait()
                controls:Enable(true)
            end
        end)
        if _G.KAMUI_DebugInput then
            print("[KAMUI input] refresh TouchGui ok =", okA, errA or "", "| controls ok =", okB, errB or "")
        end
    end

    --// while dead (before the new character exists) keep the input type on Touch,
    --// so the game rebuilds its mobile buttons in a good state
    local function watchCharacter(char)
        local hum = char:WaitForChild("Humanoid", 10)
        if not hum or not isCurrent() then
            return
        end
        hum.Died:Connect(function()
            if not isCurrent() then
                return
            end
            task.spawn(function()
                local t0 = os.clock()
                while isCurrent() and player.Character == char and os.clock() - t0 < 12 do
                    _G.KAMUI_RestoreTouchInput()
                    task.wait(0.5)
                end
            end)
        end)
    end
    if player.Character then
        task.spawn(watchCharacter, player.Character)
    end
    player.CharacterAdded:Connect(function(char)
        if not isCurrent() then
            return
        end
        task.spawn(watchCharacter, char)
        local wasDirty = touchState.dirty
        touchState.dirty = false
        if not wasDirty then
            return
        end
        task.spawn(function()
            local passed = 0
            for _, t in ipairs({ 0.6, 1.8, 3.5 }) do
                task.wait(t - passed)
                passed = t
                if not isCurrent() or player.Character ~= char then
                    return
                end
                _G.KAMUI_RestoreTouchInput()
                task.wait(0.15)
                _G.KAMUI_RefreshTouchControls()
            end
        end)
    end)
    player.CharacterRemoving:Connect(function()
        if isCurrent() then
            _G.KAMUI_RestoreTouchInput()
        end
    end)
]====]
    --// runs in its own chunk: a problem in here can never stop the rest of the script from loading
    local keeperFn, keeperCompileErr = loadstring(keeperSrc)
    if keeperFn then
        local keeperOk, keeperRunErr = pcall(keeperFn, UIS, player, Workspace, VirtualInputManager, isCurrent)
        if not keeperOk then
            warn("[KAMUI] touch keeper failed:", keeperRunErr)
        end
    else
        warn("[KAMUI] touch keeper did not compile:", keeperCompileErr)
    end
end

