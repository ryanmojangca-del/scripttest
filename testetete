    local perf = UI.card(O, "Performance")
    panelRow(perf, BoostPanel, BoostTitle, "FPS boost", "Removes textures")
    UI.switch(PSW)

    local vis = UI.card(O, "Visuals")
    panelRow(vis, DeathCounterPanel, DeathCounterTitle, "Death counter notifier", "Tags players with a skill label")
    UI.switch(DCSwitch)
    panelRow(vis, HeadlessKorbloxPanel, HeadlessKorbloxTitle, "Headless and Korblox")
    UI.switch(HeadlessKorbloxSwitch)

    local tools = UI.card(O, "Tools")
    panelRow(tools, M1EmoteLauncherPanel, M1EmoteLauncherTitle, "M1 reset and emote dash", "Opens launcher")
    UI.openButton(M1EmoteOpenButton)
    M1EmoteLauncherTitle.Size = UDim2.new(1, -190, 0, 20)
    M1EmoteLauncherTitle.TextTruncate = Enum.TextTruncate.AtEnd
    local m1Sub = M1EmoteLauncherPanel:FindFirstChild("RowSub")
    if m1Sub then
        m1Sub.Size = UDim2.new(1, -190, 0, 14)
    end
    UI.modePicker(M1EmoteLauncherPanel, 80, m1Sub, "KAMUI_M1Mobile")
    if BDU and BDU.Panel and BDU.Title and BDU.Button then
        panelRow(tools, BDU.Panel, BDU.Title, "Backdash cancel", "Opens separate window")
        UI.openButton(BDU.Button)
        BDU.Title.Size = UDim2.new(1, -250, 0, 20)
        local bduSub = BDU.Panel:FindFirstChild("RowSub")
        if bduSub then
            bduSub.Size = UDim2.new(1, -250, 0, 14)
        end
        UI.modePicker(BDU.Panel, 80, bduSub)
    end
end

_G.KAMUI_ContentInit = function()
    local ok, UI = pcall(_G.KAMUI_UIKit)
    if not ok then
        warn("[KAMUI] content kit failed:", UI)
        return
    end
    for _, name in ipairs({ "Home", "Settings", "Profiles", "Skills", "Others" }) do
        local ok2, err = pcall(_G["KAMUI_Build" .. name], UI)
        if not ok2 then
            warn("[KAMUI] " .. name .. " tab redesign failed:", err)
        end
    end
end
_G.KAMUI_ContentInit()
