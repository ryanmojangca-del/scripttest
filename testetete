--// Everything we press virtually is remembered, so a macro that gets cut short
--// (death / respawn / error) can never leave a key or mouse button stuck down.
local heldKeys = {}
local mouseHeld = false
local lifeEpoch = 0 -- +1 on every respawn; a running macro stops when it changes

local function sendKeyEvent(
    keyCode
)
    heldKeys[keyCode] = true
    VirtualInputManager:SendKeyEvent(true, keyCode, false, game)
end

local function tapKey(
    keyCode
)
    heldKeys[keyCode] = nil
    VirtualInputManager:SendKeyEvent(false, keyCode, false, game)
end

--// releases only what is actually still held (sends nothing when nothing is stuck)
local function releaseHeldInput()
    for keyCode in pairs(heldKeys) do
        heldKeys[keyCode] = nil
        pcall(function()
            VirtualInputManager:SendKeyEvent(false, keyCode, false, game)
        end)
    end
    if mouseHeld then
        mouseHeld = false
        pcall(function()
            VirtualInputManager:SendMouseButtonEvent(halfViewportX, halfViewportY, 0, false, game, 0)
        end)
    end
end

--// phone only: puts the game's mobile buttons back after virtual keyboard/mouse input
local function restoreTouchInput()
