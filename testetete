        pcall(function()
            for _, v in ipairs(game:GetObjects("rbxassetid://139607718")) do
                local m = v:IsA("CharacterMesh") and v or v:FindFirstChildWhichIsA("CharacterMesh", true)
                if m and m.BodyPart == Enum.BodyPart.RightLeg then
