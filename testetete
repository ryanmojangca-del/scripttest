local function computeLockAngles(angle, targetPosition, useCharacter, useCamera, _, smoothing)
    if not useCharacter and not useCamera and not angle then
        useCharacter = true
    end
    smoothing = smoothing or 1
    if not currentRootPart or not currentHumanoid then
        return
    end
    local cameraCFrame = camera.CFrame
