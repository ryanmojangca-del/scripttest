        elseif index == 2 then
            isEnabled = Settings.Macro.BackDashCancel2.Enabled
        elseif index == 3 then
            isEnabled = Settings.Macro.BackDashCancel3.Enabled
        elseif index == 4 then
            isEnabled = Settings.Macro.BackDashCancel4.Enabled
