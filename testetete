local function CreateInput(name, configKey)
    local frame = Instance.new("Frame")
    frame.Parent = SettingsContainer
    frame.Size = UDim2.new(1, 0, 0, 32)
    frame.BackgroundTransparency = 1
    local label = Instance.new("TextLabel")
    label.Parent = frame
    label.Text = name
    label.Size = UDim2.new(0.5, 0, 1, 0)
    label.TextColor3 = THEME.MutedText
    label.BackgroundTransparency = 1
    label.Font = Enum.Font.Gotham
    label.TextSize = 11
    label.TextXAlignment = Enum.TextXAlignment.Left
    local input = Instance.new("TextBox")
    input.Parent = frame
    input.Size = UDim2.new(0.45, 0, 1, 0)
    input.Position = UDim2.new(0.55, 0, 0, 0)
    input.BackgroundColor3 = THEME.BackgroundMedium
    input.Text = tostring(Config[configKey])
    input.TextColor3 = THEME.Red
    input.Font = Enum.Font.Gotham
    input.TextSize = 11
    applyCorner(input, 4)
    --// ------------------------------------------------------------
    --// SLIDER (numeric settings only) - typing in the box still works
    --// Ranges below are only the slider's limits; you can still type
    --// any value in the box, even outside the range.
    --//   { min, max, step }
    --// ------------------------------------------------------------
    local rangeInfo = ({
        LethalDelay       = { 0, 20, 0.001 },
        LethalJump        = { 0, 100, 1 },
        LethalAccuracy    = { 0, 300, 1 },    -- V1 (Accuracy / Flip)
        MagnetDelay       = { 0, 5, 0.01 },
        DashRange         = { 0, 12, 0.5 },
        LethalCancelDelay = { 0, 50, 0.01 },
        CamSmoothDelay    = { 0, 50, 0.01 },
        CamDuration       = { 0, 50, 0.05 },
    })[configKey]
    if rangeInfo then
        label.Size = UDim2.new(0.34, 0, 1, 0)
        input.Size = UDim2.new(0.24, 0, 0, 24)
        input.Position = UDim2.new(0.76, 0, 0.5, -12)
        local function getRange()
            -- V2 uses "Flip delay" instead of V1's Accuracy
            if configKey == "LethalAccuracy" and Config.LethalMode == "V2" then
                return 0, 100, 0.01
            end
            return rangeInfo[1], rangeInfo[2], rangeInfo[3]
        end
        local function snap(v, mn, mx, step)
            v = math.clamp(v, mn, mx)
            v = math.floor(v / step + 0.5) * step
            return tonumber(string.format("%.4f", v))
        end
        local sliderHit = Instance.new("Frame")
        sliderHit.Name = "SliderHit"
        sliderHit.Parent = frame
        sliderHit.BackgroundTransparency = 1
        sliderHit.BorderSizePixel = 0
        sliderHit.Active = true
        sliderHit:SetAttribute("KamuiNoDrag", true)
        sliderHit.Size = UDim2.new(0.38, 0, 0, 24)
        sliderHit.Position = UDim2.new(0.35, 0, 0.5, -12)
        local sliderTrack = Instance.new("Frame")
        sliderTrack.Name = "SliderTrack"
        sliderTrack.Parent = sliderHit
        sliderTrack.BackgroundColor3 = Color3.fromRGB(26, 26, 28)
        sliderTrack.BorderSizePixel = 0
        sliderTrack.Size = UDim2.new(1, -10, 0, 6)
        sliderTrack.Position = UDim2.new(0, 5, 0.5, -3)
        applyCorner(sliderTrack, 3)
        local sliderTrackStroke = Instance.new("UIStroke")
        sliderTrackStroke.Color = Color3.fromRGB(52, 52, 55)
        sliderTrackStroke.Thickness = 1
        sliderTrackStroke.Parent = sliderTrack
        local sliderFill = Instance.new("Frame")
        sliderFill.Name = "SliderFill"
        sliderFill.Parent = sliderTrack
        sliderFill.BackgroundColor3 = THEME.BrightRed
        sliderFill.BorderSizePixel = 0
        sliderFill.Size = UDim2.new(0, 0, 1, 0)
        applyCorner(sliderFill, 3)
        local sliderKnob = Instance.new("Frame")
        sliderKnob.Name = "SliderKnob"
        sliderKnob.Parent = sliderTrack
        sliderKnob.BackgroundColor3 = Color3.fromRGB(240, 236, 236)
        sliderKnob.BorderSizePixel = 0
        sliderKnob.Size = UDim2.new(0, 10, 0, 10)
        sliderKnob.Position = UDim2.new(0, -5, 0.5, -5)
        applyCorner(sliderKnob, 5)
        local dragging = false
        local function setFromX(x)
            local mn, mx, step = getRange()
            local width = sliderTrack.AbsoluteSize.X
            if width <= 0 then
                return
            end
            local a = math.clamp((x - sliderTrack.AbsolutePosition.X) / width, 0, 1)
            Config[configKey] = snap(mn + (mx - mn) * a, mn, mx, step)
        end
        sliderHit.InputBegan:Connect(function(inp)
            if not isCurrent() then
                return
            end
            if inp.UserInputType == Enum.UserInputType.MouseButton1
                or inp.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                _G.KAMUI_SliderHeld = true
                local x = inp.Position.X
                if input:IsFocused() then
                    input:ReleaseFocus()
                    task.defer(setFromX, x) -- after the box commits its text
                else
                    setFromX(x)
                end
            end
        end)
        UIS.InputChanged:Connect(function(inp)
            if not dragging then
                return
            end
            if inp.UserInputType == Enum.UserInputType.MouseMovement
                or inp.UserInputType == Enum.UserInputType.Touch then
                setFromX(inp.Position.X)
            end
        end)
        UIS.InputEnded:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.MouseButton1
                or inp.UserInputType == Enum.UserInputType.Touch then
                dragging = false
                _G.KAMUI_SliderHeld = false
            end
        end)
        -- keep the slider in sync with the value (typing, profiles, V1/V2 switch)
        local lastV, lastMin, lastMax
        local function refreshSlider()
            local mn, mx = getRange()
            local v = tonumber(Config[configKey])
            if v == lastV and mn == lastMin and mx == lastMax then
                return
            end
            lastV, lastMin, lastMax = v, mn, mx
            local a = 0
            if v and mx > mn then
                a = math.clamp((v - mn) / (mx - mn), 0, 1)
            end
            sliderFill.Size = UDim2.new(a, 0, 1, 0)
            sliderKnob.Position = UDim2.new(a, -5, 0.5, -5)
        end
        refreshSlider()
        RunService.RenderStepped:Connect(function()
            if isCurrent() and frame.Visible then
                refreshSlider()
            end
        end)
    end
    input.FocusLost:Connect(function()
        local val = tonumber(input.Text)
        if val then
            Config[configKey] = val
        else
            Config[configKey] = input.Text
        end
    end)
    RunService.RenderStepped:Connect(function()
        if not isCurrent() then
            return
        end
        if not input:IsFocused() then
            input.Text = tostring(Config[configKey])
        end
    end)
    return frame
end
