local lastDestroyClick = 0
_G.KAMUI_DestroyClick = function()
    local currentTime = tick()
    if currentTime - lastDestroyClick <= 5 then
        forceCancel()
        if SkillsColorConnection then
            SkillsColorConnection:Disconnect()
            SkillsColorConnection = nil
        end
        --// TURN FPS BOOST OFF BEFORE DESTROYING
        if potatoEnabled then
            potatoEnabled = false
            if fpsDescConn then
                fpsDescConn:Disconnect()
                fpsDescConn = nil
            end
            if fpsFreezeConn then
                fpsFreezeConn:Disconnect()
                fpsFreezeConn = nil
            end
            -- Restore lighting
            pcall(function()
                Lighting.GlobalShadows = OriginalLighting.GlobalShadows
                Lighting.Brightness = OriginalLighting.Brightness
                Lighting.Ambient = OriginalLighting.Ambient
                Lighting.FogEnd = OriginalLighting.FogEnd
                Lighting.FogStart = OriginalLighting.FogStart
                Lighting.FogColor = OriginalLighting.FogColor
                Lighting.EnvironmentDiffuseScale = OriginalLighting.EnvDiff
                Lighting.EnvironmentSpecularScale = OriginalLighting.EnvSpec
                Lighting.ClockTime = OriginalLighting.ClockTime
                Lighting.GeographicLatitude = OriginalLighting.GeoLat
            end)
            -- Restore changed effects
            for i = #fpsRestored, 1, -1 do
                local r = fpsRestored[i]
                pcall(function()
                    r.obj[r.prop] = r.old
                end)
                table.remove(fpsRestored, i)
            end
            -- Restore materials
            for _, r in ipairs(fpsTexCache) do
                pcall(function()
                    if r.obj and r.obj.Parent then
                        r.obj.Material = r.old
                    end
                end)
            end
            table.clear(fpsTexCache)
            pcall(function()
                Workspace.Terrain.WaterWaveSize = 0.15
                Workspace.Terrain.WaterWaveSpeed = 0.5
                Workspace.Terrain.WaterReflectance = 0.5
                Workspace.Terrain.Decoration = true
            end)
            pcall(function()
                settings().Rendering.QualityLevel = Enum.QualityLevel.Automatic
            end)
        end
        deathCounterEnabled = false
        if deathCounterConn then
            deathCounterConn:Disconnect()
            deathCounterConn = nil
        end
        clearDeathCounterTags()
        table.clear(deathCounterState)
        table.clear(deathCounterArmed)
        -- DASH button now lives in RestoreGui, so remove it with the script.
        pcall(function()
            local trig = RestoreGui and RestoreGui:FindFirstChild("MobileTrigger")
            if trig then
                trig:Destroy()
            end
        end)
        ScreenGui:Destroy()
    else
        lastDestroyClick = currentTime
        game:GetService("StarterGui"):SetCore(
            "SendNotification",
            { Title = "KAMUI Custom Dash", Text = "Click '×' again to destroy script.", Duration = 5, }
        )
    end
end
