        task.delay(duration, function()
            isCooldown = false
            if CooldownBar then
                CooldownBar.Visible = false
            end
        end)
    else
        task.wait(duration)
        isCooldown = false
    end
end

--// TARGET DETECTION
local function getTorsoTarget()
    local char = player.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then
        return nil
    end
    local params = OverlapParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {char}
    local parts = Workspace:GetPartBoundsInRadius(char.HumanoidRootPart.Position, Config.DashRange, params)
    local target = nil
    local dist = Config.DashRange
    for _, part in pairs(parts) do
        local model = part:FindFirstAncestorOfClass("Model")
        if model
            and model:FindFirstChild("Humanoid")
            and model ~= char then
            local torso = model:FindFirstChild("Torso")
                or model:FindFirstChild("UpperTorso") or model:FindFirstChild("HumanoidRootPart")
            if torso then
                local d = (char.HumanoidRootPart.Position - torso.Position).Magnitude
                if d < dist then
                    dist = d
                    target = torso
                end
            end
        end
    end
    return target
end

--// CAM SMOOTH
local isExecuting = false
local camSmoothConn = nil
local camSmoothAttached = false
local camSmoothPrevSubject = nil
local camSmoothDashStart = 0

local function stopCamSmooth()
    if camSmoothConn then
        camSmoothConn:Disconnect()
        camSmoothConn = nil
    end
    if camSmoothAttached then
        pcall(function()
            local char = player.Character
            local cam = workspace.CurrentCamera
            if cam then
                cam.CameraType = Enum.CameraType.Custom
                cam.CameraSubject = camSmoothPrevSubject or (char and char:FindFirstChildOfClass("Humanoid"))
            end
        end)
    end
    camSmoothAttached = false
    camSmoothPrevSubject = nil
end

local function updateCamSmooth()
    stopCamSmooth()
    if not Config.CamSmooth then
        return
    end
    camSmoothConn = RunService.RenderStepped:Connect(function()
        if not isCurrent() then
            stopCamSmooth()
            return
        end
        local char = player.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local cam = workspace.CurrentCamera
        if not root or not cam then
            return
        end
        local elapsed = os.clock() - camSmoothDashStart
        local inSmoothWindow = isExecuting
            and elapsed >= Config.CamSmoothDelay and elapsed <= (Config.CamSmoothDelay + Config.CamDuration)
        if not inSmoothWindow then
            if camSmoothAttached then
                pcall(function()
                    cam.CameraType = Enum.CameraType.Custom
                    cam.CameraSubject = camSmoothPrevSubject or char:FindFirstChildOfClass("Humanoid")
                end)
                camSmoothAttached = false
            end
            return
        end
        if not camSmoothAttached then
            camSmoothPrevSubject = cam.CameraSubject
            camSmoothAttached = true
        end
        pcall(function()
            cam.CameraType = Enum.CameraType.Attach
            cam.CameraSubject = root
        end)
    end)
end

--// LETHAL EXECUTION

local function executeLethal()
    if not isCurrent() or isExecuting or isCooldown then
        return
    end
    if not Config.Enabled or not Config.LethalEnabled then
        return
    end
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChild("Humanoid")
    if not root or not hum then
        return
    end
    local torso = getTorsoTarget()
    if not torso then
        clip()
        return
    end
    isExecuting = true
    if not Config.TouchMode then
        task.wait(Config.LethalDelay)
    end
    if not isCurrent() then
        isExecuting = false
        return
    end
    root.AssemblyLinearVelocity = Vector3.new(root.AssemblyLinearVelocity.X, Config.LethalJump, root.AssemblyLinearVelocity.Z)
    isNoclipping = true
    fireDash()
    if Config.LethalMode == "V1" then
        camSmoothDashStart = os.clock()
        updateCamSmooth()
    else
        stopCamSmooth()
    end
    local startT = tick()
    local flipped = false
    local floaterStarted = false
    local forwardDir = (torso.Position - root.Position).Unit
    local sideVec = Vector3.new(-forwardDir.Z, 0, forwardDir.X)
    local bav = nil
    if Config.LethalMode == "V1" then
        bav = Instance.new("BodyAngularVelocity")
        bav.MaxTorque = Vector3.new(0, 1000000, 0)
        bav.P = 15000
        bav.Parent = root
    end
    local conn
    conn = RunService.Heartbeat:Connect(function()
        if not isCurrent()
            or not torso
            or not torso.Parent
            or not root
            or not root.Parent then
            if bav then
                bav:Destroy()
            end
            clip()
            isExecuting = false
            stopCamSmooth()
            if conn then
                conn:Disconnect()
            end
            return
        end
        local elapsed = tick() - startT
        local torsoPos = torso.Position
        local rootPos = root.Position
        hum.AutoRotate = false
        if Config.LethalMode == "V1" then
            local angle = (elapsed / 0.45) * (math.pi / 1.5)
            local radius = Config.LethalAccuracy * (1 - math.clamp(elapsed / 0.45, 0, 1))
            local targetLookPos = torsoPos + (sideVec * math.cos(angle) + forwardDir * math.sin(angle)) * radius
            local lookAtCF = CFrame.lookAt(rootPos, Vector3.new(targetLookPos.X, rootPos.Y, targetLookPos.Z))
            local relativeCF = root.CFrame:Inverse() * lookAtCF
            local _, y, _ = relativeCF:ToEulerAnglesXYZ()
            if bav and bav.Parent then
                bav.AngularVelocity = Vector3.new(0, y * 30, 0)
            end
        else
            if elapsed >= Config.LethalAccuracy
                and not flipped then
                root.CFrame = root.CFrame * CFrame.Angles(0, math.pi, 0)
                flipped = true
            end
        end
        -- Start Floater during the dash at the user-configured Magnet Delay.
        if Config.LethalMode == "V2"
            and FloaterMode
            and not floaterStarted
            and elapsed >= Config.MagnetDelay then
            floaterStarted = true
            startFloaterMode(torso)
        end
        local distXZ = (Vector2.new(rootPos.X, rootPos.Z) - Vector2.new(torsoPos.X, torsoPos.Z)).Magnitude
        if Config.CancelEnabled
            and elapsed > Config.LethalCancelDelay then
            if distXZ < 2.2 then
                if bav then
                    bav:Destroy()
                end
                forceCancel()
                isExecuting = false
                stopCamSmooth()
                if Config.LethalMode == "V2" and FloaterMode and not floaterStarted then
                    startFloaterMode(torso)
                end
                conn:Disconnect()
                return
            end
        end
        if not Config.Enabled or elapsed > 1.5 then
            if bav then
                bav:Destroy()
            end
            clip()
            isExecuting = false
            stopCamSmooth()
