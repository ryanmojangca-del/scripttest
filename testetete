    if not currentCharacter or not currentHumanoid or not currentRootPart or not currentCommunicate then
        return
    end
    local delay = pingCompensatedRange(0.28)
    local startChar = currentCharacter
    autoCounterClicks()
    task.wait(delay)
    if currentCharacter ~= startChar or not currentHumanoid or currentHumanoid.Health <= 0 then
        return
    end
    if Settings.TrueM1Reset.AutoRotate then
        computeLockAngles(-90)
    end
    sendKeyEvent(keyD)
    tapKeyWithDelay(keyQ)
    task.wait(delay)
    tapKey(keyD)
    if Settings.TrueM1Reset.AutoRotate then
        computeLockAngles(90)
    end
    performFrontDash()
end
local function executeEmoteDash()
    if not Settings.EmoteDash.Enabled then
        return
    end
    if not currentCharacter or not currentHumanoid or not currentRootPart then
        return
    end
    tapKey(keyW)
    tapKey(keyS)
    if Settings.EmoteDash.Type == "Straight" then
        computeLockAngles(90)
    end
    if Settings.EmoteDash.Type == "Straight" or Settings.EmoteDash.Type == "Right" then
        sendKeyEvent(keyD)
    elseif Settings.EmoteDash.Type == "Left" then
        sendKeyEvent(keyA)
    end
    currentHumanoid:ChangeState(Enum.HumanoidStateType.Jumping)
    task.wait(0.005)
    tapKeyWithDelay(keyQ)
    task.wait(Settings.EmoteDash.Delay)
    local dodgeVelocity = currentRootPart:FindFirstChild("dodgevelocity")
    if dodgeVelocity then
        dodgeVelocity:Destroy()
        stopAnimation(animId2)
        stopAnimation(animId3)
    end
    tapKey(keyD)
    tapKey(keyA)
    if Settings.EmoteDash.Type == "Straight" then
        computeLockAngles(-90)
    end
end
