            elseif index == 2 then
                Settings.Macro.BackDashCancel2.Enabled = not Settings.Macro.BackDashCancel2.Enabled
            elseif index == 3 then
                Settings.Macro.BackDashCancel3.Enabled = not Settings.Macro.BackDashCancel3.Enabled
            elseif index == 4 then
                Settings.Macro.BackDashCancel4.Enabled = not Settings.Macro.BackDashCancel4.Enabled
