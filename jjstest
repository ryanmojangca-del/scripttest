    local function trackLog(track, reason, dist)
        local reports = reportedTracks[track]
        if not reports then reports = {}; reportedTracks[track] = reports end
        if reports[reason] then return end
        reports[reason] = true
        local anim = track.Animation
        local id = anim and tostring(anim.AnimationId) or "unknown"
        blockLog(string.format("%s id=%s name=%s d=%.1f len=%.2f t=%.2f pri=%s", reason, id,
