local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local old = playerGui:FindFirstChild("ShiftLockTest")
if old then old:Destroy() end

local gui = Instance.new("ScreenGui")
gui.Name = "ShiftLockTest"
gui.ResetOnSpawn = false
gui.Parent = playerGui

local frame = Instance.new("Frame")
frame.Size = UDim2.fromOffset(310, 260)
frame.Position = UDim2.new(0, 10, 0.2, 0)
frame.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
frame.Parent = gui

local close = Instance.new("TextButton")
close.Size = UDim2.fromOffset(45, 30)
close.Position = UDim2.new(1, -45, 0, 0)
close.Text = "X"
close.Parent = frame
close.MouseButton1Click:Connect(function()
    gui:Destroy()
end)

local label = Instance.new("TextLabel")
label.Size = UDim2.new(1, -16, 1, -38)
label.Position = UDim2.fromOffset(8, 34)
label.BackgroundTransparency = 1
label.TextColor3 = Color3.new(1, 1, 1)
label.TextSize = 13
label.TextWrapped = true
label.TextXAlignment = Enum.TextXAlignment.Left
label.TextYAlignment = Enum.TextYAlignment.Top
label.Font = Enum.Font.Code
label.Parent = frame

task.spawn(function()
    local lines = {"Turn shift lock ON, then OFF:"}
    local last = nil

    for i = 1, 60 do
        if not gui.Parent then break end

        local char = player.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local state = "No humanoid"

        if hum then
            local offset = hum.CameraOffset
            state = string.format(
                "Mouse: %s | AutoRotate: %s\nOffset: %.2f, %.2f, %.2f",
                UIS.MouseBehavior.Name,
                tostring(hum.AutoRotate),
                offset.X, offset.Y, offset.Z
            )
        end

        if state ~= last then
            table.insert(lines, string.format("[%ds] %s", math.floor(i / 2), state))
            if #lines > 8 then table.remove(lines, 2) end
            label.Text = table.concat(lines, "\n\n")
            last = state
        end

        task.wait(0.5)
    end
end)
