                TextColor3 = THEME.Text,
                TextXAlignment = Enum.TextXAlignment.Left,
                Text = label
            }, row)
            if sub then
                UI.subtitle(row, sub, 100)
            end
            local track = mk("Frame", {
                BorderSizePixel = 0,
                AnchorPoint = Vector2.new(1, 0.5),
                Position = UDim2.new(1, -12, 0.5, 0),
                Size = UDim2.new(0, 36, 0, 20),
                BackgroundColor3 = OFF_TRACK
            }, row)
            UI.corner(track, 10)
            local knob = mk("Frame", {
                BorderSizePixel = 0,
                Size = UDim2.new(0, 14, 0, 14),
                Position = UDim2.new(0, 3, 0.5, -7),
                BackgroundColor3 = OFF_KNOB
            }, track)
            UI.corner(knob, 7)
            local lastOn = nil
            local function paint()
                local on = get() == true
                track.BackgroundColor3 = on and THEME.Red or OFF_TRACK
                knob.BackgroundColor3 = on and WHITE or OFF_KNOB
                if on ~= lastOn then
                    local goal = on and UDim2.new(1, -17, 0.5, -7) or UDim2.new(0, 3, 0.5, -7)
                    if lastOn == nil then
                        knob.Position = goal
                    else
                        TweenService:Create(knob, TweenInfo.new(0.14, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Position = goal }):Play()
                    end
                    lastOn = on
                end
            end
            paint()
            paints[#paints + 1] = paint
            row.MouseButton1Click:Connect(function()
                set(not get())
                paint()
            end)
            return row
        end

        --// o = { label, sub, get, set, min, max, step, fmt, isOn }
        local function sliderRow(card, o)
            local hasSub = o.sub ~= nil
            local row = mk("Frame", { BackgroundTransparency = 1, BorderSizePixel = 0 }, nil)
            UI.addRow(card, row, hasSub and UI.ROW_SUB or UI.ROW)
            mk("TextLabel", {
                Name = "RowLabel",
                BackgroundTransparency = 1,
                Position = UDim2.new(0, 12, 0, hasSub and 5 or 0),
                Size = hasSub and UDim2.new(0.5, -12, 0, 20) or UDim2.new(0.5, -12, 1, 0),
                Font = Enum.Font.GothamMedium,
                TextSize = 12,
                TextColor3 = THEME.Text,
                TextXAlignment = Enum.TextXAlignment.Left,
                Text = o.label
            }, row)
            if hasSub then
                mk("TextLabel", {
                    Name = "RowSub",
                    BackgroundTransparency = 1,
                    Position = UDim2.new(0, 12, 0, 24),
                    Size = UDim2.new(0.5, -12, 0, 14),
                    Font = Enum.Font.Gotham,
                    TextSize = 11,
                    TextColor3 = THEME.MutedText,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    TextTruncate = Enum.TextTruncate.AtEnd,
                    Text = o.sub
                }, row)
            end
            local back = mk("Frame", {
                Name = "SliderBack",
                BackgroundColor3 = CHIP,
                BorderSizePixel = 0,
                Position = UDim2.new(0.52, 0, 0.5, -3),
                Size = UDim2.new(0.28, 0, 0, 6)
            }, row)
            UI.corner(back, 3)
            back:SetAttribute("KamuiNoDrag", true)
            local fill = mk("Frame", { BackgroundColor3 = THEME.Red, BorderSizePixel = 0, Size = UDim2.new(0, 0, 1, 0) }, back)
            UI.corner(fill, 3)
            local box = mk("TextBox", {
                Name = "ValueBox",
                BackgroundTransparency = 1,
                BorderSizePixel = 0,
                AnchorPoint = Vector2.new(1, 0.5),
                Position = UDim2.new(1, -12, 0.5, 0),
                Size = UDim2.new(0.18, 0, 0, 24),
                Font = Enum.Font.RobotoMono,
                TextSize = 12,
                TextColor3 = THEME.BrightRed,
                TextXAlignment = Enum.TextXAlignment.Right,
                ClearTextOnFocus = false,
                Text = ""
            }, row)
            box:SetAttribute("KamuiNoDrag", true)
            local function paint()
                local v = o.get()
                fill.Size = UDim2.new(math.clamp((v - o.min) / (o.max - o.min), 0, 1), 0, 1, 0)
                local on = o.isOn == nil or o.isOn()
                fill.BackgroundColor3 = on and THEME.Red or THEME.OffRed
                box.TextColor3 = on and THEME.BrightRed or THEME.MutedText
                if not box:IsFocused() then
                    box.Text = string.format(o.fmt or "%g", v)
                end
            end
            paint()
            paints[#paints + 1] = paint
            local hit = mk("TextButton", {
                Name = "SliderHit",
                BackgroundTransparency = 1,
                Text = "",
                Position = UDim2.new(0.5, 0, 0, 0),
                Size = UDim2.new(0.32, 0, 1, 0)
            }, row)
            hit:SetAttribute("KamuiNoDrag", true)
            local dragging, dragInput = false, nil
            local function fromX(x)
                local a = math.clamp((x - back.AbsolutePosition.X) / math.max(1, back.AbsoluteSize.X), 0, 1)
                local v = round2(math.round((o.min + a * (o.max - o.min)) / o.step) * o.step)
                o.set(math.clamp(v, o.min, o.max))
                paint()
            end
            hit.InputBegan:Connect(function(i)
                if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                    dragging, dragInput = true, i
                    _G.KAMUI_SliderHeld = true
                    fromX(i.Position.X)
                end
            end)
            myConns[#myConns + 1] = UIS.InputChanged:Connect(function(i)
                if not dragging or not isCurrent() then
                    return
                end
                if i == dragInput or (i.UserInputType == Enum.UserInputType.MouseMovement and dragInput.UserInputType == Enum.UserInputType.MouseButton1) then
                    fromX(i.Position.X)
                end
            end)
            myConns[#myConns + 1] = UIS.InputEnded:Connect(function(i)
                if dragging and (i == dragInput or i.UserInputType == Enum.UserInputType.MouseButton1) then
                    dragging, dragInput = false, nil
                    _G.KAMUI_SliderHeld = false
                end
            end)
            box.Focused:Connect(function()
                box.Text = string.format("%g", o.get())
            end)
            box.FocusLost:Connect(function()
                local n = tonumber((box.Text:gsub(",", "."):gsub("[xXmMsS%s]", "")))
                if n then
                    o.set(math.clamp(round2(n), o.min, o.max))
                end
                paint()
            end)
            return row
        end

        --// "< value >" selector that cycles through CFG[key]'s options
        local function cycleRow(card, label, sub, key)
            local opts, names = OPT[key], NAMES[key]
            local row = mk("Frame", { BackgroundTransparency = 1, BorderSizePixel = 0 }, nil)
            UI.addRow(card, row, sub and UI.ROW_SUB or UI.ROW)
            mk("TextLabel", {
                Name = "RowLabel",
                BackgroundTransparency = 1,
                Position = UDim2.new(0, 12, 0, sub and 5 or 0),
                Size = sub and UDim2.new(1, -184, 0, 20) or UDim2.new(1, -184, 1, 0),
                Font = Enum.Font.GothamMedium,
                TextSize = 12,
                TextColor3 = THEME.Text,
                TextXAlignment = Enum.TextXAlignment.Left,
                Text = label
            }, row)
            if sub then
                UI.subtitle(row, sub, 184)
            end
            local box = mk("Frame", {
                BackgroundColor3 = CHIP,
                BorderSizePixel = 0,
                AnchorPoint = Vector2.new(1, 0.5),
                Position = UDim2.new(1, -12, 0.5, 0),
                Size = UDim2.new(0, 160, 0, 26)
            }, row)
            UI.corner(box, 7)
            local val = mk("TextLabel", {
                BackgroundTransparency = 1,
                Position = UDim2.new(0, 26, 0, 0),
                Size = UDim2.new(1, -52, 1, 0),
                Font = Enum.Font.GothamMedium,
                TextSize = 11,
                TextColor3 = THEME.Text,
                TextTruncate = Enum.TextTruncate.AtEnd,
                Text = ""
            }, box)
            local function paint()
                local v = CFG[key]
                val.Text = (names and names[v]) or tostring(v)
            end
            paint()
            paints[#paints + 1] = paint
            local function step(d)
                local i = table.find(opts, CFG[key]) or 1
                CFG[key] = opts[((i - 1 + d) % #opts) + 1]
                changed()
                paint()
            end
            for _, side in ipairs({ { "<", 0, -1 }, { ">", 1, 1 } }) do
                local b = mk("TextButton", {
                    AutoButtonColor = false,
                    BackgroundTransparency = 1,
                    AnchorPoint = Vector2.new(side[2], 0),
                    Position = UDim2.new(side[2], 0, 0, 0),
                    Size = UDim2.new(0, 26, 1, 0),
                    Font = Enum.Font.GothamBold,
                    TextSize = 12,
                    TextColor3 = THEME.MutedText,
                    Text = side[1]
                }, box)
                b.MouseButton1Click:Connect(function()
                    step(side[3])
                end)
            end
            return row
        end

        local function buttonRow(card, text, onClick)
            local row = mk("Frame", { BackgroundTransparency = 1, BorderSizePixel = 0 }, nil)
            UI.addRow(card, row, UI.ROW)
            local b = mk("TextButton", {
