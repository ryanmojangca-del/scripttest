local function setHeadless(on)
    local c = hkCharacter()
    local h = c:FindFirstChild("Head")
    local f = h and h:FindFirstChild("face")
    if h then
        h.Transparency = on and 1 or 0
    end
    if f then
        f.Transparency = on and 1 or 0
    end
end

local function setKorblox(on)
    local c = hkCharacter()
    local leg = c:FindFirstChild("Right Leg")
    local hum = c:FindFirstChildOfClass("Humanoid")
    if not leg then
        return
    end
    for _, v in ipairs(c:GetChildren()) do
        if v:IsA("CharacterMesh") and (v.Name == "KittyKorbloxCM" or v.BodyPart == Enum.BodyPart.RightLeg) then
            pcall(v.Destroy, v)
        end
    end
    if on then
        if hum then
            pcall(function()
                local d = hum:GetAppliedDescription()
                d.RightLeg = 139607718
                hum:ApplyDescription(d)
            end)
        end
        local found = false
        pcall(function()
            for _, v in ipairs(game:GetObjects("rbxassetid://139607718")) do
                local m = v:IsA("CharacterMesh") and v or v:FindFirstChildWhichIsA("CharacterMesh", true)
                if m and m.BodyPart == Enum.BodyPart.RightLeg then
                    m.Name = "KittyKorbloxCM"
                    m.Parent = c
                    found = true
                end
            end
        end)
        if not found then
            local m = Instance.new("CharacterMesh")
            m.Name = "KittyKorbloxCM"
            m.MeshId = 101851696
            m.OverlayTextureId = 101851254
            m.BaseTextureId = 101851254
            m.BodyPart = Enum.BodyPart.RightLeg
            m.Parent = c
        end
        local m = leg:FindFirstChild("KittyKorbloxSM") or Instance.new("SpecialMesh")
        m.Name = "KittyKorbloxSM"
        m.MeshType = Enum.MeshType.FileMesh
        m.MeshId = "rbxassetid://101851696"
        m.TextureId = "rbxassetid://101851254"
        m.Parent = leg
    else
        local m = leg:FindFirstChild("KittyKorbloxSM")
        if m then
            pcall(m.Destroy, m)
        end
        leg.Transparency = 0
        if hum then
            pcall(function()
                local d = hum:GetAppliedDescription()
                d.RightLeg = 0
                hum:ApplyDescription(d)
            end)
        end
    end
end
