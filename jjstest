        ---------------------------------------------------------------- helpers for the settings controls
        local function round2(v)
            return math.round(v * 100) / 100
        end

        local function toggleRow(card, label, sub, get, set)
            local row = mk("TextButton", { Text = "", AutoButtonColor = false, BackgroundTransparency = 1, BorderSizePixel = 0 }, nil)
            UI.addRow(card, row, sub and UI.ROW_SUB or UI.ROW)
            mk("TextLabel", {
