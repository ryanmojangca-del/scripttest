                        if not behind(root, target) then return false, "not behind target; skill not sent" end
                        if not valid() then return false, "canceled before skill" end
                        local aim = Vector3.new(target.Position.X, root.Position.Y, target.Position.Z)
                        if (aim - root.Position).Magnitude < 0.05 then return false, "too close to aim" end
                        root.CFrame = CFrame.lookAt(root.Position, aim)
                        local cam = Workspace.CurrentCamera
                        if cam then cam.CFrame = CFrame.lookAt(cam.CFrame.Position, target.Position) end
                        CC.ChainSynthetic = true
                        -- The original physical 3 press was intercepted. Release its
                        -- virtual key state rather than waiting for the user to let go,
                        -- so the game's next key-down can be sent at dash end.
                        local phone = UIS.TouchEnabled and not UIS.KeyboardEnabled
                        if not phone and UIS:IsKeyDown(Enum.KeyCode.Three) then
                            pcall(function()
                                VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Three, false, game)
                            end)
                        end
                        local function sendThree()
                            if not phone then
                                local ok = pcall(function() VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Three, false, game) end)
                                if not ok then return false end
                                task.wait(0.04)
                                pcall(function() VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Three, false, game) end)
                                return true
                            end
                            if nativeChainInput then chainLog("mobile Skill 3 already in use"); return false end
                            local storage = game:GetService("ReplicatedStorage")
                            local keybind = storage:FindFirstChild("Keybind")
                            local combat = keybind and keybind:FindFirstChild("Combat")
                            local action = combat and combat:FindFirstChild("Skill 3")
                            if not action or not action:IsA("InputAction") then
                                chainLog("mobile Skill 3 action not found"); return false
                            end
                            local typeOk, isBool = pcall(function() return action.Type == Enum.InputActionType.Bool end)
                            local stateOk, state = pcall(function() return action:GetState() end)
                            if not typeOk or not isBool or not stateOk or state == true then
                                chainLog("mobile Skill 3 unavailable or manually held"); return false
                            end
                            local binding
                            local made, err = pcall(function()
                                binding = Instance.new("InputBinding")
                                binding.Name = "KAMUI_MobileChainBF"
                                binding.Type = Enum.InputBindingType.Scriptable
                                binding.Parent = action
                            end)
                            local sent = false
                            if made then sent, err = pcall(function() binding:Fire(true) end) end
                            if sent then
                                nativeChainInput = {action = action, binding = binding}
                            else
                                if binding then pcall(function() binding:Destroy() end) end
                                local ok, legacyErr = pcall(function() action:Fire(true) end)
                                if not ok then
                                    chainLog("mobile Skill 3 failed: " .. tostring(err) .. "; legacy: " .. tostring(legacyErr))
                                    return false
                                end
                                nativeChainInput = {action = action}
                            end
                            local own = nativeChainInput
                            task.wait(0.04)
                            if nativeChainInput == own then releaseChainInput() end
                            return true
                        end
                        if alreadyStarted then
                            chainLog("first mobile skill already started; preparing follow-up")
                        elseif dashEndedAt then
                            chainLog(string.format("starting skill %.0fms after movement", (os.clock() - dashEndedAt) * 1000))
                        else
                            chainLog("already behind; starting skill")
                        end
                        if not alreadyStarted then seenSkill = false end
                        local currentInfo = char:FindFirstChild("Info")
                        if currentInfo and currentInfo:FindFirstChild("InSkill") then seenSkill = true end
                        if not alreadyStarted then
                            strikeDamage = false
                            lastHealth = targetHum.Health
                            observingDamage = true
                        end
                        -- The physical mobile tap already sent the first skill;
                        -- do not send an extra first press on that strike.
                        local first = alreadyStarted or sendThree()
                        local nextAt = alreadyStarted and (mobileStartAt + CC.AutoBFDelay)
                            or (os.clock() + math.max(0, CC.AutoBFDelay - 0.04))
                        while valid() and os.clock() < nextAt do task.wait() end
                        if not first or not valid() then
                            CC.ChainSynthetic = false; return false, "canceled before BF follow-up"
                        end
                        if alreadyStarted and char:GetAttribute("FlashTime") == nil then
                            CC.ChainSynthetic = false; return false, "mobile follow-up missed: FlashTime already cleared"
                        end
                        if alreadyStarted then
                            chainLog(string.format("mobile follow-up %.2fs after touch", os.clock() - mobileStartAt))
                        end
                        local second = sendThree()
                        task.wait(0.06)
                        CC.ChainSynthetic = false
                        if not second then return false, "failed to send follow-up on strike " .. strike end
                        chainLog("strike " .. strike .. " sent; waiting for skill to finish")

                        -- InSkill was observed in diagnostics, but is not a guaranteed
                        -- Black Flash success signal. Never send the next strike while
                        -- this move is still active; abort if its end isn't observed.
                        local deadline = os.clock() + 6
                        local finished = false
                        while valid() and os.clock() < deadline do
                            local skillInfo = char:FindFirstChild("Info")
                            local marker = skillInfo and skillInfo:FindFirstChild("InSkill")
                            if marker then seenSkill = true end
                            if seenSkill and not marker then finished = true; break end
                            RunService.Heartbeat:Wait()
                        end
                        if not valid() then return false, "chain canceled" end
                        if not finished then return false, "strike " .. strike .. ": skill end not observed" end
                        do
                            -- Allow the replicated cooldown to settle before deciding
                            -- whether the next attempt or feint is available.
                            local settleUntil = os.clock() + 0.12
                            while valid() and os.clock() < settleUntil do RunService.Heartbeat:Wait() end
                            if not valid() then return false, "chain canceled" end
                            local nextReady = move:GetAttribute("ReadyAt")
                            observingDamage = false
                            -- Target health loss is only a proxy for our hit, not
                            -- definitive attribution or proof of a Black Flash.
                            if CC.FeintMode and strikeDamage and type(nextReady) == "number" then
                                observedHits = observedHits + 1
                                chainLog("observed hit evidence " .. observedHits .. "/2")
                            elseif CC.FeintMode then
                                chainLog("strike " .. strike .. ": hit not confirmed")
                            end
                            if type(nextReady) == "number" and nextReady > Workspace:GetServerTimeNow() + 0.15 then
                                if not CC.FeintMode and strike >= 4 then
                                    return true, "four Black Flash attempts sent"
                                end
                                return false, "Divergent Fist is on cooldown; press 3 again when ready"
                            end
                            if CC.FeintMode and observedHits >= 2 then
                                    local rAction
                                    if phone then
                                        local reason
                                        rAction, reason = findRAction()
                                        if not rAction then return false, "mobile feint: " .. tostring(reason) end
                                        chainLog("mobile feint using Special")
                                    end
                                    chainLog("two hits observed; sending feint 3 + R")
                                    CC.ChainSynthetic = true
                                    local started = sendThree()
                                    if not started or not valid() then
                                        CC.ChainSynthetic = false; return false, "feint canceled before R"
                                    end
                                    local rDown, rUp
                                    if phone then
                                        local reason
                                        rDown, reason = sendMobileFeintAction(rAction)
                                        rUp = rDown
                                        if not rDown then chainLog("mobile feint R failed: " .. tostring(reason)) end
                                    else
                                        rDown = pcall(function()
                                            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.R, false, game)
                                        end)
                                        task.wait(0.04)
                                        rUp = pcall(function()
                                            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.R, false, game)
                                        end)
                                    end
                                    CC.ChainSynthetic = false
                                    if not rDown or not rUp then return false, "feint R input failed" end
                                    chainLog("feint sent; waiting 0.5s")
                                    local resumeAt = os.clock() + 0.5
                                    while valid() and os.clock() < resumeAt do RunService.Heartbeat:Wait() end
                                    if not valid() then return false, "chain canceled after feint" end
                                    -- If the game's skill marker has not cleared yet,
                                    -- avoid firing the next attack into the feint.
                                    local clearBy = os.clock() + 1
                                    local function feintBusy()
                                        local current = char:FindFirstChild("Info")
                                        return current and current:FindFirstChild("InSkill")
                                    end
                                    while valid() and feintBusy() and os.clock() < clearBy do
                                        RunService.Heartbeat:Wait()
                                    end
                                    if not valid() then return false, "chain canceled after feint" end
                                    if feintBusy() then return false, "feint still active; chain stopped" end
                                    observedHits = 0
                            end
                        end
                        if not CC.FeintMode and strike >= 4 then
                            return true, "four Black Flash attempts sent"
                        end
                    end
                    return false, "chain canceled"
                end
                -- Always clear chainBusy and tracking if an unexpected error
                -- occurs inside the movement/skill cycle.
                local ok, _, message = pcall(runCycle)
                CC.ChainSynthetic = false
                if not ok then
                    stop("error: " .. tostring(_))
                else
                    stop(message or "loop stopped")
                end
            end)
        end
        if _G.KAMUI_ChainCleanup then pcall(_G.KAMUI_ChainCleanup) end
        CAS:BindActionAtPriority(actionName, function(_, state)
            if not isCurrent() or not ScreenGui.Parent or CC.AutoBFMode ~= "Vessel"
                or not CC.ChainMode or UIS:GetFocusedTextBox()
                or CC.ChainSynthetic then return Enum.ContextActionResult.Pass end
            local char = player.Character
            if not char or not getMove(char) then return Enum.ContextActionResult.Pass end
            if state == Enum.UserInputState.Begin then beginChain() end
            return Enum.ContextActionResult.Sink
        end, false, Enum.ContextActionPriority.High.Value + 1000, Enum.KeyCode.Three)
        -- A recent physical touch plus FlashTime creation is the same
        -- best-effort mobile signal used by normal Vessel Auto BF. It does not
        -- intercept the game's button: the first skill is already running.
        local mobileTouchAt, mobileTouchSerial, consumedTouch = -math.huge, 0, 0
        local chainFlashConn
        local chainTouchConn = UIS.TouchStarted:Connect(function()
            if not isCurrent() or not ScreenGui.Parent or not UIS.TouchEnabled or UIS.KeyboardEnabled
                or CC.AutoBFMode ~= "Vessel" or not CC.ChainMode or chainBusy
                or UIS:GetFocusedTextBox() then return end
            mobileTouchSerial = mobileTouchSerial + 1
            mobileTouchAt = os.clock()
        end)
        local function bindMobileChainCharacter(char)
            if chainFlashConn then chainFlashConn:Disconnect(); chainFlashConn = nil end
            consumedTouch = mobileTouchSerial
            local previous = char:GetAttribute("FlashTime")
            chainFlashConn = char:GetAttributeChangedSignal("FlashTime"):Connect(function()
                local old, value = previous, char:GetAttribute("FlashTime")
                previous = value
                local now = os.clock()
                if not isCurrent() or not ScreenGui.Parent or player.Character ~= char
                    or not UIS.TouchEnabled or UIS.KeyboardEnabled or CC.AutoBFMode ~= "Vessel"
                    or not CC.ChainMode or chainBusy or CC.ChainSynthetic or UIS:GetFocusedTextBox()
                    or old ~= nil or value ~= 0 or mobileTouchSerial == consumedTouch
                    or now - mobileTouchAt > 0.60 or not getMove(char) then return end
                consumedTouch = mobileTouchSerial
                chainLog(string.format("mobile FlashTime detected %.2fs after touch", now - mobileTouchAt))
                beginChain(mobileTouchAt)
            end)
        end
        local chainCharacterConn = player.CharacterAdded:Connect(bindMobileChainCharacter)
        if player.Character then bindMobileChainCharacter(player.Character) end
        local function cleanupChain()
            pcall(function() CAS:UnbindAction(actionName) end)
            chainTouchConn:Disconnect()
            chainCharacterConn:Disconnect()
            if chainFlashConn then chainFlashConn:Disconnect(); chainFlashConn = nil end
            releaseChainInput()
            CC.ChainMode = false
            CC.ChainEpoch = CC.ChainEpoch + 1
            CC.BFTrackToken = CC.BFTrackToken + 1
            CC.BFTrackTarget = nil
            if CC.TargetLockRelease then CC.TargetLockRelease() end
        end
        _G.KAMUI_ChainCleanup = cleanupChain
        ScreenGui.Destroying:Connect(cleanupChain)
        -- Observe the normal game dash on touch devices. No virtual keyboard/mouse
        -- input or synthetic touch is sent by this mobile path.
        local observedMover
        local nativeDashConn
        nativeDashConn = RunService.Heartbeat:Connect(function()
            if not isCurrent() or not page.Parent then
                nativeDashConn:Disconnect()
                return
            end
            if not (SA.Enabled and SA.Mobile and UIS.TouchEnabled) then
                observedMover = nil
                return
            end
            local char = player.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            local mover = root and findMover(root) or nil
            if mover == observedMover then return end
            observedMover = mover
            if mover and not SA.Busy and (os.clock() - (_G.KAMUI_ScriptDashAt or -math.huge)) > 0.8 then
                dashOnce(mover)
            end
        end)
        UIS.InputBegan:Connect(function(input, processed)
            if not isCurrent() or input.UserInputType ~= Enum.UserInputType.Keyboard then return end
            if capturingKey then
                capturingKey = false
                if input.KeyCode ~= Enum.KeyCode.Escape and input.KeyCode ~= Enum.KeyCode.Unknown then
                    SA.Key = input.KeyCode.Name
                end
                key.Text = SA.Key
                return
            end
            if processed or UIS:GetFocusedTextBox() then return end
            if input.KeyCode.Name == SA.Key then dashOnce() end
        end)
    end
end

--// MOVEMENT TAB CONTENT: Dash multiplier (toggle + Distance slider)
_G.KAMUI_BuildMovement = function(UI)
    local G = _G.KAMUI_MovementTab
    local page = G and G.Page
    if not page then
        return
    end
    UI.setupPage(page)
    local M = _G.KAMUI_Movement
    local CHIP = UI.CHIP
    local conns = _G.KAMUI_MovementConns or {}
    _G.KAMUI_MovementConns = conns

    local function mk(class, props, parent)
        local o = UI.make(class, props, parent)
        o:SetAttribute("KamuiSkinned", true)
        return o
    end
    local function round2(v)
        return math.round(v * 100) / 100
    end

    --// slider row: label (+ optional small text under it), bar, value you can tap and type into.
    --// o = { label, sub, get, set, min, max, step, snap, snapZone, isOn }
    local function makeSlider(card, o)
        local hasSub = o.sub ~= nil
        local row = mk("Frame", { BackgroundTransparency = 1, BorderSizePixel = 0 }, nil)
        UI.addRow(card, row, hasSub and UI.ROW_SUB or UI.ROW)
        mk("TextLabel", {
            Name = "RowLabel",
            BackgroundTransparency = 1,
            Position = UDim2.new(0, 12, 0, hasSub and 5 or 0),
            Size = hasSub and UDim2.new(0.5, -12, 0, 20) or UDim2.new(0.5, -12, 1, 0),
            Font = Enum.Font.GothamMedium,
            TextSize = 12,
            TextColor3 = THEME.Text,
            TextXAlignment = Enum.TextXAlignment.Left,
            Text = o.label
        }, row)
        if hasSub then
            mk("TextLabel", {
                Name = "RowSub",
                BackgroundTransparency = 1,
                Position = UDim2.new(0, 12, 0, 24),
                Size = UDim2.new(0.5, -12, 0, 14),
                Font = Enum.Font.Gotham,
                TextSize = 11,
                TextColor3 = THEME.MutedText,
                TextXAlignment = Enum.TextXAlignment.Left,
                TextTruncate = Enum.TextTruncate.AtEnd,
                Text = o.sub
            }, row)
        end
        local back = mk("Frame", {
            Name = "SliderBack",
            BackgroundColor3 = CHIP,
            BorderSizePixel = 0,
            Position = UDim2.new(0.52, 0, 0.5, -3),
            Size = UDim2.new(0.28, 0, 0, 6)
        }, row)
        UI.corner(back, 3)
        back:SetAttribute("KamuiNoDrag", true)
        local fill = mk("Frame", {
            BackgroundColor3 = THEME.Red,
            BorderSizePixel = 0,
            Size = UDim2.new(0, 0, 1, 0)
        }, back)
        UI.corner(fill, 3)
        --// the value is a TextBox: tap the number and type an exact value
        local box = mk("TextBox", {
            Name = "ValueBox",
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            AnchorPoint = Vector2.new(1, 0.5),
            Position = UDim2.new(1, -12, 0.5, 0),
            Size = UDim2.new(0.18, 0, 0, 24),
            Font = Enum.Font.RobotoMono,
            TextSize = 12,
            TextColor3 = THEME.BrightRed,
            TextXAlignment = Enum.TextXAlignment.Right,
            ClearTextOnFocus = false,
            Text = ""
        }, row)
        box:SetAttribute("KamuiNoDrag", true)

        local function paint()
            local v = o.get()
            fill.Size = UDim2.new(math.clamp((v - o.min) / (o.max - o.min), 0, 1), 0, 1, 0)
            local on = o.isOn == nil or o.isOn()
            fill.BackgroundColor3 = on and THEME.Red or THEME.OffRed
            box.TextColor3 = on and THEME.BrightRed or THEME.MutedText
            if not box:IsFocused() then
                box.Text = string.format(o.fmt or "%.2fx", v)
            end
        end
        paint()

        local hit = mk("TextButton", {
            Name = "SliderHit",
            BackgroundTransparency = 1,
            Text = "",
            Position = UDim2.new(0.5, 0, 0, 0),
            Size = UDim2.new(0.32, 0, 1, 0)
        }, row)
        hit:SetAttribute("KamuiNoDrag", true)
        local dragging, dragInput = false, nil
        local function fromX(x)
            local a = math.clamp((x - back.AbsolutePosition.X) / math.max(1, back.AbsoluteSize.X), 0, 1)
            local v = round2(math.round((o.min + a * (o.max - o.min)) / o.step) * o.step)
            if o.snap and math.abs(v - o.snap) < o.snapZone then
                v = o.snap -- sticks to normal (1.00x)
            end
            o.set(math.clamp(v, o.min, o.max))
            paint()
        end
        hit.InputBegan:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                dragging, dragInput = true, i
                _G.KAMUI_SliderHeld = true
                fromX(i.Position.X)
            end
        end)
        conns[#conns + 1] = UIS.InputChanged:Connect(function(i)
            if not dragging or not isCurrent() then
                return
            end
            --// follow only the finger/button that started the drag (other touches are ignored)
            if i == dragInput
                or (i.UserInputType == Enum.UserInputType.MouseMovement
                    and dragInput.UserInputType == Enum.UserInputType.MouseButton1) then
                fromX(i.Position.X)
            end
        end)
        conns[#conns + 1] = UIS.InputEnded:Connect(function(i)
            if dragging and (i == dragInput or i.UserInputType == Enum.UserInputType.MouseButton1) then
                dragging, dragInput = false, nil
                _G.KAMUI_SliderHeld = false
            end
        end)

        --// manual entry: "2.5", "2,5" and "2.5x" all work; out-of-range values are clamped
        box.Focused:Connect(function()
            box.Text = string.format("%g", o.get())
        end)
        box.FocusLost:Connect(function()
            local txt = box.Text:gsub(",", "."):gsub("[xXmMsS%s]", "")
            local n = tonumber(txt)
            if n then
                o.set(math.clamp(round2(n), o.min, o.max))
            end
            paint()
        end)
        return paint
    end

