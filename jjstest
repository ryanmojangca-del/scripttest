        local function slider(card, label, sub, key, step, fmt, isOn)
            return sliderRow(card, {
                label = label, sub = sub,
                get = function() return CFG[key] end,
                set = function(v)
                    CFG[key] = v
                    changed()
                end,
                min = RANGE[key][1], max = RANGE[key][2], step = step, fmt = fmt, isOn = isOn
            })
        end

        local function toggle(card, label, sub, key)
            return toggleRow(card, label, sub, function() return CFG[key] end, function(v)
                CFG[key] = v
                changed()
            end)
        end

