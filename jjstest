                end
                task.delay(0.04, function()
                    pcall(function() VirtualInputManager:SendKeyEvent(false, key, false, game) end)
                    task.delay(0.05, function() synthetic = false end)
                end)
                log(string.format("sent second 3 after %.2fs; result depends on timing", delaySeconds))
