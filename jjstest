                local typeOk, isBool = pcall(function() return action.Type == Enum.InputActionType.Bool end)
                if not typeOk or not isBool then
                    blockLog("native Block action is not Bool")
                    return false
                end
                local stateOk, state = pcall(function() return action:GetState() end)
                if not stateOk then
                    blockLog("native GetState failed: " .. tostring(state))
                    return false
                end
                if state == true then
                    -- Do not take ownership or release a manually-held block.
                    blockLog("native block already held; leaving it alone")
                    return false
                end
                -- Use Roblox's scriptable binding API, never alter the game's
                -- own Keyboard/Gamepad bindings. Older clients may lack it.
                local binding
                local bindingOk, bindingErr = pcall(function()
                    binding = Instance.new("InputBinding")
                    binding.Name = "KAMUI_AutoBlock"
                    binding.Type = Enum.InputBindingType.Scriptable
                    binding.Parent = action
                end)
                if bindingOk then
                    local ok, err = pcall(function() binding:Fire(true) end)
                    if ok then
                        nativeBlock = {action = action, binding = binding, method = "binding"}
                        local readOk, newState = pcall(function() return action:GetState() end)
                        blockLog("native binding press sent; state=" .. (readOk and tostring(newState) or "unavailable"))
                        return true
                    end
                    bindingErr = err
                end
                if binding then pcall(function() binding:Destroy() end) end
                -- Documented legacy fallback for Roblox versions without
                -- Scriptable bindings. It is deprecated and may be unavailable.
                local ok, err = pcall(function() action:Fire(true) end)
                if not ok then
                    blockLog("native press failed: " .. tostring(bindingErr) .. "; legacy: " .. tostring(err))
                    return false
                end
                nativeBlock = {action = action, method = "action"}
                local readOk, newState = pcall(function() return action:GetState() end)
                blockLog("native legacy press sent; state=" .. (readOk and tostring(newState) or "unavailable"))
                return true
            end
            if UIS:IsKeyDown(Enum.KeyCode.F) then
                blockLog("F already held; leaving it alone")
                return true
            end
            local ok, err = pcall(function()
                VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.F, false, game)
            end)
            syntheticBlockHeld = ok
            if ok then blockLog("virtual F press sent")
            else blockLog("virtual F press failed: " .. tostring(err)) end
            return ok
        end
        if nativeBlock then
            local own = nativeBlock
            nativeBlock = nil
            local ok, err = pcall(function()
                if own.method == "binding" then own.binding:Fire(false) else own.action:Fire(false) end
            end)
            if own.binding then pcall(function() own.binding:Destroy() end) end
            if ok then blockLog("native release sent")
            else blockLog("native release failed: " .. tostring(err)) end
        end
        if syntheticBlockHeld then
            syntheticBlockHeld = false
            local ok, err = pcall(function()
                VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.F, false, game)
            end)
            if not ok then blockLog("virtual F release failed: " .. tostring(err)) end
        end
        return true
    end
