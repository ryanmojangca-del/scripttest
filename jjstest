        local key = Enum.KeyCode.Three
        local function log(message)
            print("[KAMUI Auto BF] " .. message)
            if _G.KAMUI_ParkourDiagnostic then _G.KAMUI_ParkourDiagnostic("BF: " .. message) end
        end
        local function logTools(char)
            local backpack = player:FindFirstChildOfClass("Backpack")
            local containers = { char }
            if backpack then containers[#containers + 1] = backpack end
            local names = {}
            for _, container in ipairs(containers) do
                for _, obj in ipairs(container:GetChildren()) do
                    if obj:IsA("Tool") then names[#names + 1] = obj.Name end
                end
            end
            log("Moveset=" .. tostring(char:GetAttribute("Moveset")))
            log("Tools=" .. (#names > 0 and table.concat(names, ", ") or "none"))
        end
        local function findDivergentFist(char)
            -- JJS stores this move under a character Moveset container, not
            -- necessarily as a Roblox Tool (as seen in the diagnostic).
            local moveset = char:FindFirstChild("Moveset", true)
            if moveset then
                for _, obj in ipairs(moveset:GetChildren()) do
                    local name = string.lower(obj.Name):gsub("[^%w]", "")
                    if name == "divergentfist" then return obj end
                end
            end
            -- Older game versions may expose the move as a Tool instead.
            local backpack = player:FindFirstChildOfClass("Backpack")
            local containers = {char}
            if backpack then containers[#containers + 1] = backpack end
            for _, container in ipairs(containers) do
                for _, obj in ipairs(container:GetChildren()) do
                    if obj:IsA("Tool") then
                        local name = string.lower(obj.Name):gsub("[^%w]", "")
                        if name == "divergentfist" then return obj end
                    end
                end
            end
        end
        local conn = UIS.InputBegan:Connect(function(input)
            if input.UserInputType ~= Enum.UserInputType.Keyboard or input.KeyCode ~= key then return end
            if not alive or not isCurrent() or not ScreenGui.Parent then return end
            if synthetic or CC.ChainSynthetic or CC.ChainMode or CC.AutoBFMode ~= "Vessel" then return end
            log("3 pressed; enabled=" .. tostring(CC.AutoBF)
                .. "; textbox=" .. tostring(UIS:GetFocusedTextBox() ~= nil))
            if UIS:GetFocusedTextBox() then return end
            if not CC.AutoBF then return end
