--// WALL-JUMP DIAGNOSTIC: local observation only. Never changes movement.
do
    local frame = Instance.new("Frame")
    frame.Name = "KAMUI_WallJumpDiagnostic"
    frame.Size = UDim2.fromOffset(560, 310)
    frame.Position = UDim2.fromOffset(18, 110)
    frame.BackgroundColor3 = Color3.fromRGB(14, 14, 18)
    frame.BorderSizePixel = 0
    frame.Active, frame.Draggable = true, true
    frame.ZIndex = 100
    frame.Parent = RestoreGui
    applyCorner(frame, 9)
    local outline = Instance.new("UIStroke")
    outline.Color, outline.Thickness, outline.Parent = Color3.fromRGB(210, 24, 30), 1, frame
    local title = Instance.new("TextLabel")
    title.Size, title.Position = UDim2.new(1, -120, 0, 27), UDim2.fromOffset(10, 3)
    title.BackgroundTransparency, title.TextXAlignment = 1, Enum.TextXAlignment.Left
    title.Font, title.TextSize, title.TextColor3 = Enum.Font.Code, 14, Color3.fromRGB(245, 245, 245)
    title.Text, title.ZIndex, title.Parent = "KAMUI - MOBILE AUTO QTE", 101, frame
    local body = Instance.new("TextLabel")
    body.Size, body.Position = UDim2.new(1, -20, 1, -39), UDim2.fromOffset(10, 34)
    body.BackgroundTransparency, body.TextColor3 = 1, Color3.fromRGB(235, 235, 235)
    body.Font, body.TextSize, body.TextWrapped = Enum.Font.Code, 12, true
    body.TextXAlignment, body.TextYAlignment = Enum.TextXAlignment.Left, Enum.TextYAlignment.Top
    body.ZIndex, body.Parent = 101, frame
    local lines, allConns, charConns = {}, {}, {}
    local attempts, parkourSounds, changes, stopped = 0, 0, 0, false
    local function refresh()
        body.Text = string.format("Space presses: %d | Parkour sounds: %d | value changes: %d\n", attempts, parkourSounds, changes)
            .. table.concat(lines, "\n")
    end
    local function log(text)
        if stopped or not isCurrent() then return end
        -- SwingForce is updated every frame and buried the Auto BF messages.
        if tostring(text):find("Value SwingForce/", 1, true)
            or tostring(text):find("Value MovementForce/", 1, true) then return end
        lines[#lines + 1] = tostring(text)
        while #lines > 14 do table.remove(lines, 1) end
        refresh()
    end
    -- Infinite Parkour writes its decisions into the existing diagnostic window.
    _G.KAMUI_ParkourDiagnostic = log
    local function button(text, x)
        local b = Instance.new("TextButton")
        b.Size, b.Position = UDim2.fromOffset(46, 24), UDim2.new(1, x, 0, 5)
        b.BackgroundColor3, b.TextColor3 = Color3.fromRGB(44, 20, 23), Color3.fromRGB(255, 255, 255)
        b.Font, b.TextSize, b.Text, b.ZIndex, b.Parent = Enum.Font.GothamMedium, 12, text, 102, frame
        applyCorner(b, 5)
        return b
    end
    local function disconnect(list)
        for _, c in ipairs(list) do pcall(function() c:Disconnect() end) end
        table.clear(list)
    end
    local function stop()
        if stopped then return end
        stopped = true
        if _G.KAMUI_ParkourDiagnostic == log then _G.KAMUI_ParkourDiagnostic = nil end
        disconnect(charConns); disconnect(allConns)
        if frame.Parent then frame:Destroy() end
    end
    local clear, close = button("Clear", -102), button("X", -52)
    allConns[#allConns + 1] = clear.Activated:Connect(function()
        attempts, parkourSounds, changes = 0, 0, 0
        table.clear(lines)
        log("Cleared. Perform the action you want to test.")
    end)
    allConns[#allConns + 1] = close.Activated:Connect(stop)
    local function scalar(value)
        return type(value) == "number" or type(value) == "boolean"
    end
    local function shortName(obj)
        local parent = obj.Parent
        return (parent and parent.Name or "?") .. "/" .. obj.Name
    end
    local function watchAttributes(obj, bucket)
        local previous = obj:GetAttributes()
        bucket[#bucket + 1] = obj.AttributeChanged:Connect(function(name)
            if stopped or not isCurrent() then return end
            local value, old = obj:GetAttribute(name), previous[name]
            previous[name] = value
            if scalar(value) or scalar(old) then
                changes = changes + 1
                log("Attr " .. shortName(obj) .. "." .. name .. ": " .. tostring(old) .. " -> " .. tostring(value))
            end
        end)
    end
    watchAttributes(player, allConns)
    local function bindCharacter(char)
        disconnect(charConns)
        local watched = setmetatable({}, { __mode = "k" })
        local function watch(obj)
            if watched[obj] then return end
            watched[obj] = true
            watchAttributes(obj, charConns)
            if obj:IsA("IntValue") or obj:IsA("NumberValue") or obj:IsA("BoolValue") then
                local last = obj.Value
                charConns[#charConns + 1] = obj:GetPropertyChangedSignal("Value"):Connect(function()
                    if stopped or not isCurrent() or player.Character ~= char then return end
                    local value = obj.Value
                    changes = changes + 1
                    log("Value " .. shortName(obj) .. ": " .. tostring(last) .. " -> " .. tostring(value))
                    last = value
                end)
            end
        end
        watch(char)
        for _, obj in ipairs(char:GetDescendants()) do watch(obj) end
        charConns[#charConns + 1] = char.DescendantAdded:Connect(function(obj)
            if stopped or not isCurrent() then return end
            watch(obj)
            if string.lower(obj.Name):find("parkour", 1, true) and obj:IsA("Sound") then
                parkourSounds = parkourSounds + 1
                log("Parkour sound appeared")
            elseif obj:IsA("IntValue") or obj:IsA("NumberValue") or obj:IsA("BoolValue") then
                changes = changes + 1
                log("Value added " .. shortName(obj) .. "=" .. tostring(obj.Value))
            end
        end)
        charConns[#charConns + 1] = char.DescendantRemoving:Connect(function(obj)
            if stopped or not isCurrent() then return end
            if obj:IsA("IntValue") or obj:IsA("NumberValue") or obj:IsA("BoolValue") then
                changes = changes + 1
                log("Value removed " .. shortName(obj))
            end
        end)
        log("Character ready. Press Clear before the test.")
    end
    allConns[#allConns + 1] = UIS.InputBegan:Connect(function(input)
        if not isCurrent() or UIS:GetFocusedTextBox() then return end
        if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == Enum.KeyCode.Space then
            attempts = attempts + 1
            log("Space #" .. attempts)
        end
    end)
    allConns[#allConns + 1] = player.CharacterAdded:Connect(bindCharacter)
    allConns[#allConns + 1] = RestoreGui.Destroying:Connect(stop)
    if player.Character then bindCharacter(player.Character) else log("Waiting for character.") end
end
