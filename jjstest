            local action = combat and combat:FindFirstChild("Special")
            if action and action:IsA("InputAction") then return action end
            return nil, "Combat Special InputAction not found"
        end
        local function sendMobileFeintAction(action)
            if nativeChainInput then return false, "another Chain input is held" end
            if not action or not action.Parent then return false, "R action unavailable" end
            local typeOk, isBool = pcall(function() return action.Type == Enum.InputActionType.Bool end)
            local stateOk, state = pcall(function() return action:GetState() end)
            if not typeOk or not isBool or not stateOk then return false, "R action type/state unavailable" end
            if state == true then return false, "R action manually held" end
            local binding
            local made, err = pcall(function()
                binding = Instance.new("InputBinding")
                binding.Name = "KAMUI_MobileChainFeint"
                binding.Type = Enum.InputBindingType.Scriptable
                binding.Parent = action
            end)
            local sent = false
            if made then sent, err = pcall(function() binding:Fire(true) end) end
            if sent then
                nativeChainInput = {action = action, binding = binding}
            else
                if binding then pcall(function() binding:Destroy() end) end
                local ok, legacyErr = pcall(function() action:Fire(true) end)
                if not ok then return false, tostring(err) .. "; legacy: " .. tostring(legacyErr) end
                nativeChainInput = {action = action}
            end
