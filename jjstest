        get = function() return M.FakeLagMs end,
        set = function(v)
            M.FakeLagMs = math.clamp(math.floor(v + 0.5), 50, 5000)
            M.FakeLagApply()
        end,
        min = 50, max = 5000, step = 10,
        fmt = "%.0fms",
        isOn = function() return M.FakeLag end
