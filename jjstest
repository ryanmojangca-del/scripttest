    local function startCounter(plr, track)
        if counterActive or counterKeyHeld or UIS:GetFocusedTextBox() then return end
        local slot = CC.CounterMode == "Vessel" and 4 or 3
        local key = slot == 4 and Enum.KeyCode.Four or Enum.KeyCode.Three
        local phone = UIS.TouchEnabled and not UIS.KeyboardEnabled
