            OPT.Font[#OPT.Font + 1] = fam.name
        end
        local NAMES = {
            Corner = { TR = "Top right", TL = "Top left", BR = "Bottom right", BL = "Bottom left" }
        }
        local RANGE = {
            OffX = { 0, 1200 }, OffY = { 0, 800 }, Size = { 8, 24 }, Spacing = { 0, 8 }, Pad = { 2, 14 },
            BGTrans = { 0, 1 }, BarThick = { 1, 6 }, Radius = { 0, 10 }, AnimSpeed = { 0.25, 3 }
        }
        local MODS = {
            { "aimbot", "Aimbot" }, { "block", "Auto block" }, { "dashassist", "Dash Assist" },
            { "dashmult", "Dash multiplier" }, { "nosidecd", "No side dash cooldown" }, { "nostun", "No stun" },
            { "walkjump", "WalkSpeed / Jump height" }, { "fakelag", "Fake lag" },
            { "fps", "FPS boost" }, { "headless", "Headless & Korblox" }
        }

        local CFG, hidden = {}, {}
        for k, v in pairs(DEF) do
            CFG[k] = v
        end
        do
            local saved = _G.KAMUI_ArraylistSaved
            if type(saved) == "table" then
                for k, dv in pairs(DEF) do
                    local sv = saved[k]
                    if type(sv) == type(dv) then
                        if OPT[k] then
                            if table.find(OPT[k], sv) then
                                CFG[k] = sv
                            end
                        elseif RANGE[k] then
                            CFG[k] = math.clamp(sv, RANGE[k][1], RANGE[k][2])
                        else
                            CFG[k] = sv
                        end
                    end
                end
                if type(saved.Hidden) == "table" then
                    for k, v in pairs(saved.Hidden) do
                        if v == true then
                            hidden[k] = true
                        end
                    end
                end
                if type(saved.On) == "boolean" then
                    _G.KAMUI_ArraylistOn = saved.On
                end
            end
        end
        _G.KAMUI_ArraylistCfg = CFG
        _G.KAMUI_ArraylistSnapshot = function()
            local t = {}
            for k in pairs(DEF) do
                t[k] = CFG[k]
            end
            t.Hidden = hidden
            t.On = _G.KAMUI_ArraylistOn == true
            return t
        end

