    -- Mobile Vessel, Chain OFF. In the mobile trace, FlashTime appeared near
    -- the initial touch, whereas ReadyAt changed only after the move ended.
    -- Use the former as a best-effort start signal, never the cooldown update.
    do
        local alive, pending = true, false
        local generation, touchSerial, consumedTouch = 0, 0, 0
        local lastTouchAt = -math.huge
        local characterConn, flashConn, touchConn, held = nil, nil, nil, nil
        local previousCancel = CC.AutoBFCancel
        local function log(message)
            print("[KAMUI Mobile BF] " .. message)
            if _G.KAMUI_ParkourDiagnostic then _G.KAMUI_ParkourDiagnostic("Mobile BF: " .. message) end
        end
        local function releaseHeld()
            local own = held
            if not own then return end
            held = nil
            local ok, err = pcall(function()
                if own.binding then own.binding:Fire(false) else own.action:Fire(false) end
            end)
            if own.binding then pcall(function() own.binding:Destroy() end) end
            if not ok then log("follow-up release failed: " .. tostring(err)) end
        end
        local function cancel()
            pending = false
            generation = generation + 1
            releaseHeld()
            if previousCancel then previousCancel() end
        end
        CC.AutoBFCancel = cancel
        local function findMove(char)
            if not char then return nil end
            local moveset = char:FindFirstChild("Moveset", true)
            if moveset then
                for _, obj in ipairs(moveset:GetChildren()) do
                    if string.lower(obj.Name):gsub("[^%w]", "") == "divergentfist" then return obj end
                end
            end
            local backpack = player:FindFirstChildOfClass("Backpack")
            for _, container in ipairs(backpack and {char, backpack} or {char}) do
                for _, obj in ipairs(container:GetChildren()) do
                    if obj:IsA("Tool") and string.lower(obj.Name):gsub("[^%w]", "") == "divergentfist" then return obj end
                end
            end
        end
        local function getAction()
            local storage = game:GetService("ReplicatedStorage")
            local keybind = storage:FindFirstChild("Keybind")
            local combat = keybind and keybind:FindFirstChild("Combat")
            local action = combat and combat:FindFirstChild("Skill 3")
            return action and action:IsA("InputAction") and action or nil
        end
        local function active()
            return alive and isCurrent() and ScreenGui.Parent ~= nil
                and UIS.TouchEnabled and not UIS.KeyboardEnabled
                and CC.AutoBF and CC.AutoBFMode == "Vessel" and not CC.ChainMode
                and not CC.Counter and not UIS:GetFocusedTextBox()
        end
        touchConn = UIS.TouchStarted:Connect(function()
            if not active() then return end
            touchSerial = touchSerial + 1
            lastTouchAt = os.clock()
        end)
        local function bindCharacter(char)
            if flashConn then flashConn:Disconnect(); flashConn = nil end
            cancel()
            consumedTouch = touchSerial
            local previous = char:GetAttribute("FlashTime")
            flashConn = char:GetAttributeChangedSignal("FlashTime"):Connect(function()
                local old, value = previous, char:GetAttribute("FlashTime")
                previous = value
                -- Only a newly created FlashTime matching a recent, unconsumed
                -- physical touch can start one attempt. This prevents ReadyAt or
                -- our own follow-up alone from creating a self-triggering loop.
                local now = os.clock()
                if not active() or player.Character ~= char or pending or old ~= nil
                    or value ~= 0 or touchSerial == consumedTouch or now - lastTouchAt > 0.60 then return end
                local hum = char:FindFirstChildOfClass("Humanoid")
                local move = findMove(char)
                if not hum or hum.Health <= 0 or not move then return end
                local touchAt = lastTouchAt
                consumedTouch = touchSerial
                pending = true
                generation = generation + 1
                local myGeneration, epoch = generation, CC.AutoBFEpoch
                local delaySeconds = CC.AutoBFDelay
                local waitTime = math.max(0, touchAt + delaySeconds - now)
                log(string.format("FlashTime detected %.2fs after touch; follow-up in %.2fs", now - touchAt, waitTime))
                task.delay(waitTime, function()
                    if not active() or not pending or generation ~= myGeneration or CC.AutoBFEpoch ~= epoch
                        or player.Character ~= char or not hum.Parent or hum.Health <= 0
                        or findMove(char) ~= move then
                        if generation == myGeneration then pending = false end
                        return
                    end
                    pending = false
                    if char:GetAttribute("FlashTime") == nil then
                        log("follow-up canceled: FlashTime already cleared"); return
                    end
                    local action = getAction()
                    if not action then log("Skill 3 InputAction not found"); return end
                    local typeOk, isBool = pcall(function() return action.Type == Enum.InputActionType.Bool end)
                    local stateOk, state = pcall(function() return action:GetState() end)
                    if not typeOk or not isBool or not stateOk then
                        log("Skill 3 action type/state unavailable"); return
                    end
                    if state == true then log("Skill 3 still held; follow-up not sent"); return end
                    local binding
                    local made, err = pcall(function()
                        binding = Instance.new("InputBinding")
                        binding.Name = "KAMUI_MobileAutoBF"
                        binding.Type = Enum.InputBindingType.Scriptable
                        binding.Parent = action
                    end)
                    local sent = false
                    if made then sent, err = pcall(function() binding:Fire(true) end) end
                    if sent then
                        held = {action = action, binding = binding}
                    else
                        if binding then pcall(function() binding:Destroy() end) end
                        local ok, legacyErr = pcall(function() action:Fire(true) end)
                        if not ok then
                            log("follow-up failed: " .. tostring(err) .. "; legacy: " .. tostring(legacyErr))
                            return
                        end
                        held = {action = action}
                    end
                    local own = held
                    log(string.format("second Skill 3 sent %.2fs after touch; result depends on timing", os.clock() - touchAt))
                    task.delay(0.04, function() if held == own then releaseHeld() end end)
                end)
            end)
        end
        characterConn = player.CharacterAdded:Connect(bindCharacter)
        if player.Character then bindCharacter(player.Character) end
        ScreenGui.Destroying:Connect(function()
            alive = false
            cancel()
            if touchConn then touchConn:Disconnect() end
            if flashConn then flashConn:Disconnect() end
            if characterConn then characterConn:Disconnect() end
        end)
    end

    -- Switcher: physical 3 starts Pebble Throw; send R, 2, then a timed 2.
    -- Timing is best-effort: no verified pebble/glide confirmation is available.
    do
        local pending, alive = false, true
        local mobileHeld
        local function releaseMobileInput()
            local own = mobileHeld
            if not own then return end
            mobileHeld = nil
            local ok, err = pcall(function()
                if own.binding then own.binding:Fire(false) else own.action:Fire(false) end
            end)
            if own.binding then pcall(function() own.binding:Destroy() end) end
            if not ok then warn("[KAMUI Switcher BF] native release failed: " .. tostring(err)) end
        end
        CC.SwitcherBFCancel = function()
            pending = false
            releaseMobileInput()
            CC.SwitcherTrackTarget = nil
            if CC.SwitcherTargetRelease then CC.SwitcherTargetRelease() end
        end
        local function log(message)
            print("[KAMUI Switcher BF] " .. message)
            if _G.KAMUI_ParkourDiagnostic then _G.KAMUI_ParkourDiagnostic("Switcher BF: " .. message) end
        end
        local function findMove(char, expected)
            local moveset = char:FindFirstChild("Moveset", true)
            if moveset then
                for _, obj in ipairs(moveset:GetChildren()) do
                    if string.lower(obj.Name):gsub("[^%w]", "") == expected then return obj end
                end
            end
            local backpack = player:FindFirstChildOfClass("Backpack")
            for _, container in ipairs(backpack and {char, backpack} or {char}) do
                for _, obj in ipairs(container:GetChildren()) do
                    if obj:IsA("Tool") and string.lower(obj.Name):gsub("[^%w]", "") == expected then return obj end
                end
            end
        end
        local function available(move)
            local t = move and move:GetAttribute("ReadyAt")
            return move ~= nil and (type(t) ~= "number" or t <= Workspace:GetServerTimeNow() + 0.15)
        end
        -- mobileStartAt is the physical touch associated with the observed
        -- Pebble Throw animation. PC passes nil and keeps its keyboard flow.
        local function startSwitcher(mobileStartAt)
            if not alive or not isCurrent() or not ScreenGui.Parent
                or not CC.AutoBF or CC.AutoBFMode ~= "Switcher" or UIS:GetFocusedTextBox() then return end
            if pending then
                CC.SwitcherBFCancel()
                CC.AutoBFEpoch = (CC.AutoBFEpoch or 0) + 1
                log("sequence canceled by another 3 press")
                return
            end
            local char = player.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            local pebble = char and findMove(char, "pebblethrow")
            local brute = char and findMove(char, "bruteforce")
            if not char or not hum or hum.Health <= 0 or not pebble or not brute then
                log("Pebble Throw or Brute Force not detected; select Switcher")
                return
            end
            -- The physical 3 may already have put Pebble Throw on cooldown
            -- before this listener runs, so don't misclassify that as a failed input.
            if not available(brute) then
                log("Brute Force is on cooldown; sequence not started")
                return
            end
            local root = char:FindFirstChild("HumanoidRootPart")
            local target, nearest = nil, 120
            if root then
                for _, other in ipairs(Players:GetPlayers()) do
                    if other ~= player then
                        local tc = other.Character
                        local tr = tc and tc:FindFirstChild("HumanoidRootPart")
                        local th = tc and tc:FindFirstChildOfClass("Humanoid")
                        if tr and th and th.Health > 0 then
                            local distance = (tr.Position - root.Position).Magnitude
                            if distance < nearest then target, nearest = tr, distance end
                        end
                    end
                end
            end
            pending = true
            CC.AutoBFEpoch = (CC.AutoBFEpoch or 0) + 1
            local epoch, startedAt = CC.AutoBFEpoch, mobileStartAt or os.clock()
            local mobile = mobileStartAt ~= nil
            local skillAdded, seenSkill = nil, false
            local swapDelay, kickDelay, bfDelay = CC.SwitcherSwapDelay, CC.SwitcherKickDelay, CC.SwitcherBFDelay
            local function valid()
                return pending and alive and isCurrent() and ScreenGui.Parent ~= nil and CC.AutoBF
                    and CC.AutoBFMode == "Switcher" and CC.AutoBFEpoch == epoch
                    and player.Character == char and hum.Parent and hum.Health > 0
                    and not UIS:GetFocusedTextBox()
            end
            local function waitUntil(t)
                while valid() and os.clock() < t do RunService.Heartbeat:Wait() end
                return valid()
            end
            local function press(key)
                if not valid() then return false end
                if not mobile then
                    if UIS:IsKeyDown(key) then return false end
                    local ok = pcall(function() VirtualInputManager:SendKeyEvent(true, key, false, game) end)
                    if not ok then return false end
                    task.wait(0.04)
                    pcall(function() VirtualInputManager:SendKeyEvent(false, key, false, game) end)
                    return true
                end
                local actionName = key == Enum.KeyCode.R and "Special"
                    or (key == Enum.KeyCode.Two and "Skill 2" or nil)
                if not actionName or mobileHeld then return false end
                local storage = game:GetService("ReplicatedStorage")
                local keybind = storage:FindFirstChild("Keybind")
                local combat = keybind and keybind:FindFirstChild("Combat")
                local action = combat and combat:FindFirstChild(actionName)
                if not action or not action:IsA("InputAction") then
                    log("mobile " .. actionName .. " InputAction not found"); return false
                end
                local typeOk, isBool = pcall(function() return action.Type == Enum.InputActionType.Bool end)
                local stateOk, state = pcall(function() return action:GetState() end)
                if not typeOk or not isBool or not stateOk or state == true then
                    log("mobile " .. actionName .. " unavailable or manually held"); return false
                end
                local binding
                local made, err = pcall(function()
                    binding = Instance.new("InputBinding")
                    binding.Name = "KAMUI_MobileSwitcherBF"
                    binding.Type = Enum.InputBindingType.Scriptable
                    binding.Parent = action
                end)
                local sent = false
                if made then sent, err = pcall(function() binding:Fire(true) end) end
                if sent then
                    mobileHeld = {action = action, binding = binding}
                else
                    if binding then pcall(function() binding:Destroy() end) end
                    local ok, legacyErr = pcall(function() action:Fire(true) end)
                    if not ok then
                        log("mobile " .. actionName .. " failed: " .. tostring(err) .. "; legacy: " .. tostring(legacyErr))
                        return false
                    end
                    mobileHeld = {action = action}
                end
                local own = mobileHeld
                task.wait(0.04)
                if mobileHeld == own then releaseMobileInput() end
                return true
            end
            local function finish(message)
                if skillAdded then skillAdded:Disconnect(); skillAdded = nil end
                -- An older canceled task must not clear a newly started attempt.
                if CC.AutoBFEpoch == epoch then
                    CC.SwitcherBFCancel()
                    if message then log(message) end
                end
            end
            log(string.format("3 detected; sequence R %.2fs, kick %.2fs later, BF %.2fs later", swapDelay, kickDelay, bfDelay))
            task.spawn(function()
                -- No verified pebble-spawn signal is available. Approximate
                -- post-throw lock shortly before the scheduled swap, not on keydown.
                local lockAt = startedAt + math.max(0.04, swapDelay - 0.08)
                if not waitUntil(lockAt) then finish(); return end
                if target and not target.Parent then target = nil end
                CC.SwitcherTrackTarget = target
                CC.SwitcherTargetEngaged = CC.SwitcherTargetLock and target ~= nil
                if target then log("TargetLock target: " .. target.Parent.Name)
                else log("TargetLock: no live player within 120 studs") end
                if not waitUntil(startedAt + swapDelay) then finish(); return end
                local swapAt = os.clock()
                if not press(Enum.KeyCode.R) then finish("swap input canceled or failed"); return end
                if not valid() then finish(); return end
                log("sent R; pebble swap not verified")
                if not waitUntil(swapAt + kickDelay) then finish(); return end
                if not available(brute) then finish("Brute Force unavailable"); return end
                -- Observe InSkill from this kick onward, not the earlier pebble throw.
                local skillInfo = char:FindFirstChild("Info")
                if skillInfo then
                    skillAdded = skillInfo.ChildAdded:Connect(function(child)
                        if child.Name == "InSkill" then seenSkill = true end
                    end)
                end
                local kickAt = os.clock()
                if not press(Enum.KeyCode.Two) then finish("kick input canceled or failed"); return end
                skillInfo = char:FindFirstChild("Info")
                if skillInfo and skillInfo:FindFirstChild("InSkill") then seenSkill = true end
                if not valid() then finish(); return end
                log("sent first 2; glide not verified")
                if not waitUntil(kickAt + bfDelay) then finish(); return end
                if not press(Enum.KeyCode.Two) then finish("BF input canceled or failed"); return end
                log("sent second 2; waiting for the skill to end")
                -- Marker lifetime is inferred from diagnostics, not a verified BF
                -- completion signal. Timeout avoids a permanently locked camera.
                local deadline = os.clock() + 4
                while valid() and os.clock() < deadline do
                    local info = char:FindFirstChild("Info")
                    local marker = info and info:FindFirstChild("InSkill")
                    if marker then seenSkill = true end
                    if seenSkill and not marker then break end
                    RunService.Heartbeat:Wait()
                end
                if valid() and not seenSkill then log("skill-end marker not observed; lock timed out") end
                finish("Switcher sequence finished; outcome depends on timing")
            end)
        end
        local conn = UIS.InputBegan:Connect(function(input)
            if input.UserInputType ~= Enum.UserInputType.Keyboard or input.KeyCode ~= Enum.KeyCode.Three then return end
            startSwitcher(nil)
        end)
        -- The supplied mobile trace identified this local Action animation at
        -- the start of Pebble Throw; ReadyAt changed only after it ended.
        local PEBBLE_ANIMATION_ID = "111720035828971"
        local lastTouchAt, touchSerial, consumedTouch = -math.huge, 0, 0
        local animatorConn, characterConn
        local touchConn = UIS.TouchStarted:Connect(function()
            if not alive or not isCurrent() or not ScreenGui.Parent or not UIS.TouchEnabled or UIS.KeyboardEnabled
                or not CC.AutoBF or CC.AutoBFMode ~= "Switcher" or pending or UIS:GetFocusedTextBox() then return end
            touchSerial = touchSerial + 1
            lastTouchAt = os.clock()
        end)
        local function bindMobileSwitcher(char)
            if animatorConn then animatorConn:Disconnect(); animatorConn = nil end
            consumedTouch = touchSerial
            task.spawn(function()
                local hum = char:FindFirstChildOfClass("Humanoid") or char:WaitForChild("Humanoid", 5)
                local animator = hum and (hum:FindFirstChildOfClass("Animator") or hum:WaitForChild("Animator", 5))
                if not alive or not isCurrent() or player.Character ~= char or not animator then return end
                animatorConn = animator.AnimationPlayed:Connect(function(track)
                    local anim = track.Animation
                    local id = anim and tostring(anim.AnimationId):match("%d+")
                    local now = os.clock()
                    if not alive or not isCurrent() or not ScreenGui.Parent or player.Character ~= char
                        or not UIS.TouchEnabled or UIS.KeyboardEnabled or not CC.AutoBF
                        or CC.AutoBFMode ~= "Switcher" or pending or UIS:GetFocusedTextBox()
                        or id ~= PEBBLE_ANIMATION_ID or touchSerial == consumedTouch
                        or now - lastTouchAt > 0.60 then return end
                    consumedTouch = touchSerial
                    log(string.format("mobile Pebble animation detected %.2fs after touch", now - lastTouchAt))
                    startSwitcher(lastTouchAt)
                end)
            end)
        end
        characterConn = player.CharacterAdded:Connect(bindMobileSwitcher)
        if player.Character then bindMobileSwitcher(player.Character) end
        ScreenGui.Destroying:Connect(function()
            alive = false
            CC.SwitcherBFCancel()
            conn:Disconnect()
            touchConn:Disconnect()
            characterConn:Disconnect()
            if animatorConn then animatorConn:Disconnect(); animatorConn = nil end
        end)
    end

    ------------------------------------------------------------------ Auto QTE (PC)
    -- This uses the visible prompt, not a guessed remote. GUI names differ across
    -- game versions, so accept only W/A/D labels under a QTE/judgement container.
    -- Other visible W/A/D labels are reported for diagnosis, but never pressed.
    do
        local qteCard = UI.card(page, "Auto QTE")
        local conn, held, lastScan, lastPress = nil, nil, 0, 0
        local pressToken = 0
        local qtePaint
        local seen = {}
        local mobileTarget, mobileOrigin, mobileDone = nil, nil, false
        local mobileVisibilityConn, mobileGuiConn
        local function clearMobile()
            if mobileVisibilityConn then mobileVisibilityConn:Disconnect(); mobileVisibilityConn = nil end
            if mobileGuiConn then mobileGuiConn:Disconnect(); mobileGuiConn = nil end
            mobileTarget, mobileOrigin, mobileDone = nil, nil, false
        end
        local function log(message)
            if _G.KAMUI_ParkourDiagnostic then
                _G.KAMUI_ParkourDiagnostic("QTE: " .. message)
            end
        end
        local function release()
            if not held then return end
            local own = held
            held = nil
            pressToken = pressToken + 1
            if type(own) == "table" and own.kind == "touch" then
                local ok, err = pcall(function() VirtualInputManager:SendTouchEvent(own.id, 2, own.x, own.y) end)
                if not ok then log("mobile touch release failed: " .. tostring(err)) end
            else
                pcall(function() VirtualInputManager:SendKeyEvent(false, own, false, game) end)
            end
        end
        local function stop()
            if conn then conn:Disconnect(); conn = nil end
            release()
            clearMobile()
        end
        local function visible(obj, root)
            local cursor = obj
            while cursor and cursor ~= root do
                if cursor:IsA("GuiObject") and not cursor.Visible then return false end
                if cursor:IsA("ScreenGui") and not cursor.Enabled then return false end
                cursor = cursor.Parent
            end
            return cursor == root
        end
        local function isQteContext(obj, root)
            local cursor = obj
            while cursor and cursor ~= root do
                local name = string.lower(cursor.Name):gsub("[%s_%-]", "")
                if name:find("qte", 1, true) or name:find("quicktime", 1, true)
                    or name:find("judgement", 1, true) or name:find("judgment", 1, true) then
                    return true
                end
                cursor = cursor.Parent
            end
            return false
        end
        local keys = { W = Enum.KeyCode.W, A = Enum.KeyCode.A, D = Enum.KeyCode.D }
        local function scanMobile(gui)
            local qteGui = gui:FindFirstChild("QTE")
            local target = qteGui and qteGui:FindFirstChild("QTE_MOBILE")
            if not target or not target:IsA("TextButton") then
                if mobileTarget then clearMobile() end
                return
            end
            if target ~= mobileTarget then
                clearMobile()
                mobileTarget = target
                mobileVisibilityConn = target:GetPropertyChangedSignal("Visible"):Connect(function()
                    if not target.Visible then mobileDone, mobileOrigin = false, nil end
                end)
                if qteGui:IsA("ScreenGui") then
                    mobileGuiConn = qteGui:GetPropertyChangedSignal("Enabled"):Connect(function()
                        if not qteGui.Enabled then mobileDone, mobileOrigin = false, nil end
                    end)
                end
            end
            if not visible(target, gui) or target.TextTransparency >= 1
                or not target.Text:gsub("<[^>]->", ""):match("^%s*!%s*$") then
                mobileDone, mobileOrigin = false, nil
                return
            end
            local pos, size = target.AbsolutePosition, target.AbsoluteSize
            if size.X <= 0 or size.Y <= 0 then return end
            -- The game may reuse the button at a new randomized position. A
            -- substantial move counts as a new prompt; tiny jitter does not.
            if mobileDone and mobileOrigin then
                local threshold = math.max(12, math.min(size.X, size.Y) * 0.5)
                if (pos - mobileOrigin).Magnitude > threshold then mobileDone = false end
            end
            if mobileDone or held or os.clock() - lastPress < CC.QTESpeed then return end
            mobileDone, mobileOrigin = true, pos
            lastPress = os.clock()
            -- On mobile a failed chance roll skips this target instead of
            -- tapping a random area of the screen.
            if math.random(1, 100) > CC.QTEChance then
                log("mobile target skipped by chance"); return
            end
            local center = pos + size / 2
            local inset = game:GetService("GuiService"):GetGuiInset()
            local point
            for _, candidate in ipairs({center, center + inset, center - inset}) do
                local ok, objects = pcall(function() return gui:GetGuiObjectsAtPosition(candidate.X, candidate.Y) end)
                if ok then
                    for _, obj in ipairs(objects) do
                        if obj == target or obj:IsDescendantOf(target) then point = candidate; break end
                    end
                end
                if point then break end
            end
            if not point then
                log("mobile target found, but touch coordinates could not be verified"); return
            end
            local own = {kind = "touch", id = 98, x = math.floor(point.X + 0.5), y = math.floor(point.Y + 0.5)}
            held = own
            pressToken = pressToken + 1
            local token = pressToken
            local ok, err = pcall(function() VirtualInputManager:SendTouchEvent(own.id, 0, own.x, own.y) end)
            if not ok then
                held = nil
                log("mobile touch failed: " .. tostring(err)); return
            end
            log(string.format("mobile target tap sent at %d,%d", own.x, own.y))
            task.delay(0.04, function()
                if held == own and pressToken == token then release() end
            end)
        end
        local function scan()
            if not isCurrent() or not CC.AutoQTE then stop(); return end
            if UIS:GetFocusedTextBox() then return end
            if UIS.TouchEnabled and not UIS.KeyboardEnabled then
                local gui = player:FindFirstChildOfClass("PlayerGui")
                if gui then scanMobile(gui) end
                return
            end
            if not UIS.KeyboardEnabled then return end
            local gui = player:FindFirstChildOfClass("PlayerGui")
            if not gui then return end
            local selected, ambiguous = nil, false
            for _, obj in ipairs(gui:GetDescendants()) do
                if (obj:IsA("TextLabel") or obj:IsA("TextButton")) and obj.TextTransparency < 1 then
                    local text = obj.Text:gsub("<[^>]->", ""):match("^%s*([WwAaDd])%s*$")
                    if text and visible(obj, gui) then
                        local letter = string.upper(text)
                        local contextual = isQteContext(obj, gui)
                        if not seen[obj] then
                            seen[obj] = true
                            log((contextual and "prompt " or "unmatched ") .. obj:GetFullName() .. " = " .. letter)
                        end
                        if contextual then
                            if selected and selected ~= letter then ambiguous = true end
                            selected = letter
                        end
                    end
                end
            end
            if ambiguous or not selected or held then return end
            local now = os.clock()
            if now - lastPress < CC.QTESpeed then return end
            -- Failed chance rolls choose one of the other two QTE keys, never
            -- the correct one. Each input attempt is rolled independently.
            local chosen = selected
            if math.random(1, 100) > CC.QTEChance then
                local alternatives = {}
                for _, letter in ipairs({"W", "A", "D"}) do
                    if letter ~= selected then alternatives[#alternatives + 1] = letter end
                end
                chosen = alternatives[math.random(1, #alternatives)]
            end
            local key = keys[chosen]
            if UIS:IsKeyDown(key) then return end
            lastPress = now
            held = key
            pressToken = pressToken + 1
            local token = pressToken
            local ok = pcall(function() VirtualInputManager:SendKeyEvent(true, key, false, game) end)
            if not ok then
                held = nil
                log("could not send " .. chosen .. "; executor may not support input")
                return
            end
            task.delay(0.025, function()
                if held == key and pressToken == token then release() end
            end)
        end
        local _
        _, qtePaint = toggleRow("Auto QTE", "Answers PC prompts or mobile QTE targets", function()
            return CC.AutoQTE
        end, function(v)
            CC.AutoQTE = v
            stop()
            seen = setmetatable({}, { __mode = "k" })
            if v then
                log("ON; enter Final Judgement")
                conn = RunService.Heartbeat:Connect(function()
                    local now = os.clock()
                    if now - lastScan < 0.05 then return end
                    lastScan = now
                    local ok, err = pcall(scan)
                    if not ok then
                        log("scan error: " .. tostring(err)); CC.AutoQTE = false; stop()
                        if qtePaint then qtePaint() end
                    end
                end)
            else
                log("OFF")
            end
        end, qteCard)
        sliderRow("Chance", function() return CC.QTEChance end,
            function(v) CC.QTEChance = math.clamp(math.floor(v + 0.5), 10, 100) end,
            10, 100, function(v) return string.format("%d%%", v) end, qteCard, true)
        sliderRow("Speed", function() return CC.QTESpeed end,
            function(v) CC.QTESpeed = math.clamp(v, 0.05, 1.0) end,
            0.05, 1.0, function(v) return string.format("%.2fs", v) end, qteCard, true)
        local charConn = player.CharacterAdded:Connect(function()
            release()
            clearMobile()
            seen = setmetatable({}, { __mode = "k" })
        end)
        ScreenGui.Destroying:Connect(function()
            stop()
            charConn:Disconnect()
        end)
    end

