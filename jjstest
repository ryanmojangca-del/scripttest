    -- Independent BF-chain lock. It never picks a target from a normal dash:
    -- beginChain supplies the same root used for the behind-target movement.
    do
        local rotationHum, previousAutoRotate
        local binding = "KAMUI_BFTargetLock_" .. tostring(scriptId)
        local function release()
            CC.TargetLockEngaged = false
            if rotationHum then
                pcall(function() rotationHum.AutoRotate = previousAutoRotate end)
                rotationHum, previousAutoRotate = nil, nil
            end
        end
        CC.TargetLockRelease = release
        RunService:BindToRenderStep(binding, Enum.RenderPriority.Camera.Value + 4, function()
            if not isCurrent() or not ScreenGui.Parent then
                release()
                pcall(function() RunService:UnbindFromRenderStep(binding) end)
                return
            end
            local target = CC.BFTrackTarget
            local targetChar = target and target.Parent
            local targetHum = targetChar and targetChar:FindFirstChildOfClass("Humanoid")
            local char = player.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            local cam = Workspace.CurrentCamera
            if not CC.TargetLock or not CC.ChainMode or not targetChar or not targetHum
                or targetHum.Health <= 0 or not root or not hum or hum.Health <= 0 or not cam then
                release(); return
            end
            CC.TargetLockEngaged = true
            if CC.TargetLockMode == "Legit" then
                if rotationHum then
                    pcall(function() rotationHum.AutoRotate = previousAutoRotate end)
                    rotationHum, previousAutoRotate = nil, nil
                end
                if (target.Position - cam.CFrame.Position).Magnitude > 0.01 then
                    cam.CFrame = CFrame.lookAt(cam.CFrame.Position, target.Position)
                end
            else
                if root.Anchored or hum.PlatformStand then release(); return end
                if rotationHum ~= hum then
                    if rotationHum then pcall(function() rotationHum.AutoRotate = previousAutoRotate end) end
                    rotationHum, previousAutoRotate = hum, hum.AutoRotate
                end
                hum.AutoRotate = false
                local goal = Vector3.new(target.Position.X, root.Position.Y, target.Position.Z)
                if (goal - root.Position).Magnitude > 0.01 then
                    root.CFrame = CFrame.lookAt(root.Position, goal)
                end
            end
        end)
        ScreenGui.Destroying:Connect(function()
            release()
            pcall(function() RunService:UnbindFromRenderStep(binding) end)
        end)
    end

