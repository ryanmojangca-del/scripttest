    ------------------------------------------------------------------ Auto block
    --// React to nearby action animations, with best-effort filters for
    --// movement and defense. Animations are not reliably labelled attacks;
    --// filters can both miss attacks and admit non-attacks.
    local BLOCK_HOLD = 0.45
    local blocking, blockUntil = false, 0
    local blockStartedAt = -math.huge
    local counterActive, counterUntil, counterTarget, counterKeyHeld = false, 0, nil, nil
    local blockTarget, rotationHum, previousAutoRotate = nil, nil, nil
    local function releaseBlockCam()
        CC.BlockCamActive = false
        if rotationHum then
            pcall(function() rotationHum.AutoRotate = previousAutoRotate end)
            rotationHum, previousAutoRotate = nil, nil
        end
    end
    CC.BlockCamRelease = function() if not counterActive then releaseBlockCam() end end
    CC.CounterCamRelease = function() if counterActive then releaseBlockCam() end end
    local seenTracks = setmetatable({}, { __mode = "k" })
    local reportedTracks = setmetatable({}, { __mode = "k" })
    local lastBlockPos = {}
    local speedOf = {}
    -- The PC controls shown by the game: left click is M1, keys 1–4 are
    -- abilities. Pause only NEW automatic blocks, not a block already held.
    local ownAttackAt, ownAttackUntil = -math.huge, -math.huge
    local abilityKeys = {
        [Enum.KeyCode.One] = true, [Enum.KeyCode.Two] = true,
        [Enum.KeyCode.Three] = true, [Enum.KeyCode.Four] = true
    }
    UIS.InputBegan:Connect(function(input, processed)
        if not isCurrent() or processed or UIS:GetFocusedTextBox() then return end
        local isM1 = input.UserInputType == Enum.UserInputType.MouseButton1
        local isSkill = input.UserInputType == Enum.UserInputType.Keyboard and abilityKeys[input.KeyCode]
        if isM1 or isSkill then
            ownAttackAt = os.clock()
            ownAttackUntil = math.max(ownAttackUntil, ownAttackAt + (isM1 and 0.6 or 0.9))
        end
    end)
    -- Physical mobile M1 taps do not produce a MouseButton1 event. Listen to
    -- the game's Melee InputAction to apply the same own-attack pause used on PC.
    -- This pauses only new blocks; it does not forcibly end a held guard.
    do
        local meleeConn, alive = nil, true
        -- Read-only trace: identify which game GUI button receives a physical
        -- touch. This helps diagnose games that bypass Melee.Pressed on mobile.
        local lastTouchTrace = 0
        local touchConn = UIS.TouchStarted:Connect(function(input)
            if not alive or not isCurrent() or not CC.BlockMobile or not CC.Block
                or os.clock() - lastTouchTrace < 0.20 then return end
            local pg = player:FindFirstChildOfClass("PlayerGui")
            if not pg then return end
            local ok, objects = pcall(function()
                return pg:GetGuiObjectsAtPosition(input.Position.X, input.Position.Y)
            end)
            if not ok then return end
            for _, obj in ipairs(objects) do
                local button = obj:IsA("GuiButton") and obj or obj:FindFirstAncestorWhichIsA("GuiButton")
                if button and button:IsDescendantOf(pg) and button.Visible then
                    lastTouchTrace = os.clock()
                    local image = button:IsA("ImageButton") and (" image=" .. tostring(button.Image)) or ""
                    if _G.KAMUI_ParkourDiagnostic then
                        _G.KAMUI_ParkourDiagnostic("Own touch: " .. button:GetFullName() .. image)
                    end
                    break
                end
            end
        end)
        task.spawn(function()
            while alive and isCurrent() and ScreenGui.Parent do
                local storage = game:GetService("ReplicatedStorage")
                local keybind = storage:FindFirstChild("Keybind")
                local combat = keybind and keybind:FindFirstChild("Combat")
                local action = combat and combat:FindFirstChild("Melee")
                if action and action:IsA("InputAction") then
