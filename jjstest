        ---------------------------------------------------------------- the on-screen list
        if _G.KAMUI_ArraylistGui then
            pcall(function()
                _G.KAMUI_ArraylistGui:Destroy()
            end)
        end
        local gui = Instance.new("ScreenGui")
        gui.Name = "KamuiArraylist"
        gui.ResetOnSpawn = false
        gui.IgnoreGuiInset = true
        gui.DisplayOrder = 50
        gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
        local okParent = pcall(function()
            gui.Parent = game.CoreGui
        end)
        if not okParent then
            gui.Parent = player:WaitForChild("PlayerGui")
        end
        _G.KAMUI_ArraylistGui = gui
        local holder = Instance.new("Frame")
        holder.BackgroundTransparency = 1
        holder.BorderSizePixel = 0
        holder.Size = UDim2.new(0, 480, 1, -60)
        holder.Parent = gui
        local lay = Instance.new("UIListLayout")
        lay.FillDirection = Enum.FillDirection.Vertical
        lay.SortOrder = Enum.SortOrder.LayoutOrder
        lay.Parent = holder

        local function isRight()
            return CFG.Corner == "TR" or CFG.Corner == "BR"
        end
        local function isBottom()
            return CFG.Corner == "BR" or CFG.Corner == "BL"
        end
        local function placeHolder()
            local r, b = isRight(), isBottom()
            holder.AnchorPoint = Vector2.new(r and 1 or 0, b and 1 or 0)
            holder.Position = UDim2.new(r and 1 or 0, r and -CFG.OffX or CFG.OffX, b and 1 or 0, b and -CFG.OffY or CFG.OffY)
            lay.HorizontalAlignment = r and Enum.HorizontalAlignment.Right or Enum.HorizontalAlignment.Left
            lay.VerticalAlignment = b and Enum.VerticalAlignment.Bottom or Enum.VerticalAlignment.Top
            lay.Padding = UDim.new(0, CFG.Spacing)
        end

        local function curFont(bold)
            if CFG.Font ~= "Default" then
                local fam = famByName[CFG.Font]
                local e = fam and (bold and (fontEnum(fam.f[4]) or fontEnum(fam.f[3]) or fontEnum(fam.f[2])) or (fontEnum(fam.f[2]) or fontEnum(fam.f[1])))
                if e then
                    return e
                end
            end
            return bold and Enum.Font.GothamBold or Enum.Font.GothamMedium
        end

        local function caseText(s)
            if CFG.Case == "lower" then
                return s:lower()
            elseif CFG.Case == "UPPER" then
                return s:upper()
            end
            return s
        end

        local function fmtNum(n)
            return string.format("%g", math.floor((tonumber(n) or 0) * 100 + 0.5) / 100)
        end

        --// the list of features that are on right now: { id, cat (tab order), text, idx }
        local function entries()
            local out = {}
            local CC = _G.KAMUI_Combat or {}
            local M = _G.KAMUI_Movement or {}
            local wantKeys = CFG.Details == "Keys" or CFG.Details == "Both"
            local wantVals = CFG.Details == "Values" or CFG.Details == "Both"
            local function add(id, cat, on, text, key, val)
                if not on or hidden[id] then
                    return
                end
                if wantVals and val then
                    text = text .. " (" .. val .. ")"
                end
                if wantKeys and key then
                    text = text .. " [" .. tostring(key) .. "]"
                end
                if CFG.Suffix ~= "None" then
                    text = text .. " " .. CFG.Suffix
                end
                out[#out + 1] = { id = id, cat = cat, text = caseText(text), idx = #out + 1 }
            end
            add("autobf", 2, CC.AutoBF, "Auto BF", nil, CC.AutoBFMode)
            add("bfchain", 2, CC.ChainMode, "BF Chain")
            add("targetlock", 2, CC.TargetLock, "BF TargetLock", nil, CC.TargetLockMode)
            add("aimbot", 2, CC.Aimbot, "Aimbot", CC.AimKey, (CC.Smooth and CC.Smooth > 0) and ("smooth " .. fmtNum(CC.Smooth)) or nil)
            add("block", 2, CC.Block, "Auto block", nil, CC.BlockRange and fmtNum(CC.BlockRange))
            local SA = CC.SideDashAssist
            add("dashassist", 2, SA and SA.Enabled, "Dash Assist", SA and SA.Key, SA and SA.Mode)
            add("dashmult", 3, M.Enabled and M.Distance ~= 1, "Dash multiplier", nil, M.Distance and string.format("%.2fx", M.Distance))
            add("nosidecd", 3, M.NoSideCD, "No side dash cooldown")
            add("nostun", 3, M.NoStun, "No stun")
            add("walkjump", 3, M.SJEnabled, "WalkSpeed / Jump height", nil, M.WalkSpeed and (fmtNum(M.WalkSpeed) .. " / " .. fmtNum(M.JumpPower)))
            add("fakelag", 3, M.FakeLag, "Fake lag", M.FakeLagKey, M.FakeLagMs and (fmtNum(M.FakeLagMs) .. "ms") or nil)
            add("fps", 4, potatoEnabled, "FPS boost")
            add("headless", 4, headlessKorbloxEnabled, "Headless & Korblox")
            if #out == 0 and CFG.Draggable and not CFG.Title then
                out[1] = { id = "__preview", cat = 0, text = caseText("Arraylist"), idx = 1 }
            end
            if CFG.Title then
                table.insert(out, 1, { id = "__title", cat = -1, text = "KAMUI", idx = 0, title = true })
            end
            return out
        end

        local function accentAt(offset)
            if St.rainbow then
                return Color3.fromHSV((St.phase + offset) % 1, math.max(St.s, 0.7), math.max(St.v, 0.85))
            end
            return Color3.fromHSV(St.h, St.s, St.v)
        end

        ---------------------------------------------------------------- rows
        local rows = {}

        --// fade / slide state of a row: r.vis.Value goes 0 -> 1 (in) or 1 -> 0 (out)
        local function updateVis(r)
            local v = r.vis.Value
            r.slot.Size = UDim2.new(0, r.w, 0, math.floor(r.h * v + 0.5))
            r.fr.Position = UDim2.new(0, r.dir * (1 - v) * (r.w + 24), 0, 0)
            r.fr.BackgroundTransparency = (CFG.BG and not r.title) and (1 - (1 - CFG.BGTrans) * v) or 1
            r.label.TextTransparency = 1 - v
            r.label.TextStrokeTransparency = r.title and (1 - 0.65 * v) or (CFG.Shadow and (1 - 0.45 * v) or 1)
            r.bar.BackgroundTransparency = 1 - v
            r.stroke.Transparency = 1 - (1 - r.strokeT) * v
            if r.logoL then
                r.logoL.ImageTransparency = 1 - v
                r.logoA.ImageTransparency = 1 - v
            end
        end

        local function tweenVis(r, goal, done)
            if r.tween then
                r.tween:Cancel()
                r.tween = nil
            end
            if not CFG.Anim then
                r.vis.Value = goal
                if done then
                    done()
                end
                return
            end
            local t = TweenService:Create(r.vis, TweenInfo.new(0.22 / CFG.AnimSpeed, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Value = goal })
            r.tween = t
            t.Completed:Connect(function(state)
                if state == Enum.PlaybackState.Completed and done then
                    done()
                end
            end)
            t:Play()
        end

        --// applies every setting to one row (size, font, bar, outline...)
        local function styleRow(r)
            local size, font = CFG.Size + (r.title and 10 or 0), curFont(r.title)
            local right, barOn = isRight(), CFG.Bar ~= "Off" and not r.title
            local th = barOn and CFG.BarThick or 0
            local li = CFG.Pad + ((CFG.Bar == "Left") and th or 0)
            local ri = CFG.Pad + ((CFG.Bar == "Right") and th or 0)
            local tw = TextService:GetTextSize(r.text, size, font, Vector2.new(1000, 100)).X
            local ex = (r.title and r.logoL) and (size + 4) or 0 -- room for the logo in front of the title
            r.w = math.ceil(tw) + li + ri + ex
            r.h = size + 6
            r.dir = right and 1 or -1
            r.fr.Size = UDim2.new(0, r.w, 0, r.h)
            r.fr.Active = CFG.Draggable
            r.fr.ClipsDescendants = CFG.Radius > 0
            r.corner.CornerRadius = UDim.new(0, CFG.Radius)
            if r.title then
                r.stroke.Enabled, r.strokeT = false, 1
            elseif CFG.Outline == "Outline" then
                r.stroke.Enabled, r.stroke.Thickness, r.strokeT = true, 1, 0.15
            elseif CFG.Outline == "Glow" then
                r.stroke.Enabled, r.stroke.Thickness, r.strokeT = true, 3, 0.65
            else
                r.stroke.Enabled, r.strokeT = false, 1
            end
            local lb = r.label
            lb.Font = font
            lb.TextSize = size
            lb.Text = r.text
            lb.Position = UDim2.new(0, li + ex, 0, 0)
            lb.Size = UDim2.new(1, -(li + ri + ex), 1, 0)
            if r.logoL then
                for _, im in ipairs({ r.logoL, r.logoA }) do
                    im.Size = UDim2.new(0, size, 0, size)
                    im.Position = UDim2.new(0, li, 0.5, -math.floor(size / 2))
                end
            end
            lb.TextXAlignment = right and Enum.TextXAlignment.Right or Enum.TextXAlignment.Left
            local inset = math.floor(CFG.Radius * 0.6)
            local bar = r.bar
            bar.Visible = barOn
            bar.Size = UDim2.new(0, th, 1, -2 * inset)
            if CFG.Bar == "Left" then
                bar.AnchorPoint, bar.Position = Vector2.new(0, 0), UDim2.new(0, 0, 0, inset)
            else
                bar.AnchorPoint, bar.Position = Vector2.new(1, 0), UDim2.new(1, 0, 0, inset)
            end
            r.ver = ver
            updateVis(r)
        end

        local drag = nil
        local function makeRow(id)
            local slot = Instance.new("Frame")
            slot.BackgroundTransparency = 1
            slot.BorderSizePixel = 0
            slot.Size = UDim2.new(0, 10, 0, 0)
            local fr = Instance.new("Frame")
            fr.BackgroundColor3 = Color3.fromRGB(8, 8, 9)
            fr.BorderSizePixel = 0
            fr:SetAttribute("KamuiSkinned", true)
            fr.Parent = slot
            local corner = Instance.new("UICorner")
            corner.Parent = fr
            local stroke = Instance.new("UIStroke")
            stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
            stroke.Enabled = false
            stroke.Parent = fr
            local lb = Instance.new("TextLabel")
            lb.BackgroundTransparency = 1
            lb.TextStrokeColor3 = Color3.new(0, 0, 0)
            lb:SetAttribute("KamuiSkinned", true)
            lb:SetAttribute("KamuiKeepFont", true)
            lb.Parent = fr
            local bar = Instance.new("Frame")
            bar.BorderSizePixel = 0
            bar:SetAttribute("KamuiSkinned", true)
            bar.Parent = fr
            local logoL, logoA
            if id == "__title" and _G.KAMUI_LogoLight and _G.KAMUI_LogoAccent then
                local function layer(name, img, color)
                    local l = Instance.new("ImageLabel")
                    l.Name = name
                    l.BackgroundTransparency = 1
                    l.BorderSizePixel = 0
                    l.Image = img
                    l.ImageColor3 = color
                    l.ScaleType = Enum.ScaleType.Fit
                    l:SetAttribute("KamuiSkinned", true)
                    l.Parent = fr
                    return l
                end
                logoL = layer("LogoLight", _G.KAMUI_LogoLight, Color3.fromRGB(255, 255, 255))
                logoA = layer("LogoAccent", _G.KAMUI_LogoAccent, Color3.fromHSV(St.h, St.s, St.v))
            end
            local vis = Instance.new("NumberValue")
            vis.Parent = slot
            local r = {
                id = id, slot = slot, fr = fr, corner = corner, stroke = stroke, label = lb, bar = bar, vis = vis,
                logoL = logoL, logoA = logoA,
                text = "", cat = 0, idx = 0, w = 10, h = 18, dir = 1, strokeT = 1, ver = -1, leaving = false
            }
            vis.Changed:Connect(function()
                updateVis(r)
            end)
            fr.InputBegan:Connect(function(i)
                if CFG.Draggable and (i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch) then
                    drag = { input = i, sx = i.Position.X, sy = i.Position.Y, ox = CFG.OffX, oy = CFG.OffY }
                end
            end)
            slot.Parent = holder
            return r
        end

        myConns[#myConns + 1] = UIS.InputChanged:Connect(function(i)
            if not drag or not isCurrent() then
                return
            end
            if i == drag.input or (i.UserInputType == Enum.UserInputType.MouseMovement and drag.input.UserInputType == Enum.UserInputType.MouseButton1) then
                local dx, dy = i.Position.X - drag.sx, i.Position.Y - drag.sy
                CFG.OffX = math.floor(math.clamp(drag.ox + (isRight() and -dx or dx), RANGE.OffX[1], RANGE.OffX[2]) + 0.5)
                CFG.OffY = math.floor(math.clamp(drag.oy + (isBottom() and -dy or dy), RANGE.OffY[1], RANGE.OffY[2]) + 0.5)
                placeHolder()
            end
        end)
        myConns[#myConns + 1] = UIS.InputEnded:Connect(function(i)
            if drag and (i == drag.input or i.UserInputType == Enum.UserInputType.MouseButton1) then
                drag = nil
                saveSoon()
                repaintAll()
            end
        end)

        ---------------------------------------------------------------- update loop
        local acc, acc2 = 0, 0
        local conn
        conn = RunService.Heartbeat:Connect(function(dt)
            if not isCurrent() then
                conn:Disconnect()
                for _, c in ipairs(myConns) do
                    pcall(function()
                        c:Disconnect()
                    end)
                end
                pcall(function()
                    gui:Destroy()
                end)
                return
            end
            acc += dt
            if acc < 0.05 then
                return
            end
            acc2 += acc
            acc = 0
            if acc2 >= 0.15 then
                acc2 = 0 -- keep the controls' colors in step with the accent / rainbow
                repaintAll()
            end
            holder.Visible = _G.KAMUI_ArraylistOn == true
            if not holder.Visible then
                return
            end
            placeHolder()

            local want, list, titleRow = {}, {}, nil
            for _, e in ipairs(entries()) do
                want[e.id] = true
                local r = rows[e.id]
                if not r then
                    r = makeRow(e.id)
                    rows[e.id] = r
                    r.title = e.title
                    r.text = e.text
                    styleRow(r)
                    tweenVis(r, 1)
                else
                    if r.leaving then
                        r.leaving = false
                        tweenVis(r, 1)
                    end
                    if r.text ~= e.text or r.ver ~= ver then
                        r.text = e.text
                        styleRow(r)
                    end
                end
                r.cat, r.idx = e.cat, e.idx
                if e.title then
                    titleRow = r
                else
                    list[#list + 1] = r
                end
            end
            for id, r in pairs(rows) do
                if not want[id] and not r.leaving then
                    r.leaving = true
                    tweenVis(r, 0, function()
                        r.slot:Destroy()
                        if rows[id] == r then
                            rows[id] = nil
                        end
                    end)
                end
            end

            local mode = CFG.Sort
            table.sort(list, function(a, b)
                if mode == "Longest" then
                    if a.w ~= b.w then
                        return a.w > b.w
                    end
                elseif mode == "Shortest" then
                    if a.w ~= b.w then
                        return a.w < b.w
                    end
                elseif mode == "A-Z" then
                    local x, y = a.text:lower(), b.text:lower()
                    if x ~= y then
                        return x < y
                    end
                elseif mode == "By tab" then
                    if a.cat ~= b.cat then
                        return a.cat < b.cat
                    end
                end
                return a.idx < b.idx
            end)
            for n, r in ipairs(list) do
                r.slot.LayoutOrder = n
                local c = accentAt(n / math.max(#list, 1) * 0.25) -- rainbow fades down the list
                r.label.TextColor3 = c
                r.bar.BackgroundColor3 = c
                r.stroke.Color = c
            end
            if titleRow then
                titleRow.slot.LayoutOrder = 0
                local c = accentAt(0)
                titleRow.label.TextColor3 = c
                titleRow.bar.BackgroundColor3 = c
                titleRow.stroke.Color = c
                if titleRow.logoA then
                    titleRow.logoA.ImageColor3 = c
                end
            end
        end)
    end

    ------------------------------------------------------------------ reset button
    mk("Frame", { Name = "Spacer", BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 10), LayoutOrder = UI.nextOrder(page) }, page)
    local resetCard = mk("Frame", {
        Name = "ResetCard",
        BackgroundColor3 = PANEL,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, 34),
        LayoutOrder = UI.nextOrder(page)
    }, page)
    UI.corner(resetCard, 10)
    UI.stroke(resetCard, LINE)
    local resetBtn = mk("TextButton", {
        Name = "ResetBtn",
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 1, 0),
        Font = Enum.Font.GothamBold,
        TextSize = 12,
        TextColor3 = THEME.Text,
        Text = "Reset to default"
    }, resetCard)
    resetBtn.MouseButton1Click:Connect(function()
        St.h, St.s, St.v = DEFAULT.h, DEFAULT.s, DEFAULT.v
        St.rainbow = false
        St.speed = 1
        paintSpeed()
        St.font = "Gotham"
        applyFontAll()
        ddText.Text = "Gotham"
        setOpen(false)
        dirty = true
        saveSoon()
    end)

    ------------------------------------------------------------------ keep the picker in sync
    local function paint(h, s, v)
        local eff = Color3.fromHSV(h, s, v)
        local r8, g8, b8 = math.floor(eff.R * 255 + 0.5), math.floor(eff.G * 255 + 0.5), math.floor(eff.B * 255 + 0.5)
        swatch.BackgroundColor3 = eff
        if not hexBox:IsFocused() then
            hexBox.Text = string.format("#%02X%02X%02X", r8, g8, b8)
        end
        if not rgbBox:IsFocused() then
            rgbBox.Text = string.format("%d  %d  %d", r8, g8, b8)
        end
        hexBox.TextColor3 = (v > 0.35) and eff or THEME.Text
        sv.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
        svMark.Position = UDim2.new(s, 0, 1 - v, 0)
        hueMark.Position = UDim2.new(0.5, 0, h, 0)
        for _, pr in ipairs(presetRings) do
            pr.stroke.Enabled = (not St.rainbow)
                and math.abs(pr.s - St.s) < 0.02 and math.abs(pr.v - St.v) < 0.02
                and (pr.s < 0.08 or math.min(math.abs(pr.h - St.h), 1 - math.abs(pr.h - St.h)) < 0.01)
        end
        rbTrack.BackgroundColor3 = St.rainbow and eff or OFF_TRACK
        rbKnob.Position = St.rainbow and UDim2.new(1, -17, 0.5, -7) or UDim2.new(0, 3, 0.5, -7)
        rbKnob.BackgroundColor3 = St.rainbow and WHITE or OFF_KNOB
        spFill.BackgroundColor3 = eff
        list.ScrollBarImageColor3 = eff
        for name, b in pairs(optionBtns) do
            b.TextColor3 = (name == St.font) and eff or THEME.MutedText
        end
    end

    --// first pass: register every accent-colored element that exists right now
    sweepAll()
    applyAccent()
    paint(St.h, St.s, St.v)
    if St.font ~= "Gotham" then
        applyFontAll()
    end
    hookRoots()
    ddText.Text = St.font

    local lastApply, lastSweep, lastFont = 0, os.clock(), os.clock()
    local conn
    conn = RunService.RenderStepped:Connect(function(dt)
        if not isCurrent() or not page.Parent then
            conn:Disconnect()
            return
        end
        local now = os.clock()
        if St.rainbow then
            dirty = true
            St.phase = (St.phase + (dt * 0.12 * St.speed)) % 1
        end
        local custom = St.rainbow or math.abs(St.h - DEFAULT.h) > 1e-4 or math.abs(St.s - DEFAULT.s) > 1e-4 or math.abs(St.v - DEFAULT.v) > 1e-4
        if dirty and now - lastApply >= 0.04 then
            dirty = false
            lastApply = now
            if now - lastSweep >= 0.4 then
                lastSweep = now
                sweepAll()
            end
            local h, s, v = applyAccent()
            if not St.rainbow then
                h, s, v = St.h, St.s, St.v
            end
            paint(h, s, v)
        elseif custom and now - lastSweep >= 1 then
            lastSweep = now
            sweepAll()
        end
        if now - lastFont >= 1 then
            lastFont = now
            hookRoots()
            if St.font ~= "Gotham" then
                applyFontAll()
            end
        end
    end)
end

