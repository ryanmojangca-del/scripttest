-- Read-only diagnostic: lists available block-related bindings and remotes.
-- Does not invoke or alter any game actions.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local player = Players.LocalPlayer
local lines = {"KAMUI block binding diagnostic (read-only)"}
local function add(s) table.insert(lines, tostring(s)) end
local function inspectTree(label, root)
    add("--- " .. label .. " ---")
    if not root then add("Not found"); return end
    for _, child in ipairs(root:GetChildren()) do
        add(child.Name .. " [" .. child.ClassName .. "]")
        local name = string.lower(child.Name)
        if name:find("block", 1, true) or name:find("guard", 1, true) or name:find("defen", 1, true) then
            for _, desc in ipairs(child:GetDescendants()) do
                add("  " .. desc:GetFullName() .. " [" .. desc.ClassName .. "]")
            end
        end
    end
end
local keybind = ReplicatedStorage:FindFirstChild("Keybind")
inspectTree("ReplicatedStorage.Keybind.Combat", keybind and keybind:FindFirstChild("Combat"))
add("--- Other block/guard bindings or remotes ---")
local matches = 0
for _, obj in ipairs(ReplicatedStorage:GetDescendants()) do
    local n = string.lower(obj.Name)
    if n:find("block", 1, true) or n:find("guard", 1, true) or n:find("defen", 1, true) then
        if (keybind and obj:IsDescendantOf(keybind)) or obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction")
            or obj:IsA("BindableEvent") or obj:IsA("BindableFunction") then
            add(obj:GetFullName() .. " [" .. obj.ClassName .. "]")
            matches = matches + 1
            if matches >= 35 then add("(more matches omitted)"); break end
        end
    end
end
if matches == 0 then add("No named block/guard bindings or remotes found") end
local text = table.concat(lines, "\n")
print("[KAMUI] " .. text)
local root
local ok = pcall(function() root = (gethui and gethui()) or game:GetService("CoreGui") end)
if not ok or not root then root = player:WaitForChild("PlayerGui") end
local old = root:FindFirstChild("KAMUI_BlockBindingDiagnostic")
if old then old:Destroy() end
local gui = Instance.new("ScreenGui")
gui.Name = "KAMUI_BlockBindingDiagnostic"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.DisplayOrder = 999999
gui.Parent = root
local frame = Instance.new("Frame")
frame.Size = UDim2.new(0.8, 0, 0.75, 0)
frame.Position = UDim2.new(0.1, 0, 0.12, 0)
frame.BackgroundColor3 = Color3.fromRGB(16,16,20)
frame.BorderSizePixel = 0
frame.Parent = gui
local title = Instance.new("TextLabel")
title.Size = UDim2.new(1,-190,0,32)
title.Position = UDim2.fromOffset(8,0)
title.BackgroundTransparency = 1
title.TextColor3 = Color3.new(1,1,1)
title.Font = Enum.Font.Code
title.TextSize = 15
title.TextXAlignment = Enum.TextXAlignment.Left
title.Text = "BLOCK BINDINGS - read only"
title.Parent = frame
local function button(label, x, callback)
    local b = Instance.new("TextButton")
    b.Size = UDim2.fromOffset(80,28)
    b.Position = UDim2.new(1,x,0,2)
    b.Text = label
    b.BackgroundColor3 = Color3.fromRGB(54,36,36)
    b.TextColor3 = Color3.new(1,1,1)
    b.TextSize = 13
    b.Parent = frame
    b.Activated:Connect(callback)
    return b
end
button("Close", -84, function() gui:Destroy() end)
local copyButton
copyButton = button("Copy", -170, function()
    local copied = pcall(function()
        assert(type(setclipboard) == "function", "Clipboard unavailable")
        setclipboard(text)
    end)
    copyButton.Text = copied and "Copied!" or "No copy"
end)
local scroll = Instance.new("ScrollingFrame")
scroll.Size = UDim2.new(1,-16,1,-40)
scroll.Position = UDim2.fromOffset(8,36)
scroll.BackgroundTransparency = 1
scroll.BorderSizePixel = 0
scroll.ScrollBarThickness = 6
