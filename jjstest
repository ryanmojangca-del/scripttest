    local function looksNonAttack(char, track)
        if track.Looped then return "loop" end
        local animation = track.Animation
        for _, name in ipairs({ track.Name, animation and animation.Name or "" }) do
            local lower = string.lower(name or "")
            for _, word in ipairs(excludedNames) do
                if lower:find(word, 1, true) then return "name " .. word end
            end
        end
        -- Standard Roblox Animate slots contain the assets used for normal
        -- locomotion. Compare the IDs, not just the playing track's name.
        local animate = char:FindFirstChild("Animate")
        if animate and animation and animation.AnimationId ~= "" then
            for _, slot in ipairs(animate:GetChildren()) do
                if locomotionSlots[string.lower(slot.Name)] then
                    for _, asset in ipairs(slot:GetDescendants()) do
                        if asset:IsA("Animation") and asset.AnimationId == animation.AnimationId then
                            return "locomotion asset"
                        end
                    end
                end
            end
        end
        return nil
    end
    local function sendBlock(down)
        if down then
            if CC.BlockMobile then
                local storage = game:GetService("ReplicatedStorage")
                local keybind = storage:FindFirstChild("Keybind")
