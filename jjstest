--// MOVEMENT SETTINGS: DASH MULTIPLIER (toggle + Distance slider)
--// Distance scales the velocity of the game's dash (the "dodgevelocity" mover that appears in
--// your HumanoidRootPart while you dash), 0x - 10x. The dash time stays the same, so the
--// distance travelled may change depending on game physics. 1.00x = normal: the script does nothing.
--// It only affects YOUR dashes, never the ones this script performs (fireDash stamps the time
--// with _G.KAMUI_MarkScriptDash; a dash mover that shows up right after is the script's).
--// Debug: run `_G.KAMUI_DebugDash = true` first to print every dash mover and who it belongs to.
_G.KAMUI_Movement = { Enabled = true, Distance = 1.0, DistMin = 0, DistMax = 10, NoSideCD = false, NoStun = false, NoFatigue = false,
    SJEnabled = false, WalkSpeed = 25, JumpPower = 50, InfiniteParkour = false,
    Blinking = false, BlinkMax = 2.0, BlinkKey = "X", AutoStop = false, BlinkMobile = false, BlinkCapturing = false,
    FakeLag = false, FakeLagMs = 50, FakeLagKey = "Z", FakeLagMobile = false, FakeLagCapturing = false }
for _, c in ipairs(_G.KAMUI_MovementConns or {}) do
    pcall(function()
        c:Disconnect()
    end)
end
_G.KAMUI_MovementConns = {}
do
    local M = _G.KAMUI_Movement
    local conns = _G.KAMUI_MovementConns
    local SCRIPT_WINDOW = 0.8 -- a dash mover appearing this soon after fireDash() = script dash
    local states = setmetatable({}, { __mode = "k" }) -- dash mover -> { base, last, script, applied }
    -- Some versions use an unnamed BodyVelocity. Only consider it briefly
    -- after the player presses Q; never scale arbitrary movers at other times.
    local lastDashInput = -math.huge
    conns[#conns + 1] = UIS.InputBegan:Connect(function(input, processed)
        if isCurrent() and not UIS:GetFocusedTextBox()
            and input.UserInputType == Enum.UserInputType.Keyboard
            and input.KeyCode == Enum.KeyCode.Q then
            lastDashInput = os.clock()
        end
    end)

    local function velProp(m)
        return m:IsA("LinearVelocity") and "VectorVelocity" or "Velocity"
    end
    local function findDash(root)
        local char = root.Parent
        -- The PC diagnostic showed the dash BodyVelocity under Torso, not HRP.
        local torso = char and char:FindFirstChild("Torso")
        for _, part in ipairs(torso and { root, torso } or { root }) do
            local d = part:FindFirstChild("dodgevelocity")
            if d and (d:IsA("BodyVelocity") or d:IsA("LinearVelocity")) then return d end
            for _, c in ipairs(part:GetChildren()) do
                if c:IsA("BodyVelocity") or c:IsA("LinearVelocity") then
                    local n = string.lower(c.Name)
                    if n:find("dodge") or n:find("dash") then return c end
                end
            end
        end
        -- The game may parent the mover as BodyVelocity, then rename it to
        -- MovementForce. Restrict both names to the short manual-Q window to
        -- reduce the chance of scaling unrelated movement forces.
        if os.clock() - lastDashInput <= 0.35 then
            for _, part in ipairs(torso and { torso, root } or { root }) do
                for _, name in ipairs({ "MovementForce", "BodyVelocity" }) do
                    local candidate = part:FindFirstChild(name)
                    if candidate and candidate:IsA("BodyVelocity") then return candidate end
                end
            end
        end
        return nil
    end

    local function updateDashMultiplier()
        if not isCurrent() then
            return
        end
        local char = player.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not root then
            return
        end
        local dash = findDash(root)
        if not dash or not (dash:IsA("BodyVelocity") or dash:IsA("LinearVelocity")) then
            return
        end
        local prop = velProp(dash)
        local cur = dash[prop]
        local st = states[dash]
        if not st then
            --// first frame we see this dash: whose is it?
            st = {
                base = cur, last = cur, applied = false,
                script = (os.clock() - (_G.KAMUI_ScriptDashAt or -math.huge)) <= SCRIPT_WINDOW
            }
            states[dash] = st
            if _G.KAMUI_DebugDash then
                print("[KAMUI dash] mover:", dash.ClassName, dash.Name, st.script and "(script dash - untouched)" or "(your dash)")
            end
        end
        local mult = M.Distance
        local active = M.Enabled and not st.script and type(mult) == "number" and math.abs(mult - 1) >= 0.001
        if not active then
            if st.applied then -- turned off / reset mid-dash: give the normal speed back
                dash[prop] = st.base
                st.last = st.base
                st.applied = false
            end
            return
        end
        if (cur - st.last).Magnitude > 0.05 then
            st.base = cur -- the game changed it: that is the new unscaled value
        end
        local scaled = st.base * mult
        st.last = scaled
        st.applied = true
        dash[prop] = scaled
    end

    -- Update before physics on both PC and touch. This is still subject to
    -- game-side overwrites and server correction.
    conns[#conns + 1] = RunService.PreSimulation:Connect(updateDashMultiplier)
end

--// NO SIDE DASH COOLDOWN (toggle lives in the Movement tab, inside the Dash multiplier card)
--// Ported from the Rage tab of the other script. While ON it:
--//   1) sets your character attribute CustomSideDashCooldown to 0,
--//   2) sets the workspace flags NoDashCooldown = true / EffectAffects = 1 (the game's no-cooldown switch),
--//   3) destroys the dash cooldown markers (UsedDash / InDash / DashCooldown / SideDashCooldown) on your character.
--// Turning it OFF puts the workspace flags back to the values the game had and clears the attribute.
do
    local M = _G.KAMUI_Movement
    local conns = _G.KAMUI_MovementConns
    local MARKERS = { UsedDash = true, InDash = true, DashCooldown = true, SideDashCooldown = true }
    --// kept in _G so re-running the script can still restore the game's real values
    local orig = _G.KAMUI_NoSideCDOrig
    if not orig then
        orig = { captured = false }
        _G.KAMUI_NoSideCDOrig = orig
    end

    local function setServerFlags(on)
        pcall(function()
            if on then
                if not orig.captured then
                    orig.captured = true
                    orig.noDash = Workspace:GetAttribute("NoDashCooldown")
                    orig.effect = Workspace:GetAttribute("EffectAffects")
                end
                if Workspace:GetAttribute("NoDashCooldown") ~= true then
                    Workspace:SetAttribute("NoDashCooldown", true)
                end
                if Workspace:GetAttribute("EffectAffects") ~= 1 then
                    Workspace:SetAttribute("EffectAffects", 1)
                end
            elseif orig.captured then
                orig.captured = false
                Workspace:SetAttribute("NoDashCooldown", orig.noDash)
                Workspace:SetAttribute("EffectAffects", orig.effect)
            end
        end)
    end
    local function clearAttr(char)
        pcall(function()
            char:SetAttribute("CustomSideDashCooldown", nil)
            char:SetAttribute("AfterimageDash", nil)
        end)
    end

    --// a fresh run starts with the toggle OFF: give back anything an earlier run changed
    setServerFlags(false)

    --// kill the cooldown markers the moment the game adds them to your character
    local function hook(char)
        conns[#conns + 1] = char.DescendantAdded:Connect(function(d)
            if isCurrent() and M.NoSideCD and MARKERS[d.Name] then
                task.defer(function()
                    pcall(d.Destroy, d)
                end)
            end
        end)
    end
    if player.Character then
        hook(player.Character)
    end
    conns[#conns + 1] = player.CharacterAdded:Connect(hook)

    local wasOn = false
    conns[#conns + 1] = RunService.Heartbeat:Connect(function()
        if not isCurrent() then
            return
        end
        local char = player.Character
        if not M.NoSideCD then
            if wasOn then -- just turned off
                wasOn = false
                setServerFlags(false)
                if char then
                    clearAttr(char)
                end
            end
            return
        end
        wasOn = true
        setServerFlags(true)
        if not char then
            return
        end
        if char:GetAttribute("CustomSideDashCooldown") ~= 0 then
            pcall(char.SetAttribute, char, "CustomSideDashCooldown", 0)
        end
        for name in pairs(MARKERS) do
            local o = char:FindFirstChild(name)
            if o then
                pcall(o.Destroy, o)
            end
        end
    end)
end

--// NO STUN + NO FATIGUE (two separate toggles in the Movement tab, ported from the Rage tab of the other script)
--//   No stun    : destroys the "Freeze" stun marker as soon as the game puts it on your character.
--//   No fatigue : keeps your Humanoid JumpPower at 50 (the game lowers it while you are fatigued). It stays out of
--//                the way while you are in a state the game should control (Counter, HunterCounter, emotes,
--//                BeingLaunched, Ragdoll, Freeze, BarrageBind) or when the game marks you with NoJump.
do
    local M = _G.KAMUI_Movement
    local conns = _G.KAMUI_MovementConns
    local BLOCKERS = {
        "Counter", "HunterCounter", "DoingEmote", "CancelEmote", "CancelEmote2",
        "BeingLaunched", "Ragdoll", "Freeze", "BarrageBind", "NoJump"
    }
    local function blocked(char)
        for _, name in ipairs(BLOCKERS) do
            if char:FindFirstChild(name) then
                return true
            end
        end
        return false
    end

    --// remove Freeze the moment it appears (any depth under your character)
    local function hook(char)
        conns[#conns + 1] = char.DescendantAdded:Connect(function(d)
            if isCurrent() and M.NoStun and d.Name == "Freeze" then
                task.defer(function()
                    pcall(d.Destroy, d)
                end)
            end
        end)
    end
    if player.Character then
        hook(player.Character)
    end
    conns[#conns + 1] = player.CharacterAdded:Connect(hook)

    conns[#conns + 1] = RunService.Heartbeat:Connect(function()
        if not isCurrent() then
            return
        end
        if not M.NoStun then
            return
        end
        local char = player.Character
        if not char then
            return
        end
        if M.NoStun then
            local f = char:FindFirstChild("Freeze")
            if f then
                pcall(f.Destroy, f)
            end
        end
    end)

    --// WALKSPEED / JUMP HEIGHT: while enabled, holds Humanoid.WalkSpeed and JumpPower at the slider values.
    --// Same hands-off rule as No fatigue (blocked states). Turning it off puts back the normal 16 / 50 once.
    local wasOn = false
    local function updateWalkJump()
        if not isCurrent() then
            return
        end
        local char = player.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not hum then
            return
        end
        if M.SJEnabled then
            wasOn = true
            if not blocked(char) then
                pcall(function()
                    if hum.WalkSpeed ~= M.WalkSpeed then
                        hum.WalkSpeed = M.WalkSpeed
                    end
                    if hum.JumpPower ~= M.JumpPower or not hum.UseJumpPower then
                        hum.UseJumpPower = true
                        hum.JumpPower = M.JumpPower
                    end
                end)
            end
        elseif wasOn then
            wasOn = false
            pcall(function()
                hum.WalkSpeed = 16
                hum.JumpPower = 50
            end)
        end
    end
    -- Set properties before physics on both PC and touch, retaining blockers.
    conns[#conns + 1] = RunService.PreSimulation:Connect(updateWalkJump)

    -- PC and mobile fallback: if the game ignores JumpPower, apply the selected
    -- vertical speed once when a genuine humanoid jump begins. Never creates
    -- jumps itself, and preserves the same blocker checks as WalkSpeed.
    local jumpConn, pendingJump = nil, nil
    local function hookMobileJump(char)
        if jumpConn then jumpConn:Disconnect(); jumpConn = nil end
        pendingJump = nil
        task.spawn(function()
            local hum = char:FindFirstChildOfClass("Humanoid") or char:WaitForChild("Humanoid", 10)
            if not isCurrent() or player.Character ~= char or not hum or not hum:IsA("Humanoid") then return end
            jumpConn = hum.StateChanged:Connect(function(_, newState)
                if isCurrent() and player.Character == char and newState == Enum.HumanoidStateType.Jumping
                    and M.SJEnabled and not M.Blinking and not blocked(char)
                    and math.abs(M.JumpPower - 50) > 0.001 then
                    pendingJump = { char = char, hum = hum, started = os.clock() }
                end
            end)
            conns[#conns + 1] = jumpConn
        end)
    end
    if player.Character then hookMobileJump(player.Character) end
    conns[#conns + 1] = player.CharacterAdded:Connect(hookMobileJump)
    conns[#conns + 1] = RunService.PreSimulation:Connect(function()
        local pending = pendingJump
        if not pending then return end
        pendingJump = nil -- one correction for each detected jump
        if not isCurrent() or player.Character ~= pending.char
            or not M.SJEnabled or M.Blinking or blocked(pending.char)
            or pending.hum.Health <= 0 or os.clock() - pending.started > 0.15 then return end
        local state = pending.hum:GetState()
        if state ~= Enum.HumanoidStateType.Jumping and state ~= Enum.HumanoidStateType.Freefall then return end
        local root = pending.char:FindFirstChild("HumanoidRootPart")
        if root and not root.Anchored then
            pcall(function()
                local velocity = root.AssemblyLinearVelocity
                root.AssemblyLinearVelocity = Vector3.new(velocity.X, math.max(0, M.JumpPower), velocity.Z)
            end)
        end
    end)
end

--// INFINITE PARKOUR: reset the live JJS Parkour function's client-side counter.
--// Based on the inspected MovementController: the counter is the only number
--// among the Parkour closure's upvalues; its animation table contains BounceL/R.
--// JJS still handles wall checks, movement forces, sounds, and animations.
--// If the live controller does not match that signature, this does nothing.
do
    local M, conns = _G.KAMUI_Movement, _G.KAMUI_MovementConns
    local alive, scanning, wasEnabled = true, false, false
    local target, counterIndex, nextScan = nil, nil, 0
    local function log(message)
        if _G.KAMUI_ParkourDiagnostic then
            _G.KAMUI_ParkourDiagnostic("IP: " .. message)
        end
    end
    local function active()
        return alive and isCurrent() and ScreenGui and ScreenGui.Parent ~= nil
    end
    local function inspect(fn)
        local ok, values = pcall(debug.getupvalues, fn)
        if not ok or type(values) ~= "table" then return nil end
        local numericIndex, count, hasBounce, hasParams, hasAnimation = nil, 0, false, false, false
        for index, value in pairs(values) do
            if type(index) == "number" then
                if type(value) == "number" then
                    count = count + 1
                    numericIndex = index
                    if value < 0 or value > 4 or value % 1 ~= 0 then return nil end
                elseif type(value) == "table" then
                    if type(rawget(value, "BounceL")) == "table"
                        and type(rawget(value, "BounceR")) == "table" then hasBounce = true end
                elseif typeof(value) == "RaycastParams" then
                    hasParams = true
                elseif typeof(value) == "Instance" and value:IsA("Animation") and value.Name == "Parkour" then
                    hasAnimation = true
                end
            end
        end
        if count == 1 and hasBounce and hasParams and hasAnimation then return numericIndex end
        return nil
    end
    local function findController()
        if type(getgc) ~= "function" or type(debug.getupvalues) ~= "function"
            or type(debug.getupvalue) ~= "function" or type(debug.setupvalue) ~= "function" then
            return nil, nil, "Real debug/getgc functions unavailable"
        end
        local ok, objects = pcall(getgc, true)
        if not ok or type(objects) ~= "table" then return nil, nil, "could not scan live controllers" end
        local found, selectedIndex, seen = nil, nil, {}
        for _, object in ipairs(objects) do
            if type(object) == "table" and rawget(object, "Name") == "MovementController"
                and type(rawget(object, "Parkour")) == "function"
                and type(rawget(object, "Dash")) == "function" then
                local fn = rawget(object, "Parkour")
                if not seen[fn] then
                    seen[fn] = true
                    local index = inspect(fn)
                    if index then
                        if found then return nil, nil, "multiple matching controllers; no changes made" end
                        found, selectedIndex = fn, index
                    end
                end
            end
        end
        if not found then return nil, nil, "native controller/counter not found" end
        return found, selectedIndex
    end
    conns[#conns + 1] = RunService.PreSimulation:Connect(function()
        if not active() then return end
        if not M.InfiniteParkour then
            if wasEnabled then log("native counter reset disabled") end
            wasEnabled, target, counterIndex = false, nil, nil
            return
        end
        if not wasEnabled then
            wasEnabled, nextScan = true, 0
            log("searching for native parkour counter")
        end
        if not target then
            if not scanning and os.clock() >= nextScan then
                scanning, nextScan = true, os.clock() + 5
                task.spawn(function()
                    local fn, index, reason = findController()
                    scanning = false
                    if not active() or not M.InfiniteParkour then return end
                    target, counterIndex = fn, index
                    log(fn and ("native counter found at upvalue " .. index) or reason)
                end)
            end
            return
        end
        local ok, value = pcall(debug.getupvalue, target, counterIndex)
        if not ok or type(value) ~= "number" or value < 0 or value > 4 or value % 1 ~= 0 then
            target, counterIndex, nextScan = nil, nil, os.clock() + 5
            log("counter changed unexpectedly; stopped and will rescan")
            return
        end
        if value > 0 then
            local success, err = pcall(debug.setupvalue, target, counterIndex, 0)
            if not success then
                target, counterIndex, nextScan = nil, nil, os.clock() + 5
                log("counter reset failed: " .. tostring(err))
            else
                log("native counter reset (was " .. tostring(value) .. ")")
            end
        end
    end)
    conns[#conns + 1] = ScreenGui.Destroying:Connect(function() alive = false end)
end

--// FAKE LAG (Movement tab) - adds ping while ON
--// Uses settings().Network.IncomingReplicationLag (seconds): everything the server sends you arrives that much later,
--// so your connection behaves like it has +N ms of ping. Slider = N (50 - 5000 ms), tap the number to type an exact value.
--//   * Toggle it with the keybind (default Z, changeable in the Movement tab), the switch, or the on-screen button (Mobile mode).
--//   * The original value is put back when you turn it OFF and when the script is destroyed / re-executed.
--//   * If your executor does not allow settings().Network the console says so and it stays OFF.
do
    local M = _G.KAMUI_Movement
    local conns = _G.KAMUI_MovementConns
    local original = nil -- IncomingReplicationLag before we touched it

    local function net()
        local ok, n = pcall(function()
            return settings().Network
        end)
        if ok and n then
            return n
        end
        return nil
    end

    local function restore()
        local n = net()
        if n and original ~= nil then
            pcall(function()
                n.IncomingReplicationLag = original
            end)
        end
        original = nil
    end
    --// a re-execution while Fake lag is on puts the old value back first
    if _G.KAMUI_FakeLagRestore then
        pcall(_G.KAMUI_FakeLagRestore)
    end
    _G.KAMUI_FakeLagRestore = restore

    --// returns true, or false + reason
    local function apply()
        local n = net()
        if not n then
            return false, "settings().Network is not available in this executor"
        end
        local ok, err = pcall(function()
            if original == nil then
                original = n.IncomingReplicationLag
            end
            n.IncomingReplicationLag = math.clamp(M.FakeLagMs or 50, 0, 5000) / 1000
        end)
        if not ok then
            original = nil
            return false, tostring(err)
        end
        return true
    end

    --// called by the slider: re-applies the new ms while Fake lag is ON
    M.FakeLagApply = function()
        if M.FakeLag then
            apply()
        end
    end

    M.FakeLagSet = function(on)
        on = on and true or false
        if on == M.FakeLag then
            return
        end
        if on then
            local ok, why = apply()
            if not ok then
                warn("[KAMUI fakelag] could not start: " .. tostring(why))
                if M.FakeLagPaint then
                    pcall(M.FakeLagPaint)
                end
                return
            end
            M.FakeLag = true
            print("[KAMUI fakelag] ON - +" .. tostring(M.FakeLagMs) .. " ms")
        else
            M.FakeLag = false
            restore()
            print("[KAMUI fakelag] OFF")
        end
        if M.FakeLagPaint then
            pcall(M.FakeLagPaint)
        end
    end

    conns[#conns + 1] = UIS.InputBegan:Connect(function(input, processed)
        if not isCurrent() then
            return
        end
        --// the keybind chip in the Movement tab was clicked: the next key pressed becomes the Fake lag key
        if M.FakeLagCapturing and input.UserInputType == Enum.UserInputType.Keyboard then
            M.FakeLagCapturing = false
            if input.KeyCode ~= Enum.KeyCode.Escape then
                M.FakeLagKey = input.KeyCode.Name
            end
            if M.FakeLagPaint then
                pcall(M.FakeLagPaint)
            end
            return
        end
        if processed or UIS:GetFocusedTextBox() or M.BlinkCapturing then
            return
        end
        if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode.Name == M.FakeLagKey then
            M.FakeLagSet(not M.FakeLag)
        end
    end)
end


