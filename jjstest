    --// judges one nearby player animation once per playback; action priority is a heuristic
    local function judge(plr, track)
        if seenTracks[track] then
            return
        end
        -- Only mark an accepted track; a track outside range may enter range
        -- while playing, and a reused track is reset on AnimationPlayed.
        if counterActive or (not CC.Block and not CC.Counter) then
            return
        end
        local char = player.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local oc = plr.Character
        local oroot = oc and oc:FindFirstChild("HumanoidRootPart")
        if not root or not hum or hum.Health <= 0 or not oroot then
            return
        end
        local toMe = Vector3.new(root.Position.X - oroot.Position.X, 0, root.Position.Z - oroot.Position.Z)
        local dist = toMe.Magnitude
        local canCounter = CC.Counter and dist <= CC.CounterRange
        local canBlock = CC.Block and dist <= CC.BlockRange
        -- This side-dash animation was supplied by the user. Exclude it from
        -- Auto block only; Auto counter retains its existing detection rules.
        local anim = track.Animation
        local animId = anim and tostring(anim.AnimationId):match("%d+")
        if canBlock and animId == "138196552148011" then
            canBlock = false
            if not canCounter then
                trackLog(track, "skip side dash", dist)
                return
            end
        end
        if dist <= 0.1 or (not canCounter and not canBlock) then return end
        if track.Priority.Value < Enum.AnimationPriority.Action.Value then
            trackLog(track, "skip priority", dist); return
        end
        local reason = looksNonAttack(oc, track)
        if reason then trackLog(track, "skip " .. reason, dist); return end
        if (speedOf[plr] or 0) >= CC.Speed then
            trackLog(track, "skip high speed", dist); return
        end
        if track.TimePosition >= 0.25 then
            trackLog(track, "skip late", dist); return
        end
        local look = Vector3.new(oroot.CFrame.LookVector.X, 0, oroot.CFrame.LookVector.Z)
        local facing = look.Magnitude > 0.01 and look.Unit:Dot(toMe.Unit) or 0
        if facing <= 0.3 then trackLog(track, "skip facing", dist); return end
        if os.clock() < ownAttackUntil then
            -- Mark it checked so a hit reaction cannot trigger after the pause.
            seenTracks[track] = true
            trackLog(track, "skip own attack", dist)
            return
        end
        seenTracks[track] = true
        trackLog(track, "accepted", dist)
        if canCounter then startCounter(plr, track); return end
        if not blocking then
            blocking = sendBlock(true)
            if blocking then blockStartedAt = os.clock() end
        end
        if blocking then
            blockTarget = plr
            CC.BlockCamActive = CC.BlockCamEnabled
            local hold = BLOCK_HOLD
            if CC.BlockMobile and CC.BlockM1Back then
                -- Prioritize a faster counter after an automatic block attempt.
                -- This short hold can miss delayed/multi-hit skills.
                hold = 0.25
            elseif CC.BlockMobile then
                -- The opponent's InSkill marker and animation duration are
                -- heuristics, not authoritative attack classification.
                local startedAt = os.clock()
                local owner = nativeBlock
                local function mobileHold()
                    local info = oc and oc:FindFirstChild("Info")
                    local skillMarker = info and info:FindFirstChild("InSkill")
                    local duration, remaining = 0, 0
                    if track.Length > 0 and track.Speed > 0 then
                        duration = track.Length / track.Speed
                        remaining = math.max(0, (track.Length - track.TimePosition) / track.Speed)
                    end
                    if skillMarker or duration > 0.65 then
                        -- Unknown duration with an InSkill marker gets a
                        -- conservative hold; long animations are capped.
                        return math.clamp(remaining > 0 and remaining or 0.85, 0.65, 1.5)
                    end
                    return 0.30
                end
                hold = mobileHold()
                -- Animation length/skill markers can arrive just after
                -- AnimationPlayed; recheck while the same owned guard is active.
                for _, delaySeconds in ipairs({0.08, 0.18}) do
                    task.delay(delaySeconds, function()
                        if not isCurrent() or not CC.Block or not CC.BlockMobile or CC.BlockM1Back
                            or not blocking or nativeBlock ~= owner or blockTarget ~= plr
                            or not track.IsPlaying then return end
                        local adjusted = mobileHold()
                        if adjusted > 0.30 then
                            local untilTime = math.min(startedAt + 1.5, os.clock() + adjusted)
                            if untilTime > blockUntil then
                                blockUntil = untilTime
                                blockLog(string.format("native guard extended: %.2fs", untilTime - os.clock()))
                            end
                        end
                    end)
                end
            elseif CC.BlockM1Back then
                -- Counterattack sooner, at the cost of a shorter guard.
                hold = 0.20
            elseif track.Length > 0 and track.Speed > 0 then
                hold = math.clamp((track.Length - track.TimePosition) / track.Speed, BLOCK_HOLD, 1.5)
