--// ============================================================
--// KAMUI MINIMAL SKIN  (black + red, sidebar menu look)
--// Wrapped in a function so it adds NO top-level locals.
--// Also restyles the Macro / Backdash / M1 Emote windows when they open.
--// ============================================================
_G.KAMUI_SkinInit = function()
    local CoreGui = game:GetService("CoreGui")
    local LINE = Color3.fromRGB(46, 46, 48)
    local CARD = Color3.fromRGB(15, 15, 16)
    local OFF_TRACK = Color3.fromRGB(42, 42, 45)
    local function skipped(inst)
        local n = inst.Name
        return n == "RestoreButton"
            or n == "RestoreImage"
            or n == "MobileTrigger" or n == "Knob" or n == "TabButton" or n == "RowSwitch" or n == "RowKnob"
    end
    local function ensureCorner(inst, radius)
        local c = inst:FindFirstChildOfClass("UICorner")
        if not c then
            c = Instance.new("UICorner")
            c.Parent = inst
        end
        c.CornerRadius = radius
    end
    local function ensureStroke(inst, alpha)
        if inst:FindFirstChildOfClass("UIStroke") then
            return
        end
        local s = Instance.new("UIStroke")
        s.Name = "SkinStroke"
        s.Color = LINE
        s.Thickness = 1
        s.Transparency = alpha or 0
        s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
        s.Parent = inst
    end
    --// full-width button inside a tab = "label on the left, switch / value on the right"
    local function isRowButton(inst)
        local p = inst.Parent
        local s = inst.Size
        return p ~= nil and p:IsA("ScrollingFrame")
            and p.Parent == ContainerHolder -- tab pages only (not the "?" popup)
            and s.X.Scale >= 0.95 and s.Y.Scale == 0 and s.Y.Offset >= 26 and s.Y.Offset <= 44
    end
    local function buildRow(btn)
        btn.BackgroundColor3 = CARD
        btn.BackgroundTransparency = 0
        btn.TextTransparency = 1
        ensureCorner(btn, UDim.new(0, 8))
        ensureStroke(btn, 0)
        for _, child in ipairs(btn:GetChildren()) do
            if child:IsA("Frame")
                and child.Size.X.Scale == 0
                and child.Size.Y.Scale == 0
                and child.Size.X.Offset <= 12
                and child.Size.Y.Offset <= 12 then
                child.Visible = false -- old status dot
            end
        end
        local label = Instance.new("TextLabel")
        label.Name = "RowLabel"
        label.Parent = btn
        label.BackgroundTransparency = 1
        label.Size = UDim2.new(1, -90, 1, 0)
        label.Position = UDim2.new(0, 12, 0, 0)
        label.Font = Enum.Font.GothamMedium
        label.TextSize = 12
        label.TextXAlignment = Enum.TextXAlignment.Left
        label.TextColor3 = THEME.Text
        local value = Instance.new("TextLabel")
        value.Name = "RowValue"
        value.Parent = btn
        value.BackgroundTransparency = 1
        value.Size = UDim2.new(0, 80, 1, 0)
        value.Position = UDim2.new(1, -92, 0, 0)
        value.Font = Enum.Font.Gotham
        value.TextSize = 11
        value.TextXAlignment = Enum.TextXAlignment.Right
        value.TextColor3 = THEME.MutedText
        local track = Instance.new("Frame")
        track.Name = "RowSwitch"
        track.Parent = btn
        track.BorderSizePixel = 0
        track.Size = UDim2.new(0, 36, 0, 20)
        track.Position = UDim2.new(1, -48, 0.5, -10)
        local trackCorner = Instance.new("UICorner")
        trackCorner.CornerRadius = UDim.new(1, 0)
        trackCorner.Parent = track
        local knob = Instance.new("Frame")
        knob.Name = "RowKnob"
        knob.Parent = track
        knob.BorderSizePixel = 0
        knob.Size = UDim2.new(0, 14, 0, 14)
        local knobCorner = Instance.new("UICorner")
        knobCorner.CornerRadius = UDim.new(1, 0)
        knobCorner.Parent = knob
        local function refresh()
            local raw = tostring(btn.Text):gsub("^%s+", ""):gsub("%s+$", "")
            local name, val = raw:match("^(.-):%s*(.+)$")
            if not name then
                name = raw
                val = nil
            end
            local renamed = ({
                ["Mode Switch"] = "Mode",
                ["Cam Smooth"] = "Cam smooth",
                ["Floater Mode"] = "Floater mode",
                ["Touch Mode"] = "Touch mode",
                ["Cooldown System"] = "Cooldown system"
            })[name]
            label.Text = renamed or name
            local up = val and val:upper() or nil
            if up == "ON" or up == "OFF" then
                local on = up == "ON"
                track.Visible = true
                value.Visible = false
                track.BackgroundColor3 = on and THEME.BrightRed or OFF_TRACK
                knob.Position = on and UDim2.new(1, -17, 0.5, -7) or UDim2.new(0, 3, 0.5, -7)
                knob.BackgroundColor3 = on and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(189, 184, 184)
                label.TextColor3 = THEME.Text
            else
                track.Visible = false
                value.Visible = val ~= nil and not btn:GetAttribute("KamuiSegmented")
                value.Text = val or ""
                label.TextColor3 = THEME.Text
            end
        end
        refresh()
        btn:GetPropertyChangedSignal("Text"):Connect(refresh)
    end
    local function skin(inst)
        if not inst or not inst.Parent or skipped(inst) then
            return
        end
        if inst:GetAttribute("KamuiSkinned") then
            return
        end
        if inst:IsA("TextButton") then
            if inst.BackgroundTransparency >= 1 then
                return -- text-only buttons stay as they are
            end
            inst:SetAttribute("KamuiSkinned", true)
            if isRowButton(inst) then
                buildRow(inst)
                return
            end
            local h = inst.Size.Y
            if h.Scale == 0 and h.Offset > 0 and h.Offset <= 44 then
                ensureCorner(inst, UDim.new(0.5, 0)) -- pill
            end
            if inst.Text ~= "" then
                ensureStroke(inst, 0.2) -- switches (no text) stay stroke-free
            end
        elseif inst:IsA("TextBox") then
            inst:SetAttribute("KamuiSkinned", true)
            ensureCorner(inst, UDim.new(0, 8))
            ensureStroke(inst, 0)
        elseif inst:IsA("Frame") then
            local corner = inst:FindFirstChildOfClass("UICorner")
            local h = inst.Size.Y
            if corner
                and inst.BackgroundTransparency < 1
                and h.Scale == 0
                and h.Offset >= 40
                and h.Offset <= 90
                and corner.CornerRadius.Offset < 50 then
                inst:SetAttribute("KamuiSkinned", true)
                corner.CornerRadius = UDim.new(0, 10)
                ensureStroke(inst, 0)
            end
        end
    end
    local function skinGui(g)
        if not g or not g:IsA("ScreenGui") then
            return
        end
        local n = g.Name
        if n:find("_Restore$") then
            return
        end
        if n == "WOOjIEUI" or n:find("^KAMUI_") then
            if g:GetAttribute("KamuiSkinHooked") then
                return
            end
            g:SetAttribute("KamuiSkinHooked", true)
            for _, d in ipairs(g:GetDescendants()) do
                skin(d)
            end
            g.DescendantAdded:Connect(function(d)
                task.defer(skin, d)
            end)
        end
    end
    skinGui(ScreenGui)
    for _, g in ipairs(CoreGui:GetChildren()) do
        skinGui(g)
    end
    CoreGui.ChildAdded:Connect(function(g)
        if not isCurrent() then
            return
        end
        task.defer(skinGui, g)
    end)
end
_G.KAMUI_SkinInit()

--// ============================================================
--// WINDOW DRAGGING
--// Replaces Roblox's built-in Draggable, which also moved the window
--// while dragging a slider. The window now only moves when you press
--// on empty space (title bar, sidebar, gaps) - never on a slider,
--// button or text box. Wrapped in a function: adds no top-level locals.
--// ============================================================
_G.KAMUI_DragInit = function()
    local dragging = false
    local dragStart
    local startPos
    local function overControl(position)
        local ok, objects = pcall(function()
            return UIS:GetGuiObjectsAtPosition(position.X, position.Y)
        end)
        if not ok then
            return false
        end
        for _, obj in ipairs(objects) do
            if obj ~= MainFrame and obj:IsDescendantOf(MainFrame) then
                if obj:GetAttribute("KamuiNoDrag")
                    or obj:IsA("TextButton")
                    or obj:IsA("TextBox")
                    or obj:IsA("ImageButton") then
                    return true
                end
            end
        end
        return false
    end
    MainFrame.InputBegan:Connect(function(input)
        if not isCurrent() then
            return
        end
        if input.UserInputType ~= Enum.UserInputType.MouseButton1
            and input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end
        if overControl(input.Position) then
            return
        end
        local pressPos = input.Position
        local pressFrame = MainFrame.Position
        -- Wait until all other handlers for this press have run. If a slider
        -- grabbed it, do NOT start moving the window.
        task.defer(function()
            if _G.KAMUI_SliderHeld then
                return
            end
            if input.UserInputState == Enum.UserInputState.End then
                return
            end
            dragging = true
            dragStart = pressPos
            startPos = pressFrame
        end)
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end)
    UIS.InputChanged:Connect(function(input)
        if not dragging or not isCurrent() then
            return
        end
        if _G.KAMUI_SliderHeld then
            dragging = false
            return
        end
        if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then
            local delta = input.Position - dragStart
            MainFrame.Position = UDim2.new(
                startPos.X.Scale,
                startPos.X.Offset + delta.X,
                startPos.Y.Scale,
                startPos.Y.Offset + delta.Y
            )
        end
    end)
    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
end
_G.KAMUI_DragInit()
