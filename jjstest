            blockLog("M1 Back sent")
            -- Always release the synthetic click, even if the script stops.
            task.delay(0.04, function()
                pcall(function() VirtualInputManager:SendMouseButtonEvent(pos.X, pos.Y, 0, false, game, 0) end)
            end)
        end)
    end
    -- The mobile GUI can bypass Melee.Pressed. The diagnostic showed these
