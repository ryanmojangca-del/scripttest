        end
        local function findMover(root)
            for _, m in ipairs(root:GetChildren()) do
                if m:IsA("BodyVelocity") or m:IsA("LinearVelocity") then
                    local n = string.lower(m.Name)
                    if n:find("dodge") or n:find("dash") then return m end
                end
            end
            return nil
        end
        -- Native JJS Dash creates BodyVelocity named MovementForce on Torso,
        -- with an InDash marker in Info; it does not use dodgevelocity on root.
        local function findChainDashMover(root)
            local char = root and root.Parent
            local info = char and char:FindFirstChild("Info")
            local torso = char and char:FindFirstChild("Torso")
            if not info or not info:FindFirstChild("InDash") or not torso then return nil end
            local mover = torso:FindFirstChild("MovementForce")
            return mover and mover:IsA("BodyVelocity") and mover or nil
        end
        local function moverToWorld(m, v)
            if not m:IsA("LinearVelocity") or m.RelativeTo == Enum.ActuatorRelativeTo.World then return v end
            local a = m.RelativeTo == Enum.ActuatorRelativeTo.Attachment0 and m.Attachment0 or m.Attachment1
            return a and a.WorldCFrame:VectorToWorldSpace(v) or nil
        end
        local function moverFromWorld(m, v)
            if not m:IsA("LinearVelocity") or m.RelativeTo == Enum.ActuatorRelativeTo.World then return v end
            local a = m.RelativeTo == Enum.ActuatorRelativeTo.Attachment0 and m.Attachment0 or m.Attachment1
            return a and a.WorldCFrame:VectorToObjectSpace(v) or nil
        end
        -- With a mover, the user's mobile dash is already in progress; do not synthesize keys.
        -- Without one, keep the original PC keybind behavior.
        local function dashOnce(existingMover, chainTarget, onFinished)
            local fromChain = chainTarget ~= nil
            local function dashEnabled()
                return fromChain and CC.ChainMode or (not fromChain and SA.Enabled)
            end
            if not dashEnabled() or SA.Busy or not isCurrent() then return end
            local char = player.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if not root or not hum or hum.Health <= 0 then return end
            if existingMover then
                if existingMover.Parent ~= root then return end
            elseif (fromChain and findChainDashMover(root)) or findMover(root) then return end
            local target = chainTarget or closestTarget(root)
            if not target or (not existingMover and not VirtualInputManager) then return end
            -- Do not release or interfere with a Q key the player is already holding.
            if not existingMover and UIS:IsKeyDown(Enum.KeyCode.Q) then return end
            local targetHum = target.Parent and target.Parent:FindFirstChildOfClass("Humanoid")
            local right = flat(target.CFrame.RightVector)
            if right.Magnitude < 0.01 then return end
            right = right.Unit
            local sideSign = flat(root.Position - target.Position):Dot(right) < 0 and -1 or 1
            local chosenMode = fromChain and "Behind" or SA.Mode
            local function destination()
                if chosenMode == "Behind" then
                    local forward = flat(target.CFrame.LookVector)
                    if forward.Magnitude < 0.01 then return nil end
                    return target.Position - forward.Unit * 3.5
                end
                local side = flat(target.CFrame.RightVector)
                if side.Magnitude < 0.01 then return nil end
                return target.Position + side.Unit * (3.5 * sideSign)
            end
            local dest = destination()
            local cam = Workspace.CurrentCamera
            if not dest or not cam then return end
            local startPos = flat(root.Position)
            local sideGoal = flat(dest)
            -- Behind follows an arc around the target instead of aiming at
            -- time-based points that can make the dash cut across the middle.
            -- The target's position is followed; behind is based on the
            -- direction it was facing when the dash started.
            local curve, hook
            local delta = sideGoal - startPos
            if chosenMode == "Side" then
                local toward = flat(target.Position - root.Position)
                if toward.Magnitude < 0.1 then return end
                toward = toward.Unit
                local flank = Vector3.new(-toward.Z, 0, toward.X)
                if flank:Dot(right * sideSign) < 0 then flank = -flank end
                -- First travel beyond the nearest flank, then curl back inward.
                local entry = flat(target.Position) + flank * 5 + toward * 1.2
                local toEntry = entry - startPos
                if toEntry.Magnitude < 0.1 then return end
                hook = {
                    toward = toward,
                    flank = flank,
                    start = startPos,
                    initialDirection = toEntry.Unit,
                    entryDistance = toEntry.Magnitude,
                    progress = 0,
                }
                delta = toEntry
            end
            if chosenMode == "Behind" then
                local radial = flat(root.Position - target.Position)
                local back = flat(dest - target.Position)
                if radial.Magnitude < 0.1 or back.Magnitude < 0.1 then return end
                local startAngle = math.atan2(radial.Z, radial.X)
                local endAngle = math.atan2(back.Z, back.X)
                local side = right * sideSign
                local sideAngle = math.atan2(side.Z, side.X)
                local tau = 2 * math.pi
                local ccw = (endAngle - startAngle) % tau
                local viaSide = (sideAngle - startAngle) % tau
                local sweep = viaSide <= ccw and ccw or ccw - tau
                -- Avoid an unnecessary full circle if starting near behind.
                if math.abs(sweep) > math.pi * 1.25 then
                    sweep = sweep > 0 and math.pi * 1.25 or -math.pi * 1.25
                end
                if math.abs(sweep) > 0.1 then
                    curve = {
                        direction = sweep > 0 and 1 or -1,
                        sweep = math.abs(sweep),
                        lastAngle = startAngle,
                        travelled = 0,
                        radius = radial.Magnitude,
                        back = back.Unit,
                    }
                    local unit = radial.Unit
                    delta = Vector3.new(-unit.Z, 0, unit.X) * curve.direction
                end
            end
            if delta.Magnitude < (curve and 0.01 or 0.75) then return end
            -- Face the CAMERA perpendicular to the initial travel direction,
            -- so left/right dash input starts toward the intended path.
            local dashDirection = delta.Unit
            local rightDashFacing = Vector3.new(dashDirection.Z, 0, -dashDirection.X)
            local currentFacing = flat(cam.CFrame.LookVector)
            local useRight = currentFacing:Dot(rightDashFacing) >= 0
            local dashKey = useRight and Enum.KeyCode.D or Enum.KeyCode.A
            local cameraFacing = useRight and rightDashFacing or -rightDashFacing
            local cameraPitch = math.clamp(cam.CFrame.LookVector.Y, -0.99, 0.99)
            local function faceCameraSideways()
                if not cam.Parent or Workspace.CurrentCamera ~= cam then return false end
                local pos = cam.CFrame.Position
                local horizontal = math.sqrt(1 - cameraPitch * cameraPitch)
                local look = cameraFacing * horizontal + Vector3.new(0, cameraPitch, 0)
                cam.CFrame = CFrame.lookAt(pos, pos + look)
                return true
            end
            if not existingMover and not faceCameraSideways() then return end
            -- Mobile has already started its dash; PC still faces sideways before input.
            local moverSeen = existingMover ~= nil
            local cameraBinding = "KAMUI_SideAssistCamera_" .. tostring(scriptId)
            pcall(function()
                RunService:BindToRenderStep(cameraBinding, Enum.RenderPriority.Camera.Value + 1, function()
