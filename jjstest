--// ============================================================
--// GUI TAB (Extras): accent color picker, rainbow mode, font dropdown
--// Recolors only the RED accent (never the black surfaces). Everything lives in
--// this function, so no top-level locals are added. Saved in KAMUI_GUI.json.
--// ============================================================
_G.KAMUI_BuildGUI = function(UI)
    local G = _G.KAMUI_GuiTab
    local page = G and G.Page
    if not page then
        return
    end
    UI.setupPage(page)
    local PANEL, CHIP, LINE, HEAD = UI.PANEL, UI.CHIP, UI.LINE, UI.HEAD
    local WHITE = Color3.fromRGB(255, 255, 255)
    local OFF_TRACK = Color3.fromRGB(42, 42, 45)
    local OFF_KNOB = Color3.fromRGB(189, 184, 184)
    local FILE = "KAMUI_GUI.json"

    local function mk(class, props, parent)
        local o = UI.make(class, props, parent)
        o:SetAttribute("KamuiSkinned", true) -- keep the old skin pass away from these
        return o
    end

    ------------------------------------------------------------------ accent engine
    --// every red the script uses (hardcoded or via THEME). Skill colors (255,0,0) are NOT here.
    local FAMILY = {
        { 52, 8, 12 }, { 58, 10, 15 }, { 80, 0, 8 }, { 90, 18, 24 }, { 92, 12, 18 }, { 100, 12, 20 },
        { 110, 0, 10 }, { 205, 18, 20 }, { 215, 12, 22 }, { 235, 24, 22 }, { 240, 30, 24 }, { 255, 24, 30 }
    }
    local function key(c)
        return math.floor(c.R * 255 + 0.5) * 65536 + math.floor(c.G * 255 + 0.5) * 256 + math.floor(c.B * 255 + 0.5)
    end
    local ORIG, CUR = {}, {}
    for _, t in ipairs(FAMILY) do
        local c = Color3.fromRGB(t[1], t[2], t[3])
        local h, s, v = c:ToHSV()
        ORIG[key(c)] = { h = h, s = s, v = v }
    end
    local BASE = Color3.fromRGB(205, 18, 20)
    local baseH, baseS, baseV = BASE:ToHSV()
    local K_RED = key(BASE)
    local K_BRIGHT = key(Color3.fromRGB(240, 30, 24))
    local K_DARK = key(Color3.fromRGB(52, 8, 12))

    local DEFAULT = { h = baseH, s = baseS, v = baseV }
    local St = { h = baseH, s = baseS, v = baseV, rainbow = false, font = "Gotham", speed = 1, phase = 0 }

    --// saved settings
    if isfile and readfile then
        pcall(function()
            if isfile(FILE) then
                local d = HttpService:JSONDecode(readfile(FILE))
                if type(d) == "table" then
                    if type(d.h) == "number" and type(d.s) == "number" and type(d.v) == "number" then
                        St.h = math.clamp(d.h, 0, 1)
                        St.s = math.clamp(d.s, 0, 1)
                        St.v = math.clamp(d.v, 0, 1)
                    end
                    if type(d.rainbow) == "boolean" then
                        St.rainbow = d.rainbow
                    end
                    if type(d.font) == "string" then
                        St.font = d.font
                    end
                    if type(d.speed) == "number" then
                        St.speed = math.clamp(d.speed, 0.25, 3)
                    end
                    if type(d.al) == "table" then
                        _G.KAMUI_ArraylistSaved = d.al
                    end
                end
            end
        end)
    end
    _G.KAMUI_GuiState = St

    local REV, HIST, NEUTRAL = {}, {}, {}
    -- Cache reverse lookups until the accent palette/history changes. Sweeps and
    -- updates often inspect the same colors many times in one update cycle.
    local LOOKUP_CACHE = {}
    local function lookup(k, forSweep)
        if ORIG[k] then
            return k
        end
        if forSweep and NEUTRAL[k] then
            return nil -- grey-ish accent colors could clash with normal UI greys
        end
        local cached = LOOKUP_CACHE[k]
        if cached ~= nil then
            return cached or nil
        end
        local r = REV[k]
        if not r then
            for i = 1, #HIST do
                r = HIST[i][k]
                if r then
                    break
                end
            end
        end
        LOOKUP_CACHE[k] = r or false
        return r
    end

    local function computeCur()
        local h, s, v = St.h, St.s, St.v
        if St.rainbow then
            h = St.phase % 1
            s = math.max(s, 0.7)
            v = math.max(v, 0.85)
        end
        for k, o in pairs(ORIG) do
            local dh = o.h - baseH
            if dh > 0.5 then
                dh = dh - 1
            elseif dh < -0.5 then
                dh = dh + 1
            end
            CUR[k] = Color3.fromHSV((h + dh) % 1, math.clamp(o.s * s / baseS, 0, 1), math.clamp(o.v * v / baseV, 0, 1))
        end
        return h, s, v
    end

    local CLASS_PROPS = {}
    local function propsFor(inst)
        local cn = inst.ClassName
        local p = CLASS_PROPS[cn]
        if p == nil then
            p = false
            if inst:IsA("UIStroke") then
                p = { "Color" }
            elseif inst:IsA("GuiObject") then
                p = { "BackgroundColor3", "BorderColor3" }
                if inst:IsA("TextLabel") or inst:IsA("TextButton") or inst:IsA("TextBox") then
                    p[#p + 1] = "TextColor3"
                    p[#p + 1] = "TextStrokeColor3"
                    if inst:IsA("TextBox") then
                        p[#p + 1] = "PlaceholderColor3"
                    end
                end
                if inst:IsA("ImageLabel") or inst:IsA("ImageButton") then
                    p[#p + 1] = "ImageColor3"
                end
                if inst:IsA("ScrollingFrame") then
                    p[#p + 1] = "ScrollBarImageColor3"
                end
            end
            CLASS_PROPS[cn] = p
        end
        return p or nil
    end

    local BIND = setmetatable({}, { __mode = "k" }) -- instance -> { Property = true }
    local function register(inst)
        local list = propsFor(inst)
        if not list or inst:IsDescendantOf(page) or inst:GetAttribute("KamuiKeepColor") then
            return
        end
        for _, p in ipairs(list) do
            if lookup(key(inst[p]), true) then
                local b = BIND[inst]
                if not b then
                    b = {}
                    BIND[inst] = b
                end
                b[p] = true
            end
        end
    end

    local function guiRoots()
        local r = { ScreenGui }
        if RestoreGui and RestoreGui.Parent then
            r[#r + 1] = RestoreGui
        end
        local ok, kids = pcall(function()
            return game:GetService("CoreGui"):GetChildren()
        end)
        if ok then
            for _, g in ipairs(kids) do
                if g ~= ScreenGui and g:IsA("ScreenGui") and g.Name:find("^KAMUI_") and not g.Name:find("_Restore$") then
                    r[#r + 1] = g
                end
            end
        end
        return r
    end

    local function sweepAll()
        for _, root in ipairs(guiRoots()) do
            for _, d in ipairs(root:GetDescendants()) do
                register(d)
            end
        end
    end

    local function applyAccent()
        local h, s, v = computeCur()
        table.insert(HIST, 1, REV)
        if #HIST > 10 then
            table.remove(HIST)
        end
        REV = {}
        for k, c in pairs(CUR) do
            local ck = key(c)
            if REV[ck] == nil then
                REV[ck] = k
            end
            if math.max(c.R, c.G, c.B) - math.min(c.R, c.G, c.B) < 0.12 then
                NEUTRAL[ck] = true
            end
        end
        -- REV, HIST and NEUTRAL now represent a new palette.
        table.clear(LOOKUP_CACHE)
        THEME.Red = CUR[K_RED]
        THEME.BrightRed = CUR[K_BRIGHT]
        THEME.DarkRed = CUR[K_DARK]
        THEME.Green = CUR[K_BRIGHT]
        for inst, props in pairs(BIND) do
            if inst.Parent then
                for p in pairs(props) do
                    local current = inst[p]
                    local k = lookup(key(current), false)
                    if k then
                        local nc = CUR[k]
                        if current ~= nc then
                            inst[p] = nc
                        end
                    end
                end
            end
        end
        -- Keep the main title synced if color history loses track of it.
        if Title and Title.Parent and Title.TextColor3 ~= THEME.BrightRed then
            Title.TextColor3 = THEME.BrightRed
        end

        local seq0, grads = _G.KAMUI_BorderSeq, _G.KAMUI_BorderGradients
        if seq0 and grads then
            local pts = {}
            for i, kp in ipairs(seq0.Keypoints) do
                pts[i] = ColorSequenceKeypoint.new(kp.Time, CUR[key(kp.Value)] or kp.Value)
            end
            local ns = ColorSequence.new(pts)
            for _, g in ipairs(grads) do
                g.Color = ns
            end
        end
        return h, s, v
    end

