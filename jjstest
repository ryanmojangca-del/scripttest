            flMobStroke.Color = on and THEME.Red or Color3.fromRGB(58, 10, 15)
            flMobDot.BackgroundColor3 = on and THEME.BrightRed or Color3.fromRGB(70, 70, 74)
        end
    end
    M.FakeLagPaint = paintFlUI
    flBtn.MouseButton1Click:Connect(function()
        M.FakeLagCapturing = true
        paintFlUI()
    end)

    makeToggle(flCard, "FakeLagMobileToggle", "Mobile mode",
        function() return M.FakeLagMobile end,
        function(v)
            M.FakeLagMobile = v
            paintFlUI()
        end,
        "shows a Fake lag: ON/OFF button on screen")
    flMob = Instance.new("TextButton")
    flMob.Name = "FakeLagButton"
    flMob:SetAttribute("KamuiSkinned", true)
    flMob.Parent = RestoreGui
    flMob.ZIndex = 50
    flMob.AnchorPoint = Vector2.new(0.5, 0.5)
    flMob.Size = UDim2.new(0, 128, 0, 34)
    flMob.Position = UDim2.new(0.7, 28, 0.3, 0)
    flMob.BackgroundColor3 = THEME.BackgroundLight
    flMob.BackgroundTransparency = 0
    flMob.AutoButtonColor = false
    flMob.Text = ""
    flMob.Visible = false
    flMob.Draggable = true
    flMob.Active = true
    UI.corner(flMob, 17)
    flMobStroke = Instance.new("UIStroke")
    flMobStroke.Parent = flMob
    flMobStroke.Color = Color3.fromRGB(58, 10, 15)
    flMobStroke.Thickness = 1
    flMobDot = Instance.new("Frame")
    flMobDot.Name = "FakeLagDot"
    flMobDot.Parent = flMob
    flMobDot.AnchorPoint = Vector2.new(0, 0.5)
    flMobDot.Position = UDim2.new(0, 12, 0.5, 0)
    flMobDot.Size = UDim2.new(0, 5, 0, 5)
    flMobDot.BackgroundColor3 = Color3.fromRGB(70, 70, 74)
    flMobDot.BorderSizePixel = 0
    UI.corner(flMobDot, 100)
    flMobLabel = Instance.new("TextLabel")
    flMobLabel.Name = "FakeLagLabel"
    flMobLabel.Parent = flMob
    flMobLabel.BackgroundTransparency = 1
    flMobLabel.Position = UDim2.new(0, 22, 0, 0)
    flMobLabel.Size = UDim2.new(1, -28, 1, 0)
    flMobLabel.Font = Enum.Font.GothamMedium
    flMobLabel.TextSize = 11
    flMobLabel.TextColor3 = THEME.MutedText
    flMobLabel.Text = "Fake lag: OFF"
    flMob.MouseButton1Click:Connect(function()
        M.FakeLagSet(not M.FakeLag)
    end)
    paintFlUI()
end

_G.KAMUI_ContentInit = function()
    local ok, UI = pcall(_G.KAMUI_UIKit)
    if not ok then
        warn("[KAMUI] content kit failed:", UI)
        return
    end
    for _, name in ipairs({ "Home", "Skills", "Others", "GUI", "Combat", "Movement" }) do
        local ok2, err = pcall(_G["KAMUI_Build" .. name], UI)
        if not ok2 then
            warn("[dw] " .. name .. " tab redesign failed:", err)
        end
    end
end
_G.KAMUI_ContentInit()

