    -- This lock exists only while the scripted block is held. No target is
    -- selected independently, and normal control resumes on release.
    local camBinding = "KAMUI_BlockCam_" .. tostring(scriptId)
    RunService:BindToRenderStep(camBinding, Enum.RenderPriority.Camera.Value + 3, function()
        if not isCurrent() or not page.Parent then
            releaseBlock()
            releaseCounter()
            pcall(function() RunService:UnbindFromRenderStep(camBinding) end)
            return
        end
        if counterActive and (not CC.Counter or os.clock() > counterUntil) then releaseCounter() end
        -- BF's independent lock has temporary camera/rotation priority.
        if CC.TargetLockEngaged or CC.SwitcherTargetEngaged then releaseBlockCam(); return end
        local activeTarget, activeMode, cameraEnabled
        if counterActive then
            activeTarget, activeMode, cameraEnabled = counterTarget, CC.CounterCamMode, CC.CounterCamEnabled
        elseif CC.Block and blocking and os.clock() <= blockUntil then
            activeTarget, activeMode, cameraEnabled = blockTarget, CC.BlockCamMode, CC.BlockCamEnabled
        end
        if not activeTarget or not cameraEnabled then
            releaseBlockCam()
            return
        end
        local char = player.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local targetChar = activeTarget and activeTarget.Parent and activeTarget.Character
        local targetRoot = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
        local targetHum = targetChar and targetChar:FindFirstChildOfClass("Humanoid")
        local cam = Workspace.CurrentCamera
        if not root or not hum or hum.Health <= 0 or not targetRoot
            or not targetHum or targetHum.Health <= 0 or not cam then
            releaseBlockCam()
            return
        end
        CC.BlockCamActive = true
        if activeMode == "Legit" then
            -- Drop any previous character-rotation override when switching modes.
            if rotationHum then
                pcall(function() rotationHum.AutoRotate = previousAutoRotate end)
                rotationHum, previousAutoRotate = nil, nil
            end
            if (targetRoot.Position - cam.CFrame.Position).Magnitude > 0.01 then
                cam.CFrame = CFrame.lookAt(cam.CFrame.Position, targetRoot.Position)
            end
        else
            -- Client-controlled body rotation may replicate, but is not server code.
            if root.Anchored or hum.PlatformStand then releaseBlockCam(); return end
            if rotationHum ~= hum then
                if rotationHum then pcall(function() rotationHum.AutoRotate = previousAutoRotate end) end
                rotationHum, previousAutoRotate = hum, hum.AutoRotate
            end
            hum.AutoRotate = false
            local goal = Vector3.new(targetRoot.Position.X, root.Position.Y, targetRoot.Position.Z)
            if (goal - root.Position).Magnitude > 0.01 then
                root.CFrame = CFrame.lookAt(root.Position, goal)
            end
        end
    end)

